          </p>
        </punkt>
        <punkt eId="DU/2026/39__art_2__pkt_2" gd:GUID="113c977b-6b84-4562-a8aa-4a074a03a160" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-28_DU-2026-39_domyslne.x" wejscie-w-zycie="2026-01-28">
          <nr>2</nr>
