    <artykul eId="DU/2025/1064__art_1" gd:GUID="1b28168a-9649-4200-b350-328ee691a8de" okres="okr_obowiazywanie.zdarz_wejscie_2025-08-20_DU-2025-1064_domyslne.x" wejscie-w-zycie="2025-08-20">
