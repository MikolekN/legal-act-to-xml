      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="148f6ab3-c02b-406a-aa2b-2b12597e5aec" okres="okr_obowiazywanie.zdarz_wejscie_2025-08-20_DU-2025-1064_domyslne.x" wejscie-w-zycie="2025-08-20">
        <p>
          <zdanie nr="1" gd:zdGUID="9fbe8f11-55b5-420a-bae8-a8eb04f36b6c" fragment="1" gd:fragmentGUID="a161d454-d5d2-445d-9129-0ff587bd5c86" okres="okr_obowiazywanie.zdarz_wejscie_2025-08-20_DU-2025-1064_domyslne.x" wejscie-w-zycie="2025-08-20">Ustawa wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
      </ustep-n>
    </artykul>
