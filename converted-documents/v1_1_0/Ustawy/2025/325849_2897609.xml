      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="d9b445e5-611b-421e-88c0-de2818e914a3" okres="okr_obowiazywanie.zdarz_wejscie_2025-06-16_DU-2025-641_domyslne.x" wejscie-w-zycie="2025-06-16">
        <p>
          <zdanie nr="1" gd:zdGUID="30f2935a-629c-4eb9-8fb5-b8ba93db38bf" fragment="1" gd:fragmentGUID="c664ef88-5726-42f8-8453-a7ac203db2e9" okres="okr_obowiazywanie.zdarz_wejscie_2025-06-16_DU-2025-641_domyslne.x" wejscie-w-zycie="2025-06-16">Ustawa wchodzi w życie po upływie 30 dni od dnia ogłoszenia.</zdanie>
        </p>
      </ustep-n>
