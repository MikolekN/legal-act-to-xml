      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="a35ee934-615f-4edf-beae-ab71c0cb1370" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-10_DU-2025-1175_domyslne.x" wejscie-w-zycie="2025-09-10">
        <p>
          <zdanie nr="1" gd:zdGUID="66b25d5d-f96b-4bdc-8201-7ba7efb028d6" fragment="1" gd:fragmentGUID="c29a49a5-043f-4a63-b46c-3bddde4a3afb" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-10_DU-2025-1175_domyslne.x" wejscie-w-zycie="2025-09-10">Ustawa wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
