    <data>z dnia 4 kwietnia 2025 r.</data>
    <tytul>o zmianie ustawy o Narodowym Centrum Nauki</tytul>
    <artykul eId="DU/2025/631__art_1" gd:GUID="a28c2630-9f20-411d-9b37-e265866b7a39" okres="okr_obowiazywanie.zdarz_wejscie_2025-05-29_DU-2025-631_domyslne.x" wejscie-w-zycie="2025-05-29">
