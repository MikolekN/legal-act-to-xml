        </p>
      </ustep>
      <ustep eId="DU/2025/1018__art_2__ust_3" gd:GUID="4cdd2c06-f98e-4ff4-9e2c-0d7de84397f6" okres="okr_obowiazywanie.zdarz_wejscie_2025-08-12_DU-2025-1018_domyslne.x" wejscie-w-zycie="2025-08-12">
