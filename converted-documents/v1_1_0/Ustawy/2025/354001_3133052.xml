    <artykul eId="DU/2025/1812__art_5" gd:GUID="b52cc7a0-09a8-4576-b2e0-ee390ba43913" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-31_DU-2025-1812_odczytane.x" wejscie-w-zycie="2025-12-31">
      <nr>5</nr>
      <ustep eId="DU/2025/1812__art_5__ust_1" gd:GUID="163cd569-cc30-4ae3-bc9a-624b65054e2e" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-31_DU-2025-1812_odczytane.x" wejscie-w-zycie="2025-12-31">
        <nr>1</nr>
        <p>
