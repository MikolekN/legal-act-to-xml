          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="98efbbd2-0fa6-4d3f-824a-652af3c2f441" fragment="3" gd:fragmentGUID="3afbbbf0-af46-4123-b3b2-4da23e678be8" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-31_DU-2025-1812_odczytane.x" wejscie-w-zycie="2025-12-31">art. 60 otrzymuje brzmienie:<cytat-strukt now:akt="https://eli.gov.pl/eli/DU/2024/1288" cudzyslowy="oba" gd:nowGUID="ca5f4ba9-b05e-4339-8d39-38ef4febb9c5" element-eId="DU/2024/1288__art_60" funkcja="zastap"><artykul eId="DU/2024/1288__art_60" gd:GUID="58bfbd87-f8b2-4d56-9799-dd2fbbf5a73c" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-31_DU-2025-1812_odczytane.x" wejscie-w-zycie="2025-12-31"><nr>60</nr><ustep eId="DU/2024/1288__art_60__ust_1" gd:GUID="46835612-fe59-44ad-b5ee-b748f98f3d2b" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-31_DU-2025-1812_odczytane.x" wejscie-w-zycie="2025-12-31"><nr>1</nr><p><zdanie nr="1" gd:zdGUID="7535dfd0-405d-45af-8351-993148338b9d" fragment="1" gd:fragmentGUID="e6750e18-02ee-42b4-958e-bd47a3d30ba5" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-31_DU-2025-1812_odczytane.x" wejscie-w-zycie="2025-12-31">Przepisy art. 193 ust. 1c–1e ustawy zmienianej w art. 43 tracą moc z dniem 1 stycznia 2027 r.</zdanie></p></ustep><ustep eId="DU/2024/1288__art_60__ust_2" gd:GUID="59789e57-f66b-44a3-8b21-645a76d8e26d" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-31_DU-2025-1812_odczytane.x" wejscie-w-zycie="2025-12-31"><nr>2</nr><p><zdanie nr="1" gd:zdGUID="7394f21f-a145-4d85-b696-0a6fa895d293" fragment="1" gd:fragmentGUID="06246eaa-430c-413d-8e28-fa4639b3d4ad" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-31_DU-2025-1812_odczytane.x" wejscie-w-zycie="2025-12-31">Przepisy art. 226a ustawy zmienianej w art. 45 tracą moc z dniem 1 stycznia 2027 r.</zdanie></p></ustep></artykul></cytat-strukt>.</zdanie>
