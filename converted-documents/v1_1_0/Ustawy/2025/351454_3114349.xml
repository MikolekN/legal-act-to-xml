        </punkt>
        <punkt eId="DU/2025/1705__art_1__pkt_2" gd:GUID="894bc408-d736-4cc8-b476-4ec04928ee8e" okres="okr_obowiazywanie.zdarz_wejscie_2027-01-01_DU-2025-1705_odczytane.x" wejscie-w-zycie="2027-01-01">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="3add156a-fe0c-4df7-87a0-da9dd8fdbda3" fragment="3" gd:fragmentGUID="708c5773-8832-438d-b382-604431860e75" okres="okr_obowiazywanie.zdarz_wejscie_2027-01-01_DU-2025-1705_odczytane.x" wejscie-w-zycie="2027-01-01">w art. 5:</zdanie>
          </p>
          <litera eId="DU/2025/1705__art_1__pkt_2__lit_a" gd:GUID="9de39f90-0b38-4728-b241-58630796e326" okres="okr_obowiazywanie.zdarz_wejscie_2027-01-01_DU-2025-1705_odczytane.x" wejscie-w-zycie="2027-01-01">
            <nr>a</nr>
            <p>
