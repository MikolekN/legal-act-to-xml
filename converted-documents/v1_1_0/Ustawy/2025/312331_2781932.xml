    <rodzaj-aktu>Ustawa</rodzaj-aktu>
    <data>z dnia 5 grudnia 2024 r.</data>
    <tytul>o zmianie ustawy o sporcie</tytul>
    <artykul eId="DU/2025/28__art_1" gd:GUID="07eae0c8-853c-4041-9fcc-6cc810a1b74b" okres="okr_obowiazywanie.zdarz_wejscie_2025-04-01_DU-2025-28_odczytane.x" wejscie-w-zycie="2025-04-01">
