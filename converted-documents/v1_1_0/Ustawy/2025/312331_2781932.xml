      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="c96a097c-a892-41ec-9886-f8f3e45bcd2f" okres="okr_obowiazywanie.zdarz_wejscie_2025-04-01_DU-2025-28_odczytane.x" wejscie-w-zycie="2025-04-01">
        <p>
          <zdanie nr="1" gd:zdGUID="f7b00fa0-af7f-484e-9a67-12e0b3fc5f0d" fragment="1" gd:fragmentGUID="44651802-e2d2-43a4-9d45-01747924b8b4" okres="okr_obowiazywanie.zdarz_wejscie_2025-04-01_DU-2025-28_odczytane.x" wejscie-w-zycie="2025-04-01">W ustawie z dnia 25 czerwca 2010 r. o sporcie (Dz. U. z 2024 r. poz. 1488) w art. 36 w ust. 1 po pkt 1a dodaje się pkt 1b w brzmieniu:<cytat-strukt now:akt="https://eli.gov.pl/eli/DU/2024/1488" cudzyslowy="oba" gd:nowGUID="16cdd1a3-0714-4268-815e-b32a706e34ff" element-eId="DU/2024/1488__art_36__ust_1__pkt_1a" funkcja="dodaj-po"><punkt eId="DU/2024/1488__art_36__ust_1__pkt_1b" gd:GUID="c7a8f7f9-094e-4e1c-b431-bfd4f0f66da9" okres="okr_obowiazywanie.zdarz_wejscie_2025-04-01_DU-2025-28_odczytane.x" wejscie-w-zycie="2025-04-01"><nr>1b</nr><p><zdanie nr="1" gd:zdGUID="1b03ce55-2c9d-4dd1-b023-673ee75c09ce" fragment="1" gd:fragmentGUID="474d23df-6c45-4804-bf12-e318c8bd23fb" okres="okr_obowiazywanie.zdarz_wejscie_2025-04-01_DU-2025-28_odczytane.x" wejscie-w-zycie="2025-04-01">na Igrzyskach Dobrej Woli,</zdanie></p></punkt></cytat-strukt>.</zdanie>
        </p>
      </ustep-n>
    </artykul>
    <artykul eId="DU/2025/28__art_2" gd:GUID="774b6b8f-1c8f-4552-88c0-2470944ffb98" okres="okr_obowiazywanie.zdarz_wejscie_2025-04-01_DU-2025-28_odczytane.x" wejscie-w-zycie="2025-04-01">
      <nr>2</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="4b4254b6-fd45-4948-9b21-60b71c51f4ae" okres="okr_obowiazywanie.zdarz_wejscie_2025-04-01_DU-2025-28_odczytane.x" wejscie-w-zycie="2025-04-01">
        <p>
          <zdanie nr="1" gd:zdGUID="5103d596-0743-494a-b419-437a010b6fae" fragment="1" gd:fragmentGUID="67c60b8d-c02d-4fb4-a40d-c0bc79484090" okres="okr_obowiazywanie.zdarz_wejscie_2025-04-01_DU-2025-28_odczytane.x" wejscie-w-zycie="2025-04-01">Świadczenie, o którym mowa w art. 36 ust. 1 ustawy zmienianej w art. 1, przysługuje osobom wskazanym w art. 36 ust. 1 pkt 1b ustawy zmienianej w art. 1, które spełniły kryteria, o których mowa w art. 36 ust. 2 ustawy zmienianej w art. 1, przed dniem wejścia w życie niniejszej ustawy.</zdanie>
        </p>
      </ustep-n>
    </artykul>
    <artykul eId="DU/2025/28__art_3" gd:GUID="b8ea616f-33f3-4e7f-831d-31d3dda2fa1a" okres="okr_obowiazywanie.zdarz_wejscie_2025-04-01_DU-2025-28_odczytane.x" wejscie-w-zycie="2025-04-01">
      <nr>3</nr>
