      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="e057c8d4-6d04-4013-b228-68b692c1af5b" okres="okr_obowiazywanie.zdarz_wejscie_2026-04-08_DU-2025-900_domyslne.x" wejscie-w-zycie="2026-04-08">
        <p>
          <zdanie nr="1" gd:zdGUID="79eb5812-f2b9-4814-b6a7-4cedd4f6eb68" fragment="1" gd:fragmentGUID="03f3f52f-2add-4a47-b7f9-b7253bc71e1c" okres="okr_obowiazywanie.zdarz_wejscie_2026-04-08_DU-2025-900_domyslne.x" wejscie-w-zycie="2026-04-08">Ustawa wchodzi w życie po upływie 9 miesięcy od dnia ogłoszenia.</zdanie>
