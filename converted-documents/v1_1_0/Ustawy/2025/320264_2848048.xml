    <artykul eId="DU/2025/374__art_1" gd:GUID="63990ff2-cf3f-42ea-a77b-930fb49d91a0" okres="okr_obowiazywanie.zdarz_wejscie_2025-04-09_DU-2025-374_domyslne.x" wejscie-w-zycie="2025-04-09">
