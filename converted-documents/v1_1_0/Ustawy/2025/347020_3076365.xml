    <artykul eId="DU/2025/1507__art_1" gd:GUID="80297061-4ea5-41f2-a295-3cfaff3d2135" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-18_DU-2025-1507_domyslne.x" wejscie-w-zycie="2025-11-18">
