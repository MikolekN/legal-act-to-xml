          </p>
        </punkt>
        <punkt eId="DU/2025/1700__art_1__pkt_5" gd:GUID="1588ee9b-02f9-47c8-ad8f-d6216653cfc8" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-05_DU-2025-1700_domyslne.x" wejscie-w-zycie="2026-03-05">
