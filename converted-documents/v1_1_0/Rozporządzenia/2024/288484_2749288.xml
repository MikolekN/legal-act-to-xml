            </p>
          </litera>
          <litera eId="DU/2024/1794__art_1__pkt_1__lit_c" gd:GUID="bfd6021b-cec5-4046-8847-83e11743a277" okres="okr_obowiazywanie.zdarz_wejscie_2025-01-01_DU-2024-1794_odczytane.x" wejscie-w-zycie="2025-01-01">
            <nr>c</nr>
