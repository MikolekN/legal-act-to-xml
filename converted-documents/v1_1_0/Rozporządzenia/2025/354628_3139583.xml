            <nr>a</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="fac79386-2b82-49b3-92db-901d91d6f4c5" fragment="4" gd:fragmentGUID="bc34a2b4-e4df-4578-a673-00f2af541051" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1853_odczytane.x" wejscie-w-zycie="2026-01-01">pkt 1 otrzymuje brzmienie:<cytat-strukt now:akt="https://eli.gov.pl/eli/DU/2024/798" cudzyslowy="oba" gd:nowGUID="2839e067-2636-42c4-bdf8-f8093550b013" element-eId="DU/2024/798__art_9__ust_2__pkt_1" funkcja="zastap"><punkt eId="DU/2024/798__art_9__ust_2__pkt_1" gd:GUID="34cabdc1-f9b4-432b-b73f-8566702a2d98" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1853_odczytane.x" wejscie-w-zycie="2026-01-01"><nr>1</nr><p><zdanie nr="1" gd:zdGUID="4f64d6bc-ce00-473b-8d9c-44a2ffe6c09e" fragment="1" gd:fragmentGUID="f09702a1-90a8-421f-8f39-9c442ea99e66" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1853_odczytane.x" wejscie-w-zycie="2026-01-01">oznaczenie podmiotu wystawiającego skierowanie, zgodnie z § 10 pkt 1, i adres miejsca wystawienia skierowania;</zdanie></p></punkt></cytat-strukt>,</zdanie>
            </p>
          </litera>
          <litera eId="DU/2025/1853__art_1__pkt_2__lit_b" gd:GUID="d56064c4-5def-44dd-8187-35d2dc36124c" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1853_odczytane.x" wejscie-w-zycie="2026-01-01">
            <nr>b</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="fac79386-2b82-49b3-92db-901d91d6f4c5" fragment="5" gd:fragmentGUID="2fc56cf2-0381-472e-8479-4c728a93bcd1" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1853_odczytane.x" wejscie-w-zycie="2026-01-01">pkt 3 i 4 otrzymują brzmienie:<cytat-strukt now:akt="https://eli.gov.pl/eli/DU/2024/798" cudzyslowy="otwierajacy" gd:nowGUID="ea6a5d2c-beb3-4b30-a997-97dd0aedc4bd" element-eId="DU/2024/798__art_9__ust_2__pkt_3" funkcja="zastap"><punkt eId="DU/2024/798__art_9__ust_2__pkt_3" gd:GUID="dbfb83df-72dd-4153-a3c7-6cc6d44dee87" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1853_odczytane.x" wejscie-w-zycie="2026-01-01"><nr>3</nr><p><zdanie nr="1" gd:zdGUID="6b52c26a-e5c5-436d-a00e-694cbee052ad" fragment="1" gd:fragmentGUID="297fcbd6-1f8c-4af7-8a7f-873d21445de4" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1853_odczytane.x" wejscie-w-zycie="2026-01-01">oznaczenie rodzaju badania, konsultacji lub leczenia, na które kieruje się pacjenta, zgodnie z obowiązującą Międzynarodową Klasyfikacją Procedur Medycznych;</zdanie></p></punkt></cytat-strukt><cytat-strukt now:akt="https://eli.gov.pl/eli/DU/2024/798" cudzyslowy="zamykajacy" gd:nowGUID="2fa8968c-ca42-4cea-95a0-884eebb6044d" element-eId="DU/2024/798__art_9__ust_2__pkt_4" funkcja="zastap"><punkt eId="DU/2024/798__art_9__ust_2__pkt_4" gd:GUID="6d17b335-3172-4b84-aa91-67729f5a9fbf" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1853_odczytane.x" wejscie-w-zycie="2026-01-01"><nr>4</nr><p><zdanie nr="1" gd:zdGUID="094ee48e-718e-4c8b-a8c7-e09eac3c1885" fragment="1" gd:fragmentGUID="f1f9230c-13c1-4516-ab6b-699bbb564007" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1853_odczytane.x" wejscie-w-zycie="2026-01-01">rozpoznanie kliniczne dotyczące problemu zdrowotnego, stanowiące przyczynę wystawienia skierowania oraz rozpoznania współistniejące, z zastosowaniem obowiązującej Międzynarodowej Klasyfikacji Chorób i Problemów Zdrowotnych;</zdanie></p></punkt></cytat-strukt>,</zdanie>
            </p>
          </litera>
          <litera eId="DU/2025/1853__art_1__pkt_2__lit_c" gd:GUID="e886382f-b1fd-4f8e-9510-b9cc2594067b" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1853_odczytane.x" wejscie-w-zycie="2026-01-01">
            <nr>c</nr>
