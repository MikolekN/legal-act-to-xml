          </p>
        </punkt>
        <punkt eId="DU/2025/1853__art_1__pkt_2" gd:GUID="c807cfdf-e20d-4bf4-8e6c-4d81a15a7b4e" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1853_odczytane.x" wejscie-w-zycie="2026-01-01">
          <nr>2</nr>
          <p>
