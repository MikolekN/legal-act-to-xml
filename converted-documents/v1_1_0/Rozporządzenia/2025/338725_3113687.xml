              </p>
            </tiret>
          </litera>
          <litera eId="DU/2025/1701__art_1__pkt_1__lit_b" gd:GUID="10a9cd73-1eb0-4aeb-baaa-5b88a860eeed" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-19_DU-2025-1701_domyslne.x" wejscie-w-zycie="2025-12-19">
