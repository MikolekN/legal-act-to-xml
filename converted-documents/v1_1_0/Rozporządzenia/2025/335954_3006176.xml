        <p>
          <zdanie nr="1" gd:zdGUID="b7d5c496-02df-4d95-8406-90c8cda21380" fragment="1" gd:fragmentGUID="0f688641-83b9-4057-ad3a-19e7f125f68d" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-01_DU-2025-1195_odczytane.x" wejscie-w-zycie="2025-09-01">Rozporządzenie wchodzi w życie z dniem 1 września 2025 r.</zdanie>
        </p>
      </ustep-n>
