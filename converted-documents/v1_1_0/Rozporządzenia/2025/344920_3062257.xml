          </p>
        </punkt>
        <punkt eId="DU/2025/1433__art_1__pkt_3" gd:GUID="c4c044e7-fff3-43c2-ab12-e4e554c3636d" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-05_DU-2025-1433_domyslne.x" wejscie-w-zycie="2025-11-05">
          <nr>3</nr>
          <p>
