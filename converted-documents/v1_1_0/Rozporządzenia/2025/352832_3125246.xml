        </p>
        <punkt eId="DU/2025/1771__art_1__ust_3__pkt_1" gd:GUID="a0e5b684-633a-4fbb-bccf-e62080f0d985" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1771_odczytane.x" wejscie-w-zycie="2026-01-01">
