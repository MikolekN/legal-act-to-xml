          </p>
        </punkt>
        <punkt eId="DU/2025/1771__art_1__ust_3__pkt_2" gd:GUID="7d639f5f-5284-4870-8de1-4b248fdf8fb5" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1771_odczytane.x" wejscie-w-zycie="2026-01-01">
          <nr>2</nr>
