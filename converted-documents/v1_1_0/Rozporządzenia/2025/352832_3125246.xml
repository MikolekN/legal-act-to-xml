          </p>
        </punkt>
        <punkt eId="DU/2025/1771__art_1__ust_3__pkt_3" gd:GUID="0c69894b-25d1-40a4-8a48-cd703c3f2dd9" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1771_odczytane.x" wejscie-w-zycie="2026-01-01">
