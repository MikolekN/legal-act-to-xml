        <p>
          <zdanie nr="1" gd:zdGUID="69c54650-2e92-401a-b8bd-5a70050786ae" fragment="1" gd:fragmentGUID="5dc9eb9c-47f3-44de-91de-9b85bf4f040c" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-13_DU-2025-1488_domyslne.x" wejscie-w-zycie="2025-11-13">Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
