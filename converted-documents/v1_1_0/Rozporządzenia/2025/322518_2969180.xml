            <nr>a</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="5c958b0a-2de0-4883-8aa0-5a7c82ffa824" fragment="5" gd:fragmentGUID="6df4d8a3-9a04-4888-8947-fe3356bf5cb4" okres="okr_obowiazywanie.zdarz_wejscie_2025-08-08_DU-2025-985_domyslne.x" wejscie-w-zycie="2025-08-08">w lp. 21 objaśnienie do jednostki statystycznej „Świadczenie profilaktyczne” otrzymuje brzmienie:<cytat-w-tekscie now:akt="https://eli.gov.pl/eli/DU/2024/610" cudzyslowy="oba" gd:nowGUID="52672d5c-f6ff-45f7-a5ba-9b8c9f8af3c8" element-eId="DU/2024/610__zal_1" funkcja="zastap-recznie"><tekst>Obejmuje pozostałe badania profilaktyczne, nieprzyporządkowane jednostkom statystycznym o kodach 5, 7, 17, 19, 20 i 25.</tekst></cytat-w-tekscie>,</zdanie>
            </p>
          </litera>
          <litera eId="DU/2025/985__art_1__pkt_3__lit_b" gd:GUID="107b4a3d-2d83-4506-9ca8-801fa0420f8e" okres="okr_obowiazywanie.zdarz_wejscie_2025-08-08_DU-2025-985_domyslne.x" wejscie-w-zycie="2025-08-08">
