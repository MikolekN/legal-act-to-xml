    <paragraf eId="DU/2025/1622__art_4" gd:GUID="b00d32a8-da9d-4329-a766-417c1001c167" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-01_DU-2025-1622_odczytane.x" wejscie-w-zycie="2025-12-01">
