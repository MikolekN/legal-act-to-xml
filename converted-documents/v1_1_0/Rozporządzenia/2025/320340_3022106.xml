        <p>
          <zdanie nr="1" gd:zdGUID="3c2dc0a8-4ffd-404d-a2c9-69a0e36033dc" fragment="1" gd:fragmentGUID="409d5284-b7f6-4131-a2c5-a0a5cb827c4b" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-30_DU-2025-1243_domyslne.x" wejscie-w-zycie="2025-09-30">Przepisy rozporządzenia stosuje się do sprawozdań, o których mowa w art. 28 ust. 1 i 3 ustawy, za rok obrotowy, który zakończy się po wejściu w życie rozporządzenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <paragraf eId="DU/2025/1243__art_6" gd:GUID="38e3e4c8-d44a-45fb-9e4d-14c9552e8241" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-30_DU-2025-1243_domyslne.x" wejscie-w-zycie="2025-09-30">
