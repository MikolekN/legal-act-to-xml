          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="99d2fd53-c9e4-449e-81be-797a7547fde5" fragment="3" gd:fragmentGUID="13f6c7c3-852b-4a8d-b780-81726e1ee526" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-30_DU-2025-1243_domyslne.x" wejscie-w-zycie="2025-09-30">terminy oraz sposób przekazywania sprawozdań, o których mowa w art. 28 ust. 1 i 3 ustawy z dnia 20 grudnia 2024 r. o podmiotach obsługujących kredyty i nabywcach kredytów, zwanej dalej „ustawą”.</zdanie>
          </p>
        </punkt>
      </ustep-n>
    </paragraf>
