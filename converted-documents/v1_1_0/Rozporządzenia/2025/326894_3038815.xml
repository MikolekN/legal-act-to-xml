    <paragraf eId="DU/2025/1316__art_1" gd:GUID="02932e46-f70c-485a-80ef-2f600859c783" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1316_odczytane.x" wejscie-w-zycie="2026-01-01">
      <nr>1</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="ffa61641-983b-4b6a-8798-b17ce7891fd8" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1316_odczytane.x" wejscie-w-zycie="2026-01-01">
