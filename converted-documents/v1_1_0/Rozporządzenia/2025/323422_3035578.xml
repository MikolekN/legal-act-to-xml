            </p>
          </litera>
        </punkt>
        <punkt eId="DU/2025/1294__art_8__ust_1__pkt_3" gd:GUID="0e218212-7663-4e4c-bf01-8355b519e00b" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1294_odczytane.x" wejscie-w-zycie="2026-01-01">
          <nr>3</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="9301d1e2-f451-4047-b8d9-14f13752e605" fragment="9" gd:fragmentGUID="a2f5c49f-c358-47e0-883b-2b28fe753e59" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1294_odczytane.x" wejscie-w-zycie="2026-01-01">określenie środka trwałego lub wartości niematerialnej i prawnej;</zdanie>
          </p>
        </punkt>
