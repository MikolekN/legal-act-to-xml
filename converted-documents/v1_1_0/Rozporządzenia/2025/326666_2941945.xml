    <paragraf eId="DU/2025/846__art_1" gd:GUID="38221c98-4ead-4eeb-b043-9a9ddffec816" okres="okr_obowiazywanie.zdarz_wejscie_2025-07-15_DU-2025-846_domyslne.x" wejscie-w-zycie="2025-07-15">
