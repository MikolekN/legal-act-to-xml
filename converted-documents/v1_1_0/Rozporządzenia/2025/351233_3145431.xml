          <nr>1</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="327bd7ed-a9e2-496a-a92d-2a7af348af3b" fragment="2" gd:fragmentGUID="e8e779b7-4982-4e54-b1ec-3c2383e84ff8" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1898_odczytane.x" wejscie-w-zycie="2026-01-01">rozliczenie kwot przeznaczonych na finansowanie rent wyrównawczych, w podziale na kopalnię – za dany miesiąc i narastająco;</zdanie>
          </p>
        </punkt>
        <punkt eId="DU/2025/1898__art_5__ust_2__pkt_2" gd:GUID="40885c77-e784-4214-8dfc-0f9bd87c0304" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1898_odczytane.x" wejscie-w-zycie="2026-01-01">
