          </p>
        </punkt>
        <punkt eId="DU/2025/1898__art_3__ust_2__pkt_2" gd:GUID="aa62e3cf-0349-4085-9c7a-1e0b916a6a13" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1898_odczytane.x" wejscie-w-zycie="2026-01-01">
