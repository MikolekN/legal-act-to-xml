        <p>
          <zdanie nr="1" gd:zdGUID="e1a567e5-9cb2-4089-b991-c679f39c1f69" fragment="1" gd:fragmentGUID="c35631c8-c902-4f5d-a442-77c6c811ddeb" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1898_odczytane.x" wejscie-w-zycie="2026-01-01">Obowiązek przedłożenia rozliczenia miesięcznego nie dotyczy transzy dotacji wnioskowanej po raz pierwszy i drugi.</zdanie>
        </p>
      </ustep>
    </paragraf>
    <paragraf eId="DU/2025/1898__art_5" gd:GUID="56ebd121-9c92-4a33-9e24-9525f446a5e6" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1898_odczytane.x" wejscie-w-zycie="2026-01-01">
