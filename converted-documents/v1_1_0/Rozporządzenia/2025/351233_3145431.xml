        </punkt>
        <punkt eId="DU/2025/1898__art_4__ust_2__pkt_2" gd:GUID="18db11f9-6c86-4407-9449-76dc7291f710" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1898_odczytane.x" wejscie-w-zycie="2026-01-01">
