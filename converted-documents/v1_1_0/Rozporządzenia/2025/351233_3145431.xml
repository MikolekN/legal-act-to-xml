        <nr>3</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="fae100df-fb76-4a89-89cb-3202d64af04a" fragment="1" gd:fragmentGUID="f1ba5e63-c662-449b-b9fa-12471569a0ae" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1898_odczytane.x" wejscie-w-zycie="2026-01-01">Rozliczenie roczne zawiera informacje, o których mowa w ust. 2, za okres od dnia 1 stycznia do dnia 31 grudnia danego roku.</zdanie>
        </p>
      </ustep>
    </paragraf>
