      </ustep>
      <ustep eId="DU/2025/1898__art_2__ust_2" gd:GUID="03a3f23b-7c25-4bb9-b7b6-956f10425d9c" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1898_odczytane.x" wejscie-w-zycie="2026-01-01">
