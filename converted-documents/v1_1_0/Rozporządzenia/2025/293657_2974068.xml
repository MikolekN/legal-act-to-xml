            <nr>a</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="30ac1362-b8ad-4450-9e72-6cf4d94ce368" fragment="31" gd:fragmentGUID="fd38b4a7-9580-4f72-9bc4-f08b6023a9d9" okres="okr_obowiazywanie.zdarz_wejscie_2025-08-01_DU-2025-1028_domyslne.x" wejscie-w-zycie="2025-08-01">substancji chemicznych bardzo toksycznych lub toksycznych,</zdanie>
