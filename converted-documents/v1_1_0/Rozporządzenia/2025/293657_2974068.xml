    <paragraf eId="DU/2025/1028__art_2" gd:GUID="9340cbe4-6f4f-4309-a282-cc4c958fb89c" okres="okr_obowiazywanie.zdarz_wejscie_2025-08-01_DU-2025-1028_domyslne.x" wejscie-w-zycie="2025-08-01">
