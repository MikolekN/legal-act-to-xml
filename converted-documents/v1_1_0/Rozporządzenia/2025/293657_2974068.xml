        <punkt eId="DU/2025/1028__art_1__pkt_6" gd:GUID="a1024545-ee27-4a27-8f89-bc7fe7bb1a77" okres="okr_obowiazywanie.zdarz_wejscie_2025-08-01_DU-2025-1028_domyslne.x" wejscie-w-zycie="2025-08-01">
          <nr>6</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="30ac1362-b8ad-4450-9e72-6cf4d94ce368" fragment="33" gd:fragmentGUID="93d31e2c-4012-4731-bd3a-3ce3ea95b9da" okres="okr_obowiazywanie.zdarz_wejscie_2025-08-01_DU-2025-1028_domyslne.x" wejscie-w-zycie="2025-08-01">pełnienie służby w warunkach wystąpienia co najmniej czterokrotnej ekspozycji na substancje, ich mieszaniny, czynniki lub procesy, o których mowa w pkt 5, z których każda trwa po minimum 8 godzin.</zdanie>
          </p>
        </punkt>
