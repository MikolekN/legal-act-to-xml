        <tekst-zwykly gd:GUID="12906768-2ba5-4f61-84a1-29902031c5b0">2) 1 Baza Lotnictwa Transportowego,</tekst-zwykly>
        <tekst-zwykly gd:GUID="ebc8ba83-d937-42d8-8be8-a314d8ed1a6d">3) 1 Brygada Logistyczna w Bydgoszczy,</tekst-zwykly>
