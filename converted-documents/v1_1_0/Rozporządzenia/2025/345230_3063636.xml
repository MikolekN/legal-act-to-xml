      <nr>1</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="abe93cba-dd5d-499a-8684-3ee7fe39f096" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-23_DU-2025-1448_domyslne.x" wejscie-w-zycie="2025-10-23">
