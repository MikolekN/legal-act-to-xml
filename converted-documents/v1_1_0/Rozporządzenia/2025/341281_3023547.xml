          <nr>1</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="756d6d80-365e-4341-b369-59b1d0b18f61" fragment="2" gd:fragmentGUID="832cf695-2d5b-4d40-8dea-440904d56549" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-17_DU-2025-1246_domyslne.x" wejscie-w-zycie="2025-09-17"><now:uchyl akt="https://eli.gov.pl/eli/DU/2022/2437" element-eId="DU/2022/2437__art_1__pkt_1__lit_g" gd:nowGUID="599884a1-a8fa-4785-80dd-baae26a454ec" />w § 1 w pkt 1 uchyla się lit. g;</zdanie>
          </p>
        </punkt>
        <punkt eId="DU/2025/1246__art_1__pkt_2" gd:GUID="cfe20187-0bf0-43ca-b0b7-ac0fc3d00940" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-17_DU-2025-1246_domyslne.x" wejscie-w-zycie="2025-09-17">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="756d6d80-365e-4341-b369-59b1d0b18f61" fragment="3" gd:fragmentGUID="f45d698b-2dc9-4d17-8f5f-7b1619723ca7" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-17_DU-2025-1246_domyslne.x" wejscie-w-zycie="2025-09-17"><now:zamien-tekst stary-tekst=", z wyjątkiem § 1 pkt 1 lit. g, który wchodzi w życie z dniem 1 stycznia 2028 r" nowy-tekst="" element-eId="DU/2022/2437__art_2" akt="https://eli.gov.pl/eli/DU/2022/2437" gd:nowGUID="b955e93a-bad4-466a-bd09-ca669b9402f7" />w § 2 skreśla się wyrazy „ , z wyjątkiem § 1 pkt 1 lit. g, który wchodzi w życie z dniem 1 stycznia 2028 r”.</zdanie>
