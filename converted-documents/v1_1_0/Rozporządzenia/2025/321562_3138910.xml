        <p>
          <zdanie nr="1" gd:zdGUID="e32a2520-e030-4d4d-b330-444eb34af2ac" fragment="1" gd:fragmentGUID="f5c4eb7b-1e53-4f8a-9c06-126ca83fed85" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1842_odczytane.x" wejscie-w-zycie="2026-01-01">Rozporządzenie wchodzi w życie z dniem 1 stycznia 2026 r.</zdanie>
        </p>
      </ustep-n>
