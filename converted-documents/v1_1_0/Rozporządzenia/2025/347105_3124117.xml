        <p>
          <zdanie nr="1" gd:zdGUID="b431be66-2e54-438a-8c9f-ec1dec8da9fb" fragment="1" gd:fragmentGUID="7a00102c-df7e-4ecf-9ba3-0961d8e026f3" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1763_odczytane.x" wejscie-w-zycie="2026-01-01">Rozporządzenie wchodzi w życie z dniem 1 stycznia 2026 r.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
