        <tekst-zwykly gd:GUID="59709a64-c364-472d-b360-f45582cba243">7) 3 Regionalna Baza Logistyczna w Krakowie,</tekst-zwykly>
        <tekst-zwykly gd:GUID="dd6f93fe-c805-43b7-b33f-bd5a2674e125">8) 4 Brygada Logistyczna w Pomiechówku,</tekst-zwykly>
        <tekst-zwykly gd:GUID="e2fd7d02-2522-433b-9bda-6fa04fc32967">9) 4 Regionalna Baza Logistyczna we Wrocławiu,</tekst-zwykly>
        <tekst-zwykly gd:GUID="798762e2-41ca-45ab-a74b-19b3ecfe547f">10) 4 Wojskowy Oddział Gospodarczy,</tekst-zwykly>
        <tekst-zwykly gd:GUID="0fc4384d-0844-434a-8c82-5afb211709e9">11) 6 Wojskowy Oddział Gospodarczy,</tekst-zwykly>
