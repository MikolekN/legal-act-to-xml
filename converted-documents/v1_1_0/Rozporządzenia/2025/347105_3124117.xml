    <zalacznik eId="DU/2025/1763__zal_1" gd:GUID="0b085261-01de-464e-8051-7fbc405b72ca">
      <zalacznik-do gd:GUID="5fd17f4f-2511-4b03-9252-87b67e4c6aa1">Załącznik do rozporządzenia Ministra Obrony Narodowej z dnia 10 grudnia 2025 r. (Dz. U. poz. 1763)</zalacznik-do>
      <tytul-zalacznika gd:GUID="a8a41784-0f4f-4f0f-9dea-9eaf705a1a5c">WYKAZ OPERATORÓW PRODUKTÓW I URZĄDZEŃ ZAWIERAJĄCYCH SUBSTANCJE KONTROLOWANE LUB FLUOROWANE GAZY CIEPLARNIANE, BĘDĄCYCH WE WŁADANIU JEDNOSTEK ORGANIZACYJNYCH SIŁ ZBROJNYCH RZECZYPOSPOLITEJ POLSKIEJ</tytul-zalacznika>
      <segment-zalacznika gd:GUID="8c8bbd37-f12b-4094-81b6-0482969783ef" orientacja="pionowa">
