          </p>
        </punkt>
        <punkt eId="DU/2025/1433__art_1__pkt_3" gd:GUID="4165ce12-5fb3-4567-bcad-4715c77e0aec" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-05_DU-2025-1433_domyslne.x" wejscie-w-zycie="2025-11-05">
          <nr>3</nr>
          <p>
