          <zdanie nr="1" gd:zdGUID="dfbba11d-4092-4be4-ab63-494a5903a52b" fragment="1" gd:fragmentGUID="5c25dae0-3504-483f-bacc-a3887951237a" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-02_DU-2025-1134_domyslne.x" wejscie-w-zycie="2025-09-02">Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
