            </p>
            <tiret eId="DU/2025/1134__art_1__pkt_2__lit_d__tir_1" gd:GUID="fb6b5c0e-9a73-46bf-8338-c446a2995825" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-02_DU-2025-1134_domyslne.x" wejscie-w-zycie="2025-09-02">
              <p>
