      <nr>1</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="bdb42483-5ad2-4d5d-a893-e412e5f82ffc" okres="okr_obowiazywanie.zdarz_wejscie_2025-08-26_DU-2025-1093_domyslne.x" wejscie-w-zycie="2025-08-26">
