          <zdanie nr="1" gd:zdGUID="9b8df186-b865-4d04-a56b-7329d73f889d" fragment="1" gd:fragmentGUID="57973a27-37d6-4032-8d9a-9859163644d7" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-02_DU-2025-1134_domyslne.x" wejscie-w-zycie="2025-09-02">Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
