        <tekst-zwykly gd:GUID="cfc745af-4c6b-455c-b201-9125b4c86afb">– gminę Regimin,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d91c079c-60d4-4eb6-a9f9-b0f938f29554">e) w powiecie makowskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="5cc006c3-4504-423d-9fd3-c58e48f28881">– gminę Krasnosielc,</tekst-zwykly>
        <tekst-zwykly gd:GUID="babf1f08-38b6-44db-a96a-b1a16b22121f">– gminę Płoniawy-Bramura,</tekst-zwykly>
        <tekst-zwykly gd:GUID="6c94367e-c641-4357-bec3-63dd84a49dd4">– gminę Sypniewo,</tekst-zwykly>
