      <tytul-zalacznika gd:GUID="42cba0f5-9771-4017-87be-4c2b06851a3f">TABELA MNOŻNIKÓW KWOTY BAZOWEJ DLA TYTUŁU HONOROWEGO DYPLOMOWANEGO KURATORA SPECJALISTY, STOPNI SŁUŻBOWYCH KURATORÓW ZAWODOWYCH ORAZ APLIKANTA KURATORSKIEGO</tytul-zalacznika>
      <segment-zalacznika gd:GUID="5221d521-8727-4c7e-8aac-b5ee584f9317" orientacja="pionowa">
        <tabela gd:GUID="4844bd44-a401-4679-974c-dca76e6a3d95">
          <tbody>
            <tr gd:GUID="f77e05c3-6e54-44fd-bd57-df3b9b374b77">
              <td gd:GUID="e8e1f2bd-2789-4c84-89e5-29c62b7f34c2">
                <tekst-zwykly gd:GUID="01e2fe71-c77f-4bb4-a6aa-7a31ef03b95e">Lp.</tekst-zwykly>
              </td>
              <td gd:GUID="3b2b950c-2b11-461b-9e1e-454e2ddcdda3">
