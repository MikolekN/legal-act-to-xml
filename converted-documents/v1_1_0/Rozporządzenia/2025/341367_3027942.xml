      <zalacznik-do gd:GUID="0a51ad75-e5fc-4668-9498-129c3c996836">Załącznik do rozporządzenia Ministra Spraw Wewnętrznych i Administracji z dnia 12 września 2025 r. (Dz. U. poz. 1257)</zalacznik-do>
      <tytul-zalacznika gd:GUID="7e5cd581-99eb-477d-8427-469eadd3b429">Norma umundurowania nr 5a</tytul-zalacznika>
      <segment-zalacznika gd:GUID="ce460491-9e70-4b60-be70-1cdd9ece764e" orientacja="pionowa">
        <tekst-zwykly gd:GUID="079851cc-bee2-4e3a-b3c9-de1a9b72c902">dotycząca ubioru służbowego dla policjantów mianowanych na okres służby kontraktowej</tekst-zwykly>
      </segment-zalacznika>
    </zalacznik>
