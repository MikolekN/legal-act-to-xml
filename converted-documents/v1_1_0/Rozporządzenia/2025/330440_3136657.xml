        </p>
        <punkt eId="DU/2025/1835__art_2__pkt_1" gd:GUID="87623b62-4949-4f7f-b374-62aaa41e71ae" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1835_odczytane.x" wejscie-w-zycie="2026-01-01">
