          </p>
        </punkt>
        <punkt eId="DU/2025/1835__art_2__pkt_2" gd:GUID="f3b5592a-72e7-4737-bcd9-7d71e43299fd" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1835_odczytane.x" wejscie-w-zycie="2026-01-01">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="d8f33390-959b-40b0-83b4-e5e178bc8ac1" fragment="3" gd:fragmentGUID="ced0908d-7c93-49b8-b6a6-8a1c0030d2fb" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1835_odczytane.x" wejscie-w-zycie="2026-01-01">pkt 2–5 i 7:</zdanie>
          </p>
          <litera eId="DU/2025/1835__art_2__pkt_2__lit_a" gd:GUID="e0a584ce-1d1e-4cee-9d0d-d1c09c37609a" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1835_odczytane.x" wejscie-w-zycie="2026-01-01">
            <nr>a</nr>
