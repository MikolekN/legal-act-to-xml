    <paragraf eId="DU/2025/1835__art_8" gd:GUID="e125ef36-f1bc-47ce-ba8c-1183b212883f" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1835_odczytane.x" wejscie-w-zycie="2026-01-01">
