            </p>
          </litera>
          <litera eId="DU/2025/1835__art_2__pkt_2__lit_b" gd:GUID="5506e904-24c4-45be-a780-ddc3a2ad5c0c" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1835_odczytane.x" wejscie-w-zycie="2026-01-01">
