            <tiret eId="DU/2025/1133__art_1__pkt_4__lit_a__tir_1" gd:GUID="3a6e3de9-2ab0-44dc-9815-bbb701f2be81" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-02_DU-2025-1133_domyslne.x" wejscie-w-zycie="2025-09-02">
