    <paragraf eId="DU/2025/1133__art_2" gd:GUID="ea53ea25-ea31-4591-be9e-a7e42620e137" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-02_DU-2025-1133_domyslne.x" wejscie-w-zycie="2025-09-02">
