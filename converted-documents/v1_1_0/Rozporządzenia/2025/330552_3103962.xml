        <p>
          <zdanie nr="1" gd:zdGUID="51dca942-0286-4b89-97c2-096f86be141c" fragment="1" gd:fragmentGUID="b970e136-d4d8-42fd-9958-284c7fcdea58" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-12_DU-2025-1640_domyslne.x" wejscie-w-zycie="2025-12-12">Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
