        </p>
      </ustep>
      <ustep eId="DU/2025/1808__art_9__ust_4" gd:GUID="948851f5-98c1-44a7-a555-c3ee6ae5301a" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1808_domyslne.x" wejscie-w-zycie="2026-01-01">
