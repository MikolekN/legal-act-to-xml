          <nr>5</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="aecb70ce-1fe5-4786-8133-2db1f72957e1" fragment="6" gd:fragmentGUID="328e50a5-9293-49aa-b0e9-ef7ae1191182" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-01_DU-2025-1629_odczytane.x" wejscie-w-zycie="2025-12-01">dokumenty potwierdzające okoliczności, o których mowa w art. 36 ust. 3 ustawy – jeżeli przesłanką wydania zezwolenia jest wykazanie tych okoliczności;</zdanie>
          </p>
        </punkt>
