    <paragraf eId="DU/2025/1629__art_3" gd:GUID="575a818c-f217-4ea5-9b5f-fb22cb4289b9" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-01_DU-2025-1629_odczytane.x" wejscie-w-zycie="2025-12-01">
