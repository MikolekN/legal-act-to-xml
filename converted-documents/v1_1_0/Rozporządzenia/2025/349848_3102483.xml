          </p>
        </punkt>
        <punkt eId="DU/2025/1629__art_3__pkt_3" gd:GUID="684537fe-6a97-4125-9729-9472547af1ec" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-01_DU-2025-1629_odczytane.x" wejscie-w-zycie="2025-12-01">
          <nr>3</nr>
          <p>
