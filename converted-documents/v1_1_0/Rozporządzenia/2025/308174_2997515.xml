          </p>
        </punkt>
        <punkt eId="DU/2025/1149__art_1__pkt_3" gd:GUID="6e962a90-6de4-44ba-b6cd-74ccd613abbf" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-05_DU-2025-1149_domyslne.x" wejscie-w-zycie="2025-09-05">
          <nr>3</nr>
          <p>
