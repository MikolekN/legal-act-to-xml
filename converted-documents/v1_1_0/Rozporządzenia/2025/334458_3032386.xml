    <paragraf eId="DU/2025/1277__art_2" gd:GUID="d7dc8f17-7ab3-46bd-bb4f-2434fc409bec" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-09_DU-2025-1277_domyslne.x" wejscie-w-zycie="2025-10-09">
      <nr>2</nr>
      <ustep eId="DU/2025/1277__art_2__ust_1" gd:GUID="ccb393e5-e169-4cdc-a6c6-454dedfb80f1" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-09_DU-2025-1277_domyslne.x" wejscie-w-zycie="2025-10-09">
        <nr>1</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="453a0b6b-02fe-450e-a91e-680298a2e70b" fragment="1" gd:fragmentGUID="074b1b66-76b0-4919-80b5-25442bb194f3" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-09_DU-2025-1277_domyslne.x" wejscie-w-zycie="2025-10-09">Świadectwa zatwierdzenia typu, świadectwa zgodności wytwarzania, świadectwa ponownej oceny zgodności, świadectwa badania odbiorczego i prób wydane przez jednostki notyfikowane przed dniem wejścia w życie niniejszego rozporządzenia zachowują ważność do końca okresu, na jaki zostały wydane.</zdanie>
        </p>
      </ustep>
      <ustep eId="DU/2025/1277__art_2__ust_2" gd:GUID="322924af-7b5c-4a6c-a606-6b74e405b3af" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-09_DU-2025-1277_domyslne.x" wejscie-w-zycie="2025-10-09">
        <nr>2</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="600dd3e0-d381-48ad-adc5-f82bb3fe1735" fragment="1" gd:fragmentGUID="cdd94f1b-09c5-4aa3-8ba1-aa64bbded96c" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-09_DU-2025-1277_domyslne.x" wejscie-w-zycie="2025-10-09">Do spraw dotyczących oceny zgodności ciśnieniowych urządzeń transportowych oraz badań okresowych, pośrednich i nadzwyczajnych wszczętych i niezakończonych przed dniem wejścia w życie niniejszego rozporządzenia stosuje się przepisy dotychczasowe.</zdanie>
        </p>
      </ustep>
    </paragraf>
    <paragraf eId="DU/2025/1277__art_3" gd:GUID="00311985-6ec2-4615-b3ce-9e0f5cb7161c" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-09_DU-2025-1277_domyslne.x" wejscie-w-zycie="2025-10-09">
      <nr>3</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="903223a3-c3c4-49ad-92ff-72d76edee920" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-09_DU-2025-1277_domyslne.x" wejscie-w-zycie="2025-10-09">
        <p>
          <zdanie nr="1" gd:zdGUID="425af98f-0fc0-4849-bac7-766b073f997e" fragment="1" gd:fragmentGUID="5d9e8b54-d5e3-4467-89d2-bf42dd94e5eb" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-09_DU-2025-1277_domyslne.x" wejscie-w-zycie="2025-10-09">Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
