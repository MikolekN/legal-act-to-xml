        <punkt eId="DU/2025/1277__art_1__pkt_6" gd:GUID="d2b33f94-7a87-443b-93bf-dacb7583f01f" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-09_DU-2025-1277_domyslne.x" wejscie-w-zycie="2025-10-09">
