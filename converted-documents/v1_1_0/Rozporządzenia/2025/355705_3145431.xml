            </p>
          </litera>
        </punkt>
        <punkt eId="DU/2025/1898__art_4__ust_2__pkt_2" gd:GUID="ef318708-d01e-4a12-85e1-032e16059e7b" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1898_odczytane.x" wejscie-w-zycie="2026-01-01">
          <nr>2</nr>
