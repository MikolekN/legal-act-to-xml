        <nr>3</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="b2e32bbb-c50e-479b-9300-f267f8f85a8e" fragment="1" gd:fragmentGUID="f8c33403-c962-4002-b2e7-2a6034f2599c" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1898_odczytane.x" wejscie-w-zycie="2026-01-01">Rozliczenie roczne zawiera informacje, o których mowa w ust. 2, za okres od dnia 1 stycznia do dnia 31 grudnia danego roku.</zdanie>
        </p>
      </ustep>
    </paragraf>
