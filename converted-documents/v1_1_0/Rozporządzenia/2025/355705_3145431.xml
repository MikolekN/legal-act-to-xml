    </paragraf>
    <paragraf eId="DU/2025/1898__art_12" gd:GUID="26445974-f674-46cc-9a0f-ea6fb22d4451" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1898_odczytane.x" wejscie-w-zycie="2026-01-01">
