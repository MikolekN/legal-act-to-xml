        <p>
          <zdanie nr="1" gd:zdGUID="23f9fa9d-eafd-441f-8823-ec5ebc2af89f" fragment="1" gd:fragmentGUID="53aeacd2-0e7e-4807-bcf6-15ce2a367d9d" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1898_odczytane.x" wejscie-w-zycie="2026-01-01">Obowiązek przedłożenia rozliczenia miesięcznego nie dotyczy transzy dotacji wnioskowanej po raz pierwszy i drugi.</zdanie>
        </p>
      </ustep>
    </paragraf>
    <paragraf eId="DU/2025/1898__art_5" gd:GUID="3e226f18-d5b4-4e33-b96a-acb5abdde591" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1898_odczytane.x" wejscie-w-zycie="2026-01-01">
