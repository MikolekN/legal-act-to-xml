          <nr>1</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="a62c21f6-8984-425d-b3e8-3141030d0a04" fragment="2" gd:fragmentGUID="cde2c0f5-d89a-4596-a4b1-780a2a3b4843" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1898_odczytane.x" wejscie-w-zycie="2026-01-01">rozliczenie kwot przeznaczonych na finansowanie rent wyrównawczych, w podziale na kopalnię – za dany miesiąc i narastająco;</zdanie>
          </p>
        </punkt>
        <punkt eId="DU/2025/1898__art_5__ust_2__pkt_2" gd:GUID="1a680d18-4e26-46fe-8613-028c9bc0f39b" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1898_odczytane.x" wejscie-w-zycie="2026-01-01">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="a62c21f6-8984-425d-b3e8-3141030d0a04" fragment="3" gd:fragmentGUID="bb879246-6ca6-46dd-a20b-8cdbff9657ec" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1898_odczytane.x" wejscie-w-zycie="2026-01-01">informację o liczbie osób, którym wypłacono renty wyrównawcze, w podziale na kopalnię.</zdanie>
          </p>
