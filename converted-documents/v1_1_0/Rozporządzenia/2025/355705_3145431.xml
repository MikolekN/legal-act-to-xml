          <litera eId="DU/2025/1898__art_4__ust_2__pkt_1__lit_b" gd:GUID="1330942a-0783-4bbc-8b5c-9ec491d54f26" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1898_odczytane.x" wejscie-w-zycie="2026-01-01">
