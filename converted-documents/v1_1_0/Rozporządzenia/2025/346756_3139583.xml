          </p>
        </punkt>
        <punkt eId="DU/2025/1853__art_1__pkt_2" gd:GUID="8defd2b6-c6af-4cf8-b816-8a5b6c6a9d0f" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1853_odczytane.x" wejscie-w-zycie="2026-01-01">
          <nr>2</nr>
          <p>
