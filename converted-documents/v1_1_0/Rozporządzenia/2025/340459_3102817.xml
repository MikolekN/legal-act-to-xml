      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="2398ba79-8a7f-4120-91c2-589d477173da" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-01_DU-2025-1636_odczytane.x" wejscie-w-zycie="2025-12-01">
        <p>
          <zdanie nr="1" gd:zdGUID="97fa96ea-26cf-4bc6-af8c-62fe3a0d39ce" fragment="1" gd:fragmentGUID="e7935141-6589-4695-82fc-def8f1e87507" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-01_DU-2025-1636_odczytane.x" wejscie-w-zycie="2025-12-01">Pracownik zatrudniony w dniu wejścia w życie niniejszego rozporządzenia na stanowisku nieprzewidzianym w tym rozporządzeniu może być nadal zatrudniony, z tym że na stanowisku określonym w rozporządzeniu zmienianym w § 1 w brzmieniu nadanym niniejszym rozporządzeniem.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <paragraf eId="DU/2025/1636__art_3" gd:GUID="bf5cee51-5fbb-4167-b680-ae8c8a3b55af" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-01_DU-2025-1636_odczytane.x" wejscie-w-zycie="2025-12-01">
