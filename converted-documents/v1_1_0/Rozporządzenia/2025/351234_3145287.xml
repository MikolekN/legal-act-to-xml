    <paragraf eId="DU/2025/1895__art_8" gd:GUID="493bfa82-3d00-4a4f-b9af-c38e0b74df36" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1895_odczytane.x" wejscie-w-zycie="2026-01-01">
