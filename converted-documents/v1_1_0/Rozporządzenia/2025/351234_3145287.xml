          <nr>1</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="47c0e38b-dee6-4675-84dc-2932098bf3a5" fragment="2" gd:fragmentGUID="cad90d28-43ba-41e4-be9e-1fb19c346549" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1895_odczytane.x" wejscie-w-zycie="2026-01-01">nie podlegają zwrotowi i są przeznaczane na finansowanie świadczeń w kolejnym roku budżetowym, pomniejszając wysokość wsparcia w tym roku, albo</zdanie>
          </p>
        </punkt>
        <punkt eId="DU/2025/1895__art_8__ust_2__pkt_2" gd:GUID="0602ea6b-65b2-4327-bb57-f41f7147ff10" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1895_odczytane.x" wejscie-w-zycie="2026-01-01">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="47c0e38b-dee6-4675-84dc-2932098bf3a5" fragment="3" gd:fragmentGUID="29fcfbb8-5db9-4c9c-86b1-713913a86121" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1895_odczytane.x" wejscie-w-zycie="2026-01-01">podlegają zwrotowi w terminie 5 dni po zakończeniu roku, jeżeli przedsiębiorstwo zaprzestało finansowania świadczeń, o których mowa w § 4.</zdanie>
          </p>
