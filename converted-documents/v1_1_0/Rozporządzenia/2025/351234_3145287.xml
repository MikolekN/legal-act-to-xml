          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="9426e7d4-a973-4520-97e7-2ffb7348dacd" fragment="3" gd:fragmentGUID="2385260d-15f4-4097-b133-a57ef5d75b42" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1895_odczytane.x" wejscie-w-zycie="2026-01-01">sposób wykorzystania przyznanej dotacji budżetowej oraz środków uzyskanych ze sprzedaży przekazanych skarbowych papierów wartościowych;</zdanie>
          </p>
        </punkt>
        <punkt eId="DU/2025/1895__art_1__pkt_3" gd:GUID="81b4b1cf-ce2a-4c46-952a-e952038b898f" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1895_odczytane.x" wejscie-w-zycie="2026-01-01">
