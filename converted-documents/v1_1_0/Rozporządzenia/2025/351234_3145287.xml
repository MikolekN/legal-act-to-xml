          </p>
        </punkt>
        <punkt eId="DU/2025/1895__art_1__pkt_4" gd:GUID="7dbff039-31f4-4d02-b7c6-3c7286fa93d9" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1895_odczytane.x" wejscie-w-zycie="2026-01-01">
          <nr>4</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="9426e7d4-a973-4520-97e7-2ffb7348dacd" fragment="5" gd:fragmentGUID="203ccee5-fb50-4776-82e4-eb1a7443231e" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1895_odczytane.x" wejscie-w-zycie="2026-01-01">szczegółowe warunki powodujące cofnięcie lub czasowe wstrzymanie wypłaty przyznanej dotacji budżetowej oraz sposób zwrotu, w całości lub w części, równowartości środków uzyskanych ze sprzedaży skarbowych papierów wartościowych.</zdanie>
          </p>
        </punkt>
      </ustep-n>
    </paragraf>
