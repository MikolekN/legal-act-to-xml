          <nr>3</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="e0d9981a-dafd-44bf-b971-9b0f16bd6c59" fragment="4" gd:fragmentGUID="4c3b5dd8-922f-4a17-b338-dd8817019026" okres="okr_obowiazywanie.zdarz_wejscie_2025-02-27_DU-2025-238_domyslne.x" wejscie-w-zycie="2025-02-27">pkt 6 – nadzoruje minister nadzorujący, który zlecił zadanie.</zdanie>
          </p>
        </punkt>
      </ustep>
    </paragraf>
    <paragraf eId="DU/2025/238__art_4" gd:GUID="197961aa-6ed7-4703-b4db-0a435cc7ae30" okres="okr_obowiazywanie.zdarz_wejscie_2025-02-27_DU-2025-238_domyslne.x" wejscie-w-zycie="2025-02-27">
