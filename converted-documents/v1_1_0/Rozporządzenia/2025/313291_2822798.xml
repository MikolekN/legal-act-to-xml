      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="8be035d9-136d-4bb2-bd86-9283d7c64db3" okres="okr_obowiazywanie.zdarz_wejscie_2025-02-27_DU-2025-238_domyslne.x" wejscie-w-zycie="2025-02-27">
        <p>
          <zdanie nr="1" gd:zdGUID="27b9bad2-8e01-4321-a2f8-7278134c4a4d" fragment="1" gd:fragmentGUID="76ae9476-0119-4c4b-8fad-dea2ffd11ec2" okres="okr_obowiazywanie.zdarz_wejscie_2025-02-27_DU-2025-238_domyslne.x" wejscie-w-zycie="2025-02-27">Minister właściwy do spraw informatyzacji wyposaża Instytut:</zdanie>
        </p>
        <punkt eId="DU/2025/238__art_4__pkt_1" gd:GUID="a06226e7-12fe-4b9a-b2d5-04887c61adba" okres="okr_obowiazywanie.zdarz_wejscie_2025-02-27_DU-2025-238_domyslne.x" wejscie-w-zycie="2025-02-27">
          <nr>1</nr>
