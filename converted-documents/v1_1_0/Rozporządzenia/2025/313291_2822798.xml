        </punkt>
        <punkt eId="DU/2025/238__art_3__ust_2__pkt_2" gd:GUID="3cfbd7d2-9c64-4f73-80f5-d83ec59c6fae" okres="okr_obowiazywanie.zdarz_wejscie_2025-02-27_DU-2025-238_domyslne.x" wejscie-w-zycie="2025-02-27">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="e0d9981a-dafd-44bf-b971-9b0f16bd6c59" fragment="3" gd:fragmentGUID="04f69e40-8acc-461c-ae26-5c5b045e637b" okres="okr_obowiazywanie.zdarz_wejscie_2025-02-27_DU-2025-238_domyslne.x" wejscie-w-zycie="2025-02-27">pkt 2 – nadzoruje Minister Obrony Narodowej;</zdanie>
