    <paragraf eId="DU/2025/922__art_4" gd:GUID="d2e258d6-083e-4417-8b65-0734f65cc1e5" okres="okr_obowiazywanie.zdarz_wejscie_2025-07-25_DU-2025-922_domyslne.x" wejscie-w-zycie="2025-07-25">
