      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="c8370e59-05cc-449b-ab7e-d3f7f6dfbebf" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-16_DU-2025-1387_domyslne.x" wejscie-w-zycie="2025-10-16">
