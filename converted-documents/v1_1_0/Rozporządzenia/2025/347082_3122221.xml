      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="125c13d3-0fce-4a9c-a28f-8f9788cc7068" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-30_DU-2025-1755_odczytane.x" wejscie-w-zycie="2025-12-30">
        <p>
          <zdanie nr="1" gd:zdGUID="980d0fc8-7c83-4af2-8b67-5de2d56265f3" fragment="1" gd:fragmentGUID="0c1d725d-d659-4bb2-93d2-749fbb4016e5" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-30_DU-2025-1755_odczytane.x" wejscie-w-zycie="2025-12-30">Rozporządzenie wchodzi w życie z dniem 30 grudnia 2025 r.</zdanie>
        </p>
      </ustep-n>
