      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="3b7d1157-aa5b-492e-ab6e-73003e93acce" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1664_odczytane.x" wejscie-w-zycie="2026-01-01">
        <p>
          <zdanie nr="1" gd:zdGUID="b9573aaa-489a-473a-8246-8d7b770a4d5f" fragment="1" gd:fragmentGUID="8035477c-3e93-4c23-bcd9-fdc40ffbdd52" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1664_odczytane.x" wejscie-w-zycie="2026-01-01">Wysokość stawki opłaty kogeneracyjnej na rok 2026 wynosi 3,00 zł/MWh.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
