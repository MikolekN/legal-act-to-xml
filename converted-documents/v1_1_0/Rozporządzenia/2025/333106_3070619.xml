      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="2f3134b4-4ea7-4748-b463-a2dc18a5d2ae" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-13_DU-2025-1485_odczytane.x" wejscie-w-zycie="2025-11-13">
        <p>
          <zdanie nr="1" gd:zdGUID="eb20648c-a8b9-4aca-bf19-fbd3f12c279a" fragment="1" gd:fragmentGUID="a3315b97-93c1-4618-ab78-7a4061143525" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-13_DU-2025-1485_odczytane.x" wejscie-w-zycie="2025-11-13">Rozporządzenie wchodzi w życie z dniem 13 listopada 2025 r.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
