        </p>
      </ustep>
      <ustep eId="DU/2025/1808__art_9__ust_4" gd:GUID="bf7213c7-fa77-4318-b7b3-57ac74d58078" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1808_domyslne.x" wejscie-w-zycie="2026-01-01">
