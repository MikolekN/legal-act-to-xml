    <paragraf eId="DU/2025/1316__art_1" gd:GUID="679b2f1c-9af7-4981-a244-e0af662a6c7e" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1316_odczytane.x" wejscie-w-zycie="2026-01-01">
      <nr>1</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="015ee83d-55bf-4b1c-bff7-a3922ee6e290" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1316_odczytane.x" wejscie-w-zycie="2026-01-01">
