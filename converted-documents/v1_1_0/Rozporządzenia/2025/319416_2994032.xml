            <tiret eId="DU/2025/1133__art_1__pkt_4__lit_b__tir_2" gd:GUID="7df5a14b-0042-48ae-a873-62131aed20da" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-02_DU-2025-1133_domyslne.x" wejscie-w-zycie="2025-09-02">
              <p>
