    <rodzaj-aktu>Rozporządzenie</rodzaj-aktu>
    <autor-aktu>Ministra Klimatu i Środowiska<odnosnik id-odnosnika="1" symbol="1" gd:GUID="08ee67ea-2779-43b1-a68f-0dbc77c0fd32"><p><zdanie nr="1" gd:zdGUID="27205846-9abb-4fe8-98f8-6958847c6205" fragment="1" gd:fragmentGUID="38731604-7401-470b-a48a-4425afed1903">Minister Klimatu i Środowiska kieruje działem administracji rządowej – środowisko, na podstawie § 1 ust. 2 pkt 2 rozporządzenia Prezesa Rady Ministrów z dnia 25 lipca 2025 r. w sprawie szczegółowego zakresu działania Ministra Klimatu i Środowiska (Dz. U. poz. 995).</zdanie></p></odnosnik></autor-aktu>
    <data>z dnia 6 sierpnia 2025 r.</data>
    <tytul>w sprawie wzorów mundurów leśnika i oznak dla osób uprawnionych do ich noszenia</tytul>
    <podstawa-prawna>Na podstawie art. 35a ust. 4 ustawy z dnia 28 września 1991 r. o lasach (Dz. U. z 2025 r. poz. 567) zarządza się, co następuje:</podstawa-prawna>
    <paragraf eId="art_1" gd:GUID="a40b77ca-a25e-43f9-980c-07484c6bdd6f">
      <nr>1</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="9ead5992-a07b-46e5-95fd-e688b033ffda">
        <p>
          <zdanie nr="1" gd:zdGUID="30d2b908-7f46-4286-b450-3261bd93645b" fragment="1" gd:fragmentGUID="a8dacc09-1c7c-49a8-9436-b34be038defb">Wzory mundurów leśnika:</zdanie>
        </p>
        <punkt eId="art_1__pkt_1" gd:GUID="7db7476d-8613-41ee-92d7-fc1d3a5d0195">
          <nr>1</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="30d2b908-7f46-4286-b450-3261bd93645b" fragment="2" gd:fragmentGUID="bd92bb71-1c71-4207-b561-07b5834db688">munduru wyjściowego określa załącznik nr 1 do rozporządzenia;</zdanie>
          </p>
        </punkt>
        <punkt eId="art_1__pkt_2" gd:GUID="a6a9b06e-aa77-4d00-ac4b-908d58d4e6fe">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="30d2b908-7f46-4286-b450-3261bd93645b" fragment="3" gd:fragmentGUID="c7e9c571-f7c5-4f2f-9329-890f7acda877">munduru codziennego określa załącznik nr 2 do rozporządzenia.</zdanie>
          </p>
        </punkt>
      </ustep-n>
    </paragraf>
    <paragraf eId="art_2" gd:GUID="8a8363d3-50ce-48b8-981c-d694b0ecd06c">
      <nr>2</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="6702a0ee-6104-4cab-90a7-8e9c64edc83b">
        <p>
          <zdanie nr="1" gd:zdGUID="fdf89a94-064f-4385-8e78-ddddae2c3edb" fragment="1" gd:fragmentGUID="49bf34a7-03bb-481c-9157-be3a49838799">Wzory oznak dla osób uprawnionych do ich noszenia określa załącznik nr 3 do rozporządzenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <paragraf eId="art_3" gd:GUID="f2842ab2-3e15-4982-82ff-79686d3281c3">
      <nr>3</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="5b05de78-c9b4-46b7-813d-afca5ae70b03">
        <p>
          <zdanie nr="1" gd:zdGUID="52bd0d27-4ee5-4e27-8c0e-3d999fd6bf0b" fragment="1" gd:fragmentGUID="e8eab9e6-82c4-4344-b5e4-a0b61a146d80">Mundury leśnika i oznaki, których wzory zostały określone w:</zdanie>
        </p>
        <punkt eId="art_3__pkt_1" gd:GUID="0c5740ef-c010-4688-9e3d-8321e908ac7e">
          <nr>1</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="52bd0d27-4ee5-4e27-8c0e-3d999fd6bf0b" fragment="2" gd:fragmentGUID="22e6898f-cff6-45a1-a98a-b73b3950edf4">rozporządzeniu Ministra Środowiska z dnia 19 grudnia 2017 r. w sprawie wzorów mundurów leśnika i oznak dla osób uprawnionych do ich noszenia (Dz. U. z 2022 r. poz. 2391),</zdanie>
          </p>
        </punkt>
        <punkt eId="art_3__pkt_2" gd:GUID="8efcb754-e1c6-4ce0-88a8-060511f54c56">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="52bd0d27-4ee5-4e27-8c0e-3d999fd6bf0b" fragment="3" gd:fragmentGUID="7ab1f812-31bb-4341-9507-2a0c05ade777">rozporządzeniu Ministra Klimatu i Środowiska z dnia 12 grudnia 2023 r. w sprawie wzorów mundurów leśnika i oznak dla osób uprawnionych do ich noszenia (Dz. U. poz. 2779)</zdanie>
          </p>
        </punkt>
        <czesc-wspolna-punkt eId="art_3__czw" gd:GUID="f98e401e-1d45-4900-baff-1dfe06755b7b">
          <p>
            <zdanie nr="1" gd:zdGUID="52bd0d27-4ee5-4e27-8c0e-3d999fd6bf0b" fragment="4" gd:fragmentGUID="91ad1e76-c018-449e-8cb6-8cf2b4e47af2">– mogą być otrzymywane i noszone przez osoby uprawnione przez okres 24 miesięcy od dnia wejścia w życie niniejszego rozporządzenia.</zdanie>
          </p>
        </czesc-wspolna-punkt>
      </ustep-n>
    </paragraf>
    <paragraf eId="art_4" gd:GUID="b8080e19-31a1-4149-9f28-ef2d47a1f69f">
      <nr>4</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="6788d04e-0c21-4bf5-975d-8e4ba26b8288">
        <p>
          <zdanie nr="1" gd:zdGUID="01ffde8c-bf9a-4bda-882c-10d598e555be" fragment="1" gd:fragmentGUID="44447789-7481-4754-a8c1-c03c2943277c">Traci moc rozporządzenie Ministra Klimatu i Środowiska z dnia 12 grudnia 2023 r. w sprawie wzorów mundurów leśnika i oznak dla osób uprawnionych do ich noszenia (Dz. U. poz. 2779).</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <paragraf eId="art_5" gd:GUID="63e19aad-39ff-4439-9224-4664f33c1657">
      <nr>5</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="88ac82c5-e1e6-4e7d-bd11-41b825eabace">
        <p>
          <zdanie nr="1" gd:zdGUID="317be6b8-be92-472c-946f-16e338b6f5f8" fragment="1" gd:fragmentGUID="39a5b8de-5aa7-4bb3-8d7f-c478d2ac3e43">Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
