          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="a1a599c4-f15b-4cd5-b7e1-6cce98ab86ef" fragment="3" gd:fragmentGUID="0c49e89d-45f2-4284-a1da-cc0f7009c3e0" okres="okr_obowiazywanie.zdarz_wejscie_2026-06-14_DU-2025-991_odczytane.x" wejscie-w-zycie="2026-06-14">w § 2:</zdanie>
          </p>
