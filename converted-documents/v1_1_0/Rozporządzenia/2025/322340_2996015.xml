    <rodzaj-aktu>Rozporządzenie</rodzaj-aktu>
    <autor-aktu>Ministra Klimatu i Środowiska<odnosnik id-odnosnika="1" symbol="1" gd:GUID="479d8d96-0b1f-474f-8fd7-9603c61cd930"><p><zdanie nr="1" gd:zdGUID="88eb449b-726b-4228-96ff-7d4b59cda810" fragment="1" gd:fragmentGUID="789d0987-b90a-4265-9998-794cc5b5e864">Minister Klimatu i Środowiska kieruje działem administracji rządowej – środowisko, na podstawie § 1 ust. 2 pkt 2 rozporządzenia Prezesa Rady Ministrów z dnia 25 lipca 2025 r. w sprawie szczegółowego zakresu działania Ministra Klimatu i Środowiska (Dz. U. poz. 995).</zdanie></p></odnosnik></autor-aktu>
    <data>z dnia 6 sierpnia 2025 r.</data>
    <tytul>w sprawie wzorów mundurów leśnika i oznak dla osób uprawnionych do ich noszenia</tytul>
    <podstawa-prawna>Na podstawie art. 35a ust. 4 ustawy z dnia 28 września 1991 r. o lasach (Dz. U. z 2025 r. poz. 567) zarządza się, co następuje:</podstawa-prawna>
    <paragraf eId="art_1" gd:GUID="13f22234-7d33-49d5-a921-238f8e9847cc">
      <nr>1</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="884659d1-2f74-4631-8c64-60976efe0da9">
        <p>
          <zdanie nr="1" gd:zdGUID="3e9a3a85-89f0-4f57-bc79-3658e15c1ab9" fragment="1" gd:fragmentGUID="7bac908f-b982-40b3-9846-7b9f1d46cd34">Wzory mundurów leśnika:</zdanie>
        </p>
        <punkt eId="art_1__pkt_1" gd:GUID="c963286a-a34c-4433-9233-c103c342082c">
          <nr>1</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="3e9a3a85-89f0-4f57-bc79-3658e15c1ab9" fragment="2" gd:fragmentGUID="13acf04c-1869-4878-8100-84729f14403f">munduru wyjściowego określa załącznik nr 1 do rozporządzenia;</zdanie>
          </p>
        </punkt>
        <punkt eId="art_1__pkt_2" gd:GUID="803189b5-8e62-4719-aabe-8308071f4c0e">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="3e9a3a85-89f0-4f57-bc79-3658e15c1ab9" fragment="3" gd:fragmentGUID="79e196e4-8d1f-4143-909f-5f692cf9e71a">munduru codziennego określa załącznik nr 2 do rozporządzenia.</zdanie>
          </p>
        </punkt>
      </ustep-n>
    </paragraf>
    <paragraf eId="art_2" gd:GUID="a5e37cff-5120-4003-874b-0995375e5566">
      <nr>2</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="a06f03d0-483b-41fd-9595-b4b9b497c9c9">
        <p>
          <zdanie nr="1" gd:zdGUID="7f7cff34-a1ca-4288-a12d-1cf30ed2d818" fragment="1" gd:fragmentGUID="683ea0a8-6ff0-41fd-bb60-98af001e4b06">Wzory oznak dla osób uprawnionych do ich noszenia określa załącznik nr 3 do rozporządzenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <paragraf eId="art_3" gd:GUID="93deca45-0b85-4c6f-a68d-7ebe2f565de7">
      <nr>3</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="a6f037ca-54a6-4424-83b9-9766fae3546c">
        <p>
          <zdanie nr="1" gd:zdGUID="c5f344a1-e5ba-40bc-907c-2b6d12f9afe9" fragment="1" gd:fragmentGUID="a5036190-9fd5-4bfc-b46a-ddcac73e7c39">Mundury leśnika i oznaki, których wzory zostały określone w:</zdanie>
        </p>
        <punkt eId="art_3__pkt_1" gd:GUID="67ed7205-d618-43a9-a020-2a5b24134129">
          <nr>1</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="c5f344a1-e5ba-40bc-907c-2b6d12f9afe9" fragment="2" gd:fragmentGUID="a5140fac-fc36-4082-b64a-fce4cc7265fa">rozporządzeniu Ministra Środowiska z dnia 19 grudnia 2017 r. w sprawie wzorów mundurów leśnika i oznak dla osób uprawnionych do ich noszenia (Dz. U. z 2022 r. poz. 2391),</zdanie>
          </p>
        </punkt>
        <punkt eId="art_3__pkt_2" gd:GUID="0ee57608-073e-47bd-81da-9e4cc3c3dd85">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="c5f344a1-e5ba-40bc-907c-2b6d12f9afe9" fragment="3" gd:fragmentGUID="5fc8fbc9-f0dd-4692-b6d2-4200215f226e">rozporządzeniu Ministra Klimatu i Środowiska z dnia 12 grudnia 2023 r. w sprawie wzorów mundurów leśnika i oznak dla osób uprawnionych do ich noszenia (Dz. U. poz. 2779)</zdanie>
          </p>
        </punkt>
        <czesc-wspolna-punkt eId="art_3__czw" gd:GUID="866e21bb-62a7-490a-9eac-ef22d0b209b1">
          <p>
            <zdanie nr="1" gd:zdGUID="c5f344a1-e5ba-40bc-907c-2b6d12f9afe9" fragment="4" gd:fragmentGUID="a0c46758-fd93-419c-84d4-317ff7c304ab">– mogą być otrzymywane i noszone przez osoby uprawnione przez okres 24 miesięcy od dnia wejścia w życie niniejszego rozporządzenia.</zdanie>
          </p>
        </czesc-wspolna-punkt>
      </ustep-n>
    </paragraf>
    <paragraf eId="art_4" gd:GUID="ffe4f46f-d551-4f76-a489-ae61db261285">
      <nr>4</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="ec24790b-236e-4dbe-9d8b-633f72838478">
        <p>
          <zdanie nr="1" gd:zdGUID="89d33c7c-b4a5-4c52-83f4-06c34ce5280a" fragment="1" gd:fragmentGUID="2730fe0e-c04a-4c4f-a24f-8c119d8171be">Traci moc rozporządzenie Ministra Klimatu i Środowiska z dnia 12 grudnia 2023 r. w sprawie wzorów mundurów leśnika i oznak dla osób uprawnionych do ich noszenia (Dz. U. poz. 2779).</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <paragraf eId="art_5" gd:GUID="5452c905-1654-476b-b42c-5cc597f87383">
      <nr>5</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="7e9a7adf-83b9-4fe6-af62-f26828267c17">
        <p>
          <zdanie nr="1" gd:zdGUID="12db438c-7500-4c78-a72e-da56deadbeba" fragment="1" gd:fragmentGUID="ebe7b63f-66d5-48b4-818a-836c238d452a">Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
