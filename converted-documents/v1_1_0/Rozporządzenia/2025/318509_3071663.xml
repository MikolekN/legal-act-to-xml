        <p>
          <zdanie nr="1" gd:zdGUID="e4bb5905-58ff-4cb3-b621-71e1a0677474" fragment="1" gd:fragmentGUID="47dc4f5a-dbea-4825-9552-3c5d8ef9f770" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-13_DU-2025-1488_domyslne.x" wejscie-w-zycie="2025-11-13">Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
