      <nr>2</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="7c268f1e-cb03-4b6b-a1de-196e95777a06" okres="okr_obowiazywanie.zdarz_wejscie_2025-08-14_DU-2025-1115_domyslne.x" wejscie-w-zycie="2025-08-14">
        <p>
          <zdanie nr="1" gd:zdGUID="dab408c3-6b7a-43f3-954f-4969ef72d492" fragment="1" gd:fragmentGUID="6d2371cc-6130-49ae-b02d-4e7f137ca59f" okres="okr_obowiazywanie.zdarz_wejscie_2025-08-14_DU-2025-1115_domyslne.x" wejscie-w-zycie="2025-08-14">Przepisy rozporządzenia zmienianego w § 1, w brzmieniu nadanym niniejszym rozporządzeniem, mają zastosowanie przy ustalaniu wysokości stypendium aplikantów Krajowej Szkoły Sądownictwa i Prokuratury od dnia 1 lipca 2025 r.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
