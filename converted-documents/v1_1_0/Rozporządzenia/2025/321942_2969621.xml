            <nr>b</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="05df4a58-b546-4698-9f18-8a74aba02fa4" fragment="8" gd:fragmentGUID="f4bc05e0-8dc6-4895-af8a-7b9e959c38c8" okres="okr_obowiazywanie.zdarz_wejscie_2026-06-14_DU-2025-991_odczytane.x" wejscie-w-zycie="2026-06-14">pkt 2–5 otrzymują brzmienie:<cytat-strukt now:akt="https://eli.gov.pl/eli/DU/2003/1398" cudzyslowy="oba" gd:nowGUID="fcd0299d-7269-4178-8f25-827a299a15ad" element-eId="DU/2003/1398__art_3__ust_2__pkt_2" element-do-eId="DU/2003/1398__art_3__ust_2__pkt_5" funkcja="zastap"><punkt eId="DU/2003/1398__art_3__ust_2__pkt_2" gd:GUID="d5e81454-92bb-4482-99a0-956f31be91a5" okres="okr_obowiazywanie.zdarz_wejscie_2026-06-14_DU-2025-991_odczytane.x" wejscie-w-zycie="2026-06-14"><nr>2</nr><p><zdanie nr="1" gd:zdGUID="d401f248-01a5-4781-b283-e22baed75a54" fragment="1" gd:fragmentGUID="1773933b-47f5-4e0f-9e3f-7c88448b9c96" okres="okr_obowiazywanie.zdarz_wejscie_2026-06-14_DU-2025-991_odczytane.x" wejscie-w-zycie="2026-06-14">dżemu można dodać sok owocowy lub zagęszczony sok owocowy;</zdanie></p></punkt><punkt eId="DU/2003/1398__art_3__ust_2__pkt_3" gd:GUID="51abcc50-ce69-48d1-b09f-7c3a58d22348" okres="okr_obowiazywanie.zdarz_wejscie_2026-06-14_DU-2025-991_odczytane.x" wejscie-w-zycie="2026-06-14"><nr>3</nr><p><zdanie nr="1" gd:zdGUID="d401f248-01a5-4781-b283-e22baed75a54" fragment="2" gd:fragmentGUID="de65dfaa-e45e-42f5-889d-d4818d409a70" okres="okr_obowiazywanie.zdarz_wejscie_2026-06-14_DU-2025-991_odczytane.x" wejscie-w-zycie="2026-06-14">dżemu i dżemu ekstra wytwarzanych z owoców dzikiej róży, truskawek, malin, agrestu, czerwonych porzeczek, śliwek i rabarbaru można dodać soki z czerwonych owoców lub zagęszczone soki z czerwonych owoców;</zdanie></p></punkt><punkt eId="DU/2003/1398__art_3__ust_2__pkt_4" gd:GUID="fc273c66-f582-4eed-951c-4c62150bc598" okres="okr_obowiazywanie.zdarz_wejscie_2026-06-14_DU-2025-991_odczytane.x" wejscie-w-zycie="2026-06-14"><nr>4</nr><p><zdanie nr="1" gd:zdGUID="d401f248-01a5-4781-b283-e22baed75a54" fragment="3" gd:fragmentGUID="c6e0fa8f-39f2-4e72-85b8-eb858a3e2c53" okres="okr_obowiazywanie.zdarz_wejscie_2026-06-14_DU-2025-991_odczytane.x" wejscie-w-zycie="2026-06-14">dżemu i galaretki wytwarzanych z truskawek, malin, agrestu, czerwonych porzeczek i śliwek można dodać sok z buraków ćwikłowych lub zagęszczony sok z buraków ćwikłowych;</zdanie></p></punkt><punkt eId="DU/2003/1398__art_3__ust_2__pkt_5" gd:GUID="4957bcba-f39d-4ff6-be0c-368870b2f3cc" okres="okr_obowiazywanie.zdarz_wejscie_2026-06-14_DU-2025-991_odczytane.x" wejscie-w-zycie="2026-06-14"><nr>5</nr><p><zdanie nr="1" gd:zdGUID="d401f248-01a5-4781-b283-e22baed75a54" fragment="4" gd:fragmentGUID="454209b0-c8a0-4fe3-98f8-ad47f9c746b6" okres="okr_obowiazywanie.zdarz_wejscie_2026-06-14_DU-2025-991_odczytane.x" wejscie-w-zycie="2026-06-14">marmolady z owoców cytrusowych, marmolady galaretkowej lub marmolady z owoców innych niż cytrusowe można dodać olejki eteryczne z owoców cytrusowych;</zdanie></p></punkt></cytat-strukt>;</zdanie>
            </p>
          </litera>
