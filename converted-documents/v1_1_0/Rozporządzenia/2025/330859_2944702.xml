          <Nazwa>Minister Zdrowia</Nazwa>
          <OrganPodpisujacy>Minister Zdrowia</OrganPodpisujacy>
          <OsobaPodpisujaca>
            <imie>I.</imie> <nazwisko>Leszczyna</nazwisko></OsobaPodpisujaca>
