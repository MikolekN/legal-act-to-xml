      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="859c8f37-bec2-4956-8e98-c1e15e79d97d" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-06_DU-2026-147_odczytane.x" wejscie-w-zycie="2026-03-06">
        <p>
          <zdanie nr="1" gd:zdGUID="04e56dd5-e947-4659-b641-f6f29250c253" fragment="1" gd:fragmentGUID="c6112ff1-081c-4ff3-b598-09e474a5fe65" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-06_DU-2026-147_odczytane.x" wejscie-w-zycie="2026-03-06">Wykaz, o którym mowa w § 1, jest określony w załączniku do rozporządzenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <paragraf eId="DU/2026/147__art_3" gd:GUID="a3f99d68-a538-46f0-ad01-8a8507c9b43d" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-06_DU-2026-147_odczytane.x" wejscie-w-zycie="2026-03-06">
