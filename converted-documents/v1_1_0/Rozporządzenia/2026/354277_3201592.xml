        </punkt>
        <punkt eId="DU/2026/201__art_2__ust_2__pkt_2" gd:GUID="5e1f46e9-0edb-4276-81f4-f89abec37903" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-10_DU-2026-201_domyslne.x" wejscie-w-zycie="2026-03-10">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="1ef38f6b-df03-45de-9392-95482dcc8bb6" fragment="3" gd:fragmentGUID="c4f6061a-8b78-4564-a32a-41c745586a90" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-10_DU-2026-201_domyslne.x" wejscie-w-zycie="2026-03-10">do wniosku, o którym mowa w tym przepisie, załącza się dowód uiszczenia opłaty, o której mowa w pkt 1.</zdanie>
