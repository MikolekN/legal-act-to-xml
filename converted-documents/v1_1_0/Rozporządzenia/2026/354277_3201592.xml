    <paragraf eId="DU/2026/201__art_3" gd:GUID="ac79b258-198b-4bca-b102-e1f70ff85728" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-10_DU-2026-201_domyslne.x" wejscie-w-zycie="2026-03-10">
      <nr>3</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="92821940-e827-4298-b46f-252733c47d95" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-10_DU-2026-201_domyslne.x" wejscie-w-zycie="2026-03-10">
        <p>
          <zdanie nr="1" gd:zdGUID="d1a808fd-dfb8-4a9e-9e4e-4f66385581cf" fragment="1" gd:fragmentGUID="c0f2897a-0a89-4f5c-ab3c-c12993f99460" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-10_DU-2026-201_domyslne.x" wejscie-w-zycie="2026-03-10">W sprawach wszczętych i niezakończonych przed dniem wejścia w życie niniejszego rozporządzenia fotografie kandydatów posiadających obywatelstwo polskie załączone do wniosku o nadanie uprawnień zawodowych w zakresie szacowania nieruchomości zgodnie z przepisami dotychczasowymi są zwracane tym osobom wraz ze świadectwem nadania uprawnień zawodowych w zakresie szacowania nieruchomości albo z decyzją odmawiającą nadania tych uprawnień albo umarzającą postępowanie.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <paragraf eId="DU/2026/201__art_4" gd:GUID="4357d329-211a-4afc-8a2b-7c565805c525" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-10_DU-2026-201_domyslne.x" wejscie-w-zycie="2026-03-10">
      <nr>4</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="f5f24b7a-66dd-4d9d-a22a-5e9a13efcff6" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-10_DU-2026-201_domyslne.x" wejscie-w-zycie="2026-03-10">
        <p>
          <zdanie nr="1" gd:zdGUID="ae69f4c3-c683-462f-8b33-9472562d82c6" fragment="1" gd:fragmentGUID="d2434d45-9191-45b9-a9ef-346566a3aa5e" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-10_DU-2026-201_domyslne.x" wejscie-w-zycie="2026-03-10">W przypadku złożenia wniosku o wydanie duplikatu świadectwa nadania uprawnień zawodowych w zakresie szacowania nieruchomości po dniu wejścia w życie niniejszego rozporządzenia wydaje się świadectwo zgodnie ze wzorem stanowiącym załącznik nr 2 do rozporządzenia zmienianego w § 1, w brzmieniu nadanym niniejszym rozporządzeniem, z adnotacją „Duplikat”.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <paragraf eId="DU/2026/201__art_5" gd:GUID="35670d91-12f0-4879-8d11-02e0b5ca9dd8" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-10_DU-2026-201_domyslne.x" wejscie-w-zycie="2026-03-10">
      <nr>5</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="b972df3b-d84e-4834-a280-570decd30d40" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-10_DU-2026-201_domyslne.x" wejscie-w-zycie="2026-03-10">
        <p>
          <zdanie nr="1" gd:zdGUID="d6addef8-e35b-4e98-b123-66fd551a4a6d" fragment="1" gd:fragmentGUID="b229c8fa-efcd-490c-aaa7-05f8f2b151a9" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-10_DU-2026-201_domyslne.x" wejscie-w-zycie="2026-03-10">Świadectwa nadania uprawnień zawodowych w zakresie szacowania nieruchomości wydane przed dniem wejścia w życie niniejszego rozporządzenia zachowują ważność.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <paragraf eId="DU/2026/201__art_6" gd:GUID="63ff0257-f237-4f78-bcd5-524bdb70d05f" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-10_DU-2026-201_domyslne.x" wejscie-w-zycie="2026-03-10">
      <nr>6</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="c0a92c84-6a5f-44ad-a169-7815bd8daf51" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-10_DU-2026-201_domyslne.x" wejscie-w-zycie="2026-03-10">
        <p>
          <zdanie nr="1" gd:zdGUID="cb4a065a-d536-4f89-b8c7-05fc11b0aab0" fragment="1" gd:fragmentGUID="61734169-77a1-45ab-9948-46066a8d923a" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-10_DU-2026-201_domyslne.x" wejscie-w-zycie="2026-03-10">Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <organ-podpisujacy>Minister Finansów i Gospodarki: <i><osoba podpisujacy="true" gd:osobaGUID="c2f8f8d4-ede4-4021-b2a1-1f451e00b412"><imie>A.</imie> <nazwisko>Domański</nazwisko></osoba></i></organ-podpisujacy>
    <zalacznik eId="DU/2026/201__zal_1" gd:GUID="8d5fbbfb-9a2b-450b-82fe-5aa974aa1566">
      <zalacznik-do gd:GUID="1f99b01f-ae18-4e10-9cfd-32115483e06f">Załączniki do rozporządzenia Ministra Finansów i Gospodarki z dnia 12 lutego 2026 r. (poz. 201)</zalacznik-do>
      <zalacznik-nr gd:GUID="56cf83e6-3778-457a-a64d-9f99cd77bc4a">
        <nr>1</nr>
      </zalacznik-nr>
      <tytul-zalacznika gd:GUID="e9579a1d-a230-4183-9c8f-c873be86e07c">WZÓR ŚWIADECTWA NADANIA UPRAWNIEŃ ZAWODOWYCH W ZAKRESIE SZACOWANIA NIERUCHOMOŚCI</tytul-zalacznika>
      <segment-zalacznika gd:GUID="9d11704b-0411-4dc6-80ab-f911b739f6c7" orientacja="pionowa">
        <tekst-zwykly gd:GUID="418b5de7-4191-43c4-967b-6946d6dac3d7">awers</tekst-zwykly>
        <tekst-zwykly gd:GUID="43827c60-96f0-4249-88ad-586ef711cfca">rewers</tekst-zwykly>
        <tekst-zwykly gd:GUID="7f4e2407-f0fd-4b71-a853-11fa4fcb3fd9">Opis wzoru Świadectwa nadania uprawnień zawodowych w zakresie szacowania nieruchomości</tekst-zwykly>
        <tekst-zwykly gd:GUID="505402ad-365f-43e1-964c-34426cc19e01">Format dokumentu: dwustronna karta w formacie ID-1.</tekst-zwykly>
        <tekst-zwykly gd:GUID="f3099fea-5016-47f9-963c-af91a67e02c5">Podłoże: poliwęglan, niewykazujący luminescencji w promieniowaniu ultrafioletowym, umożliwiające trwałe naniesienie szaty graficznej, danych personalnych, identyfikacyjnych oraz elementów zabezpieczających.</tekst-zwykly>
        <tekst-zwykly gd:GUID="8d816c30-e57a-486b-96a5-066e96707af8">Awers:</tekst-zwykly>
        <tekst-zwykly gd:GUID="e1ed74c4-44c3-4b8d-bc6d-4b0b0d89d4f6">dwukolorowe tło giloszowe zawierające reliefowe napisy „RzM”, wykonane w technice druku irysowego,</tekst-zwykly>
        <tekst-zwykly gd:GUID="3bc5ac2f-b8d4-488b-8809-e27d5b6e99be">mikrodruki pozytywowe i negatywowy, zawierające wielokrotnie powtórzony tekst „RZECZOZNAWCA MAJĄTKOWY”, wykonany w technice druku irysowego,</tekst-zwykly>
        <tekst-zwykly gd:GUID="80383c10-230d-4311-93dc-71895a5b2f3b">reliefowy element graficzny przedstawiający orła w koronie,</tekst-zwykly>
        <tekst-zwykly gd:GUID="eaea98f6-800a-4aac-a1c3-e53ffea666b8">mikrodruki pozytywowe, zawierające wielokrotnie powtórzony tekst „RzM”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d13aeb89-6f98-4599-9719-c0fe326f61fa">nazwa dokumentu „ŚWIADECTWO NADANIA UPRAWNIEŃ ZAWODOWYCH W ZAKRESIE SZACOWANIA NIERUCHOMOŚCI” w dwóch wierszach,</tekst-zwykly>
        <tekst-zwykly gd:GUID="fb7b80f6-17b9-48c5-b137-74a9697c36a2">napis „IMIĘ”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="c859b9d0-c6be-4d0b-b20d-98cfe895d424">napis „NAZWISKO”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="af29b17b-008f-4a44-b952-5917e11f7965">napis „TYTUŁ ZAWODOWY”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="130a5920-e6dd-40a8-9b08-649f7f47df2d">napis „NUMER UPRAWNIEŃ”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="8cf48f1e-8ca3-41be-b39f-e83357789918">pole do umieszczenia wizerunku twarzy rzeczoznawcy majątkowego.</tekst-zwykly>
        <tekst-zwykly gd:GUID="aef8098c-7481-4309-9a55-dfc669e95e2a">Rewers:</tekst-zwykly>
        <tekst-zwykly gd:GUID="84377ff1-77ef-4c53-8015-c35e2b9cc422">dwukolorowe tło giloszowe zawierające reliefowe napisy „RzM”, wykonane w technice druku irysowego,</tekst-zwykly>
        <tekst-zwykly gd:GUID="387f815e-0f29-4967-b9b8-7a9a8e647508">mikrodruki pozytywowe zawierające wielokrotnie powtórzony tekst „RZECZOZNAWCA MAJĄTKOWY”, wykonane w technice druku irysowego,</tekst-zwykly>
        <tekst-zwykly gd:GUID="dfe9a016-c9c5-49e2-9b0d-7a9130d7b5cd">indywidualny numer blankietu dokumentu składający się z pięciu cyfr, nanoszony techniką grawerowania laserowego,</tekst-zwykly>
        <tekst-zwykly gd:GUID="5b64f156-de1d-4b2d-a591-0d2da09cded1">nazwa dokumentu „ŚWIADECTWO NADANIA UPRAWNIEŃ ZAWODOWYCH W ZAKRESIE SZACOWANIA NIERUCHOMOŚCI” w dwóch wierszach,</tekst-zwykly>
        <tekst-zwykly gd:GUID="2c828a7a-1e7f-4e0d-90da-ca3bbc097669">napis „DATA WYDANIA”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="775fd1d2-d2b1-4121-ad2f-d464245b5c16">napis „ORGAN WYDAJĄCY” i „PIECZĘĆ MINISTRA”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d1ac21a4-5566-4339-b2b4-8e3074693c1e">napis „DATA UZYSKANIA UPRAWNIEŃ”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="5726b36b-a6a1-4404-9b4b-97d259c345db">napis „PODSTAWA PRAWNA”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="c8843a84-b050-4a85-8cb2-68fd7bba49dc">napis „NUMER BLANKIETU”.</tekst-zwykly>
        <tekst-zwykly gd:GUID="08a98ec7-a79a-4073-8b6c-383cf207977b">Blankiet świadectwa jest personalizowany techniką grawerowania laserowego. W procesie personalizacji są nanoszone następujące dane:</tekst-zwykly>
        <tekst-zwykly gd:GUID="ebf20576-c0ca-4101-a271-6618ed729556">na awersie:</tekst-zwykly>
        <tekst-zwykly gd:GUID="67ac7f0f-ab9b-4533-97e9-6ac49da3b5fc">imię rzeczoznawcy majątkowego,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d0ea6901-ccf3-467c-82f6-77a6430e5e46">nazwisko rzeczoznawcy majątkowego,</tekst-zwykly>
        <tekst-zwykly gd:GUID="e6081793-c7c6-4d1d-aeca-89da5f58aa7c">„RZECZOZNAWCA MAJĄTKOWY”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="9f1bfd80-4e5f-480d-aaeb-b0aef65e6b52">numer uprawnień,</tekst-zwykly>
        <tekst-zwykly gd:GUID="09f6a0d0-db4f-464b-a873-19d849bff547">wizerunek twarzy rzeczoznawcy majątkowego zgodny z zasadami określonymi w ustawie z dnia 6 sierpnia 2010 r. o dowodach osobistych (Dz. U. z 2025 r. poz. 1753),</tekst-zwykly>
        <tekst-zwykly gd:GUID="b5fe7245-cfb2-42bf-b949-84e36707bf09">na rewersie:</tekst-zwykly>
        <tekst-zwykly gd:GUID="e9c95c01-d3dd-44e3-92e2-8633cccfcfb1">data wydania świadectwa w układzie DD.MM.RRRR,</tekst-zwykly>
        <tekst-zwykly gd:GUID="7722b3fb-68ce-4caf-9405-d2a751b0ead4">nazwa organu wydającego świadectwo,</tekst-zwykly>
        <tekst-zwykly gd:GUID="51ea0664-f175-4609-be66-0025a798cbc1">odwzorowanie pieczęci organu wydającego świadectwo,</tekst-zwykly>
        <tekst-zwykly gd:GUID="2d43bd9b-ff8f-4b4a-ad08-ca49cf901b23">data uzyskania uprawnień w układzie DD.MM.RRRR,</tekst-zwykly>
        <tekst-zwykly gd:GUID="8742d1f3-3f51-4bff-9e2d-62769cfc60b7">podstawa prawna wydania świadectwa,</tekst-zwykly>
        <tekst-zwykly gd:GUID="da6a0f2d-3316-4892-b33f-ce6dd78caaa4">kod kreskowy.</tekst-zwykly>
        <tekst-zwykly gd:GUID="665245e3-3e18-495d-8dba-1b390c2b24af">W przypadku wydawania duplikatu świadectwa nadania uprawnień zawodowych w zakresie szacowania nieruchomości napis „DUPLIKAT” nanoszony jest w procesie personalizacji.</tekst-zwykly>
      </segment-zalacznika>
    </zalacznik>
    <zalacznik eId="DU/2026/201__zal_2" gd:GUID="2dc799a7-128f-4ed9-8f0b-52030827e2f3">
      <zalacznik-nr gd:GUID="3e282132-8f96-41a9-966d-3c33f60652b2">
        <nr>2</nr>
      </zalacznik-nr>
      <tytul-zalacznika gd:GUID="a4300e6c-88f5-45ff-b06f-50bfab92287e">WIZUALIZACJA ŚWIADECTWA NADANIA UPRAWNIEŃ ZAWODOWYCH W ZAKRESIE SZACOWANIA NIERUCHOMOŚCI UDOSTĘPNIANEGO W POSTACI DOKUMENTU MOBILNEGO</tytul-zalacznika>
      <segment-zalacznika gd:GUID="f73713ac-4a93-460b-a7e7-15f2b8a224e6" orientacja="pionowa">
        <tekst-zwykly gd:GUID="cbeaf05b-6008-4bd2-929c-066f5afc6876">Opis wizualizacji</tekst-zwykly>
        <tekst-zwykly gd:GUID="cb70d0d8-ccf3-4a9c-86a4-7e31357203a5">Na świadectwie nadania uprawnień zawodowych w zakresie szacowania nieruchomości w postaci dokumentu mobilnego umieszcza się:</tekst-zwykly>
        <tekst-zwykly gd:GUID="a09b7349-f656-4e05-a160-837e1fe07c86">nazwę dokumentu „Świadectwo nadania uprawnień zawodowych w zakresie szacowania nieruchomości”;</tekst-zwykly>
        <tekst-zwykly gd:GUID="a1219103-3110-4473-8650-24bc63925bdd">imię rzeczoznawcy majątkowego;</tekst-zwykly>
        <tekst-zwykly gd:GUID="b230ee96-d783-418e-a764-f250e5e3aae0">nazwisko rzeczoznawcy majątkowego;</tekst-zwykly>
        <tekst-zwykly gd:GUID="be6e22fa-db29-4274-8219-c7f3adb4b349">tytuł zawodowy;</tekst-zwykly>
        <tekst-zwykly gd:GUID="e27efdc9-28cc-497f-927f-769b4f0d18fb">numer uprawnień;</tekst-zwykly>
        <tekst-zwykly gd:GUID="7ec8f8a9-f243-4650-9b7e-950bc0c40435">datę uzyskania uprawnień;</tekst-zwykly>
        <tekst-zwykly gd:GUID="f26fe252-1e8d-429f-b837-ac1773a80d23">wizerunek twarzy rzeczoznawcy majątkowego zgodny z zasadami określonymi w ustawie z dnia 6 sierpnia 2010 r. o dowodach osobistych (Dz. U. z 2025 r. poz. 1753).</tekst-zwykly>
      </segment-zalacznika>
    </zalacznik>
  </rozporzadzenie>
