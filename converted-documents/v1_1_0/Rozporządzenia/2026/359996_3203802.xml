      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="efab89eb-208c-4058-880f-635e3efb84a7" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-26_DU-2026-212_domyslne.x" wejscie-w-zycie="2026-02-26">
        <p>
          <zdanie nr="1" gd:zdGUID="e44da7ed-0689-4966-a64f-be8ab722fab8" fragment="1" gd:fragmentGUID="1a33d333-f161-4d9a-8fe2-92024d9b638e" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-26_DU-2026-212_domyslne.x" wejscie-w-zycie="2026-02-26">Stawki uposażenia zasadniczego żołnierzy zawodowych dla poszczególnych grup uposażenia, określone w załączniku do rozporządzenia, stosuje się do ustalania wysokości uposażenia zasadniczego żołnierzy zawodowych od dnia 1 stycznia 2026 r.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
