      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="e58c2647-19d4-47f3-b497-bdf9b3d70f86" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-26_DU-2026-212_domyslne.x" wejscie-w-zycie="2026-02-26">
        <p>
          <zdanie nr="1" gd:zdGUID="30c4e3cf-4b80-4647-95ec-a38abdcd4beb" fragment="1" gd:fragmentGUID="1ea4aeda-9692-4138-8082-003945ce2cf9" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-26_DU-2026-212_domyslne.x" wejscie-w-zycie="2026-02-26">Rozporządzenie określa stawki uposażenia zasadniczego żołnierzy zawodowych dla poszczególnych grup uposażenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <paragraf eId="DU/2026/212__art_2" gd:GUID="dfedd2bb-47a7-4509-851f-5485f70c2e11" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-26_DU-2026-212_domyslne.x" wejscie-w-zycie="2026-02-26">
