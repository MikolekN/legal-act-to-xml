        <p>
          <zdanie nr="1" gd:zdGUID="d26c0077-792d-4c09-8e2d-d0cb0ab200d4" fragment="1" gd:fragmentGUID="4c7f94b2-b764-40a7-bcd8-9178f2946773" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-26_DU-2026-212_domyslne.x" wejscie-w-zycie="2026-02-26">Stawki uposażenia zasadniczego żołnierzy zawodowych dla poszczególnych grup uposażenia są określone w załączniku do rozporządzenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <paragraf eId="DU/2026/212__art_3" gd:GUID="67f60ff8-5724-413f-905d-246f15a2a901" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-26_DU-2026-212_domyslne.x" wejscie-w-zycie="2026-02-26">
