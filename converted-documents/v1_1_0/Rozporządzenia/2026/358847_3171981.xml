          <nr>4</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="bd9f4e49-0ec1-455d-b6db-92e0ceab731f" fragment="5" gd:fragmentGUID="1b297359-ed5c-4d44-852a-b78737df2366" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-01_DU-2026-83_domyslne.x" wejscie-w-zycie="2026-02-01">w § 8 ust. 1 otrzymuje brzmienie:<cytat-strukt now:akt="https://eli.gov.pl/eli/DU/2018/1548" cudzyslowy="oba" gd:nowGUID="6d5a858b-dd5f-4df6-a91c-b69a8ac59217" element-eId="DU/2018/1548__art_8__ust_1" funkcja="zastap"><ustep eId="DU/2018/1548__art_8__ust_1" gd:GUID="69f8fa2d-7e16-41d4-b30d-fae8173f9034" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-01_DU-2026-83_domyslne.x" wejscie-w-zycie="2026-02-01"><nr>1</nr><p><zdanie nr="1" gd:zdGUID="ddca614c-533b-4569-8a18-3b7f1e0a4269" fragment="1" gd:fragmentGUID="46470c0a-c16f-413c-bfbf-662988dfed41" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-01_DU-2026-83_domyslne.x" wejscie-w-zycie="2026-02-01">Zwrot kosztów, o których mowa w art. 77 § 6 pkt 2 i 6 ustawy, następuje raz w miesiącu z dołu w terminie 14 dni od dnia złożenia kierownikowi jednostki wykazu odbytych przejazdów lub dojazdów oraz oświadczenia o wysokości poniesionych kosztów, z zastrzeżeniem ust. 2.</zdanie></p></ustep></cytat-strukt>;</zdanie>
          </p>
        </punkt>
        <punkt eId="DU/2026/83__art_1__pkt_5" gd:GUID="248ad843-10f3-4736-9b6f-c97342a2b863" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-01_DU-2026-83_domyslne.x" wejscie-w-zycie="2026-02-01">
