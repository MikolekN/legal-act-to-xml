        <tekst-zwykly gd:GUID="0921d4f9-120f-4010-b0b4-32232f416634">– gminę Ostrów Mazowiecka,</tekst-zwykly>
        <tekst-zwykly gd:GUID="7d8113e1-3839-48d0-839b-46daa53c2160">– miasto Ostrów Mazowiecka,</tekst-zwykly>
