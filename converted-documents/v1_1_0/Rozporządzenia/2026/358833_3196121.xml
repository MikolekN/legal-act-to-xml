        <tekst-zwykly gd:GUID="cae8efc1-568c-43cb-8872-3e1d2aa18fee">– gminę Wąsewo,</tekst-zwykly>
        <tekst-zwykly gd:GUID="b7d7eb3b-4178-486b-9ea1-cde779481490">o) w powiecie płońskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="ea00c841-a0cb-4ce0-9597-7dd251d14085">– gminę Baboszewo,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d26bab0c-1ed7-4f90-ad68-084029bb87ae">– gminę Czerwińsk nad Wisłą,</tekst-zwykly>
        <tekst-zwykly gd:GUID="1538b14d-b7a0-4dea-8c67-09125b263ae5">– gminę Dzierzążnia,</tekst-zwykly>
        <tekst-zwykly gd:GUID="eb7dfe62-08aa-4fc5-81f5-a53b60e4efc3">– gminę Joniec,</tekst-zwykly>
        <tekst-zwykly gd:GUID="905ddcd6-292b-42b3-8a5a-439bbfb12382">– gminę Naruszewo,</tekst-zwykly>
        <tekst-zwykly gd:GUID="3e3fd920-e9d6-46b8-ad3b-17f8c75f8b65">– gminę Nowe Miasto,</tekst-zwykly>
        <tekst-zwykly gd:GUID="01b25273-b4ac-4ad7-affe-4ce7e98532c7">– gminę Płońsk,</tekst-zwykly>
        <tekst-zwykly gd:GUID="c11db026-dc75-4896-a3a7-7858335d9525">– miasto Płońsk,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d1933127-5afe-4164-ba80-c8cd17a8357d">– gminę Raciąż,</tekst-zwykly>
        <tekst-zwykly gd:GUID="09fa515e-b176-4374-b1f3-40d478a03a4d">– miasto Raciąż,</tekst-zwykly>
        <tekst-zwykly gd:GUID="932fd942-ee83-442b-851e-b60954f8c61a">– gminę Sochocin,</tekst-zwykly>
        <tekst-zwykly gd:GUID="da662f6f-242d-48ba-8e6a-ed9deeab67ea">p) w powiecie sochaczewskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="336df971-e03f-4e03-9506-0edade27d62f">– gminę Brochów,</tekst-zwykly>
