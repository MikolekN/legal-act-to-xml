        <tekst-zwykly gd:GUID="f234de63-1560-43c9-8eda-c992225e9152">i) powiat sejneński,</tekst-zwykly>
        <tekst-zwykly gd:GUID="5d00a227-2e70-4fae-8023-7a4854ef3fb4">j) powiat sokólski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d1f2cf86-a96c-4dee-ae0b-ba78d471074f">k) powiat suwalski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="5ede8b7b-f682-4bf7-844a-37610e020cef">l) miasto na prawach powiatu Suwałki,</tekst-zwykly>
