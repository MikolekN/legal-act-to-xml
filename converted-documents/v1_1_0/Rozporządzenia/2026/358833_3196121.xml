        <tekst-zwykly gd:GUID="845f599d-c19a-4f41-9056-41aa92673395">e) powiat kolneński,</tekst-zwykly>
        <tekst-zwykly gd:GUID="27cc0efa-8ab5-44ba-9b8c-c1ee8b164f7b">f) powiat łomżyński,</tekst-zwykly>
