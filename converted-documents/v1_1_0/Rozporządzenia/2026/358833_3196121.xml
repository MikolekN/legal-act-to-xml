        <tekst-zwykly gd:GUID="d42b748e-ac7c-4216-89b1-a0e18eac7fd2">– gminę Młodzieszyn,</tekst-zwykly>
        <tekst-zwykly gd:GUID="7fd03f6f-24b0-40d1-ac26-2fb5752323f7">– gminę Nowa Sucha,</tekst-zwykly>
        <tekst-zwykly gd:GUID="dd11c3e8-669c-4c80-85a5-2a8290459b21">– gminę Rybno,</tekst-zwykly>
        <tekst-zwykly gd:GUID="0395ec93-8e08-4a58-8b4f-16ac529e0a60">– gminę Sochaczew,</tekst-zwykly>
        <tekst-zwykly gd:GUID="08f0a032-8cbc-400b-b09f-768d3d0164be">– miasto Sochaczew,</tekst-zwykly>
        <tekst-zwykly gd:GUID="3e729fef-9807-4576-95d1-5c40dc6ca1fb">q) w powiecie wyszkowskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="a141a840-8f0c-4399-87bb-6bb78c312145">– gminę Długosiodło,</tekst-zwykly>
        <tekst-zwykly gd:GUID="3da6f2aa-c14a-4bd4-b0c8-50ffb522cc31">– gminę Rząśnik,</tekst-zwykly>
        <tekst-zwykly gd:GUID="ead10b65-0db0-462d-8fec-e11e80c48da4">– gminę Somianka;</tekst-zwykly>
        <tekst-zwykly gd:GUID="0de0008b-6f68-410c-a169-21ec7f44a682">13) w województwie podlaskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="d3315354-10b0-46a2-82f6-ac7fb06232fc">a) powiat augustowski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="69d822f3-fb6e-48aa-b23c-48306d85838f">b) powiat białostocki,</tekst-zwykly>
