          </p>
        </punkt>
        <punkt eId="DU/2026/22__art_1__pkt_2" gd:GUID="3edf00c6-fa69-4c7c-9f1b-78c28d6e746b" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-24_DU-2026-22_domyslne.x" wejscie-w-zycie="2026-01-24">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="607bd66c-0524-42d6-9279-7c9411cec2de" fragment="3" gd:fragmentGUID="4b664612-d760-4958-af63-cbc0a03cec02" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-24_DU-2026-22_domyslne.x" wejscie-w-zycie="2026-01-24">w § 15 w ust. 5 w pkt 20 kropkę zastępuje się średnikiem i dodaje się pkt 21 w brzmieniu:<cytat-w-tekscie now:akt="https://eli.gov.pl/eli/DU/2025/133" cudzyslowy="oba" gd:nowGUID="1a8f0bab-c55d-49f0-98a9-f82586a13090" element-eId="DU/2025/133__zal_36" funkcja="zastap-recznie"><tekst>;</tekst></cytat-w-tekscie><cytat-strukt now:akt="https://eli.gov.pl/eli/DU/2025/133" cudzyslowy="oba" gd:nowGUID="6f43151a-e597-4be0-afea-3f030f055def" element-eId="DU/2025/133__zal_36" funkcja="dodaj-recznie"><punkt eId="DU/2025/133__zal_36__art_15__ust_5__pkt_21" gd:GUID="7bc7e161-156a-43a7-b025-7fd6359cd723" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-24_DU-2026-22_domyslne.x" wejscie-w-zycie="2026-01-24"><nr>21</nr><p><zdanie nr="1" gd:zdGUID="f32638ba-fc0e-4064-bf70-4ad999d20906" fragment="1" gd:fragmentGUID="78826339-dd80-424e-9943-85af99f0fd38" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-24_DU-2026-22_domyslne.x" wejscie-w-zycie="2026-01-24">członków Rady Fiskalnej.</zdanie></p></punkt></cytat-strukt>;</zdanie>
          </p>
        </punkt>
        <punkt eId="DU/2026/22__art_1__pkt_3" gd:GUID="29fdea9b-640b-4896-a6ff-413696d9c43b" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-24_DU-2026-22_domyslne.x" wejscie-w-zycie="2026-01-24">
          <nr>3</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="607bd66c-0524-42d6-9279-7c9411cec2de" fragment="4" gd:fragmentGUID="8bdae7c2-a347-451b-8bdd-8b98f775a4c3" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-24_DU-2026-22_domyslne.x" wejscie-w-zycie="2026-01-24">w § 16 w pkt 7 w lit. u średnik zastępuje się przecinkiem i dodaje się lit. w w brzmieniu:<cytat-w-tekscie now:akt="https://eli.gov.pl/eli/DU/2025/133" cudzyslowy="oba" gd:nowGUID="d871e6f0-0d75-45f1-8283-4834a63cade4" element-eId="DU/2025/133__zal_36" funkcja="zastap-recznie"><tekst>,</tekst></cytat-w-tekscie><cytat-strukt now:akt="https://eli.gov.pl/eli/DU/2025/133" cudzyslowy="oba" gd:nowGUID="e8e59fb3-755e-4d7c-8cf7-437bf331d2d2" element-eId="DU/2025/133__zal_36" funkcja="dodaj-recznie"><litera eId="DU/2025/133__zal_36__art_16__pkt_7__lit_w" gd:GUID="e2fccadf-92a1-4972-8c51-3587e7996033" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-24_DU-2026-22_domyslne.x" wejscie-w-zycie="2026-01-24"><nr>w</nr><p><zdanie nr="1" gd:zdGUID="7cc78f60-8dd3-42cf-915d-4d5f17b6a46a" fragment="1" gd:fragmentGUID="5363e353-dda2-4dba-b130-7b982464fcf2" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-24_DU-2026-22_domyslne.x" wejscie-w-zycie="2026-01-24">21 – członkowie Rady Fiskalnej;</zdanie></p></litera></cytat-strukt>.</zdanie>
          </p>
        </punkt>
      </ustep-n>
    </paragraf>
    <paragraf eId="DU/2026/22__art_2" gd:GUID="a5469bf4-ae95-4878-9b1e-eeebed33cea0" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-24_DU-2026-22_domyslne.x" wejscie-w-zycie="2026-01-24">
