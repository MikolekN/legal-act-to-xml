        <p>
          <zdanie nr="1" gd:zdGUID="2da36394-5793-4838-b7b6-c29e6d9cc7de" fragment="1" gd:fragmentGUID="e495fbb9-8097-4fea-a564-c37ce1463f76" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-26_DU-2026-212_domyslne.x" wejscie-w-zycie="2026-02-26">Stawki uposażenia zasadniczego żołnierzy zawodowych dla poszczególnych grup uposażenia są określone w załączniku do rozporządzenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <paragraf eId="DU/2026/212__art_3" gd:GUID="062212b5-d493-4f0e-b115-c93500f5ecf4" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-26_DU-2026-212_domyslne.x" wejscie-w-zycie="2026-02-26">
