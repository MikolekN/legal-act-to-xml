        <punkt eId="DU/2026/201__art_2__ust_2__pkt_2" gd:GUID="1f79273e-a74c-4e0e-953f-3ac38a96a571" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-10_DU-2026-201_domyslne.x" wejscie-w-zycie="2026-03-10">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="adadc3ba-382a-4225-a50f-9773893735dd" fragment="3" gd:fragmentGUID="6e46000f-c23a-48e0-916f-fcf576db37fa" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-10_DU-2026-201_domyslne.x" wejscie-w-zycie="2026-03-10">do wniosku, o którym mowa w tym przepisie, załącza się dowód uiszczenia opłaty, o której mowa w pkt 1.</zdanie>
