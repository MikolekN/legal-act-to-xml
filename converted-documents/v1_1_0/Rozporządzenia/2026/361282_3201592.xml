    <organ-podpisujacy>Minister Finansów i Gospodarki: <i><osoba podpisujacy="true" gd:osobaGUID="ff6d467d-d9f5-455c-b9a1-28bd6effb6ff"><imie>A.</imie> <nazwisko>Domański</nazwisko></osoba></i></organ-podpisujacy>
    <zalacznik eId="DU/2026/201__zal_1" gd:GUID="d2296b11-4f8d-4bd9-9bf9-237635069317">
      <zalacznik-do gd:GUID="bc80f486-6cbe-4059-88a9-c6fd742be75f">Załączniki do rozporządzenia Ministra Finansów i Gospodarki z dnia 12 lutego 2026 r. (poz. 201)</zalacznik-do>
      <zalacznik-nr gd:GUID="17a90b3b-aaa1-4d61-8720-e1f4f0a10482">
        <nr>1</nr>
      </zalacznik-nr>
      <tytul-zalacznika gd:GUID="df9bd5f2-5bb7-4568-bfb4-4d8404c401a0">WZÓR ŚWIADECTWA NADANIA UPRAWNIEŃ ZAWODOWYCH W ZAKRESIE SZACOWANIA NIERUCHOMOŚCI</tytul-zalacznika>
      <segment-zalacznika gd:GUID="1fc4d4cb-9f01-41d2-a358-5ae27d6232a8" orientacja="pionowa">
        <tekst-zwykly gd:GUID="05aa71bf-9dd7-49f6-ab37-380aae4ad079">awers</tekst-zwykly>
        <tekst-zwykly gd:GUID="3f7994cb-edbd-40d2-a952-4b7d0e8609f6">rewers</tekst-zwykly>
        <tekst-zwykly gd:GUID="e1fcd71e-69e5-45fd-878d-f4768bc95777">Opis wzoru Świadectwa nadania uprawnień zawodowych w zakresie szacowania nieruchomości</tekst-zwykly>
        <tekst-zwykly gd:GUID="e3ac9785-21d7-44d6-ad95-175aad402b2e">Format dokumentu: dwustronna karta w formacie ID-1.</tekst-zwykly>
        <tekst-zwykly gd:GUID="578e88f0-c7e4-4e36-95a6-3e52398e8a79">Podłoże: poliwęglan, niewykazujący luminescencji w promieniowaniu ultrafioletowym, umożliwiające trwałe naniesienie szaty graficznej, danych personalnych, identyfikacyjnych oraz elementów zabezpieczających.</tekst-zwykly>
        <tekst-zwykly gd:GUID="8de1a4cf-7a1f-4248-912e-3347010a7c16">Awers:</tekst-zwykly>
        <tekst-zwykly gd:GUID="38590c23-848a-4e2e-a2ae-eba29508f255">dwukolorowe tło giloszowe zawierające reliefowe napisy „RzM”, wykonane w technice druku irysowego,</tekst-zwykly>
        <tekst-zwykly gd:GUID="10334c95-fc69-42ad-8438-eed45c3631f0">mikrodruki pozytywowe i negatywowy, zawierające wielokrotnie powtórzony tekst „RZECZOZNAWCA MAJĄTKOWY”, wykonany w technice druku irysowego,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d61df70f-6395-47a8-a0dd-1b881dda51fe">reliefowy element graficzny przedstawiający orła w koronie,</tekst-zwykly>
        <tekst-zwykly gd:GUID="bef57530-0e4a-42cb-8d37-9810cee6f9c0">mikrodruki pozytywowe, zawierające wielokrotnie powtórzony tekst „RzM”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="30f5b412-6b1d-45db-8c0e-ba79c6abb114">nazwa dokumentu „ŚWIADECTWO NADANIA UPRAWNIEŃ ZAWODOWYCH W ZAKRESIE SZACOWANIA NIERUCHOMOŚCI” w dwóch wierszach,</tekst-zwykly>
        <tekst-zwykly gd:GUID="87d25c80-172c-4beb-ac28-a78e813b7dff">napis „IMIĘ”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="20176825-7600-4de7-b812-d8a81bf5d281">napis „NAZWISKO”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="38a38ca9-e1bd-446a-bed5-b25d9bde9adb">napis „TYTUŁ ZAWODOWY”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="0b7514ee-e879-4dc5-9df7-f73ce3a99864">napis „NUMER UPRAWNIEŃ”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="f181921d-47e4-4908-bc19-6f03f23f8518">pole do umieszczenia wizerunku twarzy rzeczoznawcy majątkowego.</tekst-zwykly>
        <tekst-zwykly gd:GUID="4524e53a-48a4-4324-84f8-dda1850bdf47">Rewers:</tekst-zwykly>
        <tekst-zwykly gd:GUID="15294237-cd75-40dc-a9e7-ac0f9aed0e04">dwukolorowe tło giloszowe zawierające reliefowe napisy „RzM”, wykonane w technice druku irysowego,</tekst-zwykly>
        <tekst-zwykly gd:GUID="e067b05d-3804-4106-9f40-6892556636ee">mikrodruki pozytywowe zawierające wielokrotnie powtórzony tekst „RZECZOZNAWCA MAJĄTKOWY”, wykonane w technice druku irysowego,</tekst-zwykly>
        <tekst-zwykly gd:GUID="26a19dd7-7927-4d8c-aedf-1e2993aa7db6">indywidualny numer blankietu dokumentu składający się z pięciu cyfr, nanoszony techniką grawerowania laserowego,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d3bc0088-1167-48ef-bff4-f75fb58c8435">nazwa dokumentu „ŚWIADECTWO NADANIA UPRAWNIEŃ ZAWODOWYCH W ZAKRESIE SZACOWANIA NIERUCHOMOŚCI” w dwóch wierszach,</tekst-zwykly>
        <tekst-zwykly gd:GUID="03c71960-761d-4a40-9817-7394d12097ab">napis „DATA WYDANIA”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="4846bfd5-47af-48f9-acb3-b33007aa42a4">napis „ORGAN WYDAJĄCY” i „PIECZĘĆ MINISTRA”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="11d7e2aa-7ccb-442b-88b7-3762cd5213d2">napis „DATA UZYSKANIA UPRAWNIEŃ”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="6db3401e-fc6a-4840-a7fa-77ac240279f2">napis „PODSTAWA PRAWNA”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="cb3a1cda-5a6c-4f8c-b4c2-c6f0726c81eb">napis „NUMER BLANKIETU”.</tekst-zwykly>
        <tekst-zwykly gd:GUID="75fd0ddd-2481-4f9c-a47a-39f4e58b7f87">Blankiet świadectwa jest personalizowany techniką grawerowania laserowego. W procesie personalizacji są nanoszone następujące dane:</tekst-zwykly>
        <tekst-zwykly gd:GUID="dcc73311-c447-48e6-9352-14e1583c43b5">na awersie:</tekst-zwykly>
        <tekst-zwykly gd:GUID="2fae49f1-9623-42f8-a2e8-ff21ff4e0b33">imię rzeczoznawcy majątkowego,</tekst-zwykly>
        <tekst-zwykly gd:GUID="1e278f0b-e4a5-4c0f-85e3-363ff2aeffa5">nazwisko rzeczoznawcy majątkowego,</tekst-zwykly>
        <tekst-zwykly gd:GUID="906c4aee-347e-4ac8-9c8f-b96f8be2da73">„RZECZOZNAWCA MAJĄTKOWY”,</tekst-zwykly>
        <tekst-zwykly gd:GUID="c2ddfda4-d127-4a76-b17b-e6f32e82798b">numer uprawnień,</tekst-zwykly>
        <tekst-zwykly gd:GUID="5543ef66-a73b-44fd-8887-657396591509">wizerunek twarzy rzeczoznawcy majątkowego zgodny z zasadami określonymi w ustawie z dnia 6 sierpnia 2010 r. o dowodach osobistych (Dz. U. z 2025 r. poz. 1753),</tekst-zwykly>
        <tekst-zwykly gd:GUID="45093109-aae8-4991-802a-b711a72d02d3">na rewersie:</tekst-zwykly>
        <tekst-zwykly gd:GUID="005064be-99af-4776-b505-d9615c0dfa1d">data wydania świadectwa w układzie DD.MM.RRRR,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d19be8f4-33fd-4959-ac86-07a2cdfe9275">nazwa organu wydającego świadectwo,</tekst-zwykly>
        <tekst-zwykly gd:GUID="81ff13f9-6ed9-4dd3-8a78-83a734711230">odwzorowanie pieczęci organu wydającego świadectwo,</tekst-zwykly>
        <tekst-zwykly gd:GUID="dfab7f46-b1f5-4a83-b771-5e936982d27b">data uzyskania uprawnień w układzie DD.MM.RRRR,</tekst-zwykly>
        <tekst-zwykly gd:GUID="fc84426a-7c33-4f90-9d6c-a17c4c5201c4">podstawa prawna wydania świadectwa,</tekst-zwykly>
        <tekst-zwykly gd:GUID="ca0ed9a6-5587-4b6e-8e3e-601ac81f9d10">kod kreskowy.</tekst-zwykly>
        <tekst-zwykly gd:GUID="fc274939-c69f-494f-8a03-eae9d4987a55">W przypadku wydawania duplikatu świadectwa nadania uprawnień zawodowych w zakresie szacowania nieruchomości napis „DUPLIKAT” nanoszony jest w procesie personalizacji.</tekst-zwykly>
      </segment-zalacznika>
    </zalacznik>
    <zalacznik eId="DU/2026/201__zal_2" gd:GUID="685251b1-59a1-45d2-9606-689d56d4ec08">
      <zalacznik-nr gd:GUID="29389227-80b0-43a0-9bf7-e7d051245cfa">
        <nr>2</nr>
      </zalacznik-nr>
      <tytul-zalacznika gd:GUID="f8e44fb2-0c55-4e53-ac26-36f0210f39f1">WIZUALIZACJA ŚWIADECTWA NADANIA UPRAWNIEŃ ZAWODOWYCH W ZAKRESIE SZACOWANIA NIERUCHOMOŚCI UDOSTĘPNIANEGO W POSTACI DOKUMENTU MOBILNEGO</tytul-zalacznika>
      <segment-zalacznika gd:GUID="a023f221-ffe9-4d8a-8e71-fd98a2a502b4" orientacja="pionowa">
        <tekst-zwykly gd:GUID="78e29967-ce14-4509-8c54-c14e74cb0180">Opis wizualizacji</tekst-zwykly>
        <tekst-zwykly gd:GUID="0fe47489-b729-4d68-95d3-ba131fe1e1b4">Na świadectwie nadania uprawnień zawodowych w zakresie szacowania nieruchomości w postaci dokumentu mobilnego umieszcza się:</tekst-zwykly>
        <tekst-zwykly gd:GUID="3cf5ac34-b3af-476c-9c74-742fe079172d">nazwę dokumentu „Świadectwo nadania uprawnień zawodowych w zakresie szacowania nieruchomości”;</tekst-zwykly>
        <tekst-zwykly gd:GUID="3d730054-36eb-4b9c-9463-42935a1ea5b6">imię rzeczoznawcy majątkowego;</tekst-zwykly>
        <tekst-zwykly gd:GUID="38dcc452-2118-4e8a-aee5-ef6ac25d6b29">nazwisko rzeczoznawcy majątkowego;</tekst-zwykly>
        <tekst-zwykly gd:GUID="3790aa85-18b0-4b90-8064-17529d37c22d">tytuł zawodowy;</tekst-zwykly>
        <tekst-zwykly gd:GUID="e57b7973-bd75-48a2-8314-253f5c7cc6d4">numer uprawnień;</tekst-zwykly>
        <tekst-zwykly gd:GUID="19fdd756-14e0-4671-b3ac-c7dd35813952">datę uzyskania uprawnień;</tekst-zwykly>
        <tekst-zwykly gd:GUID="cc7122a3-707a-4083-abd6-0c3eaeb13581">wizerunek twarzy rzeczoznawcy majątkowego zgodny z zasadami określonymi w ustawie z dnia 6 sierpnia 2010 r. o dowodach osobistych (Dz. U. z 2025 r. poz. 1753).</tekst-zwykly>
      </segment-zalacznika>
    </zalacznik>
  </rozporzadzenie>
