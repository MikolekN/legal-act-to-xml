    <paragraf eId="DU/2026/259__art_3" gd:GUID="30df061d-0870-49cd-8f90-e775636ea855" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-18_DU-2026-259_odczytane.x" wejscie-w-zycie="2026-03-18">
