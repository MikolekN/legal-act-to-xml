          </p>
        </punkt>
        <punkt eId="DU/2026/229__art_2__pkt_3" gd:GUID="ebbf2c0c-b490-4fe2-89b7-63142fed146b" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-27_DU-2026-229_odczytane.x" wejscie-w-zycie="2026-02-27">
          <nr>3</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="1b71665b-7d21-44f1-83b4-a06d9640f4c1" fragment="4" gd:fragmentGUID="206c6096-11aa-4275-9c93-818d58ee3fc9" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-27_DU-2026-229_odczytane.x" wejscie-w-zycie="2026-02-27">inicjowanie, wspieranie i promowanie rozwiązań na rzecz osób starszych;</zdanie>
          </p>
        </punkt>
        <punkt eId="DU/2026/229__art_2__pkt_4" gd:GUID="5011dbac-f30b-4d72-a020-211585a9d1fa" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-27_DU-2026-229_odczytane.x" wejscie-w-zycie="2026-02-27">
          <nr>4</nr>
          <p>
