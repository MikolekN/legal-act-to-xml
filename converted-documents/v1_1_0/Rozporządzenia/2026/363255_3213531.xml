          <litera eId="DU/2026/277__art_1__pkt_1__lit_c" gd:GUID="bc131ddd-b6f0-4736-8f48-54d4160cf519" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-06_DU-2026-277_domyslne.x" wejscie-w-zycie="2026-03-06">
