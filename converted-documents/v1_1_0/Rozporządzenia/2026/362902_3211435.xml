    <paragraf eId="DU/2026/259__art_3" gd:GUID="c7ac2f67-956c-4cc3-951e-608ec4f5ee19" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-18_DU-2026-259_odczytane.x" wejscie-w-zycie="2026-03-18">
