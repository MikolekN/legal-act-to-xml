        <p>
          <zdanie nr="1" gd:zdGUID="c1314fa2-9b93-4a66-a4ca-500f74200312" fragment="1" gd:fragmentGUID="ba386abb-03c7-4cdf-a141-f6950faf0f2a" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-05_DU-2026-257_odczytane.x" wejscie-w-zycie="2026-03-05">Rozporządzenie wchodzi w życie z dniem 5 marca 2026 r.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
