          </p>
        </punkt>
        <punkt eId="DU/2026/285__art_1__pkt_2" gd:GUID="cc7e45b1-3241-4ab8-a597-9d9da98a6b14" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-21_DU-2026-285_domyslne.x" wejscie-w-zycie="2026-03-21">
