      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="d9cc553f-45e3-4079-bc78-91d7b45d5094" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-06_DU-2026-147_odczytane.x" wejscie-w-zycie="2026-03-06">
        <p>
          <zdanie nr="1" gd:zdGUID="22f57bc6-4c1a-48f2-972f-307cf15450a9" fragment="1" gd:fragmentGUID="38ed3ade-7e89-4d17-9eae-bfc56e9ad7cb" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-06_DU-2026-147_odczytane.x" wejscie-w-zycie="2026-03-06">Wykaz, o którym mowa w § 1, jest określony w załączniku do rozporządzenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <paragraf eId="DU/2026/147__art_3" gd:GUID="9271c750-f17c-4025-b435-43f0272a271e" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-06_DU-2026-147_odczytane.x" wejscie-w-zycie="2026-03-06">
