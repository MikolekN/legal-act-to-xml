    <paragraf eId="DU/2026/231__art_1" gd:GUID="c725b0a7-8291-4015-9042-c7057b220963" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-28_DU-2026-231_domyslne.x" wejscie-w-zycie="2026-03-28">
