          </p>
        </punkt>
        <punkt eId="DU/2026/169__art_1__pkt_2" gd:GUID="7cfaa1fe-d3c0-49a9-b430-93e78ff5c135" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-13_DU-2026-169_domyslne.x" wejscie-w-zycie="2026-02-13">
