        <p>
          <zdanie nr="1" gd:zdGUID="fd297efb-3931-48f2-b791-75a640387fbc" fragment="1" gd:fragmentGUID="7d46e2ae-ed20-47e2-8b5c-fdd87ecb65f2" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-27_DU-2026-164_domyslne.x" wejscie-w-zycie="2026-02-27">Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
