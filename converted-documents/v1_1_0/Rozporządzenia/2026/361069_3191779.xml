          </p>
        </punkt>
        <punkt eId="DU/2026/169__art_1__pkt_2" gd:GUID="2627c66e-9467-4cd2-97ca-8e05665ec345" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-13_DU-2026-169_domyslne.x" wejscie-w-zycie="2026-02-13">
