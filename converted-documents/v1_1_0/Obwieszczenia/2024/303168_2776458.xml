              </p>
            </litera>
            <litera eId="MP/2024/1112__art_3__ust_1__pkt_3__lit_f" gd:GUID="254dc362-6410-4efe-9627-dc018510753c">
              <nr>f</nr>
              <p>
                <zdanie nr="1" gd:zdGUID="473a782e-19bc-400a-a1a6-312cf21cfa0d" fragment="10" gd:fragmentGUID="a290f7ad-17df-451c-8d77-66d66dd536ba">ministra właściwego do spraw gospodarki,</zdanie>
              </p>
            </litera>
            <litera eId="MP/2024/1112__art_3__ust_1__pkt_3__lit_fa" gd:GUID="5e349c60-b28a-4319-a829-39b25a535aef">
              <nr>fa</nr>
