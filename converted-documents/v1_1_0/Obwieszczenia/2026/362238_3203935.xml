          </p>
        </nie-ztp-litera>
        <nie-ztp-litera eId="MP/2026/242__pkt_2__lit_f" gd:GUID="90bff686-1d79-4a6e-8a17-74629d363a58">
          <nr>f</nr>
          <p>
