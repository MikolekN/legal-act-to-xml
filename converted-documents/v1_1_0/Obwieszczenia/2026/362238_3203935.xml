          </p>
        </nie-ztp-litera>
        <nie-ztp-litera eId="MP/2026/242__pkt_1__lit_d" gd:GUID="d972beb8-0b62-4760-aab4-64f56f4fd07b">
          <nr>d</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="fe8f5f15-9a43-43f0-9e22-2f44f9648689" fragment="6" gd:fragmentGUID="3e278e63-b0af-40d5-96a7-cdf8bd13f60d">wielkość średniego dziennego przywozu gazu płynnego (LPG) wyniosła 6,118 tys. ton;</zdanie>
          </p>
        </nie-ztp-litera>
      </nie-ztp-punkt>
      <nie-ztp-punkt eId="MP/2026/242__pkt_2" gd:GUID="1673d663-671f-4827-8ae3-12474b3e55f7">
        <nr>2</nr>
