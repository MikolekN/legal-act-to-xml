            <zdanie nr="1" gd:zdGUID="fe8f5f15-9a43-43f0-9e22-2f44f9648689" fragment="4" gd:fragmentGUID="ffc327af-cb8b-4a62-8c56-ee884ea9dbcc">wielkość średniego dziennego zużycia krajowego brutto ekwiwalentu ropy naftowej wyniosła 91,522 tys. ton,</zdanie>
          </p>
        </nie-ztp-litera>
        <nie-ztp-litera eId="MP/2026/242__pkt_1__lit_c" gd:GUID="00f5c406-74a0-46c6-85fe-febc6f596dbb">
          <nr>c</nr>
