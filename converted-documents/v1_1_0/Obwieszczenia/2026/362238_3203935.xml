        <nie-ztp-litera eId="MP/2026/242__pkt_2__lit_g" gd:GUID="aff9d237-42e7-4cd2-b71c-79fa3aca3d7b">
          <nr>g</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="fe8f5f15-9a43-43f0-9e22-2f44f9648689" fragment="14" gd:fragmentGUID="db6235bc-06f2-4ede-8335-6788dbca1a3d">olejów napędowych, w tym lekkich olejów opałowych – 0,832 tony/m<sup>3</sup>,</zdanie>
          </p>
