                  <tekst-zwykly gd:GUID="6afd18c7-5950-4190-b35e-b9f37052973c">2)</tekst-zwykly>
                </td>
                <td rowspan="2" gd:GUID="5a383fc7-8fd5-45b2-b3bd-80ba4ef8652a">
                  <tekst-zwykly gd:GUID="6ed1b44c-77dd-401c-acf1-bcd158f71d0d">W<sub>2</sub> =</tekst-zwykly>
                </td>
                <td gd:GUID="8407440c-51b1-4107-8892-0019774389f7">
                  <tekst-zwykly gd:GUID="9eae9dc9-98d2-4e6d-b0d1-c51deab72623">P<sub>2</sub></tekst-zwykly>
                </td>
                <td rowspan="2" gd:GUID="ef0f6dc7-9cda-4f12-a988-929c93fa82d2">
                  <tekst-zwykly gd:GUID="ded2a72a-9d4a-4e6e-8bf1-feff822ab15a">× 1000,</tekst-zwykly>
                </td>
              </tr>
              <tr gd:GUID="9beb17c7-ac37-4d65-9c09-d86afca00c06">
                <td gd:GUID="66cca82d-c4ac-47d6-bda6-e4f29739894a">
                  <tekst-zwykly gd:GUID="144c4e2d-afde-4731-9e44-577781cf7ba2">U</tekst-zwykly>
                </td>
