              <zdanie nr="1" gd:zdGUID="daee6552-2388-492b-8f1b-89c54e2f3848" fragment="2" gd:fragmentGUID="1c36b7cc-0c3a-4256-93c5-d242ad142e2d">numer mLegitymacji;</zdanie>
            </p>
          </punkt>
          <punkt eId="DU/2025/1594__art_8__pkt_2" gd:GUID="29a8b0ab-24ae-4ffc-84a3-d3d3765c57b1">
            <nr>2</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="daee6552-2388-492b-8f1b-89c54e2f3848" fragment="3" gd:fragmentGUID="27315ae9-83a7-41fb-a73f-7bd71a7cfe80">zdjęcie emeryta lub rencisty;</zdanie>
