    <rodzaj-aktu>Obwieszczenie</rodzaj-aktu>
    <autor-aktu>Ministra Finansów i Gospodarki<odnosnik id-odnosnika="1" symbol="1" gd:GUID="8cb5716d-be58-466e-9235-f897d412ab01"><p><zdanie nr="1" gd:zdGUID="05e8cfe0-d659-4416-a55a-5b6e971327a7" fragment="1" gd:fragmentGUID="62d26fba-84ae-412d-a709-e69c65286db2">Minister Finansów i Gospodarki kieruje działem administracji rządowej – finanse publiczne, na podstawie § 1 ust. 2 pkt 3 rozporządzenia Prezesa Rady Ministrów z dnia 25 lipca 2025 r. w sprawie szczegółowego zakresu działania Ministra Finansów i Gospodarki (Dz. U. poz. 997).</zdanie></p></odnosnik></autor-aktu>
    <data>z dnia 31 lipca 2025 r.</data>
    <tytul>w sprawie maksymalnych opłat za usunięcie i przechowywanie statków lub innych obiektów pływających na rok 2026</tytul>
    <nie-ztp-artykul brak-eid="jednostka-nieoznaczona" gd:GUID="8b49ba4b-6f53-40d2-852f-877d2d6cf17f">
      <nr />
      <p>
        <zdanie nr="1" gd:zdGUID="800217e7-f255-4fd1-9373-b71ae564c516" fragment="1" gd:fragmentGUID="3c7caf72-4c2e-4732-8e6f-ad0e13ea9a6c">Na podstawie art. 31 ust. 4 ustawy z dnia 18 sierpnia 2011 r. o bezpieczeństwie osób przebywających na obszarach wodnych (Dz. U. z 2023 r. poz. 714) ogłasza się maksymalną wysokość opłat obowiązujących w 2026 r., określonych w art. 31 ust. 2 tej ustawy, w przypadku:</zdanie>
      </p>
      <nie-ztp-punkt eId="MP/2025/727__pkt_1" gd:GUID="4316ae99-154e-4bd7-b7c9-fdb38fece9b7">
        <nr>1</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="800217e7-f255-4fd1-9373-b71ae564c516" fragment="2" gd:fragmentGUID="8a18a5f6-1a91-4f95-85b9-1b84e913193c">usunięcia roweru wodnego lub skutera wodnego – 91 zł oraz za każdą dobę jego przechowywania – 33 zł;</zdanie>
        </p>
      </nie-ztp-punkt>
      <nie-ztp-punkt eId="MP/2025/727__pkt_2" gd:GUID="bbaa542e-f8d7-49bf-a1a0-f25d48f5a4a8">
        <nr>2</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="800217e7-f255-4fd1-9373-b71ae564c516" fragment="3" gd:fragmentGUID="9992cb22-6c99-461d-900a-3218449ad192">usunięcia poduszkowca – 170 zł oraz za każdą dobę jego przechowywania – 58 zł;</zdanie>
        </p>
      </nie-ztp-punkt>
      <nie-ztp-punkt eId="MP/2025/727__pkt_3" gd:GUID="26bbe80e-f287-4e0d-a82a-0b39dcd0fc22">
        <nr>3</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="800217e7-f255-4fd1-9373-b71ae564c516" fragment="4" gd:fragmentGUID="78ba458d-ab07-4de1-a395-1593cbff9809">usunięcia statku o długości kadłuba do 10 m – 205 zł oraz za każdą dobę jego przechowywania – 91 zł;</zdanie>
        </p>
      </nie-ztp-punkt>
      <nie-ztp-punkt eId="MP/2025/727__pkt_4" gd:GUID="7cbf02e4-1b64-49d5-801c-05d8495d38ad">
        <nr>4</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="800217e7-f255-4fd1-9373-b71ae564c516" fragment="5" gd:fragmentGUID="90025a2a-dbde-476b-adc0-7a576a64bf85">usunięcia statku o długości kadłuba do 20 m – 251 zł oraz za każdą dobę jego przechowywania – 170 zł;</zdanie>
        </p>
      </nie-ztp-punkt>
      <nie-ztp-punkt eId="MP/2025/727__pkt_5" gd:GUID="ba5353d0-4026-471f-9e54-7ebb39525eee">
        <nr>5</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="800217e7-f255-4fd1-9373-b71ae564c516" fragment="6" gd:fragmentGUID="8a01d258-eafa-42d0-b41a-b7bfa8afcf41">usunięcia statku o długości kadłuba powyżej 20 m – 332 zł oraz za każdą dobę jego przechowywania – 251 zł.</zdanie>
        </p>
      </nie-ztp-punkt>
    </nie-ztp-artykul>
