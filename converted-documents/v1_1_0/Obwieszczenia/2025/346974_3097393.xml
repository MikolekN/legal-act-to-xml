            </p>
          </punkt>
          <punkt eId="DU/2025/1594__art_7__pkt_3" gd:GUID="d81fe393-fd61-4cdd-927e-08617dcdd16a">
            <nr>3</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="5fab1bbc-ec3e-4a10-a066-0829c4f1fed8" fragment="4" gd:fragmentGUID="18ab8742-68fa-4711-92cc-9e517e443687">numer PESEL;</zdanie>
            </p>
          </punkt>
          <punkt eId="DU/2025/1594__art_7__pkt_4" gd:GUID="b9e55245-fca2-48c9-8f0a-65fd198ececc">
            <nr>4</nr>
            <p>
