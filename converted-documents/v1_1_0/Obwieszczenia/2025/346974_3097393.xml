            <zdanie nr="1" gd:zdGUID="5fab1bbc-ec3e-4a10-a066-0829c4f1fed8" fragment="1" gd:fragmentGUID="4a157c26-41f1-417a-b195-dd87f59b11c7">Legitymacja zawiera następujące informacje:</zdanie>
          </p>
          <punkt eId="DU/2025/1594__art_7__pkt_1" gd:GUID="a5e15d72-8c55-4f02-8c63-9152efff317b">
            <nr>1</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="5fab1bbc-ec3e-4a10-a066-0829c4f1fed8" fragment="2" gd:fragmentGUID="701f0e60-05a6-4cd4-a8be-86e00d5bd8fd">numer legitymacji;</zdanie>
            </p>
          </punkt>
          <punkt eId="DU/2025/1594__art_7__pkt_2" gd:GUID="1766fd8d-e870-4853-acfa-19525a62ad63">
            <nr>2</nr>
            <p>
