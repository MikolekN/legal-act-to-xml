    <rodzaj-aktu>Obwieszczenie</rodzaj-aktu>
    <autor-aktu>Ministra Infrastruktury<odnosnik id-odnosnika="1" symbol="1" gd:GUID="dc4e2bfd-a397-4014-9365-b07d65c5477b"><p><zdanie nr="1" gd:zdGUID="94ba228a-3d9a-4996-a429-46631d3471ef" fragment="1" gd:fragmentGUID="8cf016e6-ff87-4a04-a021-b33090e1363b">Minister Infrastruktury kieruje działem administracji rządowej – transport, na podstawie § 1 ust. 2 pkt 3 rozporządzenia Prezesa Rady Ministrów z dnia 18 grudnia 2023 r. w sprawie szczegółowego zakresu działania Ministra Infrastruktury (Dz. U. poz. 2725).</zdanie></p></odnosnik></autor-aktu>
    <data>z dnia 28 października 2025 r.</data>
    <tytul>w sprawie wysokości stawek opłat za wydanie decyzji o profesjonalnej rejestracji pojazdów, blankietu profesjonalnego dowodu rejestracyjnego, profesjonalnych tablic rejestracyjnych oraz znaku legalizacyjnego obowiązujących od dnia 1 stycznia 2026 r.</tytul>
    <podstawa-prawna>Na podstawie art. 80zd ust. 3 ustawy z dnia 20 czerwca 1997 r. – Prawo o ruchu drogowym (Dz. U. z 2024 r. poz. 1251 oraz z 2025 r. poz. 820 i 1006) ogłasza się, co następuje:</podstawa-prawna>
    <paragraf eId="MP/2025/1131__art_1" gd:GUID="189d8fe4-0f12-444a-9ebf-7373d2b6a711">
      <nr>1</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="82646da3-b9ee-423a-9d8e-96abb44f6b36">
        <p>
          <zdanie nr="1" gd:zdGUID="1bf8549f-43c3-4101-9edf-f476beeeba37" fragment="1" gd:fragmentGUID="3b2ebc04-1df7-4001-8a54-bf6561e3936f">Od dnia 1 stycznia 2026 r. stawka opłaty za wydanie:</zdanie>
        </p>
        <punkt eId="MP/2025/1131__art_1__pkt_1" gd:GUID="eb35a61e-39a3-4235-956e-17eab1c112a8">
          <nr>1</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="1bf8549f-43c3-4101-9edf-f476beeeba37" fragment="2" gd:fragmentGUID="d8806dce-396e-4a28-ba85-76d01985d985">decyzji o profesjonalnej rejestracji pojazdów nie może przekroczyć 147 zł;</zdanie>
          </p>
        </punkt>
        <punkt eId="MP/2025/1131__art_1__pkt_2" gd:GUID="db177bd9-9ea4-4787-95f1-1ffd8ff7b646">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="1bf8549f-43c3-4101-9edf-f476beeeba37" fragment="3" gd:fragmentGUID="5477be6a-7118-4290-acd4-84ae6f8b4f20">blankietu profesjonalnego dowodu rejestracyjnego nie może przekroczyć 29,50 zł;</zdanie>
          </p>
        </punkt>
        <punkt eId="MP/2025/1131__art_1__pkt_3" gd:GUID="63127d7d-e1c0-4390-885b-1381b1f4743f">
          <nr>3</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="1bf8549f-43c3-4101-9edf-f476beeeba37" fragment="4" gd:fragmentGUID="23e3d895-571b-49f4-87f3-38bc7ad005d3">profesjonalnych tablic rejestracyjnych nie może przekroczyć:</zdanie>
          </p>
          <litera eId="MP/2025/1131__art_1__pkt_3__lit_a" gd:GUID="a7ff1c0d-a6c0-4ede-98c2-48cf2cca6d3d">
            <nr>a</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="1bf8549f-43c3-4101-9edf-f476beeeba37" fragment="5" gd:fragmentGUID="5df3b4a2-690c-4e25-8273-11c3c5459b3d">118 zł za komplet profesjonalnych tablic samochodowych,</zdanie>
            </p>
          </litera>
          <litera eId="MP/2025/1131__art_1__pkt_3__lit_b" gd:GUID="44e80692-3a1b-4659-a172-eaf3597a515a">
            <nr>b</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="1bf8549f-43c3-4101-9edf-f476beeeba37" fragment="6" gd:fragmentGUID="07b55938-198a-4bad-9584-dae0f798fe28">59 zł za profesjonalną tablicę motocyklową,</zdanie>
            </p>
          </litera>
          <litera eId="MP/2025/1131__art_1__pkt_3__lit_c" gd:GUID="97b9a5b5-c22b-4695-b7dc-0a792bd1889c">
            <nr>c</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="1bf8549f-43c3-4101-9edf-f476beeeba37" fragment="7" gd:fragmentGUID="ff652250-1fb3-4b5d-9ba6-5d1c54dd5187">44,50 zł za profesjonalną tablicę motorowerową;</zdanie>
            </p>
          </litera>
        </punkt>
        <punkt eId="MP/2025/1131__art_1__pkt_4" gd:GUID="208ed0fd-c391-4116-b6c4-51ed67e41612">
          <nr>4</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="1bf8549f-43c3-4101-9edf-f476beeeba37" fragment="8" gd:fragmentGUID="7a40c165-6962-442e-b8ef-5b8f18bc8a56">znaku legalizacyjnego nie może przekroczyć 22,50 zł.</zdanie>
          </p>
        </punkt>
      </ustep-n>
    </paragraf>
    <paragraf eId="MP/2025/1131__art_2" gd:GUID="aa1e044c-8da3-47be-a611-28f27851d0d9">
      <nr>2</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="8c889860-16c6-452b-b447-13891441fde6">
        <p>
          <zdanie nr="1" gd:zdGUID="323d4b67-917a-46d9-842f-f1f6e867dfbc" fragment="1" gd:fragmentGUID="cbb651c3-96f3-462b-aa36-fd5ad1599059">Od dnia 1 stycznia 2026 r. stawka opłaty za wydanie:</zdanie>
        </p>
        <punkt eId="MP/2025/1131__art_2__pkt_1" gd:GUID="450ed94a-e057-41f1-88b0-ef6ba3b93326">
          <nr>1</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="323d4b67-917a-46d9-842f-f1f6e867dfbc" fragment="2" gd:fragmentGUID="83973fcc-6cba-493c-9a18-8bbdc552ee24">blankietu profesjonalnego dowodu rejestracyjnego wynosi 15 zł;</zdanie>
          </p>
        </punkt>
        <punkt eId="MP/2025/1131__art_2__pkt_2" gd:GUID="c6fa82e7-0d5c-422d-a8dc-6bd0c564cb93">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="323d4b67-917a-46d9-842f-f1f6e867dfbc" fragment="3" gd:fragmentGUID="0746f397-0cb3-4c4d-b03d-b8df3de0d658">znaku legalizacyjnego wynosi 18,50 zł.</zdanie>
          </p>
        </punkt>
      </ustep-n>
    </paragraf>
    <organ-podpisujacy>Minister Infrastruktury: wz. <i><osoba podpisujacy="true" gd:osobaGUID="f9eece81-8853-4fc0-80c3-5a488f78b417"><imie>S.</imie> <nazwisko>Bukowiec</nazwisko></osoba></i></organ-podpisujacy>
