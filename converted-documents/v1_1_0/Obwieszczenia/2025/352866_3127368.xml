    <rodzaj-aktu>Obwieszczenie</rodzaj-aktu>
    <autor-aktu>Ministra Finansów i Gospodarki<odnosnik id-odnosnika="1" symbol="1" gd:GUID="b76db90a-58c0-40a2-b381-3d5a16c03b52"><p><zdanie nr="1" gd:zdGUID="e9bbe54e-571e-4449-9c61-ff9dfc6d30a2" fragment="1" gd:fragmentGUID="cfb49267-f9fa-4464-ad76-7e75847a09ea">Minister Finansów i Gospodarki kieruje działem administracji rządowej – finanse publiczne, na podstawie § 1 ust. 2 pkt 3 rozporządzenia Prezesa Rady Ministrów z dnia 25 lipca 2025 r. w sprawie szczegółowego zakresu działania Ministra Finansów i Gospodarki (Dz. U. poz. 997).</zdanie></p></odnosnik></autor-aktu>
    <data>z dnia 10 grudnia 2025 r.</data>
    <tytul>w sprawie ogłoszenia rodzaju bazowej stopy procentowej i marży dla potrzeb cen transferowych w zakresie podatku dochodowego od osób fizycznych i podatku dochodowego od osób prawnych</tytul>
    <nie-ztp-artykul brak-eid="jednostka-nieoznaczona" gd:GUID="9d3e7c22-9a31-4384-8f27-167ff5965597">
      <nr />
      <p>
        <zdanie nr="1" gd:zdGUID="1b979fca-bfbe-4565-8e62-29b0fe404aac" fragment="1" gd:fragmentGUID="4952fd36-ef2a-4f74-9cb2-495cbc1d8a16">Na podstawie art. 23s ust. 4 ustawy z dnia 26 lipca 1991 r. o podatku dochodowym od osób fizycznych (Dz. U. z 2025 r. poz. 163, z późn. zm.<odnosnik id-odnosnika="2" symbol="2" gd:GUID="02f6fbbd-fbb1-46b7-9dba-b2f6ec092a93"><p><zdanie nr="1" gd:zdGUID="8d707bc3-4416-4e5d-a4c6-970c1d44f238" fragment="1" gd:fragmentGUID="ba3ace35-87d9-436c-b213-6e3a8c68538c">Zmiany tekstu jednolitego wymienionej ustawy zostały ogłoszone w Dz. U. z 2025 r. poz. 340, 368, 620, 680, 1022, 1180, 1301, 1302 i 1366.</zdanie></p></odnosnik>) i art. 11g ust. 4 ustawy z dnia 15 lutego 1992 r. o podatku dochodowym od osób prawnych (Dz. U. z 2025 r. poz. 278, z późn. zm.<odnosnik id-odnosnika="3" symbol="3" gd:GUID="505c7334-d365-40db-b426-8bf74e40e4f0"><p><zdanie nr="1" gd:zdGUID="88c0d530-d887-4277-9029-3658b8eaef59" fragment="1" gd:fragmentGUID="0d0292b6-5134-4790-9d65-ac58177c5926">Zmiany tekstu jednolitego wymienionej ustawy zostały ogłoszone w Dz. U. z 2025 r. poz. 340, 620, 680, 1022, 1074, 1218, 1301, 1426, 1657 i 1658.</zdanie></p></odnosnik>) ogłasza się, że od dnia 1 stycznia 2026 r.:</zdanie>
      </p>
      <nie-ztp-punkt eId="MP/2025/1249__pkt_1" gd:GUID="1058bd5a-a1a3-4845-8b38-410e1cc4d01a">
        <nr>1</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="1b979fca-bfbe-4565-8e62-29b0fe404aac" fragment="2" gd:fragmentGUID="160e7808-7fd2-4684-930f-67daaf05d69c">rodzaj bazowej stopy procentowej dla pożyczek:</zdanie>
        </p>
        <nie-ztp-litera eId="MP/2025/1249__pkt_1__lit_a" gd:GUID="9fd9e0ae-86a3-4bae-a7f5-bbf2ecad30a7">
          <nr>a</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="1b979fca-bfbe-4565-8e62-29b0fe404aac" fragment="3" gd:fragmentGUID="0b940c88-c215-4c2a-a6fc-60f5effee142">w złotych – stanowi WIBOR 3M, WIRON 3M Stopa Składana albo POLSTR 3M Stopa Składana,</zdanie>
          </p>
        </nie-ztp-litera>
        <nie-ztp-litera eId="MP/2025/1249__pkt_1__lit_b" gd:GUID="ae9b1121-968f-4fcc-9be5-17f9be0ac3e4">
          <nr>b</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="1b979fca-bfbe-4565-8e62-29b0fe404aac" fragment="4" gd:fragmentGUID="fd21e3c6-5be8-49d2-b9ac-c0561af63441">w dolarach amerykańskich – stanowi 90-day Average SOFR,</zdanie>
          </p>
        </nie-ztp-litera>
        <nie-ztp-litera eId="MP/2025/1249__pkt_1__lit_c" gd:GUID="e10d533e-1975-4b5f-976c-0ab9c777df40">
          <nr>c</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="1b979fca-bfbe-4565-8e62-29b0fe404aac" fragment="5" gd:fragmentGUID="2dad32a5-b561-470c-8b7a-e8dab5d2e450">w euro – stanowi EURIBOR 3M,</zdanie>
          </p>
        </nie-ztp-litera>
        <nie-ztp-litera eId="MP/2025/1249__pkt_1__lit_d" gd:GUID="0da5b76b-1f54-405a-a5a7-94f214afe0a4">
          <nr>d</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="1b979fca-bfbe-4565-8e62-29b0fe404aac" fragment="6" gd:fragmentGUID="8cd90904-8321-4e6a-8936-0ff9c60985d7">we frankach szwajcarskich – stanowi SARON 3 months Compound Rate,</zdanie>
          </p>
        </nie-ztp-litera>
        <nie-ztp-litera eId="MP/2025/1249__pkt_1__lit_e" gd:GUID="1965b3da-396c-431e-9b2b-70dffe540f02">
          <nr>e</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="1b979fca-bfbe-4565-8e62-29b0fe404aac" fragment="7" gd:fragmentGUID="e890fb52-4dbc-4973-b52c-8c3839411b4b">w funtach brytyjskich – stanowi SONIA 3M Compound Rate;</zdanie>
          </p>
        </nie-ztp-litera>
      </nie-ztp-punkt>
      <nie-ztp-punkt eId="MP/2025/1249__pkt_2" gd:GUID="498e4b15-afb6-4016-95b3-868eac1a4916">
        <nr>2</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="1b979fca-bfbe-4565-8e62-29b0fe404aac" fragment="8" gd:fragmentGUID="da404e99-82b9-4115-9d68-9ed09ea7b117">marża:</zdanie>
        </p>
        <nie-ztp-litera eId="MP/2025/1249__pkt_2__lit_a" gd:GUID="0675beb5-20fd-4537-975d-f33e801114fa">
          <nr>a</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="1b979fca-bfbe-4565-8e62-29b0fe404aac" fragment="9" gd:fragmentGUID="fbb7a27c-d2c9-4749-9871-d91d0f49e153">dla pożyczkobiorcy wynosi maksymalnie 2,6 punktu procentowego,</zdanie>
          </p>
        </nie-ztp-litera>
        <nie-ztp-litera eId="MP/2025/1249__pkt_2__lit_b" gd:GUID="0da4522b-6600-4b62-a39d-b3c277d7d5c5">
          <nr>b</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="1b979fca-bfbe-4565-8e62-29b0fe404aac" fragment="10" gd:fragmentGUID="0b89a653-9126-44f6-b246-7f3b850c106a">dla pożyczkodawcy wynosi minimalnie 2,0 punkty procentowe,</zdanie>
          </p>
        </nie-ztp-litera>
        <nie-ztp-litera eId="MP/2025/1249__pkt_2__lit_c" gd:GUID="6ea39005-c23b-4bb1-98db-11237ac7d933">
          <nr>c</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="1b979fca-bfbe-4565-8e62-29b0fe404aac" fragment="11" gd:fragmentGUID="f49f7970-e672-4ebc-922c-ce371c14de37">stanowi sumę wartości bezwzględnej bazowej stopy procentowej i wartości określonej w lit. a albo b, w przypadku gdy wartość bazowej stopy procentowej określonej w pkt 1 jest mniejsza od zera.</zdanie>
          </p>
        </nie-ztp-litera>
      </nie-ztp-punkt>
    </nie-ztp-artykul>
    <organ-podpisujacy>Minister Finansów i Gospodarki: <i><osoba podpisujacy="true" gd:osobaGUID="5b7d2903-9ba2-4a2d-90ba-576c4905f739"><imie>A.</imie> <nazwisko>Domański</nazwisko></osoba></i></organ-podpisujacy>
