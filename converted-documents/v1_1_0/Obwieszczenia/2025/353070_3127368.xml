    <rodzaj-aktu>Obwieszczenie</rodzaj-aktu>
    <autor-aktu>Ministra Finansów i Gospodarki<odnosnik id-odnosnika="1" symbol="1" gd:GUID="2416a9fb-5db4-44d5-8cad-12c36f0d1139"><p><zdanie nr="1" gd:zdGUID="6a1ceaf0-7ece-4940-a946-b598f8ce0048" fragment="1" gd:fragmentGUID="461a1c27-3b3a-468f-ab6a-ff7b421e849e">Minister Finansów i Gospodarki kieruje działem administracji rządowej – finanse publiczne, na podstawie § 1 ust. 2 pkt 3 rozporządzenia Prezesa Rady Ministrów z dnia 25 lipca 2025 r. w sprawie szczegółowego zakresu działania Ministra Finansów i Gospodarki (Dz. U. poz. 997).</zdanie></p></odnosnik></autor-aktu>
    <data>z dnia 10 grudnia 2025 r.</data>
    <tytul>w sprawie ogłoszenia rodzaju bazowej stopy procentowej i marży dla potrzeb cen transferowych w zakresie podatku dochodowego od osób fizycznych i podatku dochodowego od osób prawnych</tytul>
    <nie-ztp-artykul brak-eid="jednostka-nieoznaczona" gd:GUID="5be01074-ff80-436f-b1a3-83b153051e4a">
      <nr />
      <p>
        <zdanie nr="1" gd:zdGUID="60deba48-c7b2-41f6-bf53-aa12d7e6e3fb" fragment="1" gd:fragmentGUID="300ac977-7dc7-4a65-b2e1-bbfee92180a3">Na podstawie art. 23s ust. 4 ustawy z dnia 26 lipca 1991 r. o podatku dochodowym od osób fizycznych (Dz. U. z 2025 r. poz. 163, z późn. zm.<odnosnik id-odnosnika="2" symbol="2" gd:GUID="cee70067-daa4-40cd-a871-756db73e3a3b"><p><zdanie nr="1" gd:zdGUID="2b2b6953-5202-4c34-baa9-aea637cb37c0" fragment="1" gd:fragmentGUID="8498fb88-4f50-43fa-adf4-ce992b57afae">Zmiany tekstu jednolitego wymienionej ustawy zostały ogłoszone w Dz. U. z 2025 r. poz. 340, 368, 620, 680, 1022, 1180, 1301, 1302 i 1366.</zdanie></p></odnosnik>) i art. 11g ust. 4 ustawy z dnia 15 lutego 1992 r. o podatku dochodowym od osób prawnych (Dz. U. z 2025 r. poz. 278, z późn. zm.<odnosnik id-odnosnika="3" symbol="3" gd:GUID="2e2b84a3-6dd1-48bc-b534-8a0b83dbe36c"><p><zdanie nr="1" gd:zdGUID="5e0722a1-b660-42aa-966c-a11284bad2c9" fragment="1" gd:fragmentGUID="82b99597-c997-427e-a875-5aa0f9991e43">Zmiany tekstu jednolitego wymienionej ustawy zostały ogłoszone w Dz. U. z 2025 r. poz. 340, 620, 680, 1022, 1074, 1218, 1301, 1426, 1657 i 1658.</zdanie></p></odnosnik>) ogłasza się, że od dnia 1 stycznia 2026 r.:</zdanie>
      </p>
      <nie-ztp-punkt eId="MP/2025/1249__pkt_1" gd:GUID="b6fa02c7-6899-4e37-9670-0a3426f34ea3">
        <nr>1</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="60deba48-c7b2-41f6-bf53-aa12d7e6e3fb" fragment="2" gd:fragmentGUID="7f6cbeb7-6794-40e9-8271-54f4f946afaf">rodzaj bazowej stopy procentowej dla pożyczek:</zdanie>
        </p>
        <nie-ztp-litera eId="MP/2025/1249__pkt_1__lit_a" gd:GUID="0100fc2f-19a3-41e3-8595-b6c31ea3a438">
          <nr>a</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="60deba48-c7b2-41f6-bf53-aa12d7e6e3fb" fragment="3" gd:fragmentGUID="0c3d82e9-c944-46f4-ab23-25b614fcad08">w złotych – stanowi WIBOR 3M, WIRON 3M Stopa Składana albo POLSTR 3M Stopa Składana,</zdanie>
          </p>
        </nie-ztp-litera>
        <nie-ztp-litera eId="MP/2025/1249__pkt_1__lit_b" gd:GUID="2298cff3-ed01-45f8-b919-2ff32843e6da">
          <nr>b</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="60deba48-c7b2-41f6-bf53-aa12d7e6e3fb" fragment="4" gd:fragmentGUID="5b43e575-b8e5-4243-9aa0-b37d8df8543c">w dolarach amerykańskich – stanowi 90-day Average SOFR,</zdanie>
          </p>
        </nie-ztp-litera>
        <nie-ztp-litera eId="MP/2025/1249__pkt_1__lit_c" gd:GUID="b1bbd196-c368-47c2-8089-584f92874c8d">
          <nr>c</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="60deba48-c7b2-41f6-bf53-aa12d7e6e3fb" fragment="5" gd:fragmentGUID="215b8b62-9ebf-45ef-b6ad-7cf366ff1c4b">w euro – stanowi EURIBOR 3M,</zdanie>
          </p>
        </nie-ztp-litera>
        <nie-ztp-litera eId="MP/2025/1249__pkt_1__lit_d" gd:GUID="8f8a3364-3222-440e-b5cc-5cd1e6854503">
          <nr>d</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="60deba48-c7b2-41f6-bf53-aa12d7e6e3fb" fragment="6" gd:fragmentGUID="d9f1df52-5c7e-4877-8c26-87858cd7099f">we frankach szwajcarskich – stanowi SARON 3 months Compound Rate,</zdanie>
          </p>
        </nie-ztp-litera>
        <nie-ztp-litera eId="MP/2025/1249__pkt_1__lit_e" gd:GUID="e67c312f-8322-477d-a0e4-ca9a13412569">
          <nr>e</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="60deba48-c7b2-41f6-bf53-aa12d7e6e3fb" fragment="7" gd:fragmentGUID="2fd038b1-1d96-42b1-b008-bf6c55b09102">w funtach brytyjskich – stanowi SONIA 3M Compound Rate;</zdanie>
          </p>
        </nie-ztp-litera>
      </nie-ztp-punkt>
      <nie-ztp-punkt eId="MP/2025/1249__pkt_2" gd:GUID="1614c03a-2a09-40b0-8d6f-e7d197366b1e">
        <nr>2</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="60deba48-c7b2-41f6-bf53-aa12d7e6e3fb" fragment="8" gd:fragmentGUID="c0b7d96a-232b-4845-9eb1-498b46020d75">marża:</zdanie>
        </p>
        <nie-ztp-litera eId="MP/2025/1249__pkt_2__lit_a" gd:GUID="3a2dfe74-941d-401b-afa0-2813055634f2">
          <nr>a</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="60deba48-c7b2-41f6-bf53-aa12d7e6e3fb" fragment="9" gd:fragmentGUID="43da47a8-7c70-4952-9e01-d02454a5c7c5">dla pożyczkobiorcy wynosi maksymalnie 2,6 punktu procentowego,</zdanie>
          </p>
        </nie-ztp-litera>
        <nie-ztp-litera eId="MP/2025/1249__pkt_2__lit_b" gd:GUID="96867593-c829-4eca-b5f4-cfed0246b43e">
          <nr>b</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="60deba48-c7b2-41f6-bf53-aa12d7e6e3fb" fragment="10" gd:fragmentGUID="030ed546-3677-4e06-bebf-ab87dc630a39">dla pożyczkodawcy wynosi minimalnie 2,0 punkty procentowe,</zdanie>
          </p>
        </nie-ztp-litera>
        <nie-ztp-litera eId="MP/2025/1249__pkt_2__lit_c" gd:GUID="63f1e7e1-bac6-44a1-b18b-7089b062ec41">
          <nr>c</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="60deba48-c7b2-41f6-bf53-aa12d7e6e3fb" fragment="11" gd:fragmentGUID="b5939abf-7459-425c-bd75-96141a53a031">stanowi sumę wartości bezwzględnej bazowej stopy procentowej i wartości określonej w lit. a albo b, w przypadku gdy wartość bazowej stopy procentowej określonej w pkt 1 jest mniejsza od zera.</zdanie>
          </p>
        </nie-ztp-litera>
      </nie-ztp-punkt>
    </nie-ztp-artykul>
