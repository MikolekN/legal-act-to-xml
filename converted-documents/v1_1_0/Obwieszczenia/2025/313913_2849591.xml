              </p>
            </punkt>
            <punkt eId="MP/2025/275__zal_1__par_2__pkt_2" gd:GUID="65f148db-ad33-46c0-b4bb-7f27575e6f37">
              <nr>2</nr>
              <p>
                <zdanie nr="1" gd:zdGUID="4f941154-2353-4c33-ae5d-acf5aeba3efe" fragment="3" gd:fragmentGUID="507adf29-a5d5-422f-9a8c-f59064ab7086">Departament Dziedzictwa Kulturowego;</zdanie>
