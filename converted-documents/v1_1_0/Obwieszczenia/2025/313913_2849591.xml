        <nr>2</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="00cafde9-9c69-4802-8de7-9e984a223c53" fragment="3" gd:fragmentGUID="894b2d60-457b-40fe-89ec-a99b2d9b1b86">§ 2 zarządzenia nr 89 Prezesa Rady Ministrów z dnia 4 sierpnia 2024 r. zmieniającego zarządzenie w sprawie nadania statutu Ministerstwu Kultury i Dziedzictwa Narodowego (M.P. poz. 724), który stanowi:<tresc-strukt cudzyslowy="oba" gd:GUID="0e423260-2921-4dce-a4ab-f4a354777b58"><paragraf eId="MP/2024/724__art_2" gd:GUID="ab9ba8c9-d270-4768-a667-4a9d1d94153b"><nr>2</nr><ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="c74ff1a9-7d86-4e83-9897-7e027df8b36d"><p><zdanie nr="1" gd:zdGUID="c3f5050d-940a-4b83-b405-5ebc725dc79f" fragment="1" gd:fragmentGUID="23030c73-9006-401c-90f0-3b95c86bdfb8">Zarządzenie wchodzi w życie z dniem następującym po dniu ogłoszenia.</zdanie></p></ustep-n></paragraf></tresc-strukt>;</zdanie>
        </p>
      </podpunkt-OTJ>
      <podpunkt-OTJ eId="MP/2025/275__pkt_2__ppkt_3" gd:GUID="ce68fd3f-bbb6-4e3d-8847-644c2f81aaeb">
        <nr>3</nr>
        <p>
