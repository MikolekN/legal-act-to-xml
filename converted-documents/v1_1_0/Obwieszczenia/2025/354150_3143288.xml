                <td rowspan="2" gd:GUID="4f24a1c2-d738-4bab-a091-5f170e02b073">
                  <tekst-zwykly gd:GUID="859bffaa-7c99-413f-be66-e4f696cffceb">× 1000,</tekst-zwykly>
