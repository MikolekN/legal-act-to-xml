    <artykul eId="art_1" GUID="d5d78344-88f9-4854-8066-bc4fb8937b32" wejscie-w-zycie="2026-01-01">
      <nr>1</nr>
      <ustep-n GUID="c5e44f5b-fa4f-403e-a897-a3041fa693dd" wejscie-w-zycie="2026-01-01">
        <p>
          <zdanie nr="1" GUID="3c3b7c6f-8582-49d1-ad1c-95db631b5f1d" fragment="1" fragmentGUID="816392ca-523b-480c-a252-730e9755bde5" wejscie-w-zycie="2026-01-01">W ustawie z dnia 17 grudnia 1998 r. o emeryturach i rentach z Funduszu Ubezpieczeń Społecznych (Dz. U. z 2024 r. poz. 1631 i 1674 oraz z 2025 r. poz. 718 i 769) wprowadza się następujące zmiany:</zdanie>
        </p>
        <punkt eId="art_1__pkt_1" GUID="cae5cd36-c13a-4e74-b8a8-e070c9e46859" wejscie-w-zycie="2026-01-01">
          <nr>1</nr>
          <p>
            <zdanie nr="1" GUID="3c3b7c6f-8582-49d1-ad1c-95db631b5f1d" fragment="2" fragmentGUID="d0b63f7a-3708-4b63-a855-7fe6e4efea81" wejscie-w-zycie="2026-01-01">w art. 115:</zdanie>
          </p>
          <litera eId="art_1__pkt_1__lit_a" GUID="d477a55e-172c-4c50-b44a-99523e494f2b" wejscie-w-zycie="2026-01-01">
            <nr>a</nr>
            <p>
              <zdanie nr="1" GUID="3c3b7c6f-8582-49d1-ad1c-95db631b5f1d" fragment="3" fragmentGUID="7a33f247-6ce5-428d-81e3-353f7ba50d4f" wejscie-w-zycie="2026-01-01">w ust. 1 wyrazy „ust. 2-4” zastępuje się wyrazami „ust. 2-3a”,<cytat-w-tekscie now:akt="https://eli.gov.pl/eli//2024/1631" cudzyslowy="0" nowGUID="69d61899-87c3-49c8-9556-6ab0825e3be1" element-eId="art_115__ust_1" funkcja="zastap-tekst"><tekst>ust. 2-3a</tekst></cytat-w-tekscie></zdanie>
            </p>
          </litera>
          <litera eId="art_1__pkt_1__lit_b" GUID="1b08daeb-5eb7-4d84-a877-0b23aa258354" wejscie-w-zycie="2026-01-01">
            <nr>b</nr>
            <p>
              <zdanie nr="1" GUID="3c3b7c6f-8582-49d1-ad1c-95db631b5f1d" fragment="4" fragmentGUID="0d07c275-a624-41dd-bd1a-174b3303ead5" wejscie-w-zycie="2026-01-01">po ust. 3 dodaje się ust. 3a w brzmieniu:<cytat-strukt now:akt="https://eli.gov.pl/eli//2024/1631" cudzyslowy="3" nowGUID="e6d2dde0-e2e5-4408-be6d-9695eb109f32" element-eId="art_115__ust_3" funkcja="dodaj-po"><ustep eId="ust_3a" GUID="b99e45ef-bd8f-457a-b862-ecd12b6d429b" wejscie-w-zycie="2026-01-01"><nr>3a</nr><p><zdanie nr="1" GUID="6d04c048-2e56-4c4a-af4f-9ab3b1b86e21" fragment="1" fragmentGUID="7b2b984f-a3de-4e45-803c-33615061ea85" wejscie-w-zycie="2026-01-01">Ustalenie prawa do zasiłku pogrzebowego oraz jego wysokości nie wymaga wydania decyzji, z wyjątkiem przypadków, o których mowa w art. 78 ust. 3 oraz art. 79 ust. 1.</zdanie><zdanie nr="2" GUID="2667f57a-7edf-43da-b048-ba87c4a31549" fragment="1" fragmentGUID="695e08c7-5713-47db-a018-ffe69b178b5b" wejscie-w-zycie="2026-01-01">Przepis art. 114 stosuje się odpowiednio.</zdanie></p></ustep></cytat-strukt>;</zdanie>
            </p>
          </litera>
        </punkt>
        <punkt eId="art_1__pkt_2" GUID="e2078821-853b-463f-bbe0-ee0c9abbe345" wejscie-w-zycie="2026-01-01">
          <nr>2</nr>
          <p>
            <zdanie nr="1" GUID="3c3b7c6f-8582-49d1-ad1c-95db631b5f1d" fragment="5" fragmentGUID="44233a29-170b-4507-b22b-9548a6285c12" wejscie-w-zycie="2026-01-01">w art. 116 po ust. 3 dodaje się ust. 3a w brzmieniu:<cytat-strukt now:akt="https://eli.gov.pl/eli//2024/1631" cudzyslowy="3" nowGUID="a9672b0c-c14f-4f85-a1e9-b76731159665" element-eId="art_116__ust_3" funkcja="dodaj-po"><ustep eId="ust_3a" GUID="5e0a8191-9f6b-4493-ad26-33aa2f151254" wejscie-w-zycie="2026-01-01"><nr>3a</nr><p><zdanie nr="1" GUID="ffa0e48a-0468-420f-a5a9-567517e98002" fragment="1" fragmentGUID="5d290bf0-4528-4f6a-8ed5-0ff2559b2f8d" wejscie-w-zycie="2026-01-01">Wniosek w sprawie przyznania zasiłku pogrzebowego zgłasza się w organie rentowym bezpośrednio lub za pośrednictwem zakładu pogrzebowego.</zdanie></p></ustep></cytat-strukt>;</zdanie>
          </p>
        </punkt>
        <punkt eId="art_1__pkt_3" GUID="71136d64-6e1c-4ad7-822e-9d68d7118686" wejscie-w-zycie="2026-01-01">
          <nr>3</nr>
          <p>
            <zdanie nr="1" GUID="3c3b7c6f-8582-49d1-ad1c-95db631b5f1d" fragment="6" fragmentGUID="adb80b78-8605-4a82-8194-93839bea8781" wejscie-w-zycie="2026-01-01">w art. 118:</zdanie>
          </p>
          <litera eId="art_1__pkt_3__lit_a" GUID="b7ba7f54-0374-4784-81fb-6d4226be6e61" wejscie-w-zycie="2026-01-01">
            <nr>a</nr>
            <p>
              <zdanie nr="1" GUID="3c3b7c6f-8582-49d1-ad1c-95db631b5f1d" fragment="7" fragmentGUID="52285597-14d4-4e0d-a0b4-d6c3c85aa070" wejscie-w-zycie="2026-01-01">ust. 1 otrzymuje brzmienie:<cytat-strukt now:akt="https://eli.gov.pl/eli//2024/1631" cudzyslowy="3" nowGUID="f679f10a-958f-40c3-a3df-5ca9399d8227" element-eId="art_118__ust_1" funkcja="zastap"><ustep eId="ust_1" GUID="f4c10f03-c498-48bf-8ec1-aaefd7e92707" wejscie-w-zycie="2026-01-01"><nr>1</nr><p><zdanie nr="1" GUID="20ff759c-57a1-48c9-bbd9-aa8a8820846b" fragment="1" fragmentGUID="824a04a2-49ac-4fd1-87ad-fca898a62336" wejscie-w-zycie="2026-01-01">Organ rentowy wydaje decyzję w sprawie prawa do świadczenia lub ustalenia jego wysokości po raz pierwszy w ciągu 30 dni od dnia wyjaśnienia ostatniej okoliczności niezbędnej do wydania tej decyzji, z uwzględnieniem ust. 1a-3 oraz art. 120.</zdanie></p></ustep></cytat-strukt>,</zdanie>
            </p>
          </litera>
          <litera eId="art_1__pkt_3__lit_b" GUID="82e404e1-b297-48c5-8147-d1da33b5af33" wejscie-w-zycie="2026-01-01">
            <nr>b</nr>
            <p>
              <zdanie nr="1" GUID="3c3b7c6f-8582-49d1-ad1c-95db631b5f1d" fragment="8" fragmentGUID="492f3c9e-140e-44b8-b7af-bdde817d64c1" wejscie-w-zycie="2026-01-01">po ust. 1a dodaje się ust. 1b w brzmieniu:<cytat-strukt now:akt="https://eli.gov.pl/eli//2024/1631" cudzyslowy="3" nowGUID="9b93bc3c-c0ed-4884-bb8d-0c5c9ab79da8" element-eId="art_118__ust_1a" funkcja="dodaj-po"><ustep eId="ust_1b" GUID="9e6a6c74-ee79-4b36-b7f7-20f6ca09b0c2" wejscie-w-zycie="2026-01-01"><nr>1b</nr><p><zdanie nr="1" GUID="6ea1a817-923d-4753-a868-858ec71023da" fragment="1" fragmentGUID="cad0f11f-4015-493e-a8f8-30919cc4940d" wejscie-w-zycie="2026-01-01">W przypadku gdy ustalenie prawa do zasiłku pogrzebowego oraz jego wysokości wymaga wydania decyzji, decyzja ta jest wydawana w ciągu 14 dni od dnia wyjaśnienia ostatniej okoliczności niezbędnej do wydania tej decyzji.</zdanie></p></ustep></cytat-strukt>,</zdanie>
            </p>
          </litera>
          <litera eId="art_1__pkt_3__lit_c" GUID="817d7fcf-2618-48c3-a024-44a9e75f0d8b" wejscie-w-zycie="2026-01-01">
            <nr>c</nr>
            <p>
              <zdanie nr="1" GUID="3c3b7c6f-8582-49d1-ad1c-95db631b5f1d" fragment="9" fragmentGUID="1b9a1d69-a9c6-4694-87d6-ca3e59915004" wejscie-w-zycie="2026-01-01">ust. 2 otrzymuje brzmienie:<cytat-strukt now:akt="https://eli.gov.pl/eli//2024/1631" cudzyslowy="3" nowGUID="4016a5e6-e4ad-4878-988e-f2bf82eb7d01" element-eId="art_118__ust_2" funkcja="zastap"><ustep eId="ust_2" GUID="cefa9dae-9aa0-4e46-a045-99ee7b817dc5" wejscie-w-zycie="2026-01-01"><nr>2</nr><p><zdanie nr="1" GUID="6a04a380-f95e-4045-8562-6eec1ef66ce7" fragment="1" fragmentGUID="92b11ed0-c061-480a-9187-00d574bf1cbe" wejscie-w-zycie="2026-01-01">Jeżeli w wyniku decyzji zostało ustalone prawo do świadczenia oraz jego wysokość, organ rentowy dokonuje wypłaty świadczenia w terminie określonym w ust. 1, a w przypadku zasiłku pogrzebowego w terminie określonym w ust. 1b.</zdanie></p></ustep></cytat-strukt>;</zdanie>
            </p>
          </litera>
        </punkt>
        <punkt eId="art_1__pkt_4" GUID="a27e8a85-0fbb-43c5-82a4-6f85d98fd802" wejscie-w-zycie="2026-01-01">
          <nr>4</nr>
          <p>
            <zdanie nr="1" GUID="3c3b7c6f-8582-49d1-ad1c-95db631b5f1d" fragment="10" fragmentGUID="9634c44e-d36e-4472-807a-870d5064506e" wejscie-w-zycie="2026-01-01">w art. 129 po ust. 2 dodaje się ust. 2a w brzmieniu:<cytat-strukt now:akt="https://eli.gov.pl/eli//2024/1631" cudzyslowy="3" nowGUID="b59a446b-9f12-4769-88ff-00969d95eec5" element-eId="art_129__ust_2" funkcja="dodaj-po"><ustep eId="ust_2a" GUID="e90ff18b-6a16-4e2d-8b6f-300620be02c4" wejscie-w-zycie="2026-01-01"><nr>2a</nr><p><zdanie nr="1" GUID="1235dd08-e018-4777-907c-501214b93327" fragment="1" fragmentGUID="0065c981-572d-44e5-bd41-08d59f946e0d" wejscie-w-zycie="2026-01-01">W przypadku gdy ustalenie prawa do zasiłku pogrzebowego oraz jego wysokości nie wymaga wydania decyzji, zasiłek ten wypłaca się w ciągu 14 dni od dnia wyjaśnienia ostatniej okoliczności niezbędnej do ustalenia prawa do zasiłku.</zdanie></p></ustep></cytat-strukt>;</zdanie>
          </p>
        </punkt>
        <punkt eId="art_1__pkt_5" GUID="26762f1f-9764-46b5-8cf9-ec77a05e86d2" wejscie-w-zycie="2026-01-01">
          <nr>5</nr>
          <p>
            <zdanie nr="1" GUID="3c3b7c6f-8582-49d1-ad1c-95db631b5f1d" fragment="11" fragmentGUID="a767eee8-917b-4d96-aa2c-0f619c8fa7a7" wejscie-w-zycie="2026-01-01">w art. 130:</zdanie>
          </p>
          <litera eId="art_1__pkt_5__lit_a" GUID="f434e1e9-da8d-486c-b487-4cae1c1ada8e" wejscie-w-zycie="2026-01-01">
            <nr>a</nr>
            <p>
              <zdanie nr="1" GUID="3c3b7c6f-8582-49d1-ad1c-95db631b5f1d" fragment="12" fragmentGUID="6c72d3c5-0f1f-400a-b76e-ee6bafbb9f10" wejscie-w-zycie="2026-01-01">w ust. 2 wyrazy „z uwzględnieniem ust. 3” zastępuje się wyrazami „z uwzględnieniem ust. 2c i 3”,<cytat-w-tekscie now:akt="https://eli.gov.pl/eli//2024/1631" cudzyslowy="0" nowGUID="cbcfeb33-d1c5-4bfb-9466-2b5a8cb4789c" element-eId="art_130__ust_2" funkcja="zastap-tekst"><tekst>z uwzględnieniem ust. 2c i 3</tekst></cytat-w-tekscie></zdanie>
            </p>
          </litera>
          <litera eId="art_1__pkt_5__lit_b" GUID="532543b9-0a95-4463-8b5b-58f1f1aed078" wejscie-w-zycie="2026-01-01">
            <nr>b</nr>
            <p>
              <zdanie nr="1" GUID="3c3b7c6f-8582-49d1-ad1c-95db631b5f1d" fragment="13" fragmentGUID="857eeabb-1814-477b-ba5e-6d08d0b6c77e" wejscie-w-zycie="2026-01-01">po ust. 2b dodaje się ust. 2c w brzmieniu:<cytat-strukt now:akt="https://eli.gov.pl/eli//2024/1631" cudzyslowy="3" nowGUID="1aa69b61-f97a-47c1-b1d6-c440c0a5efff" element-eId="art_130__ust_2b" funkcja="dodaj-po"><ustep eId="ust_2c" GUID="de485c3c-bc86-4054-b82c-ae508a2dc424" wejscie-w-zycie="2026-01-01"><nr>2c</nr><p><zdanie nr="1" GUID="f8e9724f-aa5d-4a40-ad36-23be901f9234" fragment="1" fragmentGUID="e21a9428-5900-497b-be30-ab7d2a3c7b71" wejscie-w-zycie="2026-01-01">Zasiłek pogrzebowy wypłaca się w całości lub w części, zgodnie z wnioskiem, upoważnionemu przez osobę uprawnioną zakładowi pogrzebowemu, o którym mowa w art. 116 ust. 3a, w formie bezgotówkowej na wskazany w upoważnieniu rachunek płatniczy tego zakładu pogrzebowego prowadzony w kraju lub wydany w kraju zakładowi pogrzebowemu instrument płatniczy w rozumieniu ustawy z dnia 19 sierpnia 2011 r. o usługach płatniczych.</zdanie></p></ustep></cytat-strukt>;</zdanie>
            </p>
          </litera>
        </punkt>
        <punkt eId="art_1__pkt_6" GUID="94977484-fde5-41e6-83d4-9400a6b24606" wejscie-w-zycie="2026-01-01">
          <nr>6</nr>
          <p>
            <zdanie nr="1" GUID="3c3b7c6f-8582-49d1-ad1c-95db631b5f1d" fragment="14" fragmentGUID="65f18169-46d4-47b8-8acb-391834e0ebda" wejscie-w-zycie="2026-01-01">w art. 138 po ust. 3 dodaje się ust. 3a w brzmieniu:<cytat-strukt now:akt="https://eli.gov.pl/eli//2024/1631" cudzyslowy="3" nowGUID="91c09298-50ae-43e7-b412-a52ecff23922" element-eId="art_138__ust_3" funkcja="dodaj-po"><ustep eId="ust_3a" GUID="199c2105-69f3-4f95-aacb-0766302c3d55" wejscie-w-zycie="2026-01-01"><nr>3a</nr><p><zdanie nr="1" GUID="a4036ad5-54fc-4eac-b3fb-7dbb0229f19e" fragment="1" fragmentGUID="fd2ea277-f6d5-4298-bbdc-c824318a465e" wejscie-w-zycie="2026-01-01">Za nienależnie pobrane świadczenia w rozumieniu ust. 1 uważa się również zasiłek pogrzebowy wypłacony z przyczyn niezależnych od organu rentowego osobie nieuprawnionej.</zdanie></p></ustep></cytat-strukt>;</zdanie>
          </p>
        </punkt>
        <punkt eId="art_1__pkt_7" GUID="960ddac0-73c0-4be1-8b72-a525b0205926" wejscie-w-zycie="2026-01-01">
          <nr>7</nr>
          <p>
            <zdanie nr="1" GUID="3c3b7c6f-8582-49d1-ad1c-95db631b5f1d" fragment="15" fragmentGUID="442f7345-9ee7-4d79-8718-acfe23b296d7" wejscie-w-zycie="2026-01-01">w art. 144 ust. 1 otrzymuje brzmienie:<cytat-strukt now:akt="https://eli.gov.pl/eli//2024/1631" cudzyslowy="3" nowGUID="03aef10b-4ccd-441e-b1eb-ceed23ec0f5a" element-eId="art_144__ust_1" funkcja="zastap"><ustep eId="ust_1" GUID="1e3e0d52-8a0f-40d6-a3fb-c4d436ecfacf" wejscie-w-zycie="2026-01-01"><nr>1</nr><p><zdanie nr="1" GUID="c2470805-8c75-4c08-b84e-c1376abcc7db" fragment="1" fragmentGUID="e181bc1d-123c-4169-80f5-2c1dd88ac05f" wejscie-w-zycie="2026-01-01">Od osób nieuprawnionych do pobierania świadczeń określonych w ustawie kwoty nienależnie pobranych świadczeń, o których mowa w:</zdanie></p><punkt eId="ust_1__pkt_1" GUID="51afba65-73a8-45d8-aaee-f416a87100e0" wejscie-w-zycie="2026-01-01"><nr>1</nr><p><zdanie nr="1" GUID="c2470805-8c75-4c08-b84e-c1376abcc7db" fragment="2" fragmentGUID="8ab941b2-cf49-4e16-92a3-f4def7ac491b" wejscie-w-zycie="2026-01-01">art. 138 ust. 2 i 3, ustalone prawomocną decyzją organu rentowego,</zdanie></p></punkt><punkt eId="ust_1__pkt_2" GUID="0ddb4074-3ae4-4a07-b788-e884a0d6a14f" wejscie-w-zycie="2026-01-01"><nr>2</nr><p><zdanie nr="1" GUID="c2470805-8c75-4c08-b84e-c1376abcc7db" fragment="3" fragmentGUID="f4242c6d-c107-4fbb-abfb-d5cb96417884" wejscie-w-zycie="2026-01-01">art. 138 ust. 3a</zdanie></p></punkt><czesc-wspolna-punkt GUID="73342888-a3c0-4663-ab17-4d90ae15c5e5" wejscie-w-zycie="2026-01-01"><p><zdanie nr="1" GUID="c2470805-8c75-4c08-b84e-c1376abcc7db" fragment="4" fragmentGUID="150596b6-2868-40a4-adac-9a42a81bce2f" wejscie-w-zycie="2026-01-01">- podlegają potrąceniu z innych świadczeń wypłacanych przez Zakład, a jeżeli prawo do świadczeń nie istnieje, zostało zawieszone bądź dokonanie potrącenia ze świadczenia nie jest możliwe - ściągnięciu w trybie przepisów o postępowaniu egzekucyjnym w administracji lub egzekucji sądowej.</zdanie></p></czesc-wspolna-punkt></ustep></cytat-strukt>.</zdanie>
          </p>
        </punkt>
      </ustep-n>
    </artykul>
    <artykul eId="art_2" GUID="e73cd074-7d20-4d18-b633-c7af1a4a50e2" wejscie-w-zycie="2026-01-01">
      <nr>2</nr>
      <ustep-n GUID="a4619ff7-03e7-4f08-8d4d-ae54766f43e7" wejscie-w-zycie="2026-01-01">
        <p>
