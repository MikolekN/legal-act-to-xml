      <ustep-n GUID="82ed4efb-072b-45d4-b0ff-57cade79696f" wejscie-w-zycie="2025-10-22">
        <p>
          <zdanie nr="1" GUID="e984a132-8262-44ae-8b1f-076cddc0c529" fragment="1" fragmentGUID="55ef0a08-56aa-4ea3-8287-c4f7aca66144" wejscie-w-zycie="2025-10-22">Ustawa wchodzi w życie z dniem następującym po dniu ogłoszenia.</zdanie>
        </p>
      </ustep-n>
    </artykul>
