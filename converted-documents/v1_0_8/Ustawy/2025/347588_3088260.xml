    <artykul eId="art_3" GUID="1a48912e-8d6f-4599-9aac-651b9512af1d" wejscie-w-zycie="2025-11-29">
      <nr>3</nr>
      <ustep-n GUID="7891d373-6899-4c72-9e6f-74c13020ce9b" wejscie-w-zycie="2025-11-29">
