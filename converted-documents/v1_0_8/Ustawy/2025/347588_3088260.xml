        <punkt eId="art_1__pkt_15" GUID="8dd09f4c-e483-44bb-ab7d-c3f40f7d152f" wejscie-w-zycie="2025-11-29">
          <nr>15</nr>
          <p>
            <zdanie nr="1" GUID="83a98362-956d-409f-99fe-4cad8ccce0fc" fragment="33" fragmentGUID="07247c94-54d1-4c84-9d4f-910dd2a4f47e" wejscie-w-zycie="2025-11-29">po rozdziale 4 dodaje się rozdział 4a w brzmieniu:<cytat-w-tekscie now:akt="https://eli.gov.pl/eli//2025/869" cudzyslowy="0" nowGUID="34e754cd-9822-406d-83ad-58a1e7d60c0a" element-eId="UNKNOWN" funkcja="dodaj-po"><tekst>„Rozdział 4a
Przepis karny
podlega grzywnie, karze ograniczenia wolności albo pozbawienia wolności do lat 2.</tekst></cytat-w-tekscie><cytat-strukt now:akt="https://eli.gov.pl/eli//2025/869" cudzyslowy="2" nowGUID="34e754cd-9822-406d-83ad-58a1e7d60c0a" element-eId="UNKNOWN" funkcja="dodaj-po"><artykul eId="art_60a" GUID="1800d5ab-ad4b-4fde-81a1-602f78edcadd" wejscie-w-zycie="2025-11-29"><nr>60a</nr><ustep-n GUID="e541f44a-e449-47bb-b596-64af8e194eca" wejscie-w-zycie="2025-11-29"><p><zdanie nr="1" GUID="65e10a30-ce93-4915-b2d4-e2b7d276fb17" fragment="1" fragmentGUID="807d097b-7ae0-495f-bee1-ab121f90c3a0" wejscie-w-zycie="2025-11-29">Kto bez uprawnienia uzyskuje z Rejestru informację za pośrednictwem usług sieciowych,</zdanie></p></ustep-n></artykul></cytat-strukt>.</zdanie>
          </p>
        </punkt>
      </ustep-n>
    </artykul>
    <artykul eId="art_2" GUID="67362763-4f6b-4dba-9e52-3e40c515a18b" wejscie-w-zycie="2025-11-29">
      <nr>2</nr>
