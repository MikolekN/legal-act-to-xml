          </p>
        </punkt>
        <punkt eId="art_4__pkt_3" GUID="a2dd4bf2-4ceb-4090-a629-bce1db8f743e" wejscie-w-zycie="2025-05-07">
          <nr>3</nr>
          <p>
            <zdanie nr="1" GUID="23247cf8-19fe-4727-a6f1-0a9b5f4857b2" fragment="4" fragmentGUID="0ef5563d-fa89-4821-81a7-95cef3f84aa3" wejscie-w-zycie="2025-05-07">w art. 52 w ust. 7, w art. 59 w ust. 3 w zdaniu pierwszym i w art. 75-77 wyrazy „1 stycznia 2026 r.” zastępuje się wyrazami „1 lipca 2026 r.”;<cytat-w-tekscie now:akt="https://eli.gov.pl/eli//2026/1688" cudzyslowy="0" nowGUID="f1116db9-9590-458b-9d50-bf27ae60869e" element-eId="art_52__ust_7" funkcja="zastap-tekst"><tekst>1 lipca 2026 r.</tekst></cytat-w-tekscie><cytat-w-tekscie now:akt="https://eli.gov.pl/eli//2026/1688" cudzyslowy="0" nowGUID="31598772-f59a-4263-8305-bb5fb781036a" element-eId="art_59__ust_3" funkcja="zastap-tekst"><tekst>1 lipca 2026 r.</tekst></cytat-w-tekscie><cytat-w-tekscie now:akt="https://eli.gov.pl/eli//2026/1688" cudzyslowy="0" nowGUID="d63770bd-ec1b-401e-8b33-36a7d52bde71" element-eId="art_75" element-do-eId="art_77" funkcja="zastap-tekst"><tekst>1 lipca 2026 r.</tekst></cytat-w-tekscie></zdanie>
