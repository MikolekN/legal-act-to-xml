      <ustep-n GUID="e7c55228-ddd5-4102-aca4-36666a742deb" wejscie-w-zycie="2026-01-02">
        <p>
          <zdanie nr="1" GUID="17721cb2-8e6d-4471-aa19-a3b3043d72ea" fragment="1" fragmentGUID="6edf49fe-6d5a-4a4c-89d5-4b87455c8b77" wejscie-w-zycie="2026-01-02">Ustawa wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
      </ustep-n>
    </artykul>
