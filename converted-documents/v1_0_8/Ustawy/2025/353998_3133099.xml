    <artykul eId="art_1" GUID="8eb3dc6d-4614-44f4-880e-e147b29f2b31" wejscie-w-zycie="2026-01-02">
      <nr>1</nr>
      <ustep-n GUID="a761ea54-d09b-41f6-89fd-9706dc46e7d5" wejscie-w-zycie="2026-01-02">
        <p>
          <zdanie nr="1" GUID="242f6c81-d271-483d-8fcf-17d1e7f95916" fragment="1" fragmentGUID="76f914bd-8556-4116-bf67-997f7fab747e" wejscie-w-zycie="2026-01-02">W ustawie z dnia 20 maja 1971 r. - Kodeks wykroczeń (Dz. U. z 2025 r. poz. 734 i 1676) wprowadza się następujące zmiany:</zdanie>
        </p>
        <punkt eId="art_1__pkt_1" GUID="69b06237-2232-40ab-aef3-d7c0f9581928" wejscie-w-zycie="2026-01-02">
          <nr>1</nr>
          <p>
            <zdanie nr="1" GUID="242f6c81-d271-483d-8fcf-17d1e7f95916" fragment="2" fragmentGUID="f502c79d-e7ca-4b5c-853a-858cc261762d" wejscie-w-zycie="2026-01-02">w art. 24 w § 1a po wyrazach „określone w” dodaje się wyrazy „art. 82 § 1-3, 4 i 5,”;</zdanie>
          </p>
        </punkt>
        <punkt eId="art_1__pkt_2" GUID="e5344f26-f9e4-43e4-ba54-a9ff3f2770a9" wejscie-w-zycie="2026-01-02">
          <nr>2</nr>
          <p>
            <zdanie nr="1" GUID="242f6c81-d271-483d-8fcf-17d1e7f95916" fragment="3" fragmentGUID="1bc02501-dfb7-4f64-acf2-705adcbc9bee" wejscie-w-zycie="2026-01-02">w art. 82:</zdanie>
          </p>
          <litera eId="art_1__pkt_2__lit_a" GUID="b6827fa5-e66f-4339-93f7-c53ece34ca09" wejscie-w-zycie="2026-01-02">
            <nr>a</nr>
            <p>
              <zdanie nr="1" GUID="242f6c81-d271-483d-8fcf-17d1e7f95916" fragment="4" fragmentGUID="800056e1-9334-4814-aec5-2369f4e7c4dd" wejscie-w-zycie="2026-01-02">w § 1, 2, 4 i 5 wyrazy „podlega karze aresztu, grzywny albo karze nagany” zastępuje się wyrazami „podlega karze aresztu, ograniczenia wolności albo grzywny”,<cytat-w-tekscie now:akt="https://eli.gov.pl/eli//2025/734" cudzyslowy="0" nowGUID="b6d84538-e046-43d1-8b3d-ca8dd98e1295" element-eId="art_82__par_1" funkcja="zastap-tekst"><tekst>podlega karze aresztu, ograniczenia wolności albo grzywny</tekst></cytat-w-tekscie><cytat-w-tekscie now:akt="https://eli.gov.pl/eli//2025/734" cudzyslowy="0" nowGUID="0c39d241-f652-4b22-9b06-e525066cf940" element-eId="art_82__par_2" funkcja="zastap-tekst"><tekst>podlega karze aresztu, ograniczenia wolności albo grzywny</tekst></cytat-w-tekscie><cytat-w-tekscie now:akt="https://eli.gov.pl/eli//2025/734" cudzyslowy="0" nowGUID="1187f87b-320c-4e05-85a1-fd7867fdf591" element-eId="art_82__par_4" funkcja="zastap-tekst"><tekst>podlega karze aresztu, ograniczenia wolności albo grzywny</tekst></cytat-w-tekscie><cytat-w-tekscie now:akt="https://eli.gov.pl/eli//2025/734" cudzyslowy="0" nowGUID="3faa8264-3f58-4155-8458-10f1b0bdb8d8" element-eId="art_82__par_5" funkcja="zastap-tekst"><tekst>podlega karze aresztu, ograniczenia wolności albo grzywny</tekst></cytat-w-tekscie></zdanie>
            </p>
          </litera>
          <litera eId="art_1__pkt_2__lit_b" GUID="534c6f0f-9571-4a82-ae7f-95179e41dd31" wejscie-w-zycie="2026-01-02">
            <nr>b</nr>
            <p>
              <zdanie nr="1" GUID="242f6c81-d271-483d-8fcf-17d1e7f95916" fragment="5" fragmentGUID="f9d4e8a4-e852-47a4-af43-27b7aaabb047" wejscie-w-zycie="2026-01-02">w § 3 wyrazy „podlega karze aresztu, ograniczenia wolności, grzywny albo karze nagany” zastępuje się wyrazami „podlega karze aresztu, ograniczenia wolności albo grzywny”.<cytat-w-tekscie now:akt="https://eli.gov.pl/eli//2025/734" cudzyslowy="0" nowGUID="a022418c-09df-42f6-969e-63c0e5d79804" element-eId="art_82__par_3" funkcja="zastap-tekst"><tekst>podlega karze aresztu, ograniczenia wolności albo grzywny</tekst></cytat-w-tekscie></zdanie>
            </p>
          </litera>
        </punkt>
      </ustep-n>
    </artykul>
    <artykul eId="art_2" GUID="b83eab5a-7dbd-41df-bce5-de040aa464b4" wejscie-w-zycie="2026-01-02">
      <nr>2</nr>
      <ustep-n GUID="8f6d55bc-91e7-4455-a40a-0dc708378e6e" wejscie-w-zycie="2026-01-02">
        <p>
          <zdanie nr="1" GUID="4aab0758-bbb5-481e-bd2b-63e5a974436a" fragment="1" fragmentGUID="dd6b9904-f530-4bc1-9ba0-f034682fa14e" wejscie-w-zycie="2026-01-02">W ustawie z dnia 24 sierpnia 2001 r. - Kodeks postępowania w sprawach o wykroczenia (Dz. U. z 2025 r. poz. 860, 1178 i 1661) w art. 96 § 1ad otrzymuje brzmienie:<cytat-strukt now:akt="https://eli.gov.pl/eli//2025/860" cudzyslowy="3" nowGUID="a28b9689-9fa4-4457-996b-bd4ccfe3915b" element-eId="art_96__par_1ad" funkcja="zastap"><paragraf-kodeksu eId="par_1ad" GUID="2c5bfcf0-efe8-4764-b76d-327baeb8f903" wejscie-w-zycie="2026-01-02"><nr>1ad</nr><p><zdanie nr="1" GUID="37ec9696-e8aa-4092-a7f0-daef8a0aec68" fragment="1" fragmentGUID="4f802839-e9ec-4630-a129-7bbcb89b3fdf" wejscie-w-zycie="2026-01-02">W postępowaniu mandatowym w sprawach o wykroczenia określone w art. 82 § 1-3, 4 i 5 Kodeksu wykroczeń oraz w rozdziale XI Kodeksu wykroczeń można nałożyć grzywnę w wysokości do 5000 zł, a w przypadku, o którym mowa w art. 9 § 1 Kodeksu wykroczeń - do 6000 zł.</zdanie></p></paragraf-kodeksu></cytat-strukt>.</zdanie>
        </p>
      </ustep-n>
    </artykul>
    <artykul eId="art_3" GUID="3aec117e-1507-4bd4-9cbe-936680585174" wejscie-w-zycie="2026-01-02">
