      <ustep-n GUID="61d55201-d167-4bf9-8c36-aa6c27ee39f9" wejscie-w-zycie="2025-04-01">
        <p>
          <zdanie nr="1" GUID="5a6d3829-9ade-45cd-bba1-0ea1ae9f25a2" fragment="1" fragmentGUID="51574176-8a2a-4d53-9707-bcd1a7aa2d99" wejscie-w-zycie="2025-04-01">W ustawie z dnia 25 czerwca 2010 r. o sporcie (Dz. U. z 2024 r. poz. 1488) w art. 36 w ust. 1 po pkt 1a dodaje się pkt 1b w brzmieniu:<cytat-strukt now:akt="https://eli.gov.pl/eli//2024/1488" cudzyslowy="3" nowGUID="eff3acf2-4b8d-411d-a1e6-5ee3f45fd30d" element-eId="art_36__ust_1__pkt_1a" funkcja="dodaj-po"><punkt eId="pkt_1b" GUID="72839326-6abe-4dd8-979f-1b9cdc536a63" wejscie-w-zycie="2025-04-01"><nr>1b</nr><p><zdanie nr="1" GUID="ca2826ad-a22f-4e76-93a2-2dde68ccceac" fragment="1" fragmentGUID="dcf5510e-8a6a-4d99-bedd-5ae2e3971662" wejscie-w-zycie="2025-04-01">na Igrzyskach Dobrej Woli,</zdanie></p></punkt></cytat-strukt>.</zdanie>
        </p>
      </ustep-n>
    </artykul>
    <artykul eId="art_2" GUID="f886218c-e5ab-4164-b5c8-7fac122ca8fe" wejscie-w-zycie="2025-04-01">
