            <nr>a</nr>
            <p>
              <zdanie nr="1" GUID="f09303d6-3b95-435d-9410-0c785c62d0dd" fragment="10" fragmentGUID="a2ac2e49-2473-4fcf-b995-0228883b98af" wejscie-w-zycie="2025-03-15">pkt 4 otrzymuje brzmienie:<cytat-strukt now:akt="https://eli.gov.pl/eli//2024/1741" cudzyslowy="3" nowGUID="55947dbf-f346-4287-9c25-7a695d4a4714" element-eId="art_30__pkt_4" funkcja="zastap"><punkt eId="pkt_4" GUID="07ba2bb0-9907-42ca-852b-b715ebe4e83a" wejscie-w-zycie="2025-03-15"><nr>4</nr><p><zdanie nr="1" GUID="e811c079-53a8-4087-ae97-5e8871f341bc" fragment="1" fragmentGUID="c25e01d9-f981-4278-b2d6-44f9fa57a8a2" wejscie-w-zycie="2025-03-15">do biologicznej uprawy;</zdanie></p></punkt></cytat-strukt>,</zdanie>
            </p>
          </litera>
          <litera eId="art_1__pkt_4__lit_b" GUID="f9c714bc-4e98-4368-87e3-9f9f221f273f" wejscie-w-zycie="2025-03-15">
            <nr>b</nr>
            <p>
              <zdanie nr="1" GUID="f09303d6-3b95-435d-9410-0c785c62d0dd" fragment="11" fragmentGUID="e264f440-654e-4cf8-9eeb-ffd2d97ecf0e" wejscie-w-zycie="2025-03-15">po pkt 5a dodaje się pkt 5b w brzmieniu:<cytat-strukt now:akt="https://eli.gov.pl/eli//2024/1741" cudzyslowy="3" nowGUID="277d4eb7-b9d9-447f-b565-8311b62317ec" element-eId="art_30__pkt_5a" funkcja="dodaj-po"><punkt eId="pkt_5b" GUID="290447b2-1684-4b98-a5f6-0a7a5cadc267" wejscie-w-zycie="2025-03-15"><nr>5b</nr><p><zdanie nr="1" GUID="2eec100b-138e-4fd5-a8c7-72a4d7625d8b" fragment="1" fragmentGUID="1a8bf009-fee1-49dd-9aa1-4c31b1df1db1" wejscie-w-zycie="2025-03-15">do materiału siewnego kategorii elitarny lub materiału siewnego kategorii kwalifikowany;</zdanie></p></punkt></cytat-strukt>;</zdanie>
            </p>
          </litera>
        </punkt>
        <punkt eId="art_1__pkt_5" GUID="3f43ecd6-e8e5-4b81-92ad-ffaa732130ec" wejscie-w-zycie="2025-03-15">
          <nr>5</nr>
