        <punkt eId="art_1__pkt_1" GUID="404b0277-428a-4a6e-b8a1-3e5bfb9bba74" wejscie-w-zycie="2025-03-15">
          <nr>1</nr>
          <p>
            <zdanie nr="1" GUID="f09303d6-3b95-435d-9410-0c785c62d0dd" fragment="2" fragmentGUID="f1cad8fb-adb5-4232-92cf-726f8685570b" wejscie-w-zycie="2025-03-15">w art. 2:</zdanie>
          </p>
          <litera eId="art_1__pkt_1__lit_a" GUID="0d3d2c88-1c98-4cdd-b0e9-dd8aa1320ab4" wejscie-w-zycie="2025-03-15">
            <nr>a</nr>
            <p>
              <zdanie nr="1" GUID="f09303d6-3b95-435d-9410-0c785c62d0dd" fragment="3" fragmentGUID="fb6ddf95-60a5-4c73-94e1-1cce7987be7b" wejscie-w-zycie="2025-03-15">pkt 14 otrzymuje brzmienie:<cytat-strukt now:akt="https://eli.gov.pl/eli//2024/1741" cudzyslowy="3" nowGUID="b07a47fd-4c19-4bf9-b4ae-24a3cc8fb695" element-eId="art_2__pkt_14" funkcja="zastap"><punkt eId="pkt_14" GUID="b73c6051-1ac3-4a42-b911-35ae36e5231a" wejscie-w-zycie="2025-03-15"><nr>14</nr><p><zdanie nr="1" GUID="b0f529a1-a517-4e0e-8fde-2ce3fd9550a4" fragment="1" fragmentGUID="2cb41b1f-4dbd-4519-b37e-59a32540fba0" wejscie-w-zycie="2025-03-15">kara administracyjna - karę administracyjną, o której mowa w art. 84 i art. 87 ust. 1 akapit pierwszy rozporządzenia 2021/2116;</zdanie></p></punkt></cytat-strukt>,</zdanie>
            </p>
          </litera>
          <litera eId="art_1__pkt_1__lit_b" GUID="b3753630-b01f-4b92-bbff-fdd0b7a65c03" wejscie-w-zycie="2025-03-15">
            <nr>b</nr>
            <p>
