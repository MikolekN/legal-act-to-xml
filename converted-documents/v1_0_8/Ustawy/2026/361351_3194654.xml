    <artykul eId="art_2" GUID="d31a4cd6-b664-43e5-ac4d-18685531ea29" wejscie-w-zycie="2026-03-04">
      <nr>2</nr>
      <ustep-n GUID="3fc143a0-0a2a-422d-bc31-371499b54e59" wejscie-w-zycie="2026-03-04">
        <p>
          <zdanie nr="1" GUID="6a29723c-e5cf-408d-809e-b36e0b54b725" fragment="1" fragmentGUID="f77bd5c1-dea1-4caf-bc43-cc6ec92f35fe" wejscie-w-zycie="2026-03-04">Przepisy art. 8 ust. 3 i 4 oraz art. 10 ust. 5 ustawy zmienianej w art. 1, w brzmieniu nadanym niniejszą ustawą, stosuje się do oświadczeń, o których mowa w art. 8 ust. 1 i art. 10 ust. 1 ustawy zmienianej w art. 1, składanych przez Rzecznika Praw Dziecka od dnia wejścia w życie niniejszej ustawy.</zdanie>
        </p>
      </ustep-n>
    </artykul>
