      <ustep-n GUID="4bd1fe49-ef9d-4cd9-b8fb-5a52c54ee330" wejscie-w-zycie="2026-03-04">
        <p>
          <zdanie nr="1" GUID="b9c8f679-337a-46e9-b4f4-d4403ebacc1b" fragment="1" fragmentGUID="0b146a04-997c-4b18-bcb8-58e7592bda89" wejscie-w-zycie="2026-03-04">W ustawie z dnia 21 sierpnia 1997 r. o ograniczeniu prowadzenia działalności gospodarczej przez osoby pełniące funkcje publiczne (Dz. U. z 2025 r. poz. 499 oraz z 2026 r. poz. 160) wprowadza się następujące zmiany:</zdanie>
        </p>
        <punkt eId="art_1__pkt_1" GUID="b98d5cf9-17ae-47d8-b290-94b5278db43e" wejscie-w-zycie="2026-03-04">
          <nr>1</nr>
          <p>
            <zdanie nr="1" GUID="b9c8f679-337a-46e9-b4f4-d4403ebacc1b" fragment="2" fragmentGUID="88f57355-0a44-42ce-9244-e4015f0be61f" wejscie-w-zycie="2026-03-04">w art. 8:</zdanie>
          </p>
          <litera eId="art_1__pkt_1__lit_a" GUID="4a255723-071f-4574-88f7-a96669d74618" wejscie-w-zycie="2026-03-04">
            <nr>a</nr>
            <p>
              <zdanie nr="1" GUID="b9c8f679-337a-46e9-b4f4-d4403ebacc1b" fragment="3" fragmentGUID="cc5fd377-c8bb-477d-88aa-55f81558d12a" wejscie-w-zycie="2026-03-04">w ust. 3 po wyrazach „Rzecznik Praw Obywatelskich,” dodaje się wyrazy „Rzecznik Praw Dziecka,”,</zdanie>
            </p>
          </litera>
          <litera eId="art_1__pkt_1__lit_b" GUID="0eb5035a-9cb6-40c4-8973-d79910560605" wejscie-w-zycie="2026-03-04">
            <nr>b</nr>
            <p>
              <zdanie nr="1" GUID="b9c8f679-337a-46e9-b4f4-d4403ebacc1b" fragment="4" fragmentGUID="9342b8cd-6271-4f31-a098-9f72153478e8" wejscie-w-zycie="2026-03-04">w ust. 4 po wyrazach „Rzecznika Praw Obywatelskich,” dodaje się wyrazy „Rzecznika Praw Dziecka,”;</zdanie>
            </p>
          </litera>
        </punkt>
        <punkt eId="art_1__pkt_2" GUID="27dedca9-d417-4c0e-9e5d-e8cdfae75e59" wejscie-w-zycie="2026-03-04">
          <nr>2</nr>
          <p>
            <zdanie nr="1" GUID="b9c8f679-337a-46e9-b4f4-d4403ebacc1b" fragment="5" fragmentGUID="b962145a-58b7-4cdf-aa8b-13aedec5791f" wejscie-w-zycie="2026-03-04">w art. 10:</zdanie>
          </p>
          <litera eId="art_1__pkt_2__lit_a" GUID="227ecb85-a8c8-4b75-9181-7febce6ba86c" wejscie-w-zycie="2026-03-04">
            <nr>a</nr>
            <p>
              <zdanie nr="1" GUID="b9c8f679-337a-46e9-b4f4-d4403ebacc1b" fragment="6" fragmentGUID="036a7be7-6863-4846-998a-19eecd04d6c6" wejscie-w-zycie="2026-03-04">w ust. 5 po wyrazach „Rzecznik Praw Obywatelskich,” dodaje się wyrazy „Rzecznik Praw Dziecka,”,</zdanie>
            </p>
          </litera>
          <litera eId="art_1__pkt_2__lit_b" GUID="e949811f-3e64-4bda-ad73-130084a625c1" wejscie-w-zycie="2026-03-04">
            <nr>b</nr>
            <p>
              <zdanie nr="1" GUID="b9c8f679-337a-46e9-b4f4-d4403ebacc1b" fragment="7" fragmentGUID="d909fd4f-a79e-43d3-9fa5-e3e62ebee93c" wejscie-w-zycie="2026-03-04">w ust. 6 w pkt 3 wyrazy „Ministrowi Finansów” zastępuje się wyrazami „ministrowi właściwemu do spraw finansów publicznych”.<cytat-w-tekscie now:akt="https://eli.gov.pl/eli//2025/499" cudzyslowy="0" nowGUID="2ceb26b3-c299-4b44-9ff9-55cf6ce59022" element-eId="art_10__ust_6__pkt_3" funkcja="zastap-tekst"><tekst>ministrowi właściwemu do spraw finansów publicznych</tekst></cytat-w-tekscie></zdanie>
            </p>
          </litera>
        </punkt>
      </ustep-n>
