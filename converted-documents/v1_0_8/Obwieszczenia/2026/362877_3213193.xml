        </p>
      </ustep-n>
    </artykul>
    <artykul eId="art_14" GUID="4f7b1547-abe1-4a36-8c72-15c2ad67d6c1" wejscie-w-zycie="2019-04-18">
      <nr>14</nr>
      <ustep-n GUID="f959a24b-8f43-46bb-9622-f467afa6b59a" wejscie-w-zycie="2019-04-18">
        <p>
          <zdanie nr="1" GUID="1f9b1bbe-0190-4719-ba80-d5dff0dd50b7" fragment="1" fragmentGUID="5ace8b47-5d46-4959-8a13-2c4765ca27b5" wejscie-w-zycie="2019-04-18">Ustawa wchodzi w życie z dniem 18 kwietnia 2019 r., z wyjątkiem art. 9 ust. 3 i art. 13, które wchodzą w życie z dniem 1 stycznia 2019 r.</zdanie>
        </p>
      </ustep-n>
    </artykul>
  </ustawa>
