      <ustep-n GUID="9ecff09a-1e6f-413c-b883-7c56772371b4" wejscie-w-zycie="2018-03-01">
        <p>
          <zdanie nr="1" GUID="d59389f2-2041-4849-8a83-a19468aa8765" fragment="1" fragmentGUID="57c30d4c-bd3e-4817-a91f-d14404325440" wejscie-w-zycie="2018-03-01">Ustawa wchodzi w życie z dniem 1 marca 2018 r.</zdanie>
