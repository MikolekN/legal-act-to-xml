    <artykul eId="art_8" GUID="9e040285-4148-4b6e-b8d6-fb912950748d" wejscie-w-zycie="2004-01-01">
      <nr>8</nr>
      <ustep eId="art_8__ust_1" GUID="497380a7-39c2-4cf6-b53b-c6b1325b5102" wejscie-w-zycie="2004-01-01">
        <nr>1</nr>
        <p>
          <zdanie nr="1" GUID="20b9c5c6-ce78-40d7-94c1-e0967f68f58f" fragment="1" fragmentGUID="30854bdb-a6e5-4ebc-8b3a-d22664bbb2e1" wejscie-w-zycie="2004-01-01">Zadaniem Komisji jest:</zdanie>
        </p>
        <punkt eId="art_8__ust_1__pkt_1" GUID="2596a626-6f76-4d9d-86db-f16dc94c00c0" wejscie-w-zycie="2004-01-01">
          <nr>1</nr>
          <p>
            <zdanie nr="1" GUID="20b9c5c6-ce78-40d7-94c1-e0967f68f58f" fragment="2" fragmentGUID="5ee7315e-2094-4514-b8e6-fb5611855dd6" wejscie-w-zycie="2004-01-01">podejmowanie określonych w odrębnych przepisach działań mających na celu zapewnienie zgodności działalności podmiotów nadzorowanych z przepisami prawa;</zdanie>
          </p>
        </punkt>
        <punkt eId="art_8__ust_1__pkt_2" GUID="fc900cdb-79db-4800-ba14-814ff782f7cf" wejscie-w-zycie="2004-01-01">
          <nr>2</nr>
          <p>
            <zdanie nr="1" GUID="20b9c5c6-ce78-40d7-94c1-e0967f68f58f" fragment="3" fragmentGUID="72d52760-36e1-4d54-b36a-8f5bcbf9babb" wejscie-w-zycie="2004-01-01">kontrola działalności i stanu majątkowego podmiotów nadzorowanych;</zdanie>
          </p>
        </punkt>
        <punkt eId="art_8__ust_1__pkt_3" GUID="9ff460ee-340b-4f14-814d-3dfb70ab2be0" wejscie-w-zycie="2004-01-01">
          <nr>3</nr>
          <p>
            <zdanie nr="1" GUID="20b9c5c6-ce78-40d7-94c1-e0967f68f58f" fragment="4" fragmentGUID="9eff5ca4-6848-4d74-b525-7cf55965bfc0" wejscie-w-zycie="2004-01-01">podejmowanie innych zadań określonych ustawami.</zdanie>
          </p>
        </punkt>
      </ustep>
      <ustep eId="art_8__ust_2" GUID="675e49c9-ecfc-4aa2-a5d3-30f84c327280" wejscie-w-zycie="2004-01-01">
        <nr>2</nr>
        <p>
          <zdanie nr="1" GUID="9f98a50c-2c46-42e5-8160-8fa6fabeb38c" fragment="1" fragmentGUID="c7281ca8-aac7-4ffd-ba6d-9027d6e0728b" wejscie-w-zycie="2004-01-01">Zakres nadzoru i szczegółowe zadania Komisji określają odrębne przepisy.</zdanie>
        </p>
      </ustep>
    </artykul>
    <artykul eId="art_9" GUID="f6dfba70-5ac8-4204-b3e3-616c2c9811ec" wejscie-w-zycie="2004-01-01">
