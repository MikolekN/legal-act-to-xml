    <artykul eId="art_1a" GUID="25525c21-8023-4891-9910-0b26e308ce82" wejscie-w-zycie="2025-03-11">
      <nr>1a</nr>
      <ustep eId="art_1a__ust_1" GUID="eb5d4a01-0083-4ed8-b335-f8f08b737ff8" wejscie-w-zycie="2025-03-11">
        <nr>1</nr>
        <p>
          <zdanie nr="1" GUID="f4d33f77-e575-424e-9632-970f669de6ef" fragment="1" fragmentGUID="8abbae4d-33ed-4686-98dc-7d09e15c43a5" wejscie-w-zycie="2025-03-11">W przypadku ogłoszenia stanu zagrożenia epidemicznego lub stanu epidemii, dniem wolnym od pracy jest także dzień określony przez Prezesa Rady Ministrów, w drodze rozporządzenia.</zdanie>
        </p>
      </ustep>
      <ustep eId="art_1a__ust_2" GUID="38e47465-e9b2-4fad-b9bc-ec6ff64d5717" wejscie-w-zycie="2025-03-11">
        <nr>2</nr>
        <p>
          <zdanie nr="1" GUID="65f90a34-ce3a-4702-8cdf-8e74943ced4d" fragment="1" fragmentGUID="8175188e-a96e-42f6-83be-da95cbe2329c" wejscie-w-zycie="2025-03-11">Wydając rozporządzenie, o którym mowa w ust. 1, Prezes Rady Ministrów uwzględnia zapewnienie bezpieczeństwa zdrowotnego na terytorium Rzeczypospolitej Polskiej.</zdanie>
        </p>
      </ustep>
    </artykul>
    <artykul eId="art_2" GUID="09fde2ea-726e-4bdd-9dcb-030ba46ea6b8" wejscie-w-zycie="2025-03-11">
