      <ustep-n GUID="0f73bcbd-758f-4ba3-b4b2-43fbdfdb41e2" wejscie-w-zycie="2025-03-01">
        <p>
          <zdanie nr="1" GUID="cd8a057d-51ed-485e-a7c7-5fffcf1d1fa0" fragment="1" fragmentGUID="e0042e12-94b4-4fc4-a46a-9ed7257cf028" wejscie-w-zycie="2025-03-01">-29. (pominięte)</zdanie>
        </p>
      </ustep-n>
    </artykul>
    <artykul eId="art_30" GUID="977a0c3c-5278-4359-bfbe-1ff062c27f8c" wejscie-w-zycie="2025-03-01">
      <nr>30</nr>
      <ustep-n GUID="ec49d7b7-6221-4678-bca6-ccf921da955a" wejscie-w-zycie="2025-03-01">
        <p>
          <zdanie nr="1" GUID="f9947464-d777-428b-86e9-5e5638cd71f0" fragment="1" fragmentGUID="89a92baf-78d6-4bbd-894e-718c5df07a62" wejscie-w-zycie="2025-03-01">Ustawa wchodzi w życie pierwszego dnia miesiąca następującego po miesiącu ogłoszenia[4)], z wyjątkiem art. 26 pkt 2, który wchodzi w życie z dniem ogłoszenia.</zdanie>
        </p>
