        <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="2ac4357b-2ff0-44d7-90ab-354d081bb511">
          <p>
            <zdanie nr="1" gd:zdGUID="a436d6b3-4267-4c30-958b-ce5ec11c20c6" fragment="1" gd:fragmentGUID="2a3c70ea-cd7e-4541-a308-5ff39c4ed29b">(pominięty)</zdanie>
          </p>
