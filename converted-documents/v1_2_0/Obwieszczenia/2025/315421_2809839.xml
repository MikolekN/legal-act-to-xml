      <artykul eId="DU/2025/177__art_12" gd:GUID="de6ebb83-25ab-40b0-80b6-0d511cb24d83">
        <nr>12</nr>
        <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="a0b9312c-27c4-40b4-a9db-b63adcdebb01">
          <p>
            <zdanie nr="1" gd:zdGUID="a1fc7c6f-beef-4f80-9681-f3824cfe85f2" fragment="1" gd:fragmentGUID="90bb5949-d827-4992-a903-25649b8caa2b">Ustawa wchodzi w życie po upływie 3 miesięcy od dnia ogłoszenia<odnosnik id-odnosnika="3" symbol="3" gd:GUID="d35a0385-cbf3-4aab-98bc-058b6a5d5997"><p><zdanie nr="1" gd:zdGUID="e878acda-5854-49d7-8883-1a3b332bb903" fragment="1" gd:fragmentGUID="7bd86524-0a0f-47c9-a9e4-afccc3bec9c3">Ustawa została ogłoszona w dniu 9 sierpnia 2002 r.</zdanie></p></odnosnik>.</zdanie>
          </p>
        </ustep-n>
