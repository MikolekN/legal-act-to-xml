    <rodzaj-aktu>Obwieszczenie</rodzaj-aktu>
    <autor-aktu>Ministra Infrastruktury<odnosnik id-odnosnika="1" symbol="1" gd:GUID="add16a17-eb2b-47e4-92e5-82bd1f6a3014"><p><zdanie nr="1" gd:zdGUID="ae76f27c-7117-4b54-a8ff-af628c5f83ed" fragment="1" gd:fragmentGUID="d275f43a-73ff-48da-b239-92c599fbd454">Minister Infrastruktury kieruje działem administracji rządowej – transport, na podstawie § 1 ust. 2 pkt 3 rozporządzenia Prezesa Rady Ministrów z dnia 18 grudnia 2023 r. w sprawie szczegółowego zakresu działania Ministra Infrastruktury (Dz. U. poz. 2725).</zdanie></p></odnosnik></autor-aktu>
    <data>z dnia 28 października 2025 r.</data>
    <tytul>w sprawie wysokości stawek opłat za wydanie decyzji o profesjonalnej rejestracji pojazdów, blankietu profesjonalnego dowodu rejestracyjnego, profesjonalnych tablic rejestracyjnych oraz znaku legalizacyjnego obowiązujących od dnia 1 stycznia 2026 r.</tytul>
    <podstawa-prawna>Na podstawie art. 80zd ust. 3 ustawy z dnia 20 czerwca 1997 r. – Prawo o ruchu drogowym (Dz. U. z 2024 r. poz. 1251 oraz z 2025 r. poz. 820 i 1006) ogłasza się, co następuje:</podstawa-prawna>
    <paragraf eId="MP/2025/1131__art_1" gd:GUID="e109fe53-79cd-4ba2-8c94-f2522e4a8781">
      <nr>1</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="18fd09fe-22a8-45f2-8ffc-996940ca4210">
        <p>
          <zdanie nr="1" gd:zdGUID="698cecab-6572-4e92-b6e8-4e297bb98f2e" fragment="1" gd:fragmentGUID="cb7103c1-84d7-4195-99e4-8ca006aef2da">Od dnia 1 stycznia 2026 r. stawka opłaty za wydanie:</zdanie>
        </p>
        <punkt eId="MP/2025/1131__art_1__pkt_1" gd:GUID="3affce1e-f10b-4ba6-abed-4559156ceebe">
          <nr>1</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="698cecab-6572-4e92-b6e8-4e297bb98f2e" fragment="2" gd:fragmentGUID="9ee9bb5f-7301-4266-8a0e-aaf34f3b07fe">decyzji o profesjonalnej rejestracji pojazdów nie może przekroczyć 147 zł;</zdanie>
          </p>
        </punkt>
        <punkt eId="MP/2025/1131__art_1__pkt_2" gd:GUID="a05bc3d5-4f61-4ca4-a9c7-e78e59199869">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="698cecab-6572-4e92-b6e8-4e297bb98f2e" fragment="3" gd:fragmentGUID="aca239f9-f4bb-4118-baa1-c7567b856acd">blankietu profesjonalnego dowodu rejestracyjnego nie może przekroczyć 29,50 zł;</zdanie>
          </p>
        </punkt>
        <punkt eId="MP/2025/1131__art_1__pkt_3" gd:GUID="b58b95d5-7fd0-4de6-a7e6-858caa32ffda">
          <nr>3</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="698cecab-6572-4e92-b6e8-4e297bb98f2e" fragment="4" gd:fragmentGUID="27f933cf-a3f9-49d7-8a8a-5b617b930848">profesjonalnych tablic rejestracyjnych nie może przekroczyć:</zdanie>
          </p>
          <litera eId="MP/2025/1131__art_1__pkt_3__lit_a" gd:GUID="721e1bd4-49c4-4460-9e5f-eac133b1edcc">
            <nr>a</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="698cecab-6572-4e92-b6e8-4e297bb98f2e" fragment="5" gd:fragmentGUID="1a1453e3-e7dc-465c-ae22-2e4d46339819">118 zł za komplet profesjonalnych tablic samochodowych,</zdanie>
            </p>
          </litera>
          <litera eId="MP/2025/1131__art_1__pkt_3__lit_b" gd:GUID="bfea9a4b-a3dc-4782-826c-cc98c4a0cd93">
            <nr>b</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="698cecab-6572-4e92-b6e8-4e297bb98f2e" fragment="6" gd:fragmentGUID="a10cf99b-e907-4321-a956-f9103ef3d1bc">59 zł za profesjonalną tablicę motocyklową,</zdanie>
            </p>
          </litera>
          <litera eId="MP/2025/1131__art_1__pkt_3__lit_c" gd:GUID="61e90bd4-2834-48f3-80f6-fa82ddf2c51a">
            <nr>c</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="698cecab-6572-4e92-b6e8-4e297bb98f2e" fragment="7" gd:fragmentGUID="33ae8a5c-55aa-48d8-8764-1160b9e1ca0d">44,50 zł za profesjonalną tablicę motorowerową;</zdanie>
            </p>
          </litera>
        </punkt>
        <punkt eId="MP/2025/1131__art_1__pkt_4" gd:GUID="eebbcede-a81d-41ad-aee5-59b609118354">
          <nr>4</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="698cecab-6572-4e92-b6e8-4e297bb98f2e" fragment="8" gd:fragmentGUID="e0fe1752-867b-4bd4-aaa0-824ff9be27eb">znaku legalizacyjnego nie może przekroczyć 22,50 zł.</zdanie>
          </p>
        </punkt>
      </ustep-n>
    </paragraf>
    <paragraf eId="MP/2025/1131__art_2" gd:GUID="5b4a71d3-0b1f-42d5-99e7-70f71f752e4f">
      <nr>2</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="ad4874d3-4687-4e6c-9c1e-e7ef30f69f6c">
        <p>
          <zdanie nr="1" gd:zdGUID="5a6ef258-e387-49ec-803d-1e6d789b963d" fragment="1" gd:fragmentGUID="903aa7bd-6644-48ac-81fa-3926920df209">Od dnia 1 stycznia 2026 r. stawka opłaty za wydanie:</zdanie>
        </p>
        <punkt eId="MP/2025/1131__art_2__pkt_1" gd:GUID="a8702395-6bac-4e9a-aa2c-e309e0646361">
          <nr>1</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="5a6ef258-e387-49ec-803d-1e6d789b963d" fragment="2" gd:fragmentGUID="f38e3086-8708-4281-ac8b-5a43ad0a72b7">blankietu profesjonalnego dowodu rejestracyjnego wynosi 15 zł;</zdanie>
          </p>
        </punkt>
        <punkt eId="MP/2025/1131__art_2__pkt_2" gd:GUID="09222549-f7e1-40ca-9c67-33ecc6a20d7b">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="5a6ef258-e387-49ec-803d-1e6d789b963d" fragment="3" gd:fragmentGUID="e102bfc9-39ce-4e2d-9119-b0b85b840d0a">znaku legalizacyjnego wynosi 18,50 zł.</zdanie>
          </p>
        </punkt>
      </ustep-n>
    </paragraf>
