          <nr>2</nr>
          <p>(oznaczenie rozdziału 2 i tytuł – uchylone)</p>
        </naglowek-rozdzialu>
        <oddzial-n brak-eid="jednostka-nieoznaczona" gd:GUID="8a926268-dd1e-4448-bdf8-1a84e827b8ff" />
