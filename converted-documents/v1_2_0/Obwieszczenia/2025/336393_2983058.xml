    <rodzaj-aktu>Obwieszczenie</rodzaj-aktu>
    <autor-aktu>Ministra Finansów i Gospodarki<odnosnik id-odnosnika="1" symbol="1" gd:GUID="1d8cfbb0-9345-4fe7-a3cc-37fb0dcb0f96"><p><zdanie nr="1" gd:zdGUID="76f6f79d-5086-496f-a7ce-5a0c3575eba1" fragment="1" gd:fragmentGUID="698377b5-bab4-4eaa-8461-3c64bc620e4c">Minister Finansów i Gospodarki kieruje działem administracji rządowej – finanse publiczne, na podstawie § 1 ust. 2 pkt 3 rozporządzenia Prezesa Rady Ministrów z dnia 25 lipca 2025 r. w sprawie szczegółowego zakresu działania Ministra Finansów i Gospodarki (Dz. U. poz. 997).</zdanie></p></odnosnik></autor-aktu>
    <data>z dnia 31 lipca 2025 r.</data>
    <tytul>w sprawie maksymalnych opłat za usunięcie i przechowywanie statków lub innych obiektów pływających na rok 2026</tytul>
    <nie-ztp-artykul brak-eid="jednostka-nieoznaczona" gd:GUID="de0bf1e8-e702-4c07-8df8-a31ce51f627d">
      <nr />
      <p>
        <zdanie nr="1" gd:zdGUID="64f5b1f2-6bab-4fa8-9cbf-a760de2906d1" fragment="1" gd:fragmentGUID="80aed9fa-123f-4fbc-8ccb-053edc99e059">Na podstawie art. 31 ust. 4 ustawy z dnia 18 sierpnia 2011 r. o bezpieczeństwie osób przebywających na obszarach wodnych (Dz. U. z 2023 r. poz. 714) ogłasza się maksymalną wysokość opłat obowiązujących w 2026 r., określonych w art. 31 ust. 2 tej ustawy, w przypadku:</zdanie>
      </p>
      <nie-ztp-punkt eId="MP/2025/727__pkt_1" gd:GUID="3b2f142f-dbbc-461d-a7fd-c9a3922124ae">
        <nr>1</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="64f5b1f2-6bab-4fa8-9cbf-a760de2906d1" fragment="2" gd:fragmentGUID="86452bb9-195a-42c1-805d-6c2c3b761c8c">usunięcia roweru wodnego lub skutera wodnego – 91 zł oraz za każdą dobę jego przechowywania – 33 zł;</zdanie>
        </p>
      </nie-ztp-punkt>
      <nie-ztp-punkt eId="MP/2025/727__pkt_2" gd:GUID="aea21e22-58aa-4475-aa01-20e0099c9722">
        <nr>2</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="64f5b1f2-6bab-4fa8-9cbf-a760de2906d1" fragment="3" gd:fragmentGUID="3b7e5b3d-aa3d-4f7c-9cc2-99c02cf73a7a">usunięcia poduszkowca – 170 zł oraz za każdą dobę jego przechowywania – 58 zł;</zdanie>
        </p>
      </nie-ztp-punkt>
      <nie-ztp-punkt eId="MP/2025/727__pkt_3" gd:GUID="b276aeb9-499d-4447-91a6-3a6535b92e65">
        <nr>3</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="64f5b1f2-6bab-4fa8-9cbf-a760de2906d1" fragment="4" gd:fragmentGUID="0c87b20a-f98b-4bec-91d1-3623ed2c9d2a">usunięcia statku o długości kadłuba do 10 m – 205 zł oraz za każdą dobę jego przechowywania – 91 zł;</zdanie>
        </p>
      </nie-ztp-punkt>
      <nie-ztp-punkt eId="MP/2025/727__pkt_4" gd:GUID="7b58eba2-2f89-495d-8827-5ee72a048d4a">
        <nr>4</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="64f5b1f2-6bab-4fa8-9cbf-a760de2906d1" fragment="5" gd:fragmentGUID="6b0b2968-8ce3-4e98-bb23-1fbf4fddfdac">usunięcia statku o długości kadłuba do 20 m – 251 zł oraz za każdą dobę jego przechowywania – 170 zł;</zdanie>
        </p>
      </nie-ztp-punkt>
      <nie-ztp-punkt eId="MP/2025/727__pkt_5" gd:GUID="29b8e670-cfdb-41ad-973a-1f8eb1e82990">
        <nr>5</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="64f5b1f2-6bab-4fa8-9cbf-a760de2906d1" fragment="6" gd:fragmentGUID="8d0f048f-a122-400d-b7dd-f8fef3bef3c1">usunięcia statku o długości kadłuba powyżej 20 m – 332 zł oraz za każdą dobę jego przechowywania – 251 zł.</zdanie>
        </p>
      </nie-ztp-punkt>
    </nie-ztp-artykul>
