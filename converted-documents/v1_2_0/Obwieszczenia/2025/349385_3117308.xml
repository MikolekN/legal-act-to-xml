          <nr>1</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="dc841b79-8dae-4aaf-a08f-fedabfe7f666" fragment="1" gd:fragmentGUID="d7b5d3df-e100-453b-972b-948c942d6987">Wniosek o dokonanie zmiany w świadectwie zdolności żeglugowej powinien zawierać:</zdanie>
          </p>
          <punkt eId="DU/2025/1727__art_7__ust_1__pkt_1" gd:GUID="e9254ab4-28c4-4302-9d2b-0cfb47d480af">
            <nr>1</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="dc841b79-8dae-4aaf-a08f-fedabfe7f666" fragment="2" gd:fragmentGUID="7ecfcf2a-cd01-40d8-86d5-92e719d1bac2">nazwę statku lub numer identyfikacyjny;</zdanie>
            </p>
          </punkt>
          <punkt eId="DU/2025/1727__art_7__ust_1__pkt_2" gd:GUID="0c07cb14-a9f7-4a24-b451-bd63436fb8a7">
            <nr>2</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="dc841b79-8dae-4aaf-a08f-fedabfe7f666" fragment="3" gd:fragmentGUID="62adc494-ef37-404f-ab73-78f774ef747e">rodzaj statku;</zdanie>
            </p>
          </punkt>
          <punkt eId="DU/2025/1727__art_7__ust_1__pkt_3" gd:GUID="a8c3cc1c-b5ee-4835-85a9-e9bc45318d79">
            <nr>3</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="dc841b79-8dae-4aaf-a08f-fedabfe7f666" fragment="4" gd:fragmentGUID="0809091e-0d30-472f-aa9e-369c880a6c22">nazwę i adres armatora;</zdanie>
