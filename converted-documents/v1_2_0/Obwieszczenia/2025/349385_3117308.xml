              <zdanie nr="1" gd:zdGUID="8eb4d1da-4250-491d-bcf9-2f1917c3afed" fragment="5" gd:fragmentGUID="2defb296-1d2a-49ef-9054-31981b509bed">miejsce rejestracji i numer rejestracyjny statku.</zdanie>
            </p>
          </punkt>
        </ustep>
        <ustep eId="DU/2025/1727__art_6__ust_2" gd:GUID="abd85ded-703e-4f30-92c3-bf09b5ee5596">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="0a69ccd1-545f-4bdd-bd52-5d87f23b994a" fragment="1" gd:fragmentGUID="9a77b542-2fbc-48e3-b766-9f9ade0aa0bb">Do wniosku załącza się świadectwo zdolności żeglugowej oraz dokumenty, o których mowa w art. 34k ust. 1 ustawy.</zdanie>
          </p>
        </ustep>
      </paragraf>
      <paragraf eId="DU/2025/1727__art_7" gd:GUID="ad720371-6abe-4ee5-9933-727bc0c06e3d">
