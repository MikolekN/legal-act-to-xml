        <tekst-zwykly gd:GUID="59d75f38-f861-4aca-92db-08290a79d43a">j) powiat sokólski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="583a59b7-69b8-469d-9df5-00f39254ceda">k) powiat suwalski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="387747f5-4758-4613-8435-0e6acd2e74e2">l) miasto na prawach powiatu Suwałki,</tekst-zwykly>
