        <tekst-zwykly gd:GUID="c9781205-e886-431d-afdd-0ba21b797466">j) powiat pułtuski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="b66ff909-18c7-493f-aae9-1316d588abc9">k) powiat sierpecki,</tekst-zwykly>
