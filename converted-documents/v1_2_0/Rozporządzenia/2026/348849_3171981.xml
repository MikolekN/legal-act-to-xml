          <nr>4</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="05cfcd27-c34e-4688-b25e-ea098940d9be" fragment="5" gd:fragmentGUID="82ce1193-b65d-4209-bd79-def834587699" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-01_DU-2026-83_domyslne.x" wejscie-w-zycie="2026-02-01">w § 8 ust. 1 otrzymuje brzmienie:<cytat-strukt now:akt="https://eli.gov.pl/eli/DU/2018/1548" cudzyslowy="oba" gd:nowGUID="abec80a8-16c7-4d26-b6d7-4e6e06aa3ad5" element-eId="DU/2018/1548__art_8__ust_1" funkcja="zastap"><ustep eId="DU/2018/1548__art_8__ust_1" gd:GUID="0c1f4b5c-4509-485b-b0c2-35967fd6aba5" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-01_DU-2026-83_domyslne.x" wejscie-w-zycie="2026-02-01"><nr>1</nr><p><zdanie nr="1" gd:zdGUID="d73791fb-9c49-472d-a2ab-0aa05e174fa2" fragment="1" gd:fragmentGUID="b923c276-2e79-44d9-a0d6-bd76125af9c8" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-01_DU-2026-83_domyslne.x" wejscie-w-zycie="2026-02-01">Zwrot kosztów, o których mowa w art. 77 § 6 pkt 2 i 6 ustawy, następuje raz w miesiącu z dołu w terminie 14 dni od dnia złożenia kierownikowi jednostki wykazu odbytych przejazdów lub dojazdów oraz oświadczenia o wysokości poniesionych kosztów, z zastrzeżeniem ust. 2.</zdanie></p></ustep></cytat-strukt>;</zdanie>
          </p>
        </punkt>
        <punkt eId="DU/2026/83__art_1__pkt_5" gd:GUID="e7612235-7448-41c3-92ef-b8da41509654" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-01_DU-2026-83_domyslne.x" wejscie-w-zycie="2026-02-01">
