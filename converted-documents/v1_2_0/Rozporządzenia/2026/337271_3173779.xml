        <p>
          <zdanie nr="1" gd:zdGUID="a6d2f834-1599-47c3-8d6e-b93505614a96" fragment="1" gd:fragmentGUID="570fc80b-72a2-48e1-aa74-bcab55dcf374" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-12_DU-2026-92_domyslne.x" wejscie-w-zycie="2026-02-12">Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
