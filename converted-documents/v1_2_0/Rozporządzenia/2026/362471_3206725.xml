    <paragraf eId="DU/2026/231__art_1" gd:GUID="2f596e8e-1b79-4a9b-8b31-40b51c703177" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-28_DU-2026-231_domyslne.x" wejscie-w-zycie="2026-03-28">
