        <p>
          <zdanie nr="1" gd:zdGUID="8d129207-fc1f-46a5-9827-696c80ac2090" fragment="1" gd:fragmentGUID="b93b594f-5f4d-4874-a89c-0d204b7d53b0" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-17_DU-2026-117_domyslne.x" wejscie-w-zycie="2026-02-17">Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
