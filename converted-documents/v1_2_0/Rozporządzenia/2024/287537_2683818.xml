        <punkt eId="DU/2024/1456__art_1__pkt_11" gd:GUID="a43fe81d-666f-49cf-9726-63c95b7b201f" okres="okr_obowiazywanie.zdarz_wejscie_2024-10-17_DU-2024-1456_domyslne.x" wejscie-w-zycie="2024-10-17">
