          </p>
        </punkt>
        <punkt eId="DU/2024/1456__art_1__pkt_12" gd:GUID="f15e7ae7-899d-4adf-886a-f09b546ee0e6" okres="okr_obowiazywanie.zdarz_wejscie_2024-10-17_DU-2024-1456_domyslne.x" wejscie-w-zycie="2024-10-17">
