        <p>
          <zdanie nr="1" gd:zdGUID="c1c40761-11ee-41e5-a1ee-86949d7396a6" fragment="1" gd:fragmentGUID="1d706052-a862-4d7a-b268-e36f9a840dfc" okres="okr_obowiazywanie.zdarz_wejscie_2025-01-01_DU-2024-1653_odczytane.x" wejscie-w-zycie="2025-01-01">Rozporządzenie wchodzi w życie z dniem 1 stycznia 2025 r.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
