    <paragraf eId="DU/2024/1529__art_2" gd:GUID="7ac9f5c9-ff01-4938-b399-e0b06b0718a3" okres="okr_obowiazywanie.zdarz_wejscie_2024-10-16_DU-2024-1529_odczytane.x" wejscie-w-zycie="2024-10-16">
