          </p>
        </punkt>
        <punkt eId="DU/2025/1149__art_1__pkt_3" gd:GUID="58bc5bfa-afba-46f3-8097-8f7acdd9ffc8" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-05_DU-2025-1149_domyslne.x" wejscie-w-zycie="2025-09-05">
          <nr>3</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="b09cf8c7-3be5-49a5-9ef0-df7be246116f" fragment="4" gd:fragmentGUID="679d3904-e668-4bfb-b8f8-ae5f1962310c" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-05_DU-2025-1149_domyslne.x" wejscie-w-zycie="2025-09-05">wymagane dokumenty;</zdanie>
