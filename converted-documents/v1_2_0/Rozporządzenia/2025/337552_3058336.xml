          </p>
        </punkt>
        <punkt eId="DU/2025/1404__art_2__ust_2__pkt_2" gd:GUID="0c63fe94-b636-4bec-84fe-056a2adb3e9e" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-01_DU-2025-1404_domyslne.x" wejscie-w-zycie="2025-11-01">
          <nr>2</nr>
