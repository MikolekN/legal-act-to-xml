          </p>
        </punkt>
      </ustep>
      <ustep eId="DU/2025/1404__art_2__ust_3" gd:GUID="24e1ccb6-4d4d-4817-8c3e-63d7b21c6ade" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-01_DU-2025-1404_domyslne.x" wejscie-w-zycie="2025-11-01">
