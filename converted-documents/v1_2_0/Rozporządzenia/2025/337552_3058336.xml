        </p>
        <punkt eId="DU/2025/1404__art_2__ust_2__pkt_1" gd:GUID="e8d0e246-fda1-41f0-b061-82345a9aa647" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-01_DU-2025-1404_domyslne.x" wejscie-w-zycie="2025-11-01">
