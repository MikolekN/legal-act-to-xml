          </p>
        </punkt>
        <punkt eId="DU/2025/1357__art_1__pkt_2" gd:GUID="51567972-dcf8-4904-a6f0-e6b776f8ecb1" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-23_DU-2025-1357_domyslne.x" wejscie-w-zycie="2025-10-23">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="520e82ab-3150-4cdb-82f0-cb4a79fb2d67" fragment="3" gd:fragmentGUID="91e9faa1-40a6-4a6d-a434-e96340d30bcf" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-23_DU-2025-1357_domyslne.x" wejscie-w-zycie="2025-10-23">w załączniku do rozporządzenia w tabeli dodaje się lp. 19 w brzmieniu:<cytat-strukt now:akt="https://eli.gov.pl/eli/DU/2022/2260" cudzyslowy="brak" gd:nowGUID="4cf83e71-d849-4987-9712-e72b74fe405b" element-eId="DU/2022/2260__zal_1" funkcja="dodaj-recznie"><tabela gd:GUID="92f5bce5-8a24-415a-8251-af23a06a07c8"><tbody><tr gd:GUID="3b09cba0-0a1b-40b5-b1e7-ef7ba1ca6ab0"><td gd:GUID="07126cb3-a6d1-4b05-8827-49896f3c1fae"><liczba gd:GUID="302a41a5-0983-4d96-a6bf-90f04119c5d3">19</liczba></td><td gd:GUID="a92ef75c-572e-4544-8d4f-ea6a34670a9a"><tekst-zwykly gd:GUID="a35d3478-0817-41de-814e-25af8d43a298" /></td><td gd:GUID="33379b23-ac28-42b1-833c-5d00a0752f4b"><tekst-zwykly gd:GUID="325c18d6-9b5a-4b9f-bfa1-864917b4264b">zakażenie wirusem zachodniego Nilu</tekst-zwykly></td></tr></tbody></tabela></cytat-strukt></zdanie>
          </p>
        </punkt>
      </ustep-n>
