        <tekst-zwykly gd:GUID="991b729f-b224-4ad7-b6cc-0afccca6807a">– miasto Chełmża;</tekst-zwykly>
        <tekst-zwykly gd:GUID="857adf98-75fb-419c-99f4-e7860358edcb">6) w województwie łódzkim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="7b948069-5da9-4ec6-bc62-a59e15cb2e84">a) powiat wieruszowski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="59856b0f-fe76-44b0-85bb-0de52167bd1c">b) w powiecie sieradzkim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="3c0d85ca-fd02-4ae0-94b5-79fefaf9660f">– gminę Błaszki,</tekst-zwykly>
        <tekst-zwykly gd:GUID="337c97f0-4fbd-45b9-9ee9-5a466c4a5305">– gminę Brąszewice,</tekst-zwykly>
        <tekst-zwykly gd:GUID="19081f1b-ebfa-4985-858d-fe10591ea3f7">– gminę Brzeźnio,</tekst-zwykly>
        <tekst-zwykly gd:GUID="5e589b2d-6846-44fc-a1bf-59b2a7fba837">– gminę Goszczanów,</tekst-zwykly>
        <tekst-zwykly gd:GUID="786fac53-28d7-479f-95db-e2d50822bdc0">– gminę Klonowa,</tekst-zwykly>
        <tekst-zwykly gd:GUID="a36c82eb-7b03-40f5-9916-e1110ca16eb9">– gminę Sieradz,</tekst-zwykly>
        <tekst-zwykly gd:GUID="9cfe7f74-16ec-4a59-8c76-478b85494dff">– miasto Sieradz,</tekst-zwykly>
