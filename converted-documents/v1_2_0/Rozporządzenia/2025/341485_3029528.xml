        <tekst-zwykly gd:GUID="a8f1be35-33bd-4e79-8654-b193d774f3a3">– gminę Złoczew,</tekst-zwykly>
        <tekst-zwykly gd:GUID="b85ef520-f07c-427a-a044-b9aca7ede4fd">c) w powiecie wieluńskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="a5b4c19a-8907-47e7-abc2-8fd39d212880">– gminę Biała,</tekst-zwykly>
        <tekst-zwykly gd:GUID="3056f1c7-b890-4dc2-8e9c-168bbeffe2c1">– gminę Czarnożyły,</tekst-zwykly>
        <tekst-zwykly gd:GUID="607aee97-b935-4da3-83c5-a4bcb50ce912">– gminę Mokrsko,</tekst-zwykly>
        <tekst-zwykly gd:GUID="da876661-d7e1-455f-a10d-b65b11a01d5d">– gminę Ostrówek,</tekst-zwykly>
        <tekst-zwykly gd:GUID="9cc726d3-42cc-47bc-b30c-ac09233436a5">– gminę Pątnów,</tekst-zwykly>
        <tekst-zwykly gd:GUID="a3a686b0-d962-4378-8a49-3da46346430c">– gminę Skomlin,</tekst-zwykly>
        <tekst-zwykly gd:GUID="ab683864-78e1-4102-aabb-4258437cb79d">– gminę Wieluń;</tekst-zwykly>
        <tekst-zwykly gd:GUID="79617498-7660-4048-aa90-079316dcf134">7) w województwie mazowieckim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="eecb2d6d-385c-487e-bebc-995d7e7ecc66">a) powiat mławski,</tekst-zwykly>
