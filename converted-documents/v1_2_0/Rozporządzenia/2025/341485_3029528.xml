        <tekst-zwykly gd:GUID="e5bc4024-1776-4895-9375-9d54acac076d">– miasto Chełmno,</tekst-zwykly>
        <tekst-zwykly gd:GUID="fd9684d1-a082-491c-afe7-fad796eba71c">– gminę Kijewo Królewskie,</tekst-zwykly>
