      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="16b8cc30-dad2-4486-80c1-a7390a48cf87" okres="okr_obowiazywanie.zdarz_wejscie_2025-07-07_DU-2025-876_odczytane.x" wejscie-w-zycie="2025-07-07">
        <p>
          <zdanie nr="1" gd:zdGUID="ef6a35e0-0e09-46ce-9f98-17fca35af95b" fragment="1" gd:fragmentGUID="603c892e-5e80-40b2-8bef-ae1280841cf4" okres="okr_obowiazywanie.zdarz_wejscie_2025-07-07_DU-2025-876_odczytane.x" wejscie-w-zycie="2025-07-07">Wykaz przejść granicznych, rodzaj ruchu dozwolonego przez te przejścia, czas ich otwarcia oraz zasięg terytorialny przejść granicznych jest określony w załączniku do rozporządzenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <paragraf eId="DU/2025/876__art_4" gd:GUID="fea89d30-fef8-4a42-b614-5c70edffda83" okres="okr_obowiazywanie.zdarz_wejscie_2025-07-07_DU-2025-876_odczytane.x" wejscie-w-zycie="2025-07-07">
