    <paragraf eId="DU/2025/1758__art_2" gd:GUID="ca03468f-ec54-41e5-a913-14b0a14cf1ab" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1758_odczytane.x" wejscie-w-zycie="2026-01-01">
