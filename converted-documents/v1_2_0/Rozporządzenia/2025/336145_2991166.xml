      <nr>2</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="b9f2a795-bfae-40e2-8c32-69b76ccd1d3b" okres="okr_obowiazywanie.zdarz_wejscie_2025-08-14_DU-2025-1115_domyslne.x" wejscie-w-zycie="2025-08-14">
        <p>
          <zdanie nr="1" gd:zdGUID="c7cdf81d-21ee-4cc5-8b6a-bc005e72cde8" fragment="1" gd:fragmentGUID="848ebfc0-f769-4717-abad-4c029d2882fc" okres="okr_obowiazywanie.zdarz_wejscie_2025-08-14_DU-2025-1115_domyslne.x" wejscie-w-zycie="2025-08-14">Przepisy rozporządzenia zmienianego w § 1, w brzmieniu nadanym niniejszym rozporządzeniem, mają zastosowanie przy ustalaniu wysokości stypendium aplikantów Krajowej Szkoły Sądownictwa i Prokuratury od dnia 1 lipca 2025 r.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
