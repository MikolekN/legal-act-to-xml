      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="5c7d4ec0-e903-49fa-84b3-6dbedc6ed9b2" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-13_DU-2025-1485_odczytane.x" wejscie-w-zycie="2025-11-13">
        <p>
          <zdanie nr="1" gd:zdGUID="7ae26538-737e-4157-b142-341f26aca2a9" fragment="1" gd:fragmentGUID="06f6fd89-e6b0-484c-8513-9bdd96bfd476" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-13_DU-2025-1485_odczytane.x" wejscie-w-zycie="2025-11-13">Rozporządzenie wchodzi w życie z dniem 13 listopada 2025 r.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <organ-podpisujacy>Minister Finansów i Gospodarki: <i><osoba podpisujacy="true" gd:osobaGUID="e5c6171f-5152-4670-80d1-f8f55c84c74e"><imie>A.</imie> <nazwisko>Domański</nazwisko></osoba></i></organ-podpisujacy>
