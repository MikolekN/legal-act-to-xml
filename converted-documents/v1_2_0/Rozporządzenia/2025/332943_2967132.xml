            </p>
          </litera>
          <litera eId="DU/2025/974__art_1__pkt_4__lit_c" gd:GUID="df1c1bda-b2b6-451f-bf2f-b13e1056e62f" okres="okr_obowiazywanie.zdarz_wejscie_2025-08-07_DU-2025-974_domyslne.x" wejscie-w-zycie="2025-08-07">
