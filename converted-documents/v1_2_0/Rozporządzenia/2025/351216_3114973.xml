    <zalacznik eId="DU/2025/1713__zal_1" gd:GUID="4fd7696e-e859-4612-819f-7ff7819f734b">
      <zalacznik-do gd:GUID="63319645-e7fd-4eb7-8261-bd17f24e8866">Załącznik do rozporządzenia Ministra Rolnictwa i Rozwoju Wsi z dnia 1 grudnia 2025 r. (Dz. U. poz. 1713)</zalacznik-do>
      <tytul-zalacznika gd:GUID="6a82b961-0cec-42b2-b755-cb600889bf99">OBSZAR, NA KTÓRYM WYSTĘPUJE CHOROBA NIEBIESKIEGO JĘZYKA LUB ZAGROŻENIE WYSTĄPIENIA TEJ CHOROBY</tytul-zalacznika>
      <segment-zalacznika gd:GUID="33c70d74-cdb1-4622-88c2-a23e7aaf78c6" orientacja="pionowa">
        <tekst-zwykly gd:GUID="ceaadb3d-fa7b-420b-abab-7cc0e7763e0e">Obszar, na którym występuje choroba niebieskiego języka lub zagrożenie wystąpienia tej choroby, obejmuje:</tekst-zwykly>
        <tekst-zwykly gd:GUID="5aa81770-991b-47ab-a43c-5fb55dc9a3cb">1) województwo dolnośląskie;</tekst-zwykly>
        <tekst-zwykly gd:GUID="26081aa8-b2ed-43cf-95bc-30884a514f68">2) województwo kujawsko-pomorskie;</tekst-zwykly>
        <tekst-zwykly gd:GUID="a019e379-9f52-4c6b-b352-06715af8c6d8">3) województwo lubuskie;</tekst-zwykly>
        <tekst-zwykly gd:GUID="79208237-c508-4a16-973e-6f7092ded2f4">4) województwo łódzkie;</tekst-zwykly>
        <tekst-zwykly gd:GUID="af8cffbd-4ba1-4bc5-b1b2-d65984bcae80">5) województwo opolskie;</tekst-zwykly>
        <tekst-zwykly gd:GUID="3e82a2b2-c0f2-4acb-82ca-48ceaec1a1aa">6) województwo pomorskie;</tekst-zwykly>
        <tekst-zwykly gd:GUID="4598b78f-55fd-4b52-a370-1b58d6d1378f">7) województwo śląskie;</tekst-zwykly>
        <tekst-zwykly gd:GUID="7eb02ddb-b03e-4e81-a1b5-0ddfa67c623e">8) województwo wielkopolskie;</tekst-zwykly>
        <tekst-zwykly gd:GUID="2f25c9f3-8559-4dbb-964e-54bca894b565">9) województwo zachodniopomorskie;</tekst-zwykly>
        <tekst-zwykly gd:GUID="f69afa9b-ff25-4218-9f9d-b9a3d08a628f">10) w województwie małopolskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="5d740b72-6d47-48b5-b068-bbbf7fb2bc9f">a) powiat chrzanowski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="1ef47b53-9c3f-4853-95b1-448a919a8616">b) powiat krakowski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="8621de0d-18a0-40f3-bb87-a12d7e3be943">c) miasto na prawach powiatu Kraków,</tekst-zwykly>
        <tekst-zwykly gd:GUID="1dd6e588-8313-451e-9c98-9cd908658efb">d) powiat limanowski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="11bae695-94f9-46e4-ab74-8be401b1a542">e) powiat miechowski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="bae691be-ee5a-4d03-b3bc-989833f8c45d">f) powiat myślenicki,</tekst-zwykly>
        <tekst-zwykly gd:GUID="ca51444a-1f8c-4258-b8be-017efd8f8413">g) powiat nowotarski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="298fdf6e-6077-4156-87da-56b25f8734b6">h) powiat olkuski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="366af8d4-5dfd-4dbd-bc53-9bb5ff0e25fd">i) powiat oświęcimski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="a8baadd3-a4b7-4e11-8ab8-3be36e1cee98">j) powiat suski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="10ed04d2-d16a-4c41-8434-6f3563e75f56">k) powiat wadowicki,</tekst-zwykly>
        <tekst-zwykly gd:GUID="dc57648c-64a9-4a06-a92d-f0bd21b0e5a8">l) w powiecie proszowickim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="bb9ce941-ea9e-4bd7-832f-15eee8d818f2">– gminę Koniusza,</tekst-zwykly>
        <tekst-zwykly gd:GUID="c25d4090-4f1d-485e-b149-bd07079d1a38">– gminę Radziemice,</tekst-zwykly>
        <tekst-zwykly gd:GUID="a903c16b-2bfb-4ea4-b1ff-9915ab939781">m) w powiecie wielickim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="c16b3eeb-2218-4a0a-b012-ce62423da627">– gminę Biskupice,</tekst-zwykly>
        <tekst-zwykly gd:GUID="1f8874f0-90c2-4afe-b281-dea21c5c71e9">– gminę Gdów,</tekst-zwykly>
        <tekst-zwykly gd:GUID="828a3ed4-0002-4bd5-b4ee-50d662d4838b">– gminę Niepołomice,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d01311cb-47de-4f2a-a656-57cd1bd88911">– gminę Wieliczka;</tekst-zwykly>
        <tekst-zwykly gd:GUID="9b9ed7ec-e459-4879-aaca-126af19abdb9">11) w województwie mazowieckim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="d4025cda-dc7e-427c-be72-723098343e73">a) powiat gostyniński,</tekst-zwykly>
        <tekst-zwykly gd:GUID="ecff090b-5f87-4659-b38b-0e5d352bdaf2">b) powiat mławski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="b567d15d-3d92-4681-8e2c-390d7785cfc0">c) powiat płocki,</tekst-zwykly>
        <tekst-zwykly gd:GUID="2bbca861-bcef-4df3-88a7-44532b1894b8">d) miasto na prawach powiatu Płock,</tekst-zwykly>
        <tekst-zwykly gd:GUID="b04ef73f-65d8-4395-935b-5ef55da5fb2c">e) powiat przasnyski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="cabb9e49-307a-4ae1-be4d-f7ff0a20dda5">f) powiat sierpecki,</tekst-zwykly>
        <tekst-zwykly gd:GUID="85ab221d-08b0-457c-a9d9-563cb596cdab">g) powiat żuromiński,</tekst-zwykly>
        <tekst-zwykly gd:GUID="554e3ac5-441a-4e5c-b6e5-0922d6229812">h) w powiecie ciechanowskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="29ca31f8-425a-4bc9-ae9d-f7d30ec48c43">– gminę Ciechanów,</tekst-zwykly>
        <tekst-zwykly gd:GUID="796aeb19-bbae-48d4-aba9-feb39df6c13a">– miasto Ciechanów,</tekst-zwykly>
        <tekst-zwykly gd:GUID="04fac475-f434-4b61-ac5c-ad74cbb5f569">– gminę Glinojeck,</tekst-zwykly>
        <tekst-zwykly gd:GUID="98c0f214-cfa3-4869-91e7-268cd658e12c">– gminę Grudusk,</tekst-zwykly>
        <tekst-zwykly gd:GUID="bf09361a-3788-4df2-b3dd-386fe9940972">– gminę Opinogóra Górna,</tekst-zwykly>
        <tekst-zwykly gd:GUID="27164a9f-ed73-49d5-909c-f4a4276bc460">– gminę Regimin,</tekst-zwykly>
        <tekst-zwykly gd:GUID="f2b0155b-c4d5-4c53-a0e0-7559cb55e3c2">i) w powiecie makowskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="c280679f-f81e-47a4-be7a-76f3c4e1e9dc">– gminę Krasnosielc,</tekst-zwykly>
        <tekst-zwykly gd:GUID="b6a5f2fc-d688-456f-944c-1dcd34fea6fb">– gminę Płoniawy-Bramura,</tekst-zwykly>
        <tekst-zwykly gd:GUID="e1655727-7d0a-4342-b7db-d3535e50346f">– gminę Sypniewo,</tekst-zwykly>
        <tekst-zwykly gd:GUID="2af1c125-8894-4983-a42f-5db28662d3e8">j) w powiecie ostrołęckim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="d3de80a7-8428-4d69-9bce-bd8a03dcaf11">– gminę Baranowo,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d2a9707e-9bf2-4bdb-a4b3-831cf81c67b4">– gminę Czarnia,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d1b0ec4f-2347-4967-a45c-1869b3397ad4">– gminę Kadzidło,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d675fd8e-97f8-48c7-807c-5de2804a242a">– gminę Lelis,</tekst-zwykly>
        <tekst-zwykly gd:GUID="8733e812-f605-4d3a-be54-6b5c6435d6f2">– gminę Łyse,</tekst-zwykly>
        <tekst-zwykly gd:GUID="29c65851-eaee-4c07-a160-672aad5ebd09">– gminę Myszyniec,</tekst-zwykly>
        <tekst-zwykly gd:GUID="7549c469-a007-4848-956b-a58a8e489e86">– gminę Olszewo-Borki,</tekst-zwykly>
        <tekst-zwykly gd:GUID="c6982925-510b-4a89-a209-504e09554cf1">k) w powiecie płońskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="f129fa47-4ded-455d-88b7-72deecdfeb09">– gminę Baboszewo,</tekst-zwykly>
        <tekst-zwykly gd:GUID="7074b843-12a5-4160-875b-3f1c4c29a851">– gminę Czerwińsk nad Wisłą,</tekst-zwykly>
        <tekst-zwykly gd:GUID="f45db0da-b98a-4f7f-987d-a93d3b98028e">– gminę Dzierzążnia,</tekst-zwykly>
        <tekst-zwykly gd:GUID="cd55e9ab-c3a1-4242-b1e1-e50a006f6b2d">– gminę Naruszewo,</tekst-zwykly>
        <tekst-zwykly gd:GUID="0b840e2e-4f00-4842-867a-86b46baa93b3">– gminę Raciąż,</tekst-zwykly>
        <tekst-zwykly gd:GUID="4755bff4-14de-4c41-b8d2-6a3fbe9b827c">– miasto Raciąż,</tekst-zwykly>
        <tekst-zwykly gd:GUID="1a23e317-a459-40a6-ae08-b38a82905363">l) w powiecie sochaczewskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="38fede85-b900-49c5-a307-35f4fec7b39b">– gminę Brochów,</tekst-zwykly>
        <tekst-zwykly gd:GUID="a4384199-d031-4eec-a53c-5bf915f7a2b1">– gminę Iłów,</tekst-zwykly>
        <tekst-zwykly gd:GUID="a6059284-0644-4f9f-9f8b-3dfecdf5eba9">– gminę Młodzieszyn,</tekst-zwykly>
        <tekst-zwykly gd:GUID="b1cd3755-df7f-474a-8484-7aa1321c14df">– gminę Nowa Sucha,</tekst-zwykly>
        <tekst-zwykly gd:GUID="86e0ed4c-b90d-4fb5-9681-b608b4b06cda">– gminę Rybno,</tekst-zwykly>
        <tekst-zwykly gd:GUID="715c46ff-deea-4dab-a7cc-fd4d0972bdc1">– gminę Sochaczew,</tekst-zwykly>
        <tekst-zwykly gd:GUID="070b8bae-a408-4ef4-85d9-862e1181be42">– miasto Sochaczew;</tekst-zwykly>
        <tekst-zwykly gd:GUID="7771775b-6a0b-49eb-a054-6c1e675ea88a">12) w województwie podlaskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="3906e53a-27de-4a5c-b43b-9aca18ec4331">a) w powiecie kolneńskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="86688201-3f95-4cc9-b7dc-5a1ca454ac30">– gminę Kolno,</tekst-zwykly>
        <tekst-zwykly gd:GUID="2da690cc-37e9-4959-a906-3439f1a3d666">– miasto Kolno,</tekst-zwykly>
        <tekst-zwykly gd:GUID="af413f2a-b74a-410a-b6f5-fa93cca4688a">– gminę Turośl,</tekst-zwykly>
        <tekst-zwykly gd:GUID="e5e9961e-6849-4b10-9c89-e7bbc3f848d2">b) w powiecie łomżyńskim – gminę Zbójna;</tekst-zwykly>
