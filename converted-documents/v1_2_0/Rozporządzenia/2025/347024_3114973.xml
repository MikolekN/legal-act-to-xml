    <zalacznik eId="DU/2025/1713__zal_1" gd:GUID="d17d42cf-d83f-4a18-b98d-41022ef8b0fc">
      <zalacznik-do gd:GUID="7d950513-ffe4-4b54-a686-2b5d31e683d5">Załącznik do rozporządzenia Ministra Rolnictwa i Rozwoju Wsi z dnia 1 grudnia 2025 r. (Dz. U. poz. 1713)</zalacznik-do>
      <tytul-zalacznika gd:GUID="b34cebb3-218e-4dd8-bd51-9ca2708336b0">OBSZAR, NA KTÓRYM WYSTĘPUJE CHOROBA NIEBIESKIEGO JĘZYKA LUB ZAGROŻENIE WYSTĄPIENIA TEJ CHOROBY</tytul-zalacznika>
      <segment-zalacznika gd:GUID="3566cfa8-2ebd-4b5d-93f3-b1b954ede24a" orientacja="pionowa">
        <tekst-zwykly gd:GUID="c25f020e-ebc8-418f-b618-bf1ec872326e">Obszar, na którym występuje choroba niebieskiego języka lub zagrożenie wystąpienia tej choroby, obejmuje:</tekst-zwykly>
        <tekst-zwykly gd:GUID="2d8306b2-1c80-4d62-a9d4-298e5aefc295">1) województwo dolnośląskie;</tekst-zwykly>
        <tekst-zwykly gd:GUID="d18b27db-5356-42dc-b015-21a8106a454e">2) województwo kujawsko-pomorskie;</tekst-zwykly>
        <tekst-zwykly gd:GUID="53a49232-3f6c-4e47-b400-70e56cf2df7b">3) województwo lubuskie;</tekst-zwykly>
        <tekst-zwykly gd:GUID="baef300e-a85b-4c23-835a-794678dd99c2">4) województwo łódzkie;</tekst-zwykly>
        <tekst-zwykly gd:GUID="5c296ca7-e436-40f4-b359-c668a9c4e207">5) województwo opolskie;</tekst-zwykly>
        <tekst-zwykly gd:GUID="e77ec8f8-a24d-4779-9b66-62121d6eca41">6) województwo pomorskie;</tekst-zwykly>
        <tekst-zwykly gd:GUID="1df9599d-0dac-4cff-8cac-df374cf57322">7) województwo śląskie;</tekst-zwykly>
        <tekst-zwykly gd:GUID="92283f13-9a67-4fe2-97be-f1a161c48bb7">8) województwo wielkopolskie;</tekst-zwykly>
        <tekst-zwykly gd:GUID="043d336f-15cc-462c-af96-520da9fca1c1">9) województwo zachodniopomorskie;</tekst-zwykly>
        <tekst-zwykly gd:GUID="def87333-453a-4832-a9c9-a798f1feee5a">10) w województwie małopolskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="b366e86d-55f9-4397-93b2-6c4d440bc038">a) powiat chrzanowski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="a897be42-cd5c-4985-8a1b-075f32cb465c">b) powiat krakowski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="334f2e95-976e-4f19-a696-4c6ec37f6ba3">c) miasto na prawach powiatu Kraków,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d233986f-8638-402f-acbb-72ed88b45edd">d) powiat limanowski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="627feeff-3172-42df-8461-b12eb9c6d216">e) powiat miechowski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="f2faba3a-e619-4db3-90b4-f033f5c483a9">f) powiat myślenicki,</tekst-zwykly>
        <tekst-zwykly gd:GUID="09201cd2-8cf6-4974-a09b-0d4de6bf8579">g) powiat nowotarski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="11316ca4-969f-4c71-b59e-d6ba2d2a7c03">h) powiat olkuski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="274dfbf4-ee37-4a38-8f2c-c0bddef25e9f">i) powiat oświęcimski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="fc377118-06ba-4414-9411-24c115379e81">j) powiat suski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="4f47ed24-3fad-4051-89b0-1ae653c415e4">k) powiat wadowicki,</tekst-zwykly>
        <tekst-zwykly gd:GUID="374e31fe-8926-45c7-a332-2e05c61f1649">l) w powiecie proszowickim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="ec28a806-ed2b-4a96-a5ca-7c7dd8ff867b">– gminę Koniusza,</tekst-zwykly>
        <tekst-zwykly gd:GUID="a28055e4-bc5b-44c3-a157-31e95932e72e">– gminę Radziemice,</tekst-zwykly>
        <tekst-zwykly gd:GUID="a6c0beb7-88b7-4703-8b41-7d845227a167">m) w powiecie wielickim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="958dc940-1871-4604-82b2-966c65cdf6c7">– gminę Biskupice,</tekst-zwykly>
        <tekst-zwykly gd:GUID="483bc1b5-351b-424f-9560-08b4f491a3fb">– gminę Gdów,</tekst-zwykly>
        <tekst-zwykly gd:GUID="0743e505-1de8-4874-b4c8-f253ac422537">– gminę Niepołomice,</tekst-zwykly>
        <tekst-zwykly gd:GUID="3c33d84c-9c14-4027-a4e2-f15bcd41f3b4">– gminę Wieliczka;</tekst-zwykly>
        <tekst-zwykly gd:GUID="b467e3dc-99f0-44c9-9e56-56b5e1574180">11) w województwie mazowieckim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="140cbd0f-2d10-426b-a8ca-68230c850359">a) powiat gostyniński,</tekst-zwykly>
        <tekst-zwykly gd:GUID="a8691017-fbfe-415d-be39-57df9021a3bd">b) powiat mławski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="6b90fc7b-03f9-463c-bb1f-be368cfbe342">c) powiat płocki,</tekst-zwykly>
        <tekst-zwykly gd:GUID="c866c250-27e7-4379-8abf-1321bc631522">d) miasto na prawach powiatu Płock,</tekst-zwykly>
        <tekst-zwykly gd:GUID="8941a399-e553-41dd-9c2d-e12d124b63a2">e) powiat przasnyski,</tekst-zwykly>
        <tekst-zwykly gd:GUID="cfd9b6d3-6e57-47d8-882c-3f573f75ead4">f) powiat sierpecki,</tekst-zwykly>
        <tekst-zwykly gd:GUID="f022b2e7-a79f-4c40-a433-1dbe673681c5">g) powiat żuromiński,</tekst-zwykly>
        <tekst-zwykly gd:GUID="29a4f3c5-4e18-472f-a62b-f9bb1ee369a2">h) w powiecie ciechanowskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="a20a5219-464e-4fd9-b5b0-7919f18a76e4">– gminę Ciechanów,</tekst-zwykly>
        <tekst-zwykly gd:GUID="1993605b-8d70-4462-987a-6f706ad71721">– miasto Ciechanów,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d52ede09-e489-4c18-8bff-82249c374969">– gminę Glinojeck,</tekst-zwykly>
        <tekst-zwykly gd:GUID="81da710b-2e8e-4108-8ad1-d67880c9f93a">– gminę Grudusk,</tekst-zwykly>
        <tekst-zwykly gd:GUID="1005e12d-ff82-46af-ad5d-1d36d57bee41">– gminę Opinogóra Górna,</tekst-zwykly>
        <tekst-zwykly gd:GUID="61d59b62-2be0-4221-867c-5c85710ce993">– gminę Regimin,</tekst-zwykly>
        <tekst-zwykly gd:GUID="2bc9f668-9087-45fd-acc4-4e0cd12823df">i) w powiecie makowskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="dbc5a284-2d60-4de8-af69-2d30d08f3288">– gminę Krasnosielc,</tekst-zwykly>
        <tekst-zwykly gd:GUID="3b80df29-9101-4f89-ab7c-7588a249ee24">– gminę Płoniawy-Bramura,</tekst-zwykly>
        <tekst-zwykly gd:GUID="85a825e7-053f-4485-9f36-8ed2aebb8a22">– gminę Sypniewo,</tekst-zwykly>
        <tekst-zwykly gd:GUID="6b9ffb79-2f89-4e7a-850a-0b0c2beb3ab1">j) w powiecie ostrołęckim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="666db089-490e-4b55-9308-97069674707c">– gminę Baranowo,</tekst-zwykly>
        <tekst-zwykly gd:GUID="844fc850-a9ec-45f6-b6db-028123e4d456">– gminę Czarnia,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d8096740-e64e-4f32-8110-4f8f1c2bd6ea">– gminę Kadzidło,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d0354599-625c-46ed-8634-6696162386df">– gminę Lelis,</tekst-zwykly>
        <tekst-zwykly gd:GUID="2fc4ae47-8c3e-445a-a7ca-433f7ebb3898">– gminę Łyse,</tekst-zwykly>
        <tekst-zwykly gd:GUID="13fefb66-e7c0-4dd6-81fd-e169cfc597fd">– gminę Myszyniec,</tekst-zwykly>
        <tekst-zwykly gd:GUID="53f25aaa-8113-4381-9738-d85ddb5cc545">– gminę Olszewo-Borki,</tekst-zwykly>
        <tekst-zwykly gd:GUID="bdcf36a2-8fbd-4212-92c9-e3941a16c2dc">k) w powiecie płońskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="42bc9947-e226-4c9a-9d10-f015f048c2eb">– gminę Baboszewo,</tekst-zwykly>
        <tekst-zwykly gd:GUID="edb345f3-5d2c-445e-8493-a5ea1fbb51eb">– gminę Czerwińsk nad Wisłą,</tekst-zwykly>
        <tekst-zwykly gd:GUID="70960a3b-a72a-4800-add2-a28288faddf9">– gminę Dzierzążnia,</tekst-zwykly>
        <tekst-zwykly gd:GUID="dc9d3f2d-8338-485d-b206-c113387e092d">– gminę Naruszewo,</tekst-zwykly>
        <tekst-zwykly gd:GUID="35094265-ae92-402f-a8c0-baecc60be460">– gminę Raciąż,</tekst-zwykly>
        <tekst-zwykly gd:GUID="0b0c6f6f-eede-4563-9642-77dce0ebe18e">– miasto Raciąż,</tekst-zwykly>
        <tekst-zwykly gd:GUID="625ce1d5-009a-4ebc-af94-c150796dc3ad">l) w powiecie sochaczewskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="5b5a7611-da21-4c28-b45d-090ef81dfe23">– gminę Brochów,</tekst-zwykly>
        <tekst-zwykly gd:GUID="7771666a-dc8c-40dc-a809-572514459d66">– gminę Iłów,</tekst-zwykly>
        <tekst-zwykly gd:GUID="b67b2e81-ccde-4957-b101-bb610b00117e">– gminę Młodzieszyn,</tekst-zwykly>
        <tekst-zwykly gd:GUID="71ab83b4-9bb9-4f1e-a40f-7ccd3f9a775d">– gminę Nowa Sucha,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d0f34350-adcd-4a72-a572-36cd1a62edc6">– gminę Rybno,</tekst-zwykly>
        <tekst-zwykly gd:GUID="e250d433-c349-43a7-ab52-0692c23a7407">– gminę Sochaczew,</tekst-zwykly>
        <tekst-zwykly gd:GUID="0103d228-fb85-4bd1-9a7c-33728b492aca">– miasto Sochaczew;</tekst-zwykly>
        <tekst-zwykly gd:GUID="5f44368a-d50e-4339-8fdd-a4506353f0c5">12) w województwie podlaskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="47188215-3baa-4961-a9d6-80887620607f">a) w powiecie kolneńskim:</tekst-zwykly>
        <tekst-zwykly gd:GUID="bf831e0d-6feb-408f-9af3-9a5a6fae6b36">– gminę Kolno,</tekst-zwykly>
        <tekst-zwykly gd:GUID="5336d34b-dc0d-475b-8c0a-bb934e69dccb">– miasto Kolno,</tekst-zwykly>
        <tekst-zwykly gd:GUID="d8948322-38ba-4961-b51f-80c6888c0080">– gminę Turośl,</tekst-zwykly>
        <tekst-zwykly gd:GUID="7a938f84-81fe-49aa-96c0-cb2745d238b2">b) w powiecie łomżyńskim – gminę Zbójna;</tekst-zwykly>
        <tekst-zwykly gd:GUID="d033b4ef-1f17-4d4e-a76f-0bd080a9d53d">13) w województwie świętokrzyskim:</tekst-zwykly>
