          </p>
        </punkt>
        <punkt eId="DU/2025/850__art_1__pkt_2" gd:GUID="f4e379c6-243d-4a56-999e-68f785f29271" okres="okr_obowiazywanie.zdarz_wejscie_2025-07-01_DU-2025-850_domyslne.x" wejscie-w-zycie="2025-07-01">
          <nr>2</nr>
          <p>
