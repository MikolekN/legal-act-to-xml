      <nr>1</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="59236904-603c-4996-9a77-3873d8b016e2" okres="okr_obowiazywanie.zdarz_wejscie_2025-07-26_DU-2025-929_domyslne.x" wejscie-w-zycie="2025-07-26">
        <p>
          <zdanie nr="1" gd:zdGUID="40d5d7cf-f803-4678-9423-9fb554bd0e6a" fragment="1" gd:fragmentGUID="67e19537-70d7-4ea7-816c-0dbc455a084e" okres="okr_obowiazywanie.zdarz_wejscie_2025-07-26_DU-2025-929_domyslne.x" wejscie-w-zycie="2025-07-26">Zarządza się zaniechanie poboru podatku dochodowego od osób fizycznych od nagród otrzymanych przez Powstańców Warszawskich albo ich małżonków przyznanych przez Radę miasta stołecznego Warszawy.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
