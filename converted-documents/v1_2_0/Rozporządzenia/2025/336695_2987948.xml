      <nr>1</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="39a429ee-dd53-41f2-8eb7-b9d642d5af1b" okres="okr_obowiazywanie.zdarz_wejscie_2025-08-26_DU-2025-1093_domyslne.x" wejscie-w-zycie="2025-08-26">
