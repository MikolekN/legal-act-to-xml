        <nr>1</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="23b65741-e4b0-4665-a949-48dcacccbf0e" fragment="1" gd:fragmentGUID="86d7fc10-fae7-4f63-907d-39b68e3166b8" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-27_DU-2025-1637_domyslne.x" wejscie-w-zycie="2025-11-27">Nagroda roczna może być przyznana, jeżeli podmiot prawny, w którym uprawniony był zatrudniony, w roku obrotowym:</zdanie>
        </p>
        <punkt eId="DU/2025/1637__art_4__ust_1__pkt_1" gd:GUID="608773e8-aaed-494c-8964-2d77af7c9244" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-27_DU-2025-1637_domyslne.x" wejscie-w-zycie="2025-11-27">
          <nr>1</nr>
          <p>
