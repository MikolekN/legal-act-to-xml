        <p>
          <zdanie nr="1" gd:zdGUID="1c71ac70-e5a3-41e7-845c-c6db85cae3ab" fragment="1" gd:fragmentGUID="7e3fbcca-9f8f-4278-808f-34cd9f931e85" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1801_domyslne.x" wejscie-w-zycie="2026-01-01">Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
