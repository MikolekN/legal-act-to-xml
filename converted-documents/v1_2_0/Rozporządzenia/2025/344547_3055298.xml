      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="7a8f3a14-ec45-4b67-a685-30df276fc4c8" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-16_DU-2025-1393_odczytane.x" wejscie-w-zycie="2025-10-16">
        <p>
          <zdanie nr="1" gd:zdGUID="577bc6a8-c417-4679-9f51-dfe1f91a46c7" fragment="1" gd:fragmentGUID="0582938e-788a-4ca5-8583-67afe110d6c6" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-16_DU-2025-1393_odczytane.x" wejscie-w-zycie="2025-10-16">Rozporządzenie wchodzi w życie z dniem 16 października 2025 r.</zdanie>
        </p>
      </ustep-n>
