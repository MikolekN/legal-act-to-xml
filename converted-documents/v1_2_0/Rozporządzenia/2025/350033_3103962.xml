        <p>
          <zdanie nr="1" gd:zdGUID="445031ae-5222-4f19-bc3d-eccdf28f7771" fragment="1" gd:fragmentGUID="6d3806c5-8012-4b22-9168-fbc7d6e0617d" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-12_DU-2025-1640_domyslne.x" wejscie-w-zycie="2025-12-12">Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
