        <p>
          <zdanie nr="1" gd:zdGUID="5102dbb6-3cc4-414b-a064-836108e1357a" fragment="1" gd:fragmentGUID="cb0793b0-b9b3-4f11-b377-fbf2c25a5b8f" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-30_DU-2025-1243_domyslne.x" wejscie-w-zycie="2025-09-30">Przepisy rozporządzenia stosuje się do sprawozdań, o których mowa w art. 28 ust. 1 i 3 ustawy, za rok obrotowy, który zakończy się po wejściu w życie rozporządzenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <paragraf eId="DU/2025/1243__art_6" gd:GUID="4d2e0ae2-c1c3-4a11-9b4a-64c06df322bc" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-30_DU-2025-1243_domyslne.x" wejscie-w-zycie="2025-09-30">
