        </p>
        <punkt eId="DU/2025/1243__art_1__pkt_1" gd:GUID="2cff991e-b4fb-48e4-a21b-97d95a8f781a" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-30_DU-2025-1243_domyslne.x" wejscie-w-zycie="2025-09-30">
          <nr>1</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="0f28c047-1cca-44cd-94c1-5c80a1679b77" fragment="2" gd:fragmentGUID="e0d11e92-fb6a-4575-86b6-c8a8cb8be19c" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-30_DU-2025-1243_domyslne.x" wejscie-w-zycie="2025-09-30">terminy oraz sposób sporządzania i przekazywania informacji, o których mowa w art. 27 ust. 2 i 3 ustawy z dnia 20 grudnia 2024 r. o podmiotach obsługujących kredyty i nabywcach kredytów, zwanych dalej „informacjami”;</zdanie>
          </p>
        </punkt>
        <punkt eId="DU/2025/1243__art_1__pkt_2" gd:GUID="b1f21c80-cab9-425f-aafb-0c3f193b8c5c" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-30_DU-2025-1243_domyslne.x" wejscie-w-zycie="2025-09-30">
          <nr>2</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="0f28c047-1cca-44cd-94c1-5c80a1679b77" fragment="3" gd:fragmentGUID="fa1e8f5c-cfec-4182-837f-0b10e536d117" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-30_DU-2025-1243_domyslne.x" wejscie-w-zycie="2025-09-30">terminy oraz sposób przekazywania sprawozdań, o których mowa w art. 28 ust. 1 i 3 ustawy z dnia 20 grudnia 2024 r. o podmiotach obsługujących kredyty i nabywcach kredytów, zwanej dalej „ustawą”.</zdanie>
          </p>
        </punkt>
      </ustep-n>
    </paragraf>
