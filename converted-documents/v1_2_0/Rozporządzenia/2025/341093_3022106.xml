    <paragraf eId="DU/2025/1243__art_4" gd:GUID="fbe35f99-ff3e-42bd-9848-7da1133dc8ac" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-30_DU-2025-1243_domyslne.x" wejscie-w-zycie="2025-09-30">
