      <nr>1</nr>
      <ustep eId="DU/2025/1487__art_1__ust_1" gd:GUID="4f85cb43-1659-4e24-9b7d-7e32835bdde5" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1487_odczytane.x" wejscie-w-zycie="2026-01-01">
        <nr>1</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="a4cf3b5c-27d5-469b-aa6a-b6fa626c359a" fragment="1" gd:fragmentGUID="93f77d4b-9ba3-4f9c-ab7a-2752894afe40" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1487_odczytane.x" wejscie-w-zycie="2026-01-01">Osiedlu Uzdrowiskowemu Miasta Lidzbark Warmiński i sołectwom: Medyny i Łabno, położonym na obszarze gminy Lidzbark Warmiński, w powiecie lidzbarskim, w województwie warmińsko-mazurskim, nadaje się status uzdrowiska.</zdanie>
        </p>
      </ustep>
      <ustep eId="DU/2025/1487__art_1__ust_2" gd:GUID="e5a38eff-fa47-4075-b46e-84fc5ab689f4" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1487_odczytane.x" wejscie-w-zycie="2026-01-01">
