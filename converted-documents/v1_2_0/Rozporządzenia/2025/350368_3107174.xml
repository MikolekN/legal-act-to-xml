        </p>
      </ustep>
    </paragraf>
    <paragraf eId="DU/2025/1663__art_6" gd:GUID="e8b1fda1-c0ae-4c4f-9a06-ffd5b3e6d40f" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-29_DU-2025-1663_domyslne.x" wejscie-w-zycie="2025-11-29">
