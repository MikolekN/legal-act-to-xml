        </p>
      </ustep>
      <ustep eId="DU/2025/1663__art_1__ust_2" gd:GUID="0f32c1b7-6753-4f1b-afbf-eb0c461b2a26" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-29_DU-2025-1663_domyslne.x" wejscie-w-zycie="2025-11-29">
        <nr>2</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="b0433213-c4ec-46d0-b687-a4c81629761b" fragment="1" gd:fragmentGUID="4957fe61-e933-43d2-860a-51060f343ea0" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-29_DU-2025-1663_domyslne.x" wejscie-w-zycie="2025-11-29">Pełnomocnikiem jest sekretarz stanu albo podsekretarz stanu w urzędzie obsługującym ministra właściwego do spraw zagranicznych.</zdanie>
        </p>
      </ustep>
    </paragraf>
