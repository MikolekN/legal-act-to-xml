        </p>
      </ustep>
      <ustep eId="DU/2025/1663__art_5__ust_2" gd:GUID="0fa0a5cd-5ac9-4d70-908a-2f08c107f0b9" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-29_DU-2025-1663_domyslne.x" wejscie-w-zycie="2025-11-29">
        <nr>2</nr>
        <p>
