        <p>
          <zdanie nr="1" gd:zdGUID="cf79ecf8-f284-409f-a684-cc40063761b5" fragment="1" gd:fragmentGUID="f4b4b789-e0c4-470c-b85b-98eb7995378b" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1798_odczytane.x" wejscie-w-zycie="2026-01-01">Rozporządzenie wchodzi w życie z dniem 1 stycznia 2026 r.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
