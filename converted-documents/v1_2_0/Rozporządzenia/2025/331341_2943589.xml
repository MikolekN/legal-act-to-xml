      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="0010c321-7184-4f0e-a4bd-aab7ac988113" okres="okr_obowiazywanie.zdarz_wejscie_2025-07-16_DU-2025-864_domyslne.x" wejscie-w-zycie="2025-07-16">
        <p>
          <zdanie nr="1" gd:zdGUID="9b9e3a7c-35bb-4947-bf72-bd669563a1bc" fragment="1" gd:fragmentGUID="93851375-7ec0-443f-9bd9-5a609287338a" okres="okr_obowiazywanie.zdarz_wejscie_2025-07-16_DU-2025-864_domyslne.x" wejscie-w-zycie="2025-07-16">Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
