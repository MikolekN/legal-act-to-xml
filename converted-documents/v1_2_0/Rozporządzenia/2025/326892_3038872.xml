    <paragraf eId="DU/2025/1314__art_1" gd:GUID="ec4d1c2a-dbe2-479b-8f28-5d8afa248e87" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1314_odczytane.x" wejscie-w-zycie="2026-01-01">
