          <zdanie nr="1" gd:zdGUID="fff5b222-ca53-4a4b-b77c-556adb85a931" fragment="1" gd:fragmentGUID="d214c04c-0d1e-4ec6-ae48-3bd256c11ffe" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-18_DU-2025-1695_domyslne.x" wejscie-w-zycie="2025-12-18">Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
