      <tytul-zalacznika gd:GUID="3d7aee80-3201-453e-8b43-2837305b2a75">Norma umundurowania nr 5a</tytul-zalacznika>
      <segment-zalacznika gd:GUID="0fb020b3-8e73-476b-a948-3751bc88ac19" orientacja="pionowa">
        <tekst-zwykly gd:GUID="e9d77d50-917d-4662-8903-de22f0f85223">dotycząca ubioru służbowego dla policjantów mianowanych na okres służby kontraktowej</tekst-zwykly>
      </segment-zalacznika>
