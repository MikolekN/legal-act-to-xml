    <paragraf eId="DU/2025/1277__art_2" gd:GUID="bb5a101b-7d60-41b0-96d0-b2af82914d5e" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-09_DU-2025-1277_domyslne.x" wejscie-w-zycie="2025-10-09">
      <nr>2</nr>
      <ustep eId="DU/2025/1277__art_2__ust_1" gd:GUID="6d94b76e-fd99-420f-8c42-3020a6433ab7" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-09_DU-2025-1277_domyslne.x" wejscie-w-zycie="2025-10-09">
        <nr>1</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="96ca4f86-4f13-4f6e-9a81-06c671cdf33d" fragment="1" gd:fragmentGUID="4b2069b4-9cd1-423f-b7e3-645bf336cc3b" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-09_DU-2025-1277_domyslne.x" wejscie-w-zycie="2025-10-09">Świadectwa zatwierdzenia typu, świadectwa zgodności wytwarzania, świadectwa ponownej oceny zgodności, świadectwa badania odbiorczego i prób wydane przez jednostki notyfikowane przed dniem wejścia w życie niniejszego rozporządzenia zachowują ważność do końca okresu, na jaki zostały wydane.</zdanie>
        </p>
      </ustep>
      <ustep eId="DU/2025/1277__art_2__ust_2" gd:GUID="7f947c41-d421-412d-b1b3-54f45d4d934f" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-09_DU-2025-1277_domyslne.x" wejscie-w-zycie="2025-10-09">
        <nr>2</nr>
        <p>
          <zdanie nr="1" gd:zdGUID="647e480c-2721-406b-be15-9357e42e8f4f" fragment="1" gd:fragmentGUID="68b37534-7c74-416d-b5e0-a1236c8befa2" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-09_DU-2025-1277_domyslne.x" wejscie-w-zycie="2025-10-09">Do spraw dotyczących oceny zgodności ciśnieniowych urządzeń transportowych oraz badań okresowych, pośrednich i nadzwyczajnych wszczętych i niezakończonych przed dniem wejścia w życie niniejszego rozporządzenia stosuje się przepisy dotychczasowe.</zdanie>
        </p>
      </ustep>
    </paragraf>
    <paragraf eId="DU/2025/1277__art_3" gd:GUID="81b3d5fb-ede1-480d-9829-8a25f2bad7a6" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-09_DU-2025-1277_domyslne.x" wejscie-w-zycie="2025-10-09">
      <nr>3</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="993ad16a-f51e-4b30-97ae-b6e06dfd54b0" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-09_DU-2025-1277_domyslne.x" wejscie-w-zycie="2025-10-09">
        <p>
          <zdanie nr="1" gd:zdGUID="2f9e46e0-5ec1-4b76-ac63-ef6f3e151cd7" fragment="1" gd:fragmentGUID="b2457f77-c119-496f-9fa2-d64ba9e1e1f2" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-09_DU-2025-1277_domyslne.x" wejscie-w-zycie="2025-10-09">Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
