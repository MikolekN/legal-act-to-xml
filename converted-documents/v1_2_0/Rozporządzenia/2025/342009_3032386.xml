          </p>
        </punkt>
        <punkt eId="DU/2025/1277__art_1__pkt_6" gd:GUID="61190331-eec0-422c-8c2d-d0419994dbf7" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-09_DU-2025-1277_domyslne.x" wejscie-w-zycie="2025-10-09">
