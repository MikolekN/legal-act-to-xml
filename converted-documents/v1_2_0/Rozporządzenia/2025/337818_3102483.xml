    </paragraf>
    <paragraf eId="DU/2025/1629__art_2" gd:GUID="6bd37be2-6fde-4c88-ac64-dc5288bd119f" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-01_DU-2025-1629_odczytane.x" wejscie-w-zycie="2025-12-01">
