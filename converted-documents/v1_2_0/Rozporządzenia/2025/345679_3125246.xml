          <p>
            <zdanie nr="1" gd:zdGUID="4ac9dc1c-e7ed-4213-a6d9-bb534b7ff26f" fragment="2" gd:fragmentGUID="1c97787c-85fe-4cae-8924-423f9c81cbdf" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1771_odczytane.x" wejscie-w-zycie="2026-01-01">sygnaturę akt sprawy, w której dozór elektroniczny był wykonywany;</zdanie>
          </p>
        </punkt>
        <punkt eId="DU/2025/1771__art_1__ust_3__pkt_2" gd:GUID="8f540556-f646-4851-b1c5-389ab14e54fa" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1771_odczytane.x" wejscie-w-zycie="2026-01-01">
