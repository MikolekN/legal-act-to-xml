        </p>
        <punkt eId="DU/2025/1771__art_1__ust_3__pkt_1" gd:GUID="b3afe9ac-515d-4b89-8936-47ef6f2bcbda" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1771_odczytane.x" wejscie-w-zycie="2026-01-01">
