          </p>
        </punkt>
        <punkt eId="DU/2025/1771__art_1__ust_3__pkt_3" gd:GUID="88733754-2ec9-4198-a343-ddf736862ecf" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1771_odczytane.x" wejscie-w-zycie="2026-01-01">
