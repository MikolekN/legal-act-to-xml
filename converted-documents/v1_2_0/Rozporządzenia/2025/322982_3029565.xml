        <p>
          <zdanie nr="1" gd:zdGUID="1a48781a-e2cd-40bb-98cd-ae0f54cff073" fragment="1" gd:fragmentGUID="a4bfd910-7386-42d3-857c-36bdd5d5f5f0" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-07_DU-2025-1265_domyslne.x" wejscie-w-zycie="2025-10-07">Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
