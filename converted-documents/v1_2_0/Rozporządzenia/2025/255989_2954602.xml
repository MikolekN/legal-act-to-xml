        <punkt eId="DU/2025/927__art_10__ust_1__pkt_7" gd:GUID="3dfec798-d6a2-4f44-96a7-d2c32a0bcec5" okres="okr_obowiazywanie.zdarz_wejscie_2025-07-26_DU-2025-927_domyslne.x" wejscie-w-zycie="2025-07-26">
