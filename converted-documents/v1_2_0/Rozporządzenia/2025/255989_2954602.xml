        </p>
        <punkt eId="DU/2025/927__art_10__ust_2__pkt_1" gd:GUID="ed51bc49-de52-4da4-974a-ea66d4df2e5b" okres="okr_obowiazywanie.zdarz_wejscie_2025-07-26_DU-2025-927_domyslne.x" wejscie-w-zycie="2025-07-26">
