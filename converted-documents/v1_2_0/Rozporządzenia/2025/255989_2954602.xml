        </punkt>
        <punkt eId="DU/2025/927__art_10__ust_2__pkt_3" gd:GUID="3c0aaae3-dee3-4ca7-9a82-ac64935de521" okres="okr_obowiazywanie.zdarz_wejscie_2025-07-26_DU-2025-927_domyslne.x" wejscie-w-zycie="2025-07-26">
          <nr>3</nr>
