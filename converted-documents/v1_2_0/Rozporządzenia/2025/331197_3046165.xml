          <nr>1</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="2f66a81f-bd00-4082-be08-05c67349711e" fragment="2" gd:fragmentGUID="cfedb77b-4ef8-4da5-baa3-84944331eec4" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-22_DU-2025-1353_domyslne.x" wejscie-w-zycie="2025-10-22">w § 1:</zdanie>
          </p>
          <litera eId="DU/2025/1353__art_1__pkt_1__lit_a" gd:GUID="eada00dc-a9df-419b-bc12-682bc1f30acf" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-22_DU-2025-1353_domyslne.x" wejscie-w-zycie="2025-10-22">
            <nr>a</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="2f66a81f-bd00-4082-be08-05c67349711e" fragment="3" gd:fragmentGUID="d968a1a0-9349-4830-b24f-8b90cc57bf11" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-22_DU-2025-1353_domyslne.x" wejscie-w-zycie="2025-10-22"><now:zamien-tekst stary-tekst="rzeźni" nowy-tekst="rzeźni lub zakładu obróbki dziczyzny" element-eId="DU/2022/1669__art_1__pkt_2" akt="https://eli.gov.pl/eli/DU/2022/1669" gd:nowGUID="766ad02c-51ec-427d-b472-087928261207" />w pkt 2 po wyrazie „rzeźni” dodaje się wyrazy „lub zakładu obróbki dziczyzny”,</zdanie>
            </p>
