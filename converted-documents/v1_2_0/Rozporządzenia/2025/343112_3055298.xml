      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="e68c6558-327f-4ba9-aeaf-9e467392052d" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-16_DU-2025-1393_odczytane.x" wejscie-w-zycie="2025-10-16">
