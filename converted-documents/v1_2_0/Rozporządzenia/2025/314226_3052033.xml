        </punkt>
        <punkt eId="DU/2025/1371__art_5__ust_1__pkt_3" gd:GUID="20236bf0-6616-46e2-98a6-8053ecb3eddb" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-14_DU-2025-1371_domyslne.x" wejscie-w-zycie="2026-03-14">
