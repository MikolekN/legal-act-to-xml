          <zdanie nr="1" gd:zdGUID="48cab979-0cd5-470d-afe9-bfda2bd5c371" fragment="1" gd:fragmentGUID="769d626a-0923-4be3-b3aa-e0de59d23737" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-01_DU-2025-1617_odczytane.x" wejscie-w-zycie="2025-12-01">Do postępowań wszczętych i niezakończonych przed dniem wejścia w życie niniejszego rozporządzenia stosuje się przepisy dotychczasowe.</zdanie>
        </p>
      </ustep-n>
    </paragraf>
    <paragraf eId="DU/2025/1617__art_5" gd:GUID="317ff2ab-621e-4a58-b3b4-9565c4fef8e5" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-01_DU-2025-1617_odczytane.x" wejscie-w-zycie="2025-12-01">
