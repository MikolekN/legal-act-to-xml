      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="594efd16-a329-48e2-ab6d-c56b87f9867f" okres="okr_obowiazywanie.zdarz_wejscie_2025-10-16_DU-2025-1387_domyslne.x" wejscie-w-zycie="2025-10-16">
