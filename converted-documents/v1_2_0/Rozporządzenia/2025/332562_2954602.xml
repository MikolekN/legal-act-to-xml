          </p>
        </punkt>
        <punkt eId="DU/2025/927__art_10__ust_1__pkt_7" gd:GUID="7fa4e4d4-fb6b-413a-8a82-b92e25cc1059" okres="okr_obowiazywanie.zdarz_wejscie_2025-07-26_DU-2025-927_domyslne.x" wejscie-w-zycie="2025-07-26">
