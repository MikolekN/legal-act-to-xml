        </p>
        <punkt eId="DU/2025/927__art_10__ust_2__pkt_1" gd:GUID="bca92e9e-de2b-456a-8fbe-0882da90b56d" okres="okr_obowiazywanie.zdarz_wejscie_2025-07-26_DU-2025-927_domyslne.x" wejscie-w-zycie="2025-07-26">
          <nr>1</nr>
          <p>
