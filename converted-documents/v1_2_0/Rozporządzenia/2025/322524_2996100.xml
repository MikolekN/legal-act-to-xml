          <nr>1</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="63097f09-70c9-4b39-bef5-ef2c93abc5e1" fragment="2" gd:fragmentGUID="450c44e0-4cdb-41b8-9fb9-701ee19ae341" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1145_odczytane.x" wejscie-w-zycie="2026-01-01">w § 2:</zdanie>
          </p>
