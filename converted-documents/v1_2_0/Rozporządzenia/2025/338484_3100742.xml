        <punkt eId="DU/2025/1622__art_2__pkt_3" gd:GUID="f7f0747a-b3de-45f4-96f8-633f40b873e5" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-01_DU-2025-1622_odczytane.x" wejscie-w-zycie="2025-12-01">
