    <paragraf eId="DU/2025/1622__art_4" gd:GUID="60f59f87-1b5a-45fd-8a4c-a647c078bdc6" okres="okr_obowiazywanie.zdarz_wejscie_2025-12-01_DU-2025-1622_odczytane.x" wejscie-w-zycie="2025-12-01">
