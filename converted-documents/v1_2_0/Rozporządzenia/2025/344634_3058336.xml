          </p>
        </punkt>
        <punkt eId="DU/2025/1404__art_2__ust_2__pkt_2" gd:GUID="8bad7c6c-6f16-4edb-a8b1-882081bc1de5" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-01_DU-2025-1404_domyslne.x" wejscie-w-zycie="2025-11-01">
          <nr>2</nr>
