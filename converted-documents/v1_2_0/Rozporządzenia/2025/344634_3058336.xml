          </p>
        </punkt>
      </ustep>
      <ustep eId="DU/2025/1404__art_2__ust_3" gd:GUID="99942a03-a292-4b19-b028-af7f34ae9286" okres="okr_obowiazywanie.zdarz_wejscie_2025-11-01_DU-2025-1404_domyslne.x" wejscie-w-zycie="2025-11-01">
