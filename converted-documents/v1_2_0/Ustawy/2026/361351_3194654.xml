    <artykul eId="DU/2026/177__art_2" gd:GUID="3eacc0e0-b8f9-46fa-b2f1-a11dabfc13c8" okres="okr_obowiazywanie.zdarz_wejscie_2026-03-04_DU-2026-177_domyslne.x" wejscie-w-zycie="2026-03-04">
