          </p>
        </punkt>
        <punkt eId="DU/2026/25__art_1__pkt_2" gd:GUID="8bd397cb-f6bf-4296-9934-019182f37d77" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-27_DU-2026-25_domyslne.x" wejscie-w-zycie="2026-01-27">
