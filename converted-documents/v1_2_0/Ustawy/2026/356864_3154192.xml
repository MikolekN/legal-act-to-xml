            </p>
          </litera>
          <litera eId="DU/2026/25__art_1__pkt_2__lit_b" gd:GUID="ded94f77-ac5f-463a-af51-8eaeadaca4ba" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-27_DU-2026-25_domyslne.x" wejscie-w-zycie="2026-01-27">
