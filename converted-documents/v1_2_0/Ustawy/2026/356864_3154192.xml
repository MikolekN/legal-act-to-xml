    <artykul eId="DU/2026/25__art_1" gd:GUID="e7280795-90eb-4997-8e40-28afbfb982a3" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-27_DU-2026-25_domyslne.x" wejscie-w-zycie="2026-01-27">
