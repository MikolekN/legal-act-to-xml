      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="46b76a43-dc8c-4964-9d36-cc0d73f39315" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-29_DU-2026-41_domyslne.x" wejscie-w-zycie="2026-01-29">
        <p>
          <zdanie nr="1" gd:zdGUID="5f295cf4-b5d1-49d9-b8ec-db1bb303e335" fragment="1" gd:fragmentGUID="666fe5ee-fe71-4885-bce1-5977d35ad5d4" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-29_DU-2026-41_domyslne.x" wejscie-w-zycie="2026-01-29">Ustawa wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
