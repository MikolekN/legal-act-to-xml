    </artykul>
    <artykul eId="DU/2025/289__art_3" gd:GUID="64756a45-1bef-4514-8cd6-57fe76192319" okres="okr_obowiazywanie.zdarz_wejscie_2025-04-01_DU-2025-289_odczytane.x" wejscie-w-zycie="2025-04-01">
      <nr>3</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="dab1721b-afc1-40bb-af82-b6f5c5d34aca" okres="okr_obowiazywanie.zdarz_wejscie_2025-04-01_DU-2025-289_odczytane.x" wejscie-w-zycie="2025-04-01">
        <p>
          <zdanie nr="1" gd:zdGUID="db9b151e-8289-446f-8369-a2375fd3288f" fragment="1" gd:fragmentGUID="69d90af0-e98b-4cf0-9a81-db1b67362a75" okres="okr_obowiazywanie.zdarz_wejscie_2025-04-01_DU-2025-289_odczytane.x" wejscie-w-zycie="2025-04-01">Ustawa wchodzi w życie z dniem 1 kwietnia 2025 r., z wyjątkiem art. 1 pkt 3, który wchodzi w życie z dniem 1 kwietnia 2026 r.</zdanie>
        </p>
      </ustep-n>
    </artykul>
