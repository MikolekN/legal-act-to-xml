            <nr>a</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="e8986e61-2fe5-423b-aa01-eddaf8b08acb" fragment="9" gd:fragmentGUID="26722b50-e99c-4e43-93e7-d73c136ae017" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-02_DU-2025-1818_domyslne.x" wejscie-w-zycie="2026-01-02"><now:uchyl akt="https://eli.gov.pl/eli/DU/2025/383" element-eId="DU/2025/383__art_231b__par_2" gd:nowGUID="c39fe5e8-4e1a-47fc-88d4-277e28157169" />uchyla się § 2,</zdanie>
            </p>
          </litera>
          <litera eId="DU/2025/1818__art_1__pkt_4__lit_b" gd:GUID="34968cba-10e1-4ef0-8190-0cbd731cf084" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-02_DU-2025-1818_domyslne.x" wejscie-w-zycie="2026-01-02">
            <nr>b</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="e8986e61-2fe5-423b-aa01-eddaf8b08acb" fragment="10" gd:fragmentGUID="fa71d419-527e-4b90-b1f9-64a17682ab4f" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-02_DU-2025-1818_domyslne.x" wejscie-w-zycie="2026-01-02">dodaje się § 3 w brzmieniu:<cytat-strukt now:akt="https://eli.gov.pl/eli/DU/2025/383" cudzyslowy="oba" gd:nowGUID="4c43b090-45a3-4de3-ad25-18e7ceedb737" element-eId="DU/2025/383__art_231b" funkcja="dodaj-w"><paragraf-kodeksu eId="DU/2025/383__art_231b__par_3" gd:GUID="7f74a839-ff37-47af-b1e7-427c35e1d4d4" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-02_DU-2025-1818_domyslne.x" wejscie-w-zycie="2026-01-02"><nr>3</nr><p><zdanie nr="1" gd:zdGUID="2caeb553-d71d-4868-8a96-16a0af161ea4" fragment="1" gd:fragmentGUID="5a1ad888-d141-4dd0-ab32-450da3f2894d" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-02_DU-2025-1818_domyslne.x" wejscie-w-zycie="2026-01-02">Jeżeli czyn sprawcy zamachu skierowany przeciwko osobie odpierającej zamach godzi wyłącznie w cześć lub godność tej osoby, ściganie następuje na wniosek pokrzywdzonego.</zdanie></p></paragraf-kodeksu></cytat-strukt>.</zdanie>
            </p>
          </litera>
        </punkt>
      </ustep-n>
