    <artykul eId="DU/2025/1818__art_2" gd:GUID="7ee1266d-73a2-4fe8-a2bb-97207031e910" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-02_DU-2025-1818_domyslne.x" wejscie-w-zycie="2026-01-02">
