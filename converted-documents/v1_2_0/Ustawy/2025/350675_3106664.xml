                </p>
              </podw-tiret>
            </tiret>
            <tiret eId="DU/2025/1657__art_1__pkt_1__lit_a__tir_2" gd:GUID="2cd6b8a9-7d19-480f-8a9e-d00bbee8aae4" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1657_odczytane.x" wejscie-w-zycie="2026-01-01">
