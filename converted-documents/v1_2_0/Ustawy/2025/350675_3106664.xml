    <artykul eId="DU/2025/1657__art_2" gd:GUID="34f4eb71-5d3c-4823-8ff6-1843dc15da68" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1657_odczytane.x" wejscie-w-zycie="2026-01-01">
