        <p>
          <zdanie nr="1" gd:zdGUID="b8d26344-ce6f-4b21-bea5-d9d856a25d0e" fragment="1" gd:fragmentGUID="da636f6f-b65c-4416-b3a2-96deb1c1e2b2" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1657_odczytane.x" wejscie-w-zycie="2026-01-01">Przepisy art. 6 ust. 1 pkt 10a i 11a oraz ust. 3a, art. 17 ust. 1 pkt 58, ust. 11 pkt 2 i ust. 13, art. 22c i art. 26 ust. 1h ustawy zmienianej w art. 1, w brzmieniu nadanym niniejszą ustawą, mają zastosowanie do dochodów (przychodów) uzyskanych od dnia 1 stycznia 2026 r.</zdanie>
        </p>
      </ustep-n>
    </artykul>
    <artykul eId="DU/2025/1657__art_3" gd:GUID="c282820c-c6d7-4732-aa0a-2dafb2cedc77" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1657_odczytane.x" wejscie-w-zycie="2026-01-01">
