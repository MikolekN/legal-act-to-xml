      <nr>4</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="6fdffc8f-46cc-478a-ae5f-fe01759bdb1b" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1817_odczytane.x" wejscie-w-zycie="2026-01-01">
        <p>
          <zdanie nr="1" gd:zdGUID="629e8dfe-6300-416e-9ed0-0cb2c9c66a2b" fragment="1" gd:fragmentGUID="9ebd36b0-4b93-4798-94cb-7a114abbd7b2" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1817_odczytane.x" wejscie-w-zycie="2026-01-01">Ustawa wchodzi w życie z dniem 1 stycznia 2026 r., z wyjątkiem art. 1 pkt 3 w zakresie art. 22j ust. 12 oraz art. 2 pkt 3 w zakresie art. 16j ust. 12, które wchodzą w życie z dniem ogłoszenia.</zdanie>
        </p>
