    <artykul eId="DU/2025/1817__art_3" gd:GUID="50414239-670d-4df2-9236-51bae8e2a56a" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1817_odczytane.x" wejscie-w-zycie="2026-01-01">
