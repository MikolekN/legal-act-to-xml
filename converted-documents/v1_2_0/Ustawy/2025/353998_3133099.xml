    <artykul eId="DU/2025/1814__art_2" gd:GUID="e0bebd29-d5d6-4fd0-86aa-e4ad5748ff77" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-02_DU-2025-1814_domyslne.x" wejscie-w-zycie="2026-01-02">
