        <punkt eId="DU/2025/1425__art_1__pkt_2" gd:GUID="1ada5a51-6be1-43ab-bc58-e04b7e74e33a" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-1425_odczytane.x" wejscie-w-zycie="2026-01-01">
