        <p>
          <zdanie nr="1" gd:zdGUID="58f318c1-d29e-4dc7-9a66-b811d1a6d844" fragment="1" gd:fragmentGUID="37ade129-3d36-4668-968e-6d0bce6697cc" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2025-896_odczytane.x" wejscie-w-zycie="2026-01-01">Ustawa wchodzi w życie z dniem 1 stycznia 2026 r.</zdanie>
        </p>
      </ustep-n>
    </artykul>
    <organ-podpisujacy>Prezydent Rzeczypospolitej Polskiej: <i><osoba podpisujacy="true" gd:osobaGUID="c1ba197c-a616-4614-8903-a087ffa57fc5"><imie>A.</imie> <nazwisko>Duda</nazwisko></osoba></i></organ-podpisujacy>
