    <artykul eId="DU/2025/1542__art_2" gd:GUID="1df2ef1d-d3c6-47f5-a883-5e464a4e1cf8" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-13_DU-2025-1542_domyslne.x" wejscie-w-zycie="2026-02-13">
      <nr>2</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="7df0f3e4-e45f-4cfc-b37f-ab423f748425" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-13_DU-2025-1542_domyslne.x" wejscie-w-zycie="2026-02-13">
        <p>
          <zdanie nr="1" gd:zdGUID="3bf84629-ca42-4abe-bd0e-bd6ec17295a9" fragment="1" gd:fragmentGUID="c90be4df-dc3a-4fc3-b786-09ef40f3a4af" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-13_DU-2025-1542_domyslne.x" wejscie-w-zycie="2026-02-13">Do wniosków o udostępnienie zbiorów danych rejestru cen nieruchomości złożonych i nierozpatrzonych przed dniem wejścia w życie niniejszej ustawy stosuje się przepisy ustawy zmienianej w art. 1 w brzmieniu dotychczasowym.</zdanie>
        </p>
      </ustep-n>
    </artykul>
    <artykul eId="DU/2025/1542__art_3" gd:GUID="6a535ac1-7435-4cd5-8c3d-2cb4edec3246" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-13_DU-2025-1542_domyslne.x" wejscie-w-zycie="2026-02-13">
      <nr>3</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="a76d60fd-6e3e-4de9-821c-748fa9525727" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-13_DU-2025-1542_domyslne.x" wejscie-w-zycie="2026-02-13">
        <p>
          <zdanie nr="1" gd:zdGUID="bdeee93d-7549-4977-a7b2-0f16da29351f" fragment="1" gd:fragmentGUID="77319d9e-8554-4464-b5a3-50fc6faf1c7b" okres="okr_obowiazywanie.zdarz_wejscie_2026-02-13_DU-2025-1542_domyslne.x" wejscie-w-zycie="2026-02-13">Dotychczasowe przepisy wykonawcze wydane na podstawie art. 40g ustawy zmienianej w art. 1 zachowują moc do dnia wejścia w życie przepisów wykonawczych wydanych na podstawie art. 40g ustawy zmienianej w art. 1, w brzmieniu nadanym niniejszą ustawą, jednak nie dłużej niż przez 6 miesięcy od dnia wejścia w życie niniejszej ustawy.</zdanie>
        </p>
      </ustep-n>
    </artykul>
