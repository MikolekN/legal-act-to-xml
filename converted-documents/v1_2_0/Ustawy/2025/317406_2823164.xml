          </p>
        </punkt>
        <punkt eId="DU/2025/240__art_1__pkt_5" gd:GUID="cce5d97f-2063-47f3-b812-2d8965759708" okres="okr_obowiazywanie.zdarz_wejscie_2025-03-01_DU-2025-240_domyslne.x" wejscie-w-zycie="2025-03-01">
