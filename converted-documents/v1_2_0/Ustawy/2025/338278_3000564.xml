        <p>
          <zdanie nr="1" gd:zdGUID="cebe05d8-a902-41b4-a1ef-744bf59a908f" fragment="1" gd:fragmentGUID="5e3ffc42-ef59-4805-9028-a0e02ad0682b" okres="okr_obowiazywanie.zdarz_wejscie_2025-09-09_DU-2025-1167_domyslne.x" wejscie-w-zycie="2025-09-09">Ustawa wchodzi w życie po upływie 14 dni od dnia ogłoszenia.</zdanie>
        </p>
      </ustep-n>
