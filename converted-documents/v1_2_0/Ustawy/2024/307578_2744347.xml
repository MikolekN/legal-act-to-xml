            <nr>b</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="6257bb83-1e45-4eb1-8d2b-58d99e76a247" fragment="4" gd:fragmentGUID="37a93307-e40a-4e3c-b899-488f03b75904" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2024-1761_odczytane.x" wejscie-w-zycie="2026-01-01"><now:uchyl akt="https://eli.gov.pl/eli/DU/2024/1491" element-eId="DU/2024/1491__art_10a__ust_1__pkt_4" gd:nowGUID="7a7d7d91-94f1-48b6-a2ce-b26ed5f03159" />uchyla się pkt 4,</zdanie>
