            <nr>c</nr>
            <p>
              <zdanie nr="1" gd:zdGUID="6257bb83-1e45-4eb1-8d2b-58d99e76a247" fragment="5" gd:fragmentGUID="425c2d35-0786-4b39-9455-d4cc961c0172" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2024-1761_odczytane.x" wejscie-w-zycie="2026-01-01">pkt 5 otrzymuje brzmienie:<cytat-strukt now:akt="https://eli.gov.pl/eli/DU/2024/1491" cudzyslowy="oba" gd:nowGUID="37e6caec-d3e3-4cce-9251-fda64d771e1f" element-eId="DU/2024/1491__art_10a__ust_1__pkt_5" funkcja="zastap"><punkt eId="DU/2024/1491__art_10a__ust_1__pkt_5" gd:GUID="2f6be035-bf7d-49e5-8851-4a4ecd58f1fe" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2024-1761_odczytane.x" wejscie-w-zycie="2026-01-01"><nr>5</nr><p><zdanie nr="1" gd:zdGUID="01783012-c08d-4810-88a4-689e988710b8" fragment="1" gd:fragmentGUID="5acea267-8420-4af5-af5c-26906c953d58" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2024-1761_odczytane.x" wejscie-w-zycie="2026-01-01">w roku poprzedzającym rok wyboru prowadzenia uproszczonej ewidencji przychodów i kosztów osiągnęły przychody w wysokości nieprzekraczającej 1 000 000 zł, nie wliczając wartości darowizn rzeczowych przeznaczonych na prowadzenie działalności statutowej</zdanie></p></punkt></cytat-strukt>;</zdanie>
            </p>
