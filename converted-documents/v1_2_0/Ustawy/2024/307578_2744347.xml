    <artykul eId="DU/2024/1761__art_3" gd:GUID="7e563b1e-024e-4944-80d9-4ae553c53821" okres="okr_obowiazywanie.zdarz_wejscie_2025-01-01_DU-2024-1761_odczytane.x" wejscie-w-zycie="2025-01-01">
      <nr>3</nr>
      <ustep-n brak-eid="jednostka-nieoznaczona" gd:GUID="5ed55a04-fc9e-4956-afa9-703cc06609ed" okres="okr_obowiazywanie.zdarz_wejscie_2025-01-01_DU-2024-1761_odczytane.x" wejscie-w-zycie="2025-01-01">
        <p>
          <zdanie nr="1" gd:zdGUID="aa523521-81cc-4641-b8d4-9be2c9edd618" fragment="1" gd:fragmentGUID="6e9351e2-0704-4927-827b-70000050e674" okres="okr_obowiazywanie.zdarz_wejscie_2025-01-01_DU-2024-1761_odczytane.x" wejscie-w-zycie="2025-01-01">W roku 2025 wysokość limitu przychodów, o których mowa w art. 10a ust. 1 pkt 5 ustawy zmienianej w art. 1 oraz art. 24 ust. 1 pkt 3 ustawy zmienianej w art. 2, wynosi 1 000 000 zł.</zdanie>
        </p>
