          </p>
        </punkt>
        <punkt eId="DU/2024/1761__art_2__pkt_3" gd:GUID="933e308c-23ce-46d0-b941-edc98833acba" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2024-1761_odczytane.x" wejscie-w-zycie="2026-01-01">
          <nr>3</nr>
          <p>
