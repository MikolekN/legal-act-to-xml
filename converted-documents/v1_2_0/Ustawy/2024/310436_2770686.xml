        </punkt>
        <punkt eId="DU/2024/1914__art_1__pkt_4" gd:GUID="7a846a2c-cb8c-495d-8e66-926a823139e3" okres="okr_obowiazywanie.zdarz_wejscie_2025-01-01_DU-2024-1914_odczytane.x" wejscie-w-zycie="2025-01-01">
