          </p>
        </punkt>
        <punkt eId="DU/2024/1914__art_1__pkt_3" gd:GUID="cb92b42c-211b-4a58-85f9-800a91d8a391" okres="okr_obowiazywanie.zdarz_wejscie_2025-01-01_DU-2024-1914_odczytane.x" wejscie-w-zycie="2025-01-01">
          <nr>3</nr>
          <p>
            <zdanie nr="1" gd:zdGUID="1f455cc6-4aa1-47d0-a393-901d63642799" fragment="4" gd:fragmentGUID="78f4d5dd-b15d-4641-90df-ab4ef7128046" okres="okr_obowiazywanie.zdarz_wejscie_2025-01-01_DU-2024-1914_odczytane.x" wejscie-w-zycie="2025-01-01">w art. 83 w ust. 1:</zdanie>
