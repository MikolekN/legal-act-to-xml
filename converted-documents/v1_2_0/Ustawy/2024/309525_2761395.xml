    <artykul eId="DU/2024/1853__art_5" gd:GUID="266d9f21-4c7a-4cd0-b057-4583af40b43b" okres="okr_obowiazywanie.zdarz_wejscie_2026-01-01_DU-2024-1853_odczytane.x" wejscie-w-zycie="2026-01-01">
