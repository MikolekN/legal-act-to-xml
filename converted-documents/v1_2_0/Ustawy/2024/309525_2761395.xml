          <zdanie nr="1" gd:zdGUID="7f1289a2-a518-4a2e-a304-9056d7b19777" fragment="1" gd:fragmentGUID="2226efd3-24b2-402b-af2d-d9d3cb7678b1" okres="okr_obowiazywanie.zdarz_wejscie_2024-12-31_DU-2024-1853_domyslne.x" wejscie-w-zycie="2024-12-31">Ustawa wchodzi w życie po upływie 14 dni od dnia ogłoszenia, z wyjątkiem:</zdanie>
