      <Tytul>Ustawa z dnia 20 marca 2025 r. o zmianie ustawy o zawodzie lekarza weterynarii i izbach lekarskoweterynaryjnych</Tytul>
      <Rodzaj>USTAWA</Rodzaj>
      <DataOgloszenia>2025-04-22</DataOgloszenia>
      <DataAktu>
        <DataWydania>2025-03-20</DataWydania>
      </DataAktu>
      <Organy>
        <Organ GUID="b3ccd009-1fc3-4c96-a3ac-af0b2ea945ea" rola="wydający" eliURI="URI">
