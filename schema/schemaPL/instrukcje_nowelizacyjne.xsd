<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="https://projects.task.gda.pl/caise/NLP/kisi/rcl/schemaPL/now"
           xmlns:now="https://projects.task.gda.pl/caise/NLP/kisi/rcl/schemaPL/now"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://projects.task.gda.pl/caise/NLP/kisi/rcl/schemaPL/now"
           elementFormDefault="qualified">
	<!--
    ============================================================
      INSTRUKCJE NOWELIZACYJNE DLA SCHEMY POLSKIEGO AKTU PRAWNEGO SCHEMAPL.XSD
      Wersja: 0.2.6
      Na podstawie pliku przygotowanego w 2010 r. przez Szymona Ziolo (RedPill Szymon Ziolo).
      Modyfikacja w 2026 r.: Patryk Ciurak
      ============================================================
    -->
	<!-- Lokalny GUIDTyp — taki sam wzorzec jak w schemaPL, bez importu zwrotnego -->
	<xs:simpleType name="GUIDTyp">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:attribute name="akt" type="xs:anyURI">
		<xs:annotation>
			<xs:documentation>ELI aktu prawnego, który podlega nowelizacji.</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="wystapienie" default="wszystkie">
		<xs:annotation>
			<xs:documentation>Wskazanie, którego wystąpienia tekstu ustawy nowelizowanej dotyczy instukcja.</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:token">
				<xs:enumeration value="pierwsze"/>
				<xs:enumeration value="drugie"/>
				<xs:enumeration value="trzecie"/>
				<xs:enumeration value="ostatnie"/>
				<xs:enumeration value="wszystkie"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:attribute>

	<xs:attributeGroup name="instr-nowelizacyjne">

		<xs:attribute ref="akt" use="required"/>

		<xs:attribute name="nowGUID" type="GUIDTyp" use="required">
			<xs:annotation>
				<xs:documentation>Unikalny GUID nowelizacji.</xs:documentation>
			</xs:annotation>
		</xs:attribute>

		<xs:attribute name="ref-nowGUID" type="GUIDTyp">
			<xs:annotation>
				<xs:documentation>GUID nowelizacji (zastap, dodaj-po itp.), do której się odwołuje odwołanie.</xs:documentation>
			</xs:annotation>
		</xs:attribute>

		<xs:attribute name="element-eId" type="xs:token" use="required">
			<!-- W tym momencie jest to token, docelowo powinien być ELI konkretnej jednostki redakcyjnej. -->
			<xs:annotation>
				<xs:documentation>Wskazanie eId jednostki redakcyjnej w ustawie nowelizowanej, która jest punktem odniesienia dla nowelizacji.</xs:documentation>
			</xs:annotation>
		</xs:attribute>

		<xs:attribute name="element-do-eId" type="xs:token"/>
		<!-- j.w. -->

		<xs:attribute name="zdanieGUID" type="GUIDTyp">
			<xs:annotation>
				<xs:documentation>Zdanie, które jest punktem odniesienia dla nowelizacji (np. podlega nowelizacji bądź po nim jest dodawany tekst).</xs:documentation>
			</xs:annotation>
		</xs:attribute>

		<xs:attribute name="fragmentGUID" type="GUIDTyp">
			<xs:annotation>
				<xs:documentation>GUID fragmentu zdania, które podlega nowelizacji.</xs:documentation>
			</xs:annotation>
		</xs:attribute>

		<xs:attribute name="funkcja" use="required">
			<xs:annotation>
				<xs:documentation>Określenie funkcji pełnionej przez cytat.</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:token">

					<xs:enumeration value="dodaj-w">
						<xs:annotation>
							<xs:documentation>Dodanie wewnątrz wskazanej jednostki redakcyjnej, na końcu jej zawartości, nowych jednostek niższego poziomu (np. dodanie w punkcie zawierającym litery kolejnych liter na końcu).</xs:documentation>
						</xs:annotation>
					</xs:enumeration>

					<xs:enumeration value="dodaj-po">
						<xs:annotation>
							<xs:documentation>Dodanie jednostek redakcyjnych po wskazanej jednostce redakcyjnej.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>

					<xs:enumeration value="zastap">
						<xs:annotation>
							<xs:documentation>Zastąpienie podanych jednostek redakcyjnych (a nie fragmentu tekstu) przez nową zawartość.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>

					<xs:enumeration value="dodaj-po-tekscie">
						<xs:annotation>
							<xs:documentation>Wskazanie tekstu, po którym ma nastąpić dodanie nowej treści.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>

					<xs:enumeration value="zastap-tekst">
						<xs:annotation>
							<xs:documentation>Wskazanie tekstu, który ma zostać zastąpiony nową treścią. Należy określić fragment zdania, który podlega nowelizacji.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>

					<!--					<xs:enumeration value="nowy-tekst">-->
					<!--						<xs:annotation>-->
					<!--							<xs:documentation>Wskazanie tekstu, który ma zostać dodany lub zastąpić pewien fragment tekstu. Używane łącznie z funkcją "dodaj-po-tekscie" lub "zastap-tekst".</xs:documentation>-->
					<!--						</xs:annotation>-->
					<!--					</xs:enumeration>-->

					<xs:enumeration value="uchyl-tekst">
						<xs:annotation>
							<xs:documentation>Wskazanie fragmentu tekstu do uchylenia.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>

					<xs:enumeration value="dodaj-recznie">
						<xs:annotation>
							<xs:documentation>Wskazanie tekstu, który musi zostać dodany ręcznie (np. gdy musi być dodany w kilku miejscach, w różnych liczbach i przypadkach).</xs:documentation>
						</xs:annotation>
					</xs:enumeration>

					<xs:enumeration value="zastap-recznie">
						<xs:annotation>
							<xs:documentation>Wskazanie tekstu, który musi zostać zastąpiony ręcznie (np. gdy musi być zmieniony w kilku miejscach, w różnych liczbach i przypadkach).</xs:documentation>
						</xs:annotation>
					</xs:enumeration>

					<xs:enumeration value="uchyl-recznie">
						<xs:annotation>
							<xs:documentation>Wskazanie tekstu, który musi być uchylony ręcznie (np. gdy nie można go precyzyjnie wskazać).</xs:documentation>
						</xs:annotation>
					</xs:enumeration>

				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>

		<xs:attribute ref="wystapienie"/>

	</xs:attributeGroup>


	<xs:group name="instrukcja-nowelizacyjna">
		<xs:choice>

			<xs:element name="uchyl">
				<xs:annotation>
					<xs:documentation>Instrukcja uchylająca wskazaną jednostkę redakcyjną lub zakres jednostek.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:attribute name="akt" type="xs:anyURI" use="required">
						<xs:annotation>
							<xs:documentation>Identyfikator aktu zawierającego jednostkę redakcyjną podlegającą uchyleniu.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="element-eId" type="xs:token" use="required">
						<xs:annotation>
							<xs:documentation>Identyfikator jednostki redakcyjnej podlegającej uchyleniu.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="element-do-eId" type="xs:token">
						<xs:annotation>
							<xs:documentation>Identyfikator końca zakresu uchylanych jednostek redakcyjnych. Jeśli podany, atrybut "element-eId" pełni rolę identyfikatora początku zakresu.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="zdanieGUID" type="GUIDTyp">
						<xs:annotation>
							<xs:documentation>Zdanie, które podlega nowelizacji.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="fragmentGUID" type="GUIDTyp">
						<xs:annotation>
							<xs:documentation>GUID fragmentu zdania, które podlega nowelizacji.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="nowGUID" type="GUIDTyp" use="required">
						<xs:annotation>
							<xs:documentation>GUID danej nowelizacji.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:complexType>
			</xs:element>

			<xs:element name="uchyl-akt">
				<xs:annotation>
					<xs:documentation>Instrukcja uchylająca cały akt prawny.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="oprocz" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Wskazanie jednostki redakcyjnej lub zakresu jednostek, które nie podlegają uchyleniu.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:attribute name="element-eId" type="xs:token" use="required">
									<xs:annotation>
										<xs:documentation>Identyfikator jednostki redakcyjnej, która nie podlega uchyleniu (lub początku zakresu jednostek, wspólnie z atrybutem element-do).</xs:documentation>
									</xs:annotation>
								</xs:attribute>
								<xs:attribute name="element-do-eId" type="xs:token">
									<xs:annotation>
										<xs:documentation>Identyfikator końca zakresu jednostek redakcyjnych, które nie podlegają uchyleniu.</xs:documentation>
									</xs:annotation>
								</xs:attribute>
								<xs:attribute name="obowiazuje-do" type="xs:date">
									<xs:annotation>
										<xs:documentation>Data obowiązywania wskazanych jednostek redakcyjnych.</xs:documentation>
									</xs:annotation>
								</xs:attribute>
								<xs:attribute name="zdanieGUID" type="GUIDTyp">
									<xs:annotation>
										<xs:documentation>Wskazanie zdania w jednostce redakcyjnej, które nie podlega uchyleniu.</xs:documentation>
									</xs:annotation>
								</xs:attribute>
								<xs:attribute name="fragmentGUID" type="GUIDTyp">
									<xs:annotation>
										<xs:documentation>Wskazanie fragmentu zdania w jednostce redakcyjnej, który nie podlega uchyleniu.</xs:documentation>
									</xs:annotation>
								</xs:attribute>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="akt" use="required">
						<xs:annotation>
							<xs:documentation>Identyfikator uchylanego aktu prawnego.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="nowGUID" type="GUIDTyp" use="required">
						<xs:annotation>
							<xs:documentation>GUID danej nowelizacji.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:complexType>
			</xs:element>

			<xs:element name="dodaj-ustep">
				<xs:annotation>
					<xs:documentation>Instrukcja obudowująca dotychczasową treść jednostki redakcyjnej dodatkowym poziomem struktury — ustępem.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:attribute name="element-eId" type="xs:token" use="required">
						<xs:annotation>
							<xs:documentation>Identyfikator jednostki redakcyjnej, w której zostanie dodany nowy ustęp.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="ustep-n-GUID" type="GUIDTyp">
						<xs:annotation>
							<xs:documentation>GUID jednostki typu ustep-n, która zostanie zamieniona na jawny, nowy ustęp.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="akt" use="required">
						<xs:annotation>
							<xs:documentation>Akt (ELI), które podlega nowelizacji.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="nowGUID" type="GUIDTyp" use="required">
						<xs:annotation>
							<xs:documentation>GUID danej nowelizacji.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:complexType>
			</xs:element>

			<xs:element name="dodaj-paragraf">
				<xs:annotation>
					<xs:documentation>Instrukcja obudowująca dotychczasową treść jednostki redakcyjnej dodatkowym poziomem struktury — paragrafem.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:attribute name="element-eId" type="xs:token" use="required">
						<xs:annotation>
							<xs:documentation>Identyfikator jednostki redakcyjnej, w której zostanie dodany nowy paragraf.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="paragraf-kodeksu-n-GUID" type="GUIDTyp">
						<xs:annotation>
							<xs:documentation>GUID jednostki typu paragraf-kodeksu-n, która zostanie zamieniona na jawny, nowy paragraf kodeksu.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="akt" use="required">
						<xs:annotation>
							<xs:documentation>Akt (ELI), które podlega nowelizacji.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="nowGUID" type="GUIDTyp" use="required">
						<xs:annotation>
							<xs:documentation>GUID danej nowelizacji.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:complexType>
			</xs:element>

			<xs:element name="usun-ustep">
				<xs:annotation>
					<xs:documentation>Instrukcja spłaszczająca strukturę — likwidująca pojedynczy ustęp i przenosząca jego treść na poziom nadrzędnej jednostki redakcyjnej (artykułu lub paragrafu).</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:attribute name="element-eId" type="xs:token" use="required">
						<xs:annotation>
							<xs:documentation>Identyfikator jednostki redakcyjnej, w której nastąpi spłaszczenie.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="akt" use="required">
						<xs:annotation>
							<xs:documentation>Akt (ELI), które podlega nowelizacji.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="nowGUID" type="GUIDTyp" use="required">
						<xs:annotation>
							<xs:documentation>GUID danej nowelizacji.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:complexType>
			</xs:element>

			<xs:element name="zastap">
				<xs:annotation>
					<xs:documentation>Instrukcja zastąpienia pewnych jednostek redakcyjnych przez inne, niewidoczna w treści aktu nowelizującego. Należy ją stosować, gdy zmiany nie da się zakodować przy pomocy innych konstrukcji.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:any namespace="https://projects.task.gda.pl/caise/NLP/kisi/rcl/schemaPL/1.0"
						        maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Zawartość, która zastąpi wskazane jednostki redakcyjne.</xs:documentation>
							</xs:annotation>
						</xs:any>
					</xs:sequence>
					<xs:attribute name="element-eId" type="xs:token" use="required">
						<xs:annotation>
							<xs:documentation>Identyfikator zastępowanej jednostki redakcyjnej.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="element-do-eId" type="xs:token">
						<xs:annotation>
							<xs:documentation>Identyfikator końca zakresu zastępowanych jednostek redakcyjnych. Jeśli podany, atrybut "element-eId" pełni rolę identyfikatora początku zakresu.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="akt" use="required">
						<xs:annotation>
							<xs:documentation>Akt (ELI), które podlega nowelizacji.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="zdanieGUID" type="GUIDTyp">
						<xs:annotation>
							<xs:documentation>Wskazanie zdania w jednostce redakcyjnej, które podlega zastąpieniu.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="fragmentGUID" type="GUIDTyp">
						<xs:annotation>
							<xs:documentation>Wskazanie fragmentu zdania w jednostce redakcyjnej, który podlega zastąpieniu.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="nowGUID" type="GUIDTyp" use="required">
						<xs:annotation>
							<xs:documentation>GUID danej nowelizacji.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:complexType>
			</xs:element>

			<xs:element name="zastap-numer">
				<xs:annotation>
					<xs:documentation>Instrukcja wskazuje numer jednostki redakcyjnej, który ma otrzymać nową wartość.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:attribute name="element-eId" type="xs:token" use="required">
						<xs:annotation>
							<xs:documentation>Identyfikator zastępowanego numeru jednostki redakcyjnej.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="element-eId-nowy" type="xs:token" use="required">
						<xs:annotation>
							<xs:documentation>Identyfikator zastępującego numeru jednostek redakcyjnych.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="akt" use="required">
						<xs:annotation>
							<xs:documentation>Akt (ELI), które podlega nowelizacji.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="nowGUID" type="GUIDTyp" use="required">
						<xs:annotation>
							<xs:documentation>GUID danej nowelizacji.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:complexType>
			</xs:element>

			<xs:element name="zamien-tekst">
				<xs:annotation>
					<xs:documentation>Instrukcja zastąpienia pewnego tekstu (np. znaku interpunkcyjnego) przez inny, gdy w tekście zmieniającym nie został użyty cytat-strukt.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:attribute name="stary-tekst" type="xs:token" use="required">
						<xs:annotation>
							<xs:documentation>Oznaczenie tekstu, który ma być zastąpiony.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="nowy-tekst" type="xs:token" use="required">
						<xs:annotation>
							<xs:documentation>Oznaczenie tekstu, który zastępuje.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="element-eId" type="xs:token" use="required">
						<xs:annotation>
							<xs:documentation>Identyfikator jednostki redakcyjnej, w której dokonuje się zamiany.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="element-do-eId" type="xs:token">
						<xs:annotation>
							<xs:documentation>Identyfikator końca zakresu jednostek redakcyjnych, w których dokonuje się zamiany. Jeśli podany, atrybut "element-eId" pełni rolę identyfikatora początku zakresu.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="akt" use="required">
						<xs:annotation>
							<xs:documentation>Akt (ELI), który podlega nowelizacji.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="zdanieGUID" type="GUIDTyp">
						<xs:annotation>
							<xs:documentation>Wskazanie zdania w jednostce redakcyjnej, które podlega zastąpieniu.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="fragmentGUID" type="GUIDTyp">
						<xs:annotation>
							<xs:documentation>Wskazanie fragmentu zdania w jednostce redakcyjnej, które podlega zastąpieniu.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="nowGUID" type="GUIDTyp" use="required">
						<xs:annotation>
							<xs:documentation>GUID danej nowelizacji.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute ref="now:wystapienie"/>
				</xs:complexType>
			</xs:element>
		</xs:choice>
	</xs:group>


</xs:schema>