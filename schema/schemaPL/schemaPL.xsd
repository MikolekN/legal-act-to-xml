	<xs:group name="od-tiret">
		<xs:sequence>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element name="piec-tiret" type="PiecTiretTyp"/>
				<xs:element ref="czesc-wspolna-piec-tiret"/>
			</xs:choice>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element name="poczw-tiret" type="PoczwTiretTyp"/>
				<xs:element ref="czesc-wspolna-poczw-tiret"/>
			</xs:choice>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element name="potr-tiret" type="PotrTiretTyp"/>
