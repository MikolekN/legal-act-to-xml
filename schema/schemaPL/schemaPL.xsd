	<xs:complexType name="JednostkaRedakcyjnaNumerowanaTyp">
		<xs:annotation>
			<xs:documentation>Typ bazowy dla jednostek redakcyjnych posiadających numer (artykułu, paragrafu, punktu, litery).</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="JednostkaRedakcyjnaTyp">
				<xs:sequence>
					<xs:element name="nr">
						<xs:annotation>
							<xs:documentation>Numer jednostki redakcyjnej. </xs:documentation>
						</xs:annotation>
						<xs:simpleType>
							<xs:restriction base="xs:string">
								<xs:pattern value="([IVXLCDM]+|[1-9]\d*[a-z]*|[a-z]+)(\[[1-9]\d*[a-z]*\])?"/> <!--Wzór zaktualizowany o możliwość użycia nawiasów kwadratowych wprowadzony nowelizacją ZTP z 1.03.2026 r. Rozpoznaje również liczby rzymskie. Do wpisywania indeksów górnych należy używać nawiasów kwadratowych [ ].-->
							</xs:restriction>
						</xs:simpleType>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="JednostkaRedakcyjnaNumerowanaTJTyp">
		<xs:annotation>
			<xs:documentation>Typ bazowy dla jednostek redakcyjnych w TJ posiadających numer (artykułu, paragrafu, punktu, litery).</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="JednostkaRedakcyjnaTyp">
				<xs:sequence>
					<xs:element name="nr">
						<xs:annotation>
							<xs:documentation>Numer jednostki redakcyjnej być może z pogrubieniem i odnośnikiem. Ze względu na typ mieszany nie można zweryfikować postaci tekstu. </xs:documentation>
						</xs:annotation>
						<xs:complexType mixed="true">
							<xs:sequence>
								<xs:element name="b" type="ZawartoscTekstowaBezCytatuTyp" minOccurs="0"/> <!--Wcześniej było type="string"-->
								<xs:choice minOccurs="0">
									<xs:element ref="odsylacz-do-odnosnika"/>
									<xs:element ref="odnosnik"/>
								</xs:choice>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="ArtykulUstawyTyp">
		<xs:complexContent>
			<xs:extension base="JednostkaRedakcyjnaNumerowanaTyp">
