			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="LiteraTyp">
		<xs:complexContent>
			<xs:extension base="JednostkaRedakcyjnaNumerowanaTJTyp">
				<xs:sequence>
					<xs:group ref="akapit-dowolny"/>
