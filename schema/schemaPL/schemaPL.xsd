	<xs:group name="akapit-dowolny">
		<xs:annotation>
			<xs:documentation>Pojedynczy akapit w schemie base.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="p" type="ZawartoscTekstowaTyp"/>
			<xs:group ref="kontynuacja-akapitu"/>
		</xs:sequence>
	</xs:group>

	<xs:group name="rozszerzenie-kontynuacji">
		<xs:annotation>
			<xs:documentation>Pozwala wstawić treść specjalną w dowolnym miejscu ciągłości tekstu, bez łamania struktury głównego modelu.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element ref="specjalny" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:group>
	<!--
        <xs:element name="hiperlacze" type="HiperlaczePodstawoweTyp"/>

        <xs:group name="dodatkowe-elementy">
            <xs:choice>
                <xs:element ref="hiperlacze"/>
                <xs:element name="hiperlacze-zakres" type="HiperlaczeZakresTyp"/>
            </xs:choice>
        </xs:group>
    -->
	<xs:group name="dodatkowe-elementy">
		<xs:choice>
			<xs:element ref="ref"/>
			<xs:element ref="rref"/>
			<xs:element ref="mref"/>
		</xs:choice>
	</xs:group>


	<!--
        ============================================================
        SEKCJA: PATOJEDNOSTKI
        Są to jednostki, których zadaniem jest obsłużyć błędy prawodawcy np. ustępy dzielące się od razu na litery.
        Pato-ustępy i Pato-paragrafy-kodeksu mają również swoje wersje niejawne (N).
        ============================================================
    -->
	<xs:complexType name="PatoArtykulParagrafTyp">
		<xs:complexContent>
			<xs:extension base="JednostkaRedakcyjnaNumerowanaTJTyp"><!--Używam typu JednostkaRedakcyjnaNumerowanaTJTyp, aby umożliwić dodawanie odnośnika przy patojednostkach.-->
				<xs:sequence>
					<xs:group ref="akapit-dowolny"/>
					<xs:group ref="od-ustepu-paragrafu-kodeksu"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="PatoUstepParagrafKodeksuTyp">
		<xs:complexContent>
			<xs:extension base="JednostkaRedakcyjnaNumerowanaTJTyp">
				<xs:sequence>
					<xs:group ref="akapit-dowolny"/>
					<xs:group ref="od-punktu"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="PatoUstepParagrafKodeksuNTyp">
		<xs:complexContent>
			<xs:extension base="JednostkaRedakcyjnaTyp">
				<xs:sequence>
					<xs:group ref="akapit-dowolny"/>
					<xs:group ref="od-punktu"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="PunktTyp">
		<xs:complexContent>
			<xs:extension base="JednostkaRedakcyjnaNumerowanaTJTyp">
				<xs:sequence>
					<xs:group ref="akapit-dowolny"/>
