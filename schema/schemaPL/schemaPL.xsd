	<!--
      Status obowiązywania aktu wg słownika ISAP
    -->
	<xs:simpleType name="StatusAktuTyp">
		<xs:restriction base="xs:string">
			<xs:enumeration value="akt obowiązujący"/>
			<xs:enumeration value="uznany za uchylony"/>
			<xs:enumeration value="uchylony"/>
			<xs:enumeration value="wygaśnięcie aktu"/>
			<xs:enumeration value="nieobowiązujący - uchylona podstawa prawna"/>
			<xs:enumeration value="akt jednorazowy"/>
			<xs:enumeration value="akt indywidualny"/>
			<xs:enumeration value="projekt"/>
		</xs:restriction>
	</xs:simpleType>
	<!--
      Binarny status obowiązywania
      Właściwość ELI: eli:in_force
    -->
	<xs:simpleType name="CzyObowiazujeTyp">
		<xs:restriction base="xs:string">
			<xs:enumeration value="IN_FORCE"/>
			<xs:enumeration value="NOT_IN_FORCE"/>
		</xs:restriction>
	</xs:simpleType>

	<!--
      Rola organu w akcie.
      Właściwości ELI: eli:passed_by (wydający), eli:authorized_by (uprawniony)
    -->
	<xs:simpleType name="RolaOrganTyp">
		<xs:restriction base="xs:string">
			<xs:enumeration value="wydający"/>
			<xs:enumeration value="uprawniony"/>
			<xs:enumeration value="zobowiązany"/>
			<xs:enumeration value="podpisujący"/>
			<xs:enumeration value="wnioskodawca"/>
			<xs:enumeration value="w porozumieniu"/>
			<xs:enumeration value="opiniujący"/>
			<xs:enumeration value="uzgadniający"/>
			<xs:enumeration value="za zgodą"/>
		</xs:restriction>
	</xs:simpleType>

	<!--
      Typ pliku tekstowego aktu
      Właściwość ELI: eli:format
    -->
	<xs:simpleType name="TypTekstuTyp">
		<xs:restriction base="xs:string">
			<xs:enumeration value="O"/>  <!-- oryginał -->
			<xs:enumeration value="H"/>  <!-- HTML -->
			<xs:enumeration value="I"/>  <!-- oryginalny PDF (wersja ISAP) -->
			<xs:enumeration value="T"/>  <!-- tekst aktu, który powstał w Kancelarii Sejmu -->
			<xs:enumeration value="U"/>  <!-- tekst ujednolicony przez ISAP-->
		</xs:restriction>
	</xs:simpleType>

	<!--
        *TYP PODPISU ELEKTRONICZNEGO
    -->
	<!--
      Dane podpisu elektronicznego organu
      Zakres: W = właściwy; kody [TOUDP] = role szczegółowe
    -->
	<xs:complexType name="PodpisElektronicznyTyp">
		<xs:all>
			<xs:element name="NrSeryjny" type="xs:token"/>
			<xs:element name="Osoba" type="xs:string"/>
			<xs:element name="Zakres">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="W"/>
						<xs:pattern value="[TOUDP]{0,5}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DataPodpisu" type="xs:dateTime"/>
		</xs:all>
	</xs:complexType>

	<!--
        *TYPY ZŁOŻONE
    -->
	<!-- Data częściowa z opcjonalnym wskazaniem jednostki redakcyjnej w formacie ELI -->
	<xs:complexType name="DataCzesciowaTyp">
		<xs:annotation>
			<xs:documentation>
				Szczególna data, która dotyczy konkretnej jednostki redakcyjnej, w tym data mocy wstecznej. Jednostka identyfikowana przez podanie eId/URI jednostki redakcyjnej.
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Jednostka" type="xs:anyURI" minOccurs="0"/>
			<xs:element name="Data" type="DataOpcjTyp" minOccurs="1"/>
			<xs:element name="Jednostka-w-zakresie" type="xs:anyURI" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>
						Wskazanie jednostki z fragmentu tekstu zmieniającego (cytatu strukturalnego), w stosunku do której prawodawca przyjął inną datę, np. używając zwrotu "w zakresie".
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Uwagi-redakcyjne" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>

	<!-- Poprzednie tytuły aktu -->
	<xs:complexType name="TytulyPoprzednieTyp">
		<xs:sequence>
			<xs:element name="TytulPoprzedni" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<!-- Słowa kluczowe tematyczne (eli:subject_matter) -->
	<xs:complexType name="ListaTerminowTyp">
		<xs:sequence>
			<xs:element name="Termin" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

