<?xml version='1.0' encoding='UTF-8'?>
<xs:schema
		xmlns="https://projects.task.gda.pl/caise/NLP/kisi/rcl/schemaPL/1.0"
		xmlns:now="https://projects.task.gda.pl/caise/NLP/kisi/rcl/schemaPL/now"
		xmlns:xs="http://www.w3.org/2001/XMLSchema"
		xmlns:mml="http://www.w3.org/1998/Math/MathML"
		xmlns:md="https://projects.task.gda.pl/caise/NLP/kisi/rcl/schemaPL/1.0"
		targetNamespace="https://projects.task.gda.pl/caise/NLP/kisi/rcl/schemaPL/1.0"
		elementFormDefault="qualified">
	<!--
      ============================================================
      SCHEMA POLSKIEGO AKTU PRAWNEGO SCHEMAPL
      Wersja: 0.1.21
      Na podstawie plików przygotowanych:
      w 2010 r. przez Szymona Ziolo (RedPill Szymon Ziolo)
      w 2018 r. przez dr. Jarosława Demineta.
      Kompilacja i dodatkowe zmiany: dr Patryk Ciurak (2026 r.)
      ============================================================-->
	<xs:import namespace="http://www.w3.org/1998/Math/MathML" schemaLocation="mathml3.xsd"/>
	<xs:import namespace="https://projects.task.gda.pl/caise/NLP/kisi/rcl/schemaPL/now" schemaLocation="instrukcje_nowelizacyjne.xsd"/>
	<!--
      ============================================================
      SEKCJA: TYPOGRAFIA
      Definiuje niskopoziomowe narzędzia formatowania tekstu — to jest "skrzynka z narzędziami" dla całej reszty schematu.
      ============================================================
      -->
	<xs:simpleType name="WyrownanieTyp">
		<xs:restriction base="xs:string">
			<xs:enumeration value="left"/>
			<xs:enumeration value="right"/>
			<xs:enumeration value="center"/>
			<xs:enumeration value="justify"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="KolumnaTyp">
		<xs:annotation>
			<xs:documentation>Numer kolumny w przypadku użycia układu wielokolumnowego.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:positiveInteger">
			<xs:minInclusive value="1"/>
			<xs:maxInclusive value="4"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="PustyTekstTyp">
		<xs:restriction base="xs:string">
			<xs:enumeration value=""/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="PtTyp">
		<xs:restriction base="xs:string">
			<xs:pattern value="\d*(\.\d*)?pt"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="PtZnakTyp">
		<xs:restriction base="xs:string">
			<xs:pattern value="-?\d*(\.\d*)?pt"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="BoolOpcjTyp">
		<xs:union memberTypes="xs:boolean PustyTekstTyp"/>
	</xs:simpleType>

	<xs:simpleType name="TabTyp">
		<xs:restriction base="xs:string">
			<xs:pattern value="(kropki|lewy|prawy|srodkowy|dziesietny)=\d*(\.\d*)?pt(,(kropki|lewy|prawy|srodkowy|dziesietny)=\d*(\.\d*)?pt)+"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:attributeGroup name="typoBezKwalifikacjiPelne">
		<xs:annotation>
			<xs:documentation>Atrybuty dowolnego akapitu.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="margin-left" type="PtTyp" form="unqualified"/>
		<xs:attribute name="margin-right" type="PtTyp" form="unqualified"/>
	</xs:attributeGroup>

	<xs:attributeGroup name="typoSpecjalne">
		<xs:annotation>
			<xs:documentation>Atrybuty akapitu specjalnego.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="margin-left" type="PtTyp" form="unqualified"/>
		<xs:attribute name="margin-right" type="PtTyp" form="unqualified"/>
		<xs:attribute name="margin-top" type="PtTyp" form="unqualified"/>
		<xs:attribute name="margin-bottom" type="PtTyp" form="unqualified"/>
		<xs:attribute name="line-height" type="PtTyp" form="unqualified"/>
		<xs:attribute name="text-indent" type="PtZnakTyp" form="unqualified"/>
		<xs:attribute name="znastepnym" type="BoolOpcjTyp" form="unqualified"/>
		<xs:attribute name="wierszerazem" type="BoolOpcjTyp" form="unqualified"/>
		<xs:attribute name="nowastrona" type="BoolOpcjTyp" form="unqualified"/>
		<xs:attribute name="bezprzenoszenia" type="BoolOpcjTyp" form="unqualified"/>
		<xs:attribute name="text-align" type="WyrownanieTyp" form="unqualified"/>
		<xs:attribute name="tabulatory" type="TabTyp" form="unqualified"/>
		<xs:attribute name="kolumna" type="KolumnaTyp" form="unqualified"/>
	</xs:attributeGroup>

	<xs:group name="formatowanieAkapituCzesciowe">
		<xs:annotation>
			<xs:documentation>Atrybuty dowolnego akapitu.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="akapit" minOccurs="0">
				<xs:complexType>
					<xs:attributeGroup ref="atrybutyAkapituFormatowanie"/>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:group>

	<xs:attributeGroup name="atrybutyAkapituFormatowanie">
		<xs:attribute name="margin-top" type="PtTyp"/>
		<xs:attribute name="margin-bottom" type="PtTyp"/>
		<xs:attribute name="margin-left" type="PtTyp"/>
		<xs:attribute name="line-height" type="PtTyp"/>
		<xs:attribute name="text-indent" type="PtZnakTyp"/>

		<xs:attribute name="znastepnym" type="BoolOpcjTyp"/>
		<xs:attribute name="wierszerazem" type="BoolOpcjTyp"/>
		<xs:attribute name="nowastrona" type="BoolOpcjTyp"/>
		<xs:attribute name="bezprzenoszenia" type="BoolOpcjTyp"/>

		<xs:attribute name="text-align" type="WyrownanieTyp"/>
		<xs:attribute name="tabulatory" type="TabTyp"/>
	</xs:attributeGroup>

	<xs:element name="typografia">
		<xs:complexType>
			<xs:attribute name="nieprzenosic" type="BoolOpcjTyp" form="qualified"/>
			<xs:attribute name="sciagniecie" type="BoolOpcjTyp" form="qualified"/>
		</xs:complexType>
	</xs:element>

	<!--
        ============================================================
        SEKCJA: WSPOLNE
        Definiuje podstawowe elementy składowe każdego aktu prawnego.
        ============================================================
    -->

	<xs:simpleType name="GUIDTyp">
		<xs:restriction base="xs:string">
			<xs:pattern value="[\da-fA-F]{8}(-)[\da-fA-F]{4}(-)[\da-fA-F]{4}(-)[\da-fA-F]{4}(-)[\da-fA-F]{12}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:attributeGroup name="cytat">
		<xs:annotation>
			<xs:documentation>Atrybuty cytatu fragmentu innego aktu prawnego.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="cudzyslowy" use="required">
			<xs:annotation>
				<xs:documentation>Czy cytat powinien być wyświetlany w cudzysłowach.</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:integer">
					<xs:minInclusive value="0"/>
					<xs:maxInclusive value="3"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:attributeGroup>

	<xs:attributeGroup name="atrybuty-akapitu">
		<xs:attribute name="GUID" type="GUIDTyp"/>
		<xs:attribute name="opinie">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="uwagi"/>
					<xs:enumeration value="uzasadnienie"/>
					<xs:enumeration value="uwagi uzasadnienie"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attributeGroup ref="typoBezKwalifikacjiPelne"/>
	</xs:attributeGroup>

	<xs:attributeGroup name="wejscie-w-zycie">
		<xs:annotation>
			<xs:documentation>Data wejścia w życie jednostki redakcyjnej lub systematyzacyjnej.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="wejscie-w-zycie" type="xs:date" use="optional"/>
		<xs:attribute name="status-jednostki" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="projektowane"/>
					<xs:enumeration value="obowiazuje"/><!--Brak wartości "nieobowiązuje", gdyż przy wytworzeniu tekstu jednolitego uchylone jednostki otrzymują oznaczenie "(uchylony)".-->
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:attributeGroup>

	<xs:attributeGroup name="enklawy">
		<xs:attribute name="enclaves" type="xs:base64Binary">
			<xs:annotation>
				<xs:documentation>Zawiera skrót dokumentu XML zawierającego ewentualne "wyspy" aplikacji EAP.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:attributeGroup>

	<xs:attributeGroup name="referencja">
		<xs:annotation>
			<xs:documentation>Atrybuty opisujące odwołanie do zewnętrznego pliku binarnego dla grafiki.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="href" type="xs:anyURI" use="required"/>
		<xs:attribute name="skrot" type="xs:base64Binary"/>
	</xs:attributeGroup>

	<xs:group name="e-podpisy">
		<xs:sequence>
			<xs:any namespace="http://www.w3.org/2000/09/xmldsig#" minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
		</xs:sequence>
	</xs:group>

	<xs:group name="zawartosc-tekstowa-bez-cytatu">
		<xs:annotation>
			<xs:documentation>Elementy używane w zawartości tekstowej.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="b" type="ZawartoscTekstowaBezCytatuTyp">
				<xs:annotation>
					<xs:documentation>Wytłuszczenie.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="i" type="ZawartoscTekstowaBezCytatuTyp">
				<xs:annotation>
					<xs:documentation>Kursywa.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="sup" type="ZawartoscTekstowaBezCytatuTyp">
				<xs:annotation>
					<xs:documentation>Indeks górny.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="sub" type="ZawartoscTekstowaBezCytatuTyp">
				<xs:annotation>
					<xs:documentation>Indeks dolny.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="wersaliki" type="ZawartoscTekstowaBezCytatuTyp">
				<xs:annotation>
					<xs:documentation>Wersaliki.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="rozstrzelone" type="ZawartoscTekstowaBezCytatuTyp">
				<xs:annotation>
					<xs:documentation>Rozstrzelenie.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="petit" type="ZawartoscTekstowaBezCytatuTyp">
				<xs:annotation>
					<xs:documentation>Zmniejszenie czcionki.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="h" type="xs:anyURI">
				<xs:annotation>
					<xs:documentation>Hiperłącze (w załącznikach i w hiperłączach).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="odnosnik"/>
			<xs:element ref="odsylacz-do-odnosnika"/>
			<xs:element name="pole">
				<xs:complexType>
					<xs:annotation>
						<xs:documentation>Pole do wprowadzania danych.</xs:documentation>
					</xs:annotation>
					<xs:simpleContent>
						<xs:extension base="xs:string">
							<xs:attribute name="nazwa" type="xs:string"/>
							<xs:attribute name="metadane" type="XpathMetadaneTyp"/>
							<xs:attribute name="styl" type="xs:token"/>
							<xs:attribute name="kod" type="xs:token"/>
							<xs:attribute name="data" type="xs:string"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element ref="typografia"/>
			<xs:group ref="dodatkowe-elementy"/>
			<xs:group ref="now:instrukcja-nowelizacyjna"/>
			<xs:element name="wynik-inline" type="xs:string"/>
			<xs:element name="podmiot-inicjujacy" type="xs:string"/>
			<xs:element name="tryb-orzekania" type="xs:string"/>
			<xs:element name="kwestionowany-przepis">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:token">
							<xs:attributeGroup ref="uniwersalneELI"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="wzorzec-kontroli">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:token">
							<xs:attributeGroup ref="uniwersalneELI"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="definicja-legalna">
				<xs:complexType mixed="true">
					<xs:group ref="zawartosc-tekstowa-bez-cytatu" minOccurs="0" maxOccurs="unbounded"/>
					<xs:attribute name="GUID" type="GUIDTyp"/>
				</xs:complexType>
			</xs:element>
			<!--Skrót może obejmować też fragmenty zaczynające się od "zwany/a dalej".-->
			<xs:element name="skrot">
				<xs:complexType mixed="true">
					<xs:group ref="zawartosc-tekstowa-bez-cytatu" minOccurs="0" maxOccurs="unbounded"/>
					<xs:attribute name="GUID" type="GUIDTyp"/>
				</xs:complexType>
			</xs:element>
			<!--odeslanie-tytul stosowane jest w przypadku, gdy prawodawca podaje TYLKO tytul aktu, bez jakichkolwiek danych identyfikacyjnych np. Kodeks karny.-->
			<xs:element name="odeslanie-tytul" type="xs:string"/>
			<!--Komentarz, który można zamieścić w treści.-->
			<xs:element name="komentarz-redakcyjny">
				<xs:complexType mixed="true">
					<xs:group ref="zawartosc-tekstowa-bez-cytatu" minOccurs="0" maxOccurs="unbounded"/>
					<xs:attribute name="GUID"   type="GUIDTyp"  use="optional"/>
					<xs:attribute name="autor"  type="xs:string" use="optional"/>
					<xs:attribute name="data"   type="xs:date"   use="optional"/>
				</xs:complexType>
			</xs:element>
		</xs:choice>
	</xs:group>

	<xs:group name="cytat-wspolne">
		<xs:choice>
			<xs:element ref="sankcja-karna"/>
			<xs:element ref="slubowanie"/>
			<xs:element ref="fragment"/>
			<xs:group ref="grupa-tabeli"/>
			<xs:element ref="grafika"/>
			<xs:element ref="grafika-wektorowa"/>
			<xs:element ref="wzor-mat"/>
			<xs:element ref="czesc-wspolna-punkt"/>
			<xs:element ref="czesc-wspolna-litera"/>
			<xs:element ref="czesc-wspolna-tiret"/>
			<xs:element ref="czesc-wspolna-podw-tiret"/>
			<!-- tiret wyższych stopni nie mogą byc cytowane -->
			<xs:element ref="odnosnik-cyt" maxOccurs="unbounded"/>
			<xs:element ref="punkt-odnosnik" maxOccurs="unbounded"/>
			<xs:element ref="fragment-odnosnik" maxOccurs="unbounded"/>
			<xs:element ref="litera-odnosnik" maxOccurs="unbounded"/>
			<xs:element ref="tiret-odnosnik" maxOccurs="unbounded"/>
			<xs:element ref="czesc-wspolna-punkt-odnosnik"/>
			<xs:element ref="czesc-wspolna-litera-odnosnik"/>
			<xs:element ref="czesc-wspolna-tiret-odnosnik"/>
			<xs:element ref="specjalny" maxOccurs="unbounded"/>
		</xs:choice>
	</xs:group>

	<xs:group name="kontynuacja-akapitu">
		<xs:sequence>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="sankcja-karna"/>
				<xs:element ref="slubowanie"/>
				<xs:element ref="fragment"/>
				<xs:group ref="grupa-tabeli"/>
				<xs:element ref="grafika"/>
				<xs:element ref="grafika-wektorowa"/>
				<xs:element ref="wzor-mat"/>
				<xs:group ref="rozszerzenie-kontynuacji"/>
			</xs:choice>
		</xs:sequence>
	</xs:group>

	<xs:group name="jednostka-systematyzacyjna">
		<xs:choice>
			<xs:element name="czesc" type="CzescTyp"/>
			<xs:element name="czesc-n" type="CzescNTyp"/>
			<xs:element name="ksiega" type="KsiegaTyp"/>
			<xs:element name="ksiega-n" type="KsiegaNTyp"/>
			<xs:element name="tytul-jednostka" type="TytulTyp"/>
			<xs:element name="tytul-n-jednostka" type="TytulNTyp"/>
			<xs:element name="dzial" type="DzialTyp"/>
			<xs:element name="dzial-n" type="DzialNTyp"/>
			<xs:element name="rozdzial" type="RozdzialTyp"/>
			<xs:element name="rozdzial-n" type="RozdzialNTyp"/>
			<xs:element name="oddzial" type="OddzialTyp"/>
			<xs:element name="oddzial-n" type="OddzialNTyp"/>
		</xs:choice>
	</xs:group>

	<xs:group name="podpisy"> <!--Do sprawdzenia, czy rzeczywiście jest potrzebna obecnie. W przypadku aktów wydawanych w porozumieniu podpisuje obecnie tylko główny organ.-->
		<xs:sequence>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element name="organ-wydajacy" type="JednostkaTekstowaTyp"/>
				<xs:element name="organ-podpisujący" type="JednostkaTekstowaTyp"/>
				<xs:element name="tekst-w-porozumieniu" type="JednostkaTekstowaTyp"/> <!--Chodzi o zwrot "w porozumieniu z"-->
				<xs:element name="organ-w-porozumieniu" type="JednostkaTekstowaTyp"/>
			</xs:choice>
		</xs:sequence>
	</xs:group>

	<xs:group name="tresc-odnosnika">
		<xs:sequence>
			<xs:element name="p" type="ZawartoscTekstowaTyp"/>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="punkt-odnosnik"/>
				<xs:element ref="fragment-odnosnik"/>
				<xs:element ref="czesc-wspolna-punkt-odnosnik"/>
			</xs:choice>
		</xs:sequence>
	</xs:group>

	<xs:complexType name="JednostkaRedakcyjnaTyp">
		<xs:annotation>
			<xs:documentation>Typ bazowy dla jednostek redakcyjnych (artykułu, paragrafu, punktu, litery, tiret, podwójnego tiret).</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:group ref="formatowanieAkapitu"/>
		</xs:sequence>
		<xs:attributeGroup ref="atrybuty-akapitu"/>
		<xs:attributeGroup ref="eId"/> <!-- Jeśli ELI nie zostanie użyte, jest to celowe.-->
		<xs:attributeGroup ref="wejscie-w-zycie"/>
	</xs:complexType>

	<xs:complexType name="JednostkaRedakcyjnaNumerowanaProstaTyp">
		<xs:annotation>
			<xs:documentation>Typ bazowy dla jednostek redakcyjnych posiadających prosty numer (np. w odnośnikach, w tekście wyświetlanym w stopce strony - przypisach dolnych).</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="JednostkaRedakcyjnaTyp"> <!--Dawniej było JednostkaRedakcyjnaBezELITyp-->
				<xs:sequence>
					<xs:element name="nr">
						<xs:annotation>
							<xs:documentation>Numer jednostki redakcyjnej. </xs:documentation>
						</xs:annotation>
						<xs:simpleType>
							<xs:restriction base="xs:string">
								<xs:pattern value="([IVXLCDM]+|[1-9]\d*[a-z]*|[a-z]+)(\[[1-9]\d*[a-z]*\])?"/> <!--Wzór zaktualizowany o możliwość użycia nawiasów kwadratowych wprowadzony nowelizacją ZTP z 1.03.2026 r. Rozpoznaje również liczby rzymskie. Do wpisywania indeksów górnych należy używać nawiasów kwadratowych [ ].-->
							</xs:restriction>
						</xs:simpleType>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="ZawartoscTekstowaBezCytatuTyp" mixed="true">
		<xs:annotation>
			<xs:documentation>Typ elementów p oraz innych o zawartości tekstowej bez cytatów strukturalnych.</xs:documentation>
		</xs:annotation>
		<xs:group ref="zawartosc-tekstowa-bez-cytatu" minOccurs="0" maxOccurs="unbounded"/>
	</xs:complexType>

	<xs:complexType name="JednostkaTekstowaTyp" mixed="true">
		<xs:annotation>
			<xs:documentation>Typ jednostki redakcyjnej lub systematyzacyjnej bezpośrednio zawierającej tekst (bez elementu p).</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:group ref="formatowanieAkapitu"/>
			<xs:group ref="zawartosc-tekstowa-bez-cytatu" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attributeGroup ref="atrybuty-akapitu"/>
		<xs:attributeGroup ref="eId"/>
	</xs:complexType>

	<xs:complexType name="JednostkaRedakcyjnaTekstowaTyp">
		<xs:annotation>
			<xs:documentation>Typ jednostki składającej się z pojedynczego akapitu tekstowego (np. części wspólne).</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="JednostkaRedakcyjnaTyp">
				<xs:sequence>
					<xs:element name="p" type="ZawartoscTekstowaTyp"/>
					<xs:group ref="rozszerzenie-kontynuacji"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="NaglowekJednostkiSystematyzacyjnejTyp">
		<xs:annotation>
			<xs:documentation>Typ nagłówka jednostki systematyzacyjnej posiadającej numer (tytułu, działu, rozdziału, oddziału). Dla uproszczenia nie wyróżnia się wersji z prostym numerem. Może nie być treści ze względu na ew. uchylenie.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="JednostkaRedakcyjnaNumerowanaTJTyp">
				<xs:sequence>
					<xs:choice minOccurs="0">
						<xs:element name="p">
							<xs:complexType mixed="true">
								<xs:sequence>
									<xs:group ref="formatowanieAkapitu"/>
									<xs:group ref="zawartosc-tekstowa-bez-cytatu" minOccurs="0" maxOccurs="unbounded"/>
								</xs:sequence>
								<xs:attributeGroup ref="atrybuty-akapitu"/>
							</xs:complexType>
						</xs:element>
						<xs:element name="uchylenie-OTJ" type="JednostkaTekstowaTyp"/><!--Znaczenie tej jednostki: patrz xs:documentation wyżej.-->
					</xs:choice>
					<xs:group ref="rozszerzenie-kontynuacji"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:element name="odnosnik">
		<xs:annotation>
			<xs:documentation>Odnośnik. Treść odnośnika jest umieszczana w zawartości elementu.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="JednostkaRedakcyjnaTyp">
					<xs:group ref="tresc-odnosnika"/>
					<xs:attribute name="id-odnosnika" type="xs:token"><!--Do zastanowienia, czy xs:token nie zamienić lepiej na xs:ID / xs:IDREF.-->
						<xs:annotation>
							<xs:documentation>Identyfikator pozwalający na umieszczanie kolejnych odwołań do tego samego odnośnika oraz odsyłaczy do odnośnika.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="symbol" type="xs:token">
						<xs:annotation>
							<xs:documentation>Identyfikator pozwalający na umieszczanie niestandardowego oznaczenia odnośnika.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="super" type="xs:token">
						<xs:annotation>
							<xs:documentation>Identyfikator określający czy odnośnik jest odnośnikiem do odnośnika.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="punkt-odnosnik">
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="JednostkaRedakcyjnaNumerowanaProstaTyp">
					<xs:sequence>
						<xs:element name="p" type="ZawartoscTekstowaTyp"/>
						<xs:choice minOccurs="0" maxOccurs="unbounded">
							<xs:element ref="litera-odnosnik"/>
							<xs:element ref="czesc-wspolna-litera-odnosnik"/>
						</xs:choice>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="litera-odnosnik">
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="JednostkaRedakcyjnaNumerowanaProstaTyp">
					<xs:sequence>
						<xs:element name="p" type="ZawartoscTekstowaTyp"/>
						<xs:choice minOccurs="0" maxOccurs="unbounded">
							<xs:element ref="tiret-odnosnik"/>
							<xs:element ref="czesc-wspolna-tiret-odnosnik"/>
						</xs:choice>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="fragment-odnosnik" type="JednostkaRedakcyjnaTekstowaTyp"/>

	<xs:element name="tiret-odnosnik" type="JednostkaRedakcyjnaTekstowaTyp"/>

	<xs:element name="czesc-wspolna-punkt-odnosnik" type="JednostkaRedakcyjnaTekstowaTyp"/>

	<xs:element name="czesc-wspolna-litera-odnosnik" type="JednostkaRedakcyjnaTekstowaTyp"/>

	<xs:element name="czesc-wspolna-tiret-odnosnik" type="JednostkaRedakcyjnaTekstowaTyp"/>

	<xs:element name="odsylacz-do-odnosnika">
		<xs:annotation>
			<xs:documentation>Powtórzenie lub odwołanie do odnośnika (w treści aktu lub w innym odnośniku).</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="id-odnosnika" type="xs:token" use="required"><!--Do zastanowienia, czy xs:token nie zamienić lepiej na xs:ID / xs:IDREF.-->
				<xs:annotation>
					<xs:documentation>Wartość atrybutu id-odnośnika elementu odnośnik, do którego się odwołujemy. </xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="symbol" type="xs:token">
				<xs:annotation>
					<xs:documentation>Identyfikator pozwalający na umieszczanie niestandardowego oznaczenia odnośnika.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="super" type="xs:token">
				<xs:annotation>
					<xs:documentation>Identyfikator określający czy odnośnik jest odnośnikiem do odnośnika.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>

	<xs:element name="podstawa-prawna" type="JednostkaTekstowaTyp"/><!--Fragment charakterystyczny dla aktów wykonawczych.-->

	<xs:element name="slubowanie" type="JednostkaTekstowaTyp"/>

	<xs:element name="fragment" type="JednostkaTekstowaTyp"/>

	<xs:element name="sankcja-karna" type="JednostkaTekstowaTyp"/>

	<xs:element name="odnosnik-cyt">
		<xs:annotation>
			<xs:documentation>Cytowany odnośnik. Składnia jak normalnego odnośnika, bez wydzielania numeru.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="JednostkaRedakcyjnaTyp">
					<xs:group ref="tresc-odnosnika"/>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>

	<!--To chyba jest zbędne.
        <xs:element name="czesc-wspolna-ustep-paragraf-kodeksu" type="JednostkaRedakcyjnaTekstowaTyp">
            <xs:annotation>
                <xs:documentation>Część wspólna podsumowująca wyliczenie ustępów ustawy/paragrafów kodeksu.</xs:documentation>
            </xs:annotation>
        </xs:element>
    -->
	<xs:element name="czesc-wspolna-punkt" type="JednostkaRedakcyjnaTekstowaTyp">
		<xs:annotation>
			<xs:documentation>Część wspólna podsumowująca wyliczenie punktów.</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:element name="czesc-wspolna-litera" type="JednostkaRedakcyjnaTekstowaTyp">
		<xs:annotation>
			<xs:documentation>Część wspólna podsumowująca wyliczenie liter.</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:element name="czesc-wspolna-tiret" type="JednostkaRedakcyjnaTekstowaTyp">
		<xs:annotation>
			<xs:documentation>Część wspólna podsumowująca wyliczenie tiretów.</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:element name="czesc-wspolna-podw-tiret" type="JednostkaRedakcyjnaTekstowaTyp">
		<xs:annotation>
			<xs:documentation>Część wspólna podsumowująca wyliczenie podwójnych tiretów.</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:element name="czesc-wspolna-potr-tiret" type="JednostkaRedakcyjnaTekstowaTyp">
		<xs:annotation>
			<xs:documentation>Część wspólna podsumowująca wyliczenie potrójnych tiretów.</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:element name="czesc-wspolna-poczw-tiret" type="JednostkaRedakcyjnaTekstowaTyp">
		<xs:annotation>
			<xs:documentation>Część wspólna podsumowująca wyliczenie poczwórnych tiretów.</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:element name="czesc-wspolna-piec-tiret" type="JednostkaRedakcyjnaTekstowaTyp">
		<xs:annotation>
			<xs:documentation>Część wspólna podsumowująca wyliczenie pięciokrotnych tiretów.</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:element name="specjalny">
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="ZawartoscTekstowaBezCytatuTyp">
					<xs:attributeGroup ref="typoSpecjalne"/>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="grafika">
		<xs:annotation>
			<xs:documentation>Odwołanie do zewnętrznego pliku zawierającego grafikę rastrową.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="JednostkaRedakcyjnaTyp">
					<xs:attributeGroup ref="referencja"/>
					<xs:attribute name="width" type="xs:string">
						<xs:annotation>
							<xs:documentation>Szerokość do jakiej ma być przeskalowany obrazek.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="height" type="xs:string">
						<xs:annotation>
							<xs:documentation>Wysokość do jakiej ma być przeskalowany obrazek.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="alt" type="xs:string">
						<xs:annotation>
							<xs:documentation>Tekstowy opis grafiki.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="grafika-wektorowa">
		<xs:annotation>
			<xs:documentation>Grafika wektorowa zapisana w formacie SVG.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="JednostkaRedakcyjnaTyp">
					<xs:sequence>
						<xs:any namespace="http://www.w3.org/2000/svg" processContents="skip"/>
					</xs:sequence>
					<xs:attribute name="href" type="xs:anyURI">
						<xs:annotation>
							<xs:documentation>Opcjonalna referencja do grafiki rastrowej reprezentującej rysunek.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="width" type="xs:string">
						<xs:annotation>
							<xs:documentation>Szerokość do jakiej ma być przeskalowany rysunek.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="height" type="xs:string">
						<xs:annotation>
							<xs:documentation>Wysokość do jakiej ma być przeskalowany rysunek.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="skrot" type="xs:string">
						<xs:annotation>
							<xs:documentation>Skrót opcjonalnej grafiki rastrowej reprezentującej rysunek.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="wzor-mat">
		<xs:annotation>
			<xs:documentation>Wzór matematyczny zapisany w języku MathML wraz z objaśnieniami symboli.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="JednostkaRedakcyjnaTyp">
					<xs:sequence>
						<xs:element ref="mml:math"/>
						<xs:element name="opis" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Opis pojedynczego symbolu użytego we wzorze.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:choice minOccurs="0">
										<xs:element name="symbol-txt" type="ZawartoscTekstowaBezCytatuTyp">
											<xs:annotation>
												<xs:documentation>Opisywany symbol przedstawiony w formie tekstowej.</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="symbol-mat">
											<xs:annotation>
												<xs:documentation>Opisywany symbol przedstawiony jako wyrażenie w języku MathML.</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:sequence>
													<xs:element ref="mml:math"/>
												</xs:sequence>
												<xs:attribute name="grafika" type="xs:anyURI">
													<xs:annotation>
														<xs:documentation>Opcjonalna referencja do grafiki reprezentującej symbol matematyczny.</xs:documentation>
													</xs:annotation>
												</xs:attribute>
												<xs:attribute name="skrot" type="xs:string">
													<xs:annotation>
														<xs:documentation>Skrót opcjonalnej grafiki reprezentującej symbol matematyczny.</xs:documentation>
													</xs:annotation>
												</xs:attribute>
											</xs:complexType>
										</xs:element>
									</xs:choice>
									<xs:element name="objasnienie">
										<xs:annotation>
											<xs:documentation>Objaśnienie znaczenia symbolu.</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:group ref="tresc-akapitowa"/>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="grafika" type="xs:anyURI">
						<xs:annotation>
							<xs:documentation>Opcjonalna referencja do grafiki reprezentującej wzór matematyczny.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="skrot" type="xs:string">
						<xs:annotation>
							<xs:documentation>Skrót opcjonalnej grafiki reprezentującej symbol matematyczny.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>

	<!--
    *********** Model tabel oparty na HTML-u  ***********
    -->

	<xs:simpleType name="SzerokoscProcentowaTyp">
		<xs:restriction base="xs:string">
			<xs:pattern value="[1-9]\d*%|0%"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="StylRamkiTyp">
		<xs:restriction base="xs:string">
			<xs:enumeration value="solid"/>
			<xs:enumeration value="none"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="GruboscRamkiTyp">
		<xs:restriction base="xs:string">
			<xs:enumeration value="thin"/>
			<xs:enumeration value="medium"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:attributeGroup name="tabele-pion">
		<xs:annotation>
			<xs:documentation>Ułożenie pionowe zawartości komórek.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="vertical-align">
			<xs:simpleType>
				<xs:restriction base="xs:token">
					<xs:enumeration value="top"/>
					<xs:enumeration value="middle"/>
					<xs:enumeration value="bottom"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:attributeGroup>

	<xs:attributeGroup name="tabele-ramki">
		<xs:attribute name="border-bottom-style" type="StylRamkiTyp"/>
		<xs:attribute name="border-bottom-width" type="GruboscRamkiTyp"/>
		<xs:attribute name="border-left-style" type="StylRamkiTyp"/>
		<xs:attribute name="border-left-width" type="GruboscRamkiTyp"/>
		<xs:attribute name="border-right-style" type="StylRamkiTyp"/>
		<xs:attribute name="border-right-width" type="GruboscRamkiTyp"/>
		<xs:attribute name="border-top-style" type="StylRamkiTyp"/>
		<xs:attribute name="border-top-width" type="GruboscRamkiTyp"/>
		<xs:attribute name="border-tl2br-style" type="StylRamkiTyp"/>
		<xs:attribute name="border-tl2br-width" type="GruboscRamkiTyp"/>
	</xs:attributeGroup>

	<xs:group name="grupa-tabeli">
		<xs:sequence>
			<xs:element ref="tytul-tabeli" minOccurs="0"/>
			<xs:element ref="tabela"/>
			<xs:sequence minOccurs="0">
				<xs:element ref="odstep-tabeli"/>
				<xs:element ref="tabela"/>
			</xs:sequence>
		</xs:sequence>
	</xs:group>

	<xs:element name="odstep-tabeli" type="ZawartoscTekstowaBezCytatuTyp"/>

	<xs:element name="tytul-tabeli" type="JednostkaTekstowaTyp"/>

	<xs:element name="tabela">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="tbody">
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="tr" maxOccurs="unbounded"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="eapid" type="xs:integer"/>
			<xs:attribute name="style" type="xs:token"/>
			<xs:attribute name="width" type="SzerokoscProcentowaTyp"/>
		</xs:complexType>
	</xs:element>

	<xs:element name="tr">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="td" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="naglowek"/>
			<xs:attribute name="niedzielic"/>
		</xs:complexType>
	</xs:element>

	<xs:element name="td">
		<xs:complexType>
			<xs:sequence>
				<xs:choice minOccurs="0" maxOccurs="unbounded">
					<xs:element ref="tytul-kolumny"/>
					<xs:element ref="tekst-centr"/>
					<xs:element ref="liczba"/>
					<xs:element ref="wyliczenie-1"/>
					<xs:element ref="wyliczenie-2"/>
					<xs:element ref="wyliczenie-3"/>
					<xs:element ref="wyliczenie-4"/>
					<xs:element ref="tekst-zwykly"/>
					<xs:element ref="tekst-1"/>
					<xs:element ref="tekst-2"/>
					<xs:element ref="tekst-3"/>
					<xs:element ref="specjalny"/>
				</xs:choice>
			</xs:sequence>
			<xs:attributeGroup ref="tabele-pion"/>
			<xs:attributeGroup ref="tabele-ramki"/>
			<xs:attribute name="colspan" type="xs:integer"/>
			<xs:attribute name="rowspan" type="xs:integer"/>
			<xs:attribute name="width" type="SzerokoscProcentowaTyp"/>
		</xs:complexType>
	</xs:element>

	<xs:element name="tytul-kolumny" type="JednostkaTekstowaTyp"/>
	<xs:element name="tekst-centr" type="JednostkaTekstowaTyp"/>
	<xs:element name="liczba" type="JednostkaTekstowaTyp"/>
	<xs:element name="wyliczenie-1" type="JednostkaTekstowaTyp"/>
	<xs:element name="wyliczenie-2" type="JednostkaTekstowaTyp"/>
	<xs:element name="wyliczenie-3" type="JednostkaTekstowaTyp"/>
	<xs:element name="wyliczenie-4" type="JednostkaTekstowaTyp"/>
	<xs:element name="tekst-zwykly" type="JednostkaTekstowaTyp"/>
	<xs:element name="tekst-1" type="JednostkaTekstowaTyp"/>
	<xs:element name="tekst-2" type="JednostkaTekstowaTyp"/>
	<xs:element name="tekst-3" type="JednostkaTekstowaTyp"/>

	<!--
        ============================================================
        SEKCJA: ZALACZNIK
        ============================================================
    -->
	<xs:complexType name="ZalacznikTyp">
		<xs:sequence>
			<xs:any namespace="##any" minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
		</xs:sequence>
		<xs:attribute name="orientacja">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="pionowa"/>
					<xs:enumeration value="pozioma"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="odnosniki">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="kontynuacja"/>
					<xs:enumeration value="litery"/>
					<xs:enumeration value="kontynuacja litery"/>
					<xs:enumeration value="litery kontynuacja"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attributeGroup ref="wejscie-w-zycie"/>
		<xs:attribute name="GUID" type="GUIDTyp" use="optional"/>
		<xs:attributeGroup ref="eId"/>
	</xs:complexType>

	<xs:complexType name="ZalacznikUzasadnieniaTyp">
		<xs:complexContent>
			<xs:extension base="ZalacznikTyp">
				<xs:attribute name="nowa-strona">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="tak"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:group name="zalaczniki">
		<xs:sequence>
			<xs:element name="zalacznik" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:choice minOccurs="0" maxOccurs="unbounded">
						<xs:element name="zalacznik-do"      type="JednostkaTekstowaTyp"/>
						<xs:element name="zalacznik-nr"      type="JednostkaRedakcyjnaNumerowanaTyp"/>
						<xs:element name="tytul-zalacznika"  type="JednostkaTekstowaTyp"/>
						<xs:element name="segment-zalacznika" type="ZalacznikTyp"/>
						<xs:element name="zalacznik-binarny">
							<xs:complexType>
								<xs:attribute name="href"        type="xs:anyURI"/>
								<xs:attribute name="skala"       type="xs:integer"/>
								<xs:attribute name="przesuniecie" type="xs:integer"/>
								<xs:attribute name="GUID"       type="GUIDTyp"/>
							</xs:complexType>
						</xs:element>
					</xs:choice>
					<xs:attributeGroup ref="eId"/>
					<xs:attribute name="GUID" type="GUIDTyp"/>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:group>


	<!--
        ============================================================
        SEKCJA: AKAPIT
        ============================================================
    -->
	<xs:complexType name="CytatStruktPustyTyp">
		<xs:annotation>
			<xs:documentation>
				Cytat strukturalny bez walidowanej zawartości — używany w kontekstach generycznych (patojednostki), gdzie typ cytowanych jednostek nie jest z góry znany.
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:any namespace="##any" minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
		</xs:sequence>
		<xs:attributeGroup ref="cytat"/>
		<xs:attributeGroup ref="now:instr-nowelizacyjne"/>
	</xs:complexType>

	<xs:complexType name="CytatStruktPelnyTyp">
		<xs:annotation>
			<xs:documentation>
				Cytat strukturalny z walidowaną zawartością jednostek redakcyjnych aktu, używany w akapitach.
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:choice>
				<xs:sequence>
					<xs:choice maxOccurs="unbounded">
						<xs:group ref="jednostka-systematyzacyjna"/>
						<xs:element name="artykul" type="ArtykulUstawyLubKodeksuTyp"/>
					</xs:choice>
				</xs:sequence>
				<xs:element ref="preambula"/>
				<xs:element name="ustep"              type="UstepTyp"             maxOccurs="unbounded"/>
				<xs:element name="ustep-n"            type="UstepNTyp"/>
				<xs:element name="paragraf-kodeksu"   type="ParagrafKodeksuTyp"   maxOccurs="unbounded"/>
				<xs:element name="paragraf-kodeksu-n" type="ParagrafKodeksuNTyp"/>
				<xs:element name="punkt"              type="PunktUstawyTyp"       maxOccurs="unbounded"/>
				<xs:element name="litera"             type="LiteraUstawyTyp"      maxOccurs="unbounded"/>
				<xs:element name="tiret"              type="TiretUstawyTyp"       maxOccurs="unbounded"/>
				<xs:element name="podw-tiret"         type="PodwTiretUstawyTyp"   maxOccurs="unbounded"/>
				<xs:group ref="cytat-wspolne"/>
			</xs:choice>
		</xs:sequence>
		<xs:attributeGroup ref="cytat"/>
		<xs:attributeGroup ref="now:instr-nowelizacyjne"/>
	</xs:complexType>

	<xs:complexType name="CytatWTekscieTyp">
		<xs:annotation>
			<xs:documentation>
				Cytat w tekście — opakowuje fragment tekstu podlegający zmianie (funkcja="zastap-tekst", "uchyl-tekst") lub wprowadzany (funkcja="nowy-tekst") przez nowelizację tekstową. Para nowGUID ↔ ref-nowGUID spina logicznie stary i nowy tekst.
			</xs:documentation>
		</xs:annotation>
		<xs:choice minOccurs="1" maxOccurs="unbounded">
			<xs:element name="tekst" type="ZawartoscTekstowaBezCytatuTyp"/>
			<xs:element name="zdanie" type="ZdanieTyp"/>
		</xs:choice>
		<xs:attributeGroup ref="cytat"/>
		<xs:attributeGroup ref="now:instr-nowelizacyjne"/>
	</xs:complexType>

	<xs:complexType name="CytatBlokTyp">
		<xs:annotation>
			<xs:documentation>
				Cytat blokowy niestrukturalny — opakowuje element blokowy (tabelę, grafikę, wzór mat.) podlegający zastąpieniu lub wprowadzany nowelizacją. Stosowany gdy zmieniany/dodawany fragment to element blokowy, ale NIE jest jednostką redakcyjną aktu (do tego służy cytat-strukt).
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:choice>
				<xs:group ref="grupa-tabeli"/>
				<xs:element ref="grafika"/>
				<xs:element ref="grafika-wektorowa"/>
				<xs:element ref="wzor-mat"/>
			</xs:choice>
		</xs:sequence>
		<xs:attributeGroup ref="cytat"/>
		<xs:attributeGroup ref="now:instr-nowelizacyjne"/>
	</xs:complexType>

	<xs:complexType name="ZdanieTyp" mixed="true">
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<xs:group ref="zawartosc-tekstowa-bez-cytatu"/>
			<xs:element name="cytat-w-tekscie" type="CytatWTekscieTyp"/>
			<xs:element name="cytat-strukt" type="CytatStruktPelnyTyp"/>
			<xs:element name="cytat-strukt-pusty" type="CytatStruktPustyTyp"/>
		</xs:choice>
		<xs:attribute name="nr"       type="xs:positiveInteger" use="required"/>
		<xs:attribute name="zdGUID"   type="GUIDTyp"            use="required"/>
		<xs:attribute name="fragment" type="xs:positiveInteger" use="required"/>
		<xs:attribute name="fragmentGUID" type="GUIDTyp" use="required"/>
		<xs:attributeGroup ref="wejscie-w-zycie"/>
	</xs:complexType>
	<!--
        <xs:complexType name="ZdanieRefTyp" mixed="true">
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:group ref="zawartosc-tekstowa-bez-cytatu"/>
                <xs:element name="cytat-w-tekscie" type="CytatWTekscieTyp"/>
            </xs:choice>
            <xs:attribute name="ref-nr"      type="xs:positiveInteger" use="required"/>
            <xs:attribute name="ref-zdGUID"  type="GUIDTyp"            use="required"/>
            <xs:attribute name="fragment"    type="xs:positiveInteger" use="required"/>
            <xs:attribute name="fragmentGUID" type="GUIDTyp" use="required"/>
            <xs:attributeGroup ref="wejscie-w-zycie"/>
        </xs:complexType>
    -->
	<xs:complexType name="ZawartoscTekstowaTyp">
		<xs:annotation>
			<xs:documentation>
				Zawartość elementu p. Wymaga opakowania tekstu w zdanie — tekst bezpośrednio w p jest niedozwolony.
			</xs:documentation>
		</xs:annotation>
		<xs:choice minOccurs="1" maxOccurs="unbounded">
			<xs:element name="zdanie"       type="ZdanieTyp"/>
			<!--<xs:element name="zdanie-ref"   type="ZdanieRefTyp"/>-->
			<xs:element name="cytat-blok"   type="CytatBlokTyp"/>
		</xs:choice>
	</xs:complexType>

	<!--Hiperłącza wzorowane na AkomaNtoso.-->
	<xs:element name="ref">
		<xs:annotation>
			<xs:documentation>
				Pojedyncze odesłanie do przepisu lub zasobu zewnętrznego. Odpowiednik AKN ref (inlinereq + link). Atrybut href zawiera adres ELI lub URI zasobu docelowego. Atrybut GUIDcelu wskazuje na GUID docelowego fragmentu w bazie — jeżeli NIE jest podany, odesłanie jest dynamiczne (domyślne wg ZTP).
			</xs:documentation>
		</xs:annotation>
		<xs:complexType mixed="true">
			<xs:group ref="zawartosc-tekstowa-bez-cytatu" minOccurs="0" maxOccurs="unbounded"/>
			<xs:attribute name="href"     type="xs:anyURI" use="required"/>
			<xs:attribute name="GUID"     type="GUIDTyp"   use="required"/>
			<xs:attribute name="GUIDcelu" type="GUIDTyp"   use="optional"/>
		</xs:complexType>
	</xs:element>

	<xs:element name="rref">
		<xs:annotation>
			<xs:documentation>
				Odesłanie zakresowe — wskazuje ciągły zakres przepisów od elementu określonego atrybutem from do elementu upTo (włącznie). Odpowiednik AKN rref (inlinereq + range). Atrybuty from i upTo zawierają adresy ELI lub URI końców zakresu. Atrybut GUIDcelu wskazuje na GUID elementu docelowego w bazie — jeżeli NIE jest podany, odesłanie jest dynamiczne (domyślne wg ZTP).
			</xs:documentation>
		</xs:annotation>
		<xs:complexType mixed="true">
			<xs:group ref="zawartosc-tekstowa-bez-cytatu" minOccurs="0" maxOccurs="unbounded"/>
			<xs:attribute name="from"     type="xs:token"  use="required"/>
			<xs:attribute name="upTo"     type="xs:token"  use="required"/>
			<xs:attribute name="GUID"     type="GUIDTyp"   use="required"/>
			<xs:attribute name="GUIDcelu" type="GUIDTyp"   use="optional"/>
		</xs:complexType>
	</xs:element>

	<xs:element name="mref">
		<xs:annotation>
			<xs:documentation>
				Odesłanie wielokrotne — kontener grupujący kilka elementów ref lub rref wskazujących na nieciągłe przepisy lub zasoby. Odpowiednik AKN mref (inline). Tekst łączący między elementami ref/rref (np. „i", „,") umieszcza się bezpośrednio jako mixed content, poza elementami ref/rref.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType mixed="true">
			<xs:group ref="zawartosc-tekstowa-bez-cytatu" minOccurs="0" maxOccurs="unbounded"/>
			<xs:attribute name="GUID" type="GUIDTyp" use="required"/>
		</xs:complexType>
	</xs:element>

	<!--
        <xs:complexType name="HiperlaczePodstawoweTyp">
            <xs:annotation>
                <xs:documentation>
                    Typ podstawowy hiperłącza — wspólne atrybuty. Wersja pierwotna odesłań w schemaPL.xsd. Jeżeli GUIDcelu NIE JEST podany, wówczas odesłanie jest dynamiczne!
            Domyślnie według Zasad Techniki Prawodawczej odesłania są dynamiczne, a więc nie powinno się wypełniać GUIDcelu.
