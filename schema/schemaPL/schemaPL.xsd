	<!-- Uporządkowana lista poziomów
	<xs:complexType name="LokalizacjaTyp">
		<xs:sequence>
			<xs:element name="Poziom" type="PoziomJednostkiTyp" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
-->
	<!--
      Pojedyncze relacje do innego aktu prawnego
      Właściwości ELI: eli:based_on, eli:amends, eli:amended_by,
                       eli:repeals, eli:repealed_by, eli:cites,
                       eli:has_related_work
    -->
	<xs:complexType name="RelacjaAktuTyp">
		<xs:annotation>
			<xs:documentation>
				Fragment opisujący relację danego aktu z innym aktem za pomocą: ELI innego aktu w relacji, eId - jednostka redakcyjna relacji, DataRelacji - data, z którą powstała relacja, Tytul - tytuł aktu w relacji.
			</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="ELI" type="xs:anyURI"/>
			<xs:element name="eId" type="xs:string" minOccurs="0"/>
			<xs:element name="DataRelacji" type="DataOpcjTyp"/>
			<!--<xs:element name="Lokalizacja" type="LokalizacjaTyp" minOccurs="0"/>-->
			<xs:element name="Tytul" type="xs:string" minOccurs="0"/>
		</xs:all>
	</xs:complexType>

	<!-- Lista odwołań do aktów tego samego typu relacji -->
	<xs:complexType name="ListaRelacjiTyp">
		<xs:sequence>
			<xs:element name="Relacja" type="RelacjaAktuTyp" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<!-- Kontener wszystkich powiązań (odpowiada sekcji references w API) -->
	<xs:complexType name="RelacjeTyp">
		<xs:all>
			<!-- eli:based_on -->
			<xs:element name="PodstawaPrawna" type="ListaRelacjiTyp" minOccurs="0"/>
			<!-- eli:based_on + eli:article -->
			<xs:element name="PodstawaPrawnaJednostka" type="ListaRelacjiTyp" minOccurs="0"/>
			<!-- eli:amends -->
			<xs:element name="Zmienia" type="ListaRelacjiTyp" minOccurs="0"/>
			<xs:element name="Prostuje" type="ListaRelacjiTyp" minOccurs="0"/>
			<xs:element name="ZmieniaWZ" type="ListaRelacjiTyp" minOccurs="0"/>
			<!-- eli:amended_by -->
			<xs:element name="JestZmienianyPrzez" type="ListaRelacjiTyp" minOccurs="0"/>
			<xs:element name="JestZmienianyPrzezWZ" type="ListaRelacjiTyp" minOccurs="0"/>
			<xs:element name="JestProstowanyPrzez" type="ListaRelacjiTyp" minOccurs="0"/>
			<!-- eli:repeals -->
			<xs:element name="Uchyla" type="ListaRelacjiTyp" minOccurs="0"/>
			<xs:element name="UchylaPosrednio" type="ListaRelacjiTyp" minOccurs="0"/>
			<xs:element name="UchylaGeneralnie" type="ListaRelacjiTyp" minOccurs="0"/>
			<!-- eli:repealed_by -->
			<xs:element name="JestUchylany" type="ListaRelacjiTyp" minOccurs="0"/>
			<xs:element name="JestUchylanyPosrednio" type="ListaRelacjiTyp" minOccurs="0"/>
			<xs:element name="JestUchylanyGeneralnie" type="ListaRelacjiTyp" minOccurs="0"/>
			<xs:element name="Wykonuje" type="ListaRelacjiTyp" minOccurs="0"/>
			<xs:element name="JestWykonywany" type="ListaRelacjiTyp" minOccurs="0"/>
			<!-- eli:cites -->
			<xs:element name="Odsyla" type="ListaRelacjiTyp" minOccurs="0"/>
			<xs:element name="OrzeczeniaTK" type="ListaRelacjiTyp" minOccurs="0"/>
			<xs:element name="OrzeczenieTKDlaAktu" type="ListaRelacjiTyp" minOccurs="0"/>
			<xs:element name="Ujednolica" type="ListaRelacjiTyp" minOccurs="0"/>
			<xs:element name="JestUjednolicany" type="ListaRelacjiTyp" minOccurs="0"/>
			<xs:element name="Wprowadza" type="ListaRelacjiTyp" minOccurs="0"/>
			<xs:element name="JestWprowadzany" type="ListaRelacjiTyp" minOccurs="0"/>
		</xs:all>
	</xs:complexType>

	<!-- Pojedyncza dyrektywa UE transponowana przez akt -->
	<xs:complexType name="DyrektywaUETyp">
		<!-- eli:transposes -->
		<xs:all>
			<xs:element name="ELI-EU" type="xs:string"/>
			<xs:element name="DataDyrektywy" type="DataOpcjTyp" minOccurs="0"/>
			<xs:element name="TytulDyrektywy" type="xs:string" minOccurs="0"/>
		</xs:all>
	</xs:complexType>

	<!-- Lista dyrektyw UE -->
	<xs:complexType name="DyrektywyUETyp">
		<xs:sequence>
			<xs:element name="DyrektywaUE" type="DyrektywaUETyp" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<!-- Pojedynczy plik tekstowy aktu -->
	<xs:complexType name="TekstAktuTyp">
		<!-- eli:format -->
		<xs:all>
			<xs:element name="NazwaPliku" type="xs:string"/>
			<xs:element name="TypTekstu" type="TypTekstuTyp"/>
		</xs:all>
	</xs:complexType>

	<!-- Lista plików tekstowych z flagami dostępności -->
	<xs:complexType name="TekstyAktuTyp">
		<xs:sequence>
			<xs:element name="TekstAktu" type="TekstAktuTyp" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="dostepnyPDF" type="xs:boolean"/>
		<xs:attribute name="dostepnyHTML" type="xs:boolean"/>
	</xs:complexType>

	<!-- Pojedynczy druk sejmowy powiązany z aktem -->
	<xs:complexType name="DrukSejmowyTyp">
		<xs:all>
			<xs:element name="NumerDruku" type="xs:string" />
			<xs:element name="Kadencja" type="xs:positiveInteger" />
			<xs:element name="ELI_DL" type="xs:anyURI" minOccurs="0"/>
			<xs:element name="LinkDruku" type="xs:anyURI" minOccurs="0"/>
			<xs:element name="LinkDrukuAPI" type="xs:anyURI" minOccurs="0"/>
			<xs:element name="LinkProcesuAPI" type="xs:anyURI" minOccurs="0"/>
		</xs:all>
	</xs:complexType>

	<!-- Lista druków sejmowych -->
	<xs:complexType name="DrukiSejmoweTyp">
		<xs:sequence>
			<xs:element name="DrukSejmowy" type="DrukSejmowyTyp" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<!--
    Organy uczestniczące w wydaniu aktu.
    @rola       — rola organu wg ELI (eli:passed_by, eli:authorized_by)
    @GUID       — identyfikator instancji organu
    @eliURI     — URI organu wg słownika eli.gov.pl/resource/authority/legal-institution
    -->
	<xs:element name="Organy">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Organ" maxOccurs="unbounded">
					<xs:complexType>
						<xs:all>
							<xs:element name="Nazwa" type="xs:string" />
							<xs:element name="OrganPodpisujacy" type="xs:string" minOccurs="0"/>
							<xs:element name="OsobaPodpisujaca" type="xs:string" minOccurs="0"/>
							<xs:element name="Uwagi" type="TekstZeSpacjamiTyp" minOccurs="0"/>
							<xs:element name="Podpis" type="PodpisElektronicznyTyp" minOccurs="0"/>
						</xs:all>
						<!--GUID został dodany na wypadek, gdyby chciano wprowadzić inny sposób identyfikacji niż eliURI. Obecnie nie ma listy z GUIDami dla organów analogicznej do eliURI.-->
						<xs:attribute name="GUID" type="GUIDMetaTyp"/>
						<xs:attribute name="rola" type="RolaOrganTyp"/>
						<xs:attribute name="eliURI" type="xs:anyURI"/>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<!-- ============================================================
         GŁÓWNY TYP: MetadaneTyp
         ============================================================ -->

	<xs:complexType name="MetadaneTyp">
		<xs:all>

			<!-- ===== BLOK 1: IDENTYFIKACJA ===== -->

			<!-- ELI — unikalny identyfikator wg European Legislation Identifier
                 eli:id — np. "DU/2020/1280"
                 API: ELI -->

			<xs:element name="ELIaktu">
				<xs:complexType>
					<xs:sequence>
						<xs:choice>
							<xs:element name="ELI" type="xs:anyURI"/>
							<xs:element name="ELIDL" type="xs:anyURI"/>
						</xs:choice>
						<!-- URI ogłoszonego aktu, który powstał z tego projektu (eli-dl:resulted_in) -->
						<xs:element name="ELIDLrezultatProjektu" type="xs:anyURI" minOccurs="0"/>

						<!-- URI aktu, którego projekt dotyczy (eli:is_about) -->
						<xs:element name="ELIDLdotyczyAktu" type="xs:anyURI" minOccurs="0"/>

						<!-- URI obiektu eli-dl:LegislativeProcess w rejestrze zewnętrznym -->
						<xs:element name="ELIDLproces" type="xs:anyURI" minOccurs="0"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>

			<!--GUIDwersji - unikalny identyfikator danej wersji aktu-->
			<xs:element name="GUIDwersji" type="GUIDTyp"/>

			<!-- AdresISAP — wewnętrzny identyfikator systemu ISAP
                 eli:id_local — np. "WDU20200001280"
                 API: address -->
			<xs:element name="AdresISAP" type="xs:string" minOccurs="0"/>

			<!-- Wydawnictwo — symbol dziennika urzędowego: np. DU (Dz.U.) lub MP (M.P.)
                 API: publisher -->
			<xs:element name="Wydawnictwo" type="xs:string" />

			<!-- Rok — rok wydania dziennika
                 API: year -->
			<xs:element name="Rok" type="RokOpcjTyp" />

			<!-- NrDziennika — numer dziennika
                 API: volume -->
			<xs:element name="NrDziennika" type="LiczbaOpcjTyp" minOccurs="0"/>

			<!-- Pozycja — pozycja aktu w roczniku dziennika
                 API: pos -->
			<xs:element name="Pozycja" type="LiczbaOpcjTyp" />

			<!-- AdresWyswietlany — czytelny adres publikacyjny
                 np. "Dz.U. 2020 poz. 1280"
                 API: displayAddress -->
			<xs:element name="AdresWyswietlany" type="xs:string" minOccurs="0"/>

			<!-- ===== BLOK 2: TYTUŁ I TYP ===== -->

			<!-- Tytul — pełny tytuł aktu prawnego
                 eli:title
                 API: title -->
			<xs:element name="Tytul" type="xs:string" minOccurs="0"/>

			<!-- Rodzaj — typ dokumentu wg słownika ELI PL
                 eli:type_document
                 Słownik: https://eli.gov.pl/resource/authority/resource-type
                 API: type -->
			<xs:element name="Rodzaj" type="RodzajAktuTyp"/>

			<!-- TytulyPoprzednie — historia tytułów aktu (przed nowelizacją)
                 API: previousTitle -->
			<xs:element name="TytulyPoprzednie" type="TytulyPoprzednieTyp" minOccurs="0"/>

			<!-- ===== BLOK 3: DATY ===== -->

			<!-- DataOgloszenia — data wydania numeru dziennika urzędowego
                 eli:date_publication
                 API: announcementDate -->
			<xs:element name="DataOgloszenia" type="DataOpcjTyp" />

			<!-- DataAktu — data wydania danego aktu
                 DataProjektu - pierwotna data, z którą projekt został wniesiony
                 DataWydania - data uznawana za datę wydania aktu
                 eli: date_promulgation
                 API: promulgation -->
			<xs:element name="DataAktu">
				<xs:complexType>
					<xs:choice>
						<xs:element name="DataProjektu" type="DataOpcjTyp"/>
						<xs:element name="DataWydania" type="DataOpcjTyp"/>
					</xs:choice>
				</xs:complexType>
			</xs:element>

			<!--Data wytworzenia kolejnej wersji projektu-->
			<xs:element name="DataWersjiProjektu" type="DataOpcjTyp" minOccurs="0"/>

			<!-- DataWejsciaWZycie — data wejścia aktu w życie
                 eli:entryIntoForce
                 API: entryIntoForce -->
			<xs:element name="DataWejsciaWZycie" type="DataOpcjTyp" minOccurs="0"/>

			<!-- DataWejsciaWZycieCzesciowa — częściowa data wejścia aktu w życie
                 brak odpowiednika w ELI oraz w API -->
			<xs:element name="DatyWejsciaWZycieCzesciowe" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="DataWejsciaWZycieCzesciowa" type="DataCzesciowaTyp" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>

			<!-- DataMocyWstecznej — wsteczna data wejścia w życie aktu; brak odpowiednika w ELI oraz w API -->
			<xs:element name="DatyMocyWstecznej" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Wskazana przez prawodawcę wsteczna data wejścia w życie poszczególnych jednostek bądź całego aktu. Jeżeli nie określono wyraźnie jednostki, DataMocyWstecznej dotyczy całego aktu.
					</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="DataMocyWstecznej" type="DataCzesciowaTyp" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>

			<!-- DatyObowiazywaniaWersji — daty, w których obowiązywała wersja (stan prawny)
                 eli:brak odpowiednika
                 API: validFrom/validTo -->
			<xs:element name="DatyObowiazywaniaWersji" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="DataObowiazywaniaWersjiOd" type="DataOpcjTyp"/>
						<xs:element name="DataObowiazywaniaWersjiDo" type="DataOpcjTyp" minOccurs="0"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>

			<!-- DataUchylenia — data uchylenia aktu przez prawodawcę
                 eli:repealDate
                 API: repealDate -->
			<xs:element name="DataUchylenia" type="DataOpcjTyp" minOccurs="0"/>

			<!-- DataUchyleniaCzesciowa — data uchylenia części aktu przez prawodawcę
                 Brak odpowiednika. Przykład: Uchyla się ustawę z wyjątkiem art. X, Y i Z. -->
			<xs:element name="DatyUchyleniaCzesciowe" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="DataUchyleniaCzesciowa"
						            type="DataCzesciowaTyp"
						            maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>

			<!-- DataWygasniecia — data wygaśnięcia z mocy prawa
                 eli: expirationDate
                 API: expirationDate -->
			<xs:element name="DataWygasniecia" type="DataOpcjTyp" minOccurs="0"/>

			<!-- DataStanuPrawnegoTJ — data stanu prawnego dla tekstu jednolitego
                 API: legalStatusDate -->
			<xs:element name="DataStanuPrawnegoTJ" type="DataOpcjTyp" minOccurs="0"/>

			<!-- DataOstatniejZmiany — data ostatniej modyfikacji rekordu w systemie ISAP
                 Do zastanowienia, czy potrzebna, jeżeli mamy daty w relacjach.
                 API: changeDate -->
			<xs:element name="DataOstatniejZmiany" type="xs:dateTime" minOccurs="0"/>

			<!-- ===== BLOK 4: STATUS OBOWIĄZYWANIA ===== -->

			<!-- Status — słownikowy status aktu w ISAP
                 API: status -->
			<xs:element name="Status" type="StatusAktuTyp" minOccurs="0"/>

			<!-- CzyObowiazuje — binarny znacznik obowiązywania
                 eli:in_force
                 API: inForce -->
			<xs:element name="CzyObowiazuje" type="CzyObowiazujeTyp" minOccurs="0"/>

			<!-- ===== BLOK 5: ORGANY ===== -->

			<!-- Organy — pełna struktura organów z rolami ELI i podpisami
                 eli:passed_by, eli:authorized_by
                 Słownik: https://eli.gov.pl/resource/authority/legal-institution -->
			<xs:element ref="Organy" />

			<!-- ===== BLOK 6: KLASYFIKACJA I OPIS ===== -->

			<!-- SlowaKluczowe — słowa kluczowe tematyczne
                 eli:subject_matter
                 API: keywords -->
			<xs:element name="SlowaKluczowe" type="ListaTerminowTyp" minOccurs="0"/>

			<!-- NazwyWlasne — nazwy własne jako słowa kluczowe
                 eli:subject_matter
                 API: keywordsNames -->
			<xs:element name="NazwyWlasne" type="ListaTerminowTyp" minOccurs="0"/>

			<!-- ===== BLOK 7: RELACJE Z INNYMI AKTAMI ===== -->

			<!-- Relacje — kompletna sieć relacji z innymi aktami
                 eli:based_on, eli:amends, eli:amended_by, eli:repeals,
                 eli:repealed_by, eli:has_related_work, eli:cites
                 API: references -->
			<xs:element name="Relacje" type="RelacjeTyp" minOccurs="0"/>

			<!--Wskazanie tekstu jednolitego będącego podstawą do wytworzenia wersji.-->
			<xs:element name="TekstJednolityBazowy" type="xs:token" minOccurs="0"/>
			<xs:element name="FlagaKonsolidacyjna" type="xs:boolean" minOccurs="0"/>

			<!-- ===== BLOK 8: DYREKTYWY UE ===== -->

			<!-- DyrektywyUE — dyrektywy UE transponowane przez akt
                 eli:transposes
                 API: directives -->
			<xs:element name="DyrektywyUE" type="DyrektywyUETyp" minOccurs="0"/>

			<!-- ===== BLOK 9: TEKSTY AKTU ===== -->

			<!-- TekstyAktu — pliki tekstowe aktu (PDF, HTML, XML)
                 eli:format
                 API: texts -->
			<xs:element name="TekstyAktu" type="TekstyAktuTyp" minOccurs="0"/>

			<!-- ===== BLOK 10: DRUKI SEJMOWE ===== -->

			<!-- DrukiSejmowe — powiązane druki sejmowe i procesy legislacyjne
                 API: prints -->
			<xs:element name="DrukiSejmowe" type="DrukiSejmoweTyp" minOccurs="0"/>

			<!-- ===== KOMENTARZE ===== -->

			<!-- Komentarze — uwagi redakcyjne do aktu
                 eli:note
                 API: comments -->
			<xs:element name="Komentarze" type="TekstZeSpacjamiTyp" minOccurs="0"/>

		</xs:all>
	</xs:complexType>

	<!-- ============================================================
         TYP XPATH — rozszerzony dla edytora metadanych
         ============================================================ -->

	<xs:simpleType name="XpathMetadaneTyp">
		<xs:restriction base="xs:string">
			<!-- Blok 1: Identyfikacja -->
			<xs:pattern value="md:ELI|md:AdresISAP|md:Wydawnictwo|md:Rok|md:Wolumin|md:Pozycja|md:AdresWyswietlany|md:Sygnatura"/>
			<!-- Blok 2: Tytuł i typ -->
			<xs:pattern value="md:Tytul|md:Rodzaj|md:RodzajTJ|md:PrzedmiotTJ"/>
			<xs:pattern value="md:TytulyPoprzednie/md:TytulPoprzedni"/>
			<!-- Blok 3: Daty -->
			<xs:pattern value="md:DataOgloszenia|md:DataWydania|md:DataWejsciaWZycie|md:DataObowiazywaniaOd"/>
			<xs:pattern value="md:DataUchylenia|md:DataWygasniecia|md:DataStanuPrawnego|md:DataZmiany"/>
			<xs:pattern value="md:DataWydaniaTJ|md:ELITJ"/>
			<!-- Blok 4: Status -->
			<xs:pattern value="md:Status|md:CzyObowiazuje"/>
			<!-- Blok 5: Organy -->
			<!--<xs:pattern value="md:Instytucja"/>-->
			<xs:pattern value="md:Organy/md:Organ\[@GUID='[\da-fA-F]{8}(-[\da-fA-F]{4}){3}-[\da-fA-F]{12}'\]/md:Nazwa"/>
			<xs:pattern value="md:Organy/md:Organ\[@GUID='[\da-fA-F]{8}(-[\da-fA-F]{4}){3}-[\da-fA-F]{12}'\]/md:OrganPodpisujacy"/>
			<xs:pattern value="md:Organy/md:Organ\[@GUID='[\da-fA-F]{8}(-[\da-fA-F]{4}){3}-[\da-fA-F]{12}'\]/md:OsobaPodpisujaca"/>
			<xs:pattern value="md:Organy/md:Organ\[@GUID='[\da-fA-F]{8}(-[\da-fA-F]{4}){3}-[\da-fA-F]{12}'\]/md:Uwagi"/>
			<xs:pattern value="md:Organy/md:Organ\[@GUID='[\da-fA-F]{8}(-[\da-fA-F]{4}){3}-[\da-fA-F]{12}'\]/md:Podpis/md:DataPodpisu"/>
			<!-- Blok 6: Klasyfikacja -->
			<xs:pattern value="md:SlowaKluczowe/md:SlowoKluczowe|md:NazwyWlasne/md:NazwaWlasna"/>
			<xs:pattern value="md:Temat|md:Przedmiot|md:Kategoria|md:Autor|md:Opis"/>
			<!-- Blok 7 Relacje/PodstawaPrawnaJednostka -->
			<!--Dodany, aby można było zaciągać metadane do xs:element name="podstawa-prawna" i umieszczonego tam `pole`.-->
			<xs:pattern value="md:Relacje/md:PodstawaPrawnaJednostka/md:Relacja/md:Lokalizacja"/>
			<xs:pattern value="md:Relacje/md:PodstawaPrawnaJednostka/md:Relacja/md:DataRelacji"/>
			<xs:pattern value="md:Relacje/md:PodstawaPrawnaJednostka/md:Relacja/md:Tytul"/>
			<xs:pattern value="md:Relacje/md:PodstawaPrawnaJednostka/md:Relacja/md:ELI"/>
			<!-- Komentarze -->
			<xs:pattern value="md:Komentarze"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- ============================================================
	 ROOT
	 ============================================================ -->

	<xs:element name="akt-prawny">
		<xs:annotation>
			<xs:documentation>Jedyny element główny dokumentu XML aktu prawnego.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:choice>
					<xs:element name="ustawa" type="UstawaTyp"/>
					<xs:element name="kodeks" type="KodeksTyp"/>
					<xs:element name="rozporzadzenie" type="RozporzadzenieTyp"/>
					<xs:element name="zarzadzenie" type="RozporzadzenieTyp"/>
					<xs:element name="uchwala" type="RozporzadzenieTyp"/>
					<xs:element name="inny-akt-prawny" type="RozporzadzenieTyp"/>
					<xs:element name="obwieszczenie" type="ObwieszczenieTyp"/>
					<xs:element name="orzeczenieTK" type="OrzeczenieTKTyp"/>
				</xs:choice>
				<xs:choice minOccurs="0">
					<xs:element name="uzasadnienie" type="UzasadnienieTyp"/>
				</xs:choice>
			</xs:sequence>
		</xs:complexType>
		<xs:unique name="AktGUID">
			<xs:selector xpath=".//*"/>
			<xs:field xpath="@GUID"/>
		</xs:unique>
		<xs:keyref name="AktRefGUID" refer="AktGUID">
			<xs:selector xpath=".//*"/>
			<xs:field xpath="@RefGUID"/>
		</xs:keyref>
		<xs:key name="AktCytatId">
			<xs:selector xpath=".//cytat-strukt"/>
			<xs:field xpath="@nowGUID"/>           <!-- unikalny GUID cytatu; attributeFormDefault=unqualified -->
		</xs:key>
		<xs:keyref  name="AktCytatRefId" refer="AktCytatId">
			<xs:selector xpath=".//cytat-strukt"/>
			<xs:field xpath="@ref-nowGUID"/>       <!-- każdy ref-id musi wskazywać na istniejący id -->
		</xs:keyref>
	</xs:element>

</xs:schema>
