	<!--Świadomie zrezygnowano z jednostek niższych niż podwójne tiret. Nie występują one w ZTP i są objawem patologii legislacyjnej. Pokrywają je patojednostki.-->

	<xs:element name="punkt-OTJ" type="PunktOTJTyp"/>

	<xs:element name="preambula">
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="JednostkaRedakcyjnaTyp">
					<xs:group ref="tresc-akapitowa-TJ"/><!--Treść akapitowa TJ została użyta, gdyż będzie pasować zarówno do tekstu oryginalnego jak i jednolitego.-->
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>

	<xs:simpleType name="RolaSedziegoTyp">
		<xs:restriction base="xs:string">
			<xs:enumeration value="przewodniczacy"/>
			<xs:enumeration value="sprawozdawca"/>
			<xs:enumeration value="czlonek"/>
			<xs:enumeration value="skladajacy-zdanie-odrebne"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="SedziaTyp">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute name="rola" type="RolaSedziegoTyp" use="required"/>
				<xs:attribute name="nr" type="xs:positiveInteger" use="optional"/>
				<xs:attribute name="GUID" type="GUIDTyp" use="optional"/>
				<xs:attributeGroup ref="typoSpecjalne"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

	<xs:complexType name="ProtokolantTyp">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute name="GUID" type="GUIDTyp"/>
				<xs:attributeGroup ref="typoSpecjalne"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

	<xs:complexType name="SkladSedziowskiTyp">
		<xs:sequence>
			<xs:element name="naglowek-skladu" type="JednostkaTekstowaTyp"/>
			<!--Na etapie konwersji xml przez szablon xslt powinna być dodana etykieta z rolą sędziego i przecinkiem na końcu.-->
			<xs:element name="sedzia" type="SedziaTyp" minOccurs="3" maxOccurs="unbounded"/>
			<!--Na etapie konwersji xml przez szablon xslt powinna być dodana etykieta: protokolant.-->
			<xs:element name="protokolant" type="ProtokolantTyp" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>

	<!-- Pojedynczy punkt zarzutów (1), 2), ...) -->
	<xs:complexType name="PunktZarzutówTyp">
		<xs:sequence>
			<!--Numer jest stringiem, gdyż niekiedy używane są liczby rzymskie.-->
			<xs:element name="nr"    type="xs:string"/>
			<!-- Treść wraz z ewentualnym wbudowanym uzasadnieniem po myślniku -->
			<xs:element name="tresc" type="JednostkaRedakcyjnaTekstowaTyp"/>
		</xs:sequence>
		<xs:attribute name="GUID"   type="GUIDTyp"/>
		<xs:attribute name="eID"  type="xs:anyURI"/>
	</xs:complexType>

	<xs:complexType name="ZarzutyTyp">
		<xs:sequence>
			<!-- Co najmniej jedno z: p lub punkt-zarzutów -->
			<xs:choice minOccurs="1" maxOccurs="unbounded">
				<xs:element name="p" type="JednostkaTekstowaTyp"/>
				<xs:element name="punkt-zarzut" type="PunktZarzutówTyp"/>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="PrzedmiotSprawyTyp">
		<xs:sequence>
			<!-- AKN: <introduction> -->
			<!--Można użyć elementów inline podmiot-inicjujacy i tryb-orzekania-->
			<xs:element name="podstawa-inicjowania" type="JednostkaTekstowaTyp"/>
			<!-- AKN: <background> -->
			<!--Można użyć inlinie kwestionowany-przepis oraz wzorzec-kontroli-->
			<xs:element name="zarzuty" type="ZarzutyTyp" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="PunktTenoruTyp">
		<xs:sequence>
			<!--Numer jest stringiem, gdyż niekiedy używane są liczby rzymskie.-->
			<xs:element name="nr" type="xs:string"/>
			<xs:element name="tresc"  type="JednostkaTekstowaTyp"/>
			<!-- Klasyfikacja wyniku — opcjonalna, może być wywnioskowana z treści -->
		</xs:sequence>
		<xs:attribute name="GUID" type="GUIDTyp"/>
		<xs:attributeGroup ref="eId"/>
	</xs:complexType>

	<!-- Pojedynczy punkt postanowienia (1), 2), ...) -->
	<xs:complexType name="PunktPostanowieniaDodatkowegoTyp">
		<xs:sequence>
			<!--Numer jest stringiem, gdyż niekiedy używane są liczby rzymskie.-->
			<xs:element name="nr"    type="xs:string"/>
			<!-- Treść wraz z ewentualnym wbudowanym uzasadnieniem po myślniku -->
			<xs:element name="tresc" type="JednostkaTekstowaTyp"/>
		</xs:sequence>
		<xs:attribute name="GUID"   type="GUIDTyp"/>
		<xs:attributeGroup ref="eId"/>
	</xs:complexType>

	<xs:complexType name="PostanowienieDodatkoweTyp">
		<xs:sequence>
			<!-- Słowa "Ponadto postanawia:" -->
			<xs:element name="naglowek-postanowienia" type="JednostkaTekstowaTyp"/>
			<!-- Co najmniej jedno z: p lub punkt-postanowienia-dodatkowego -->
			<xs:choice minOccurs="1" maxOccurs="unbounded">
				<xs:element name="p" type="JednostkaTekstowaTyp"/>
				<xs:element name="punkt-postanowienia-dodatkowego" type="PunktPostanowieniaDodatkowegoTyp"/>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="TenorOrzeczeniaTyp">
		<xs:sequence>
			<!-- Słowo "orzeka:" -->
			<xs:element name="naglowek-tenoru" type="JednostkaTekstowaTyp"/>
			<!--	  Opcjonalny akapit przed punktami tenoru-->
			<xs:element name="p" type="JednostkaTekstowaTyp" minOccurs="0"/>
			<!-- Punkty właściwego orzeczenia: 1., 2., ... -->
			<xs:element name="punkt-tenoru" type="PunktTenoruTyp" maxOccurs="unbounded"/>
			<!-- Blok "Ponadto postanawia:" — opcjonalny -->
			<xs:element name="postanowienie-dodatkowe" type="PostanowienieDodatkoweTyp" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="PodpisyTyp">
		<xs:sequence>
			<xs:element name="sedzia" type="SedziaTyp" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="ZdanieOdrebneOrzeczeniaTyp">
		<xs:sequence>
			<xs:element name="p" type="JednostkaTekstowaTyp"/>
			<xs:element name="sedzia" type="SedziaTyp" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<!--
    ============================================================
    SEKCJA: UZASADNIENIE
    ============================================================
    -->
	<xs:complexType name="SekcjaUzasadnieniaTyp">
		<xs:sequence>

			<xs:element name="tytul-sekcji"
			            type="JednostkaTekstowaTyp"
			            minOccurs="0"/>

			<!-- akapit-dowolny już zawiera tabele, grafiki, wzory przez kontynuacja-akapitu -->
			<xs:group ref="akapit-dowolny"
			          minOccurs="1"
			          maxOccurs="unbounded"/>

			<!-- podsekcje na końcu -->
			<xs:element name="sekcja-uzasadnienia"
			            type="SekcjaUzasadnieniaTyp"
			            minOccurs="0"
			            maxOccurs="unbounded"/>

		</xs:sequence>
		<xs:attribute name="GUID" type="GUIDTyp" use="optional"/>
	</xs:complexType>

	<xs:group name="tresc-uzasadnienia">
		<xs:sequence>
			<xs:element name="tytul-uzasadnienia"
			            type="JednostkaTekstowaTyp"
			            minOccurs="0"/>
			<xs:element name="sekcja-uzasadnienia"
			            type="SekcjaUzasadnieniaTyp"
			            minOccurs="0"
			            maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:group>

	<xs:group name="zalaczniki-uzasadnienia">
		<xs:sequence>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element name="zalacznik-tekstowy" type="ZalacznikUzasadnieniaTyp"/>
				<xs:element name="zalacznik-binarny">
					<xs:complexType>
						<xs:attribute name="href"        type="xs:anyURI"/>
						<xs:attribute name="skala"       type="xs:integer"/>
						<xs:attribute name="przesuniecie" type="xs:integer"/>
						<xs:attribute name="GUID"       type="GUIDTyp"/>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:sequence>
	</xs:group>

	<xs:complexType name="UzasadnienieTyp">
		<xs:sequence>
			<xs:group ref="tresc-uzasadnienia" minOccurs="0"/>
			<xs:group ref="zalaczniki-uzasadnienia" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>

	<!--
        ============================================================
        SEKCJA: AKTY PRAWNE
        ============================================================
    -->
	<xs:complexType name="UstawaTyp">
		<xs:sequence>
			<xs:element name="metadane" type="MetadaneTyp"/>
			<xs:element name="oznaczenie" type="JednostkaTekstowaTyp" minOccurs="0"/><!--Jest to odpowiednik numeru pozycji w dzienniku urzędowym.-->
			<xs:element name="rodzaj-aktu" type="JednostkaTekstowaTyp"/>
			<xs:element name="data" type="JednostkaTekstowaTyp"/>
			<xs:element name="tytul" type="JednostkaTekstowaTyp"/>
			<xs:element ref="preambula" minOccurs="0"/>
			<xs:choice maxOccurs="unbounded">
				<xs:group ref="jednostka-systematyzacyjna"/>
				<xs:element name="artykul" type="ArtykulUstawyTyp"/>
				<xs:element	name="pato-artykul" type="PatoArtykulParagrafTyp"/>
			</xs:choice>
			<xs:group ref="podpisy"/>
			<xs:group ref="zalaczniki" minOccurs="0"/>
			<xs:element name="uzasadnienie" type="UzasadnienieTyp" minOccurs="0"/>
			<xs:group ref="e-podpisy"/>
		</xs:sequence>
		<xs:attributeGroup ref="enklawy"/>
	</xs:complexType>

	<xs:complexType name="KodeksTyp">
		<xs:sequence>
			<xs:element name="metadane" type="MetadaneTyp"/>
			<xs:element name="oznaczenie" type="JednostkaTekstowaTyp" minOccurs="0"/>
			<xs:element name="rodzaj-aktu" type="JednostkaTekstowaTyp"/>
			<xs:element name="data" type="JednostkaTekstowaTyp"/>
			<xs:element name="tytul" type="JednostkaTekstowaTyp"/>
			<xs:element ref="preambula" minOccurs="0"/>
			<xs:choice maxOccurs="unbounded">
				<xs:group ref="jednostka-systematyzacyjna"/>
				<xs:element name="artykul" type="ArtykulKodeksuTyp"/>
				<xs:element	name="pato-artykul" type="PatoArtykulParagrafTyp"/>
			</xs:choice>
			<xs:group ref="podpisy"/>
			<xs:group ref="zalaczniki" minOccurs="0"/>
			<xs:element name="uzasadnienie" type="UzasadnienieTyp" minOccurs="0"/>
			<xs:group ref="e-podpisy"/>
		</xs:sequence>
		<xs:attributeGroup ref="enklawy"/>
	</xs:complexType>

	<xs:complexType name="RozporzadzenieTyp">
		<xs:sequence>
			<xs:element name="metadane" type="MetadaneTyp"/>
			<xs:element name="oznaczenie" type="JednostkaTekstowaTyp" minOccurs="0"/>
			<xs:element name="rodzaj-aktu" type="JednostkaTekstowaTyp"/> <!--Wcześniej były wymagane dokładnie dwa wystąpienia rodzaju aktu. Rozbiłem to na rodzaj i autora aktu.-->
			<xs:element name="autor-aktu" type="JednostkaTekstowaTyp"/>
			<xs:element name="data" type="JednostkaTekstowaTyp"/>
			<xs:element name="tytul" type="JednostkaTekstowaTyp"/>
			<xs:element ref="podstawa-prawna"/>
			<xs:choice maxOccurs="unbounded">
				<xs:group ref="jednostka-systematyzacyjna"/>
				<xs:element name="paragraf" type="ParagrafRozporzadzeniaTyp"/>
				<xs:element name="pato-paragraf-rozporzadzenia" type="PatoArtykulParagrafTyp"/>
			</xs:choice>
			<xs:group ref="podpisy"/>
			<xs:group ref="zalaczniki" minOccurs="0"/>
			<xs:element name="uzasadnienie" type="UzasadnienieTyp" minOccurs="0"/>
			<xs:group ref="e-podpisy"/>
		</xs:sequence>
		<xs:attributeGroup ref="enklawy"/>
	</xs:complexType>

	<xs:complexType name="OrzeczenieTKTyp">
		<xs:sequence>
			<!--Metadane-->
			<xs:element name="metadane" type="MetadaneTyp"/>
			<!--Element uwagi służy zamieszczeniu ewentualnych uwag o wyrokach ETPC.-->
			<xs:element name="uwagi" type="JednostkaTekstowaTyp" minOccurs="0"/>
			<!--odpowiednik w AKN: header-->
			<xs:element name="oznaczenie" type="JednostkaTekstowaTyp" minOccurs="0"/>
			<xs:element name="rodzaj-aktu" type="JednostkaTekstowaTyp"/> <!--Wcześniej były wymagane dokładnie dwa wystąpienia rodzaju aktu. Rozbiłem to na rodzaj i autora aktu.-->
			<xs:element name="autor-aktu" type="JednostkaTekstowaTyp"/>
			<xs:element name="daty" type="JednostkaTekstowaTyp"/>
			<xs:element name="sygnatura" type="JednostkaTekstowaTyp"/>
			<xs:element name="sklad-sedziowski" type="SkladSedziowskiTyp"/>
			<!--Odpowiendnik w AKN: body-->
			<xs:element name="przedmiot-sprawy" type="PrzedmiotSprawyTyp"/>
			<!--Odpowienik w AKN: conclusions-->
			<xs:element name="tenor-orzeczenia" type="TenorOrzeczeniaTyp"/>
			<xs:element name="wynik-narady" type="JednostkaTekstowaTyp"/>
			<xs:element name="podpisy" type="PodpisyTyp"/>
			<xs:element name="zdanie-odrebne" type="ZdanieOdrebneOrzeczeniaTyp" minOccurs="0"/>
			<xs:element name="poswiadczenie" type="JednostkaTekstowaTyp" minOccurs="0"/>
			<xs:group ref="e-podpisy"/>
		</xs:sequence>
		<xs:attributeGroup ref="enklawy"/>
	</xs:complexType>

	<xs:complexType name="PunktOTJTyp">
		<xs:complexContent>
			<xs:extension base="JednostkaRedakcyjnaTyp">
				<xs:sequence minOccurs="0">
					<xs:group ref="akapit-TJ"/>
					<xs:sequence>
						<xs:element name="podpunkt-OTJ" type="PodpunktOTJTyp" minOccurs="0" maxOccurs="unbounded"/>
						<xs:element name="czesc-wspolna-podpunkt-OTJ" type="JednostkaRedakcyjnaTekstowaTyp" minOccurs="0"/>
					</xs:sequence>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="PodpunktOTJTyp">
		<xs:complexContent>
			<xs:extension base="JednostkaRedakcyjnaNumerowanaTyp">
				<xs:sequence>
					<xs:group ref="akapit-dowolny"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="TJUstawyTyp">
		<xs:sequence>
			<xs:element name="zalacznik-do" type="JednostkaTekstowaTyp"/>
			<xs:element name="rodzaj-aktu" type="JednostkaTekstowaTyp"/>
			<xs:element name="data" type="JednostkaTekstowaTyp"/>
			<xs:element name="tytul" type="JednostkaTekstowaTyp"/>
			<xs:element ref="preambula" minOccurs="0"/>
			<xs:choice maxOccurs="unbounded">
				<xs:group ref="jednostka-systematyzacyjna"/>
				<xs:element name="artykul" type="ArtykulUstawyTJTyp"/>
				<xs:element name="pato-artykul" type="PatoArtykulParagrafTyp"/>
			</xs:choice>
			<xs:group ref="zalaczniki" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="TJKodeksuTyp">
		<xs:sequence>
			<xs:element name="zalacznik-do" type="JednostkaTekstowaTyp"/>
			<xs:element name="rodzaj-aktu" type="JednostkaTekstowaTyp"/>
			<xs:element name="data" type="JednostkaTekstowaTyp"/>
			<xs:element name="tytul" type="JednostkaTekstowaTyp"/>
			<xs:element ref="preambula" minOccurs="0"/>
			<xs:choice maxOccurs="unbounded">
				<xs:group ref="jednostka-systematyzacyjna"/>
				<xs:element name="artykul" type="ArtykulKodeksuTJTyp"/>
				<xs:element name="pato-artykul" type="PatoArtykulParagrafTyp"/>
			</xs:choice>
			<xs:group ref="zalaczniki" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="TJRozporzadzeniaTyp">
		<xs:sequence>
			<xs:element name="zalacznik-do" type="JednostkaTekstowaTyp"/>
			<xs:element name="rodzaj-aktu" type="JednostkaTekstowaTyp"/> <!-- Wcześniej było: <xs:element name="rodzaj-aktu" type="JednostkaTekstowaTyp" minOccurs="2" maxOccurs="2"/> Obowiązkowe dwa wystąpienia wynikają z dwóch linijek tekstu: pierwsza: "rozporządzenie", druga: np. "Ministra Cyfryzacji". Do zastanowienia, czy włączyć autora.-->
			<xs:element name="autor-aktu" type="JednostkaTekstowaTyp"/>
			<xs:element name="data" type="JednostkaTekstowaTyp"/>
			<xs:element name="tytul" type="JednostkaTekstowaTyp"/>
			<xs:element ref="podstawa-prawna" minOccurs="0"/>
			<xs:choice maxOccurs="unbounded">
				<xs:group ref="jednostka-systematyzacyjna"/>
				<xs:element name="paragraf" type="ParagrafRozporzadzeniaTJTyp"/>
				<xs:element name="pato-paragraf-rozporzadzenia" type="PatoArtykulParagrafTyp"/>
			</xs:choice>
			<xs:group ref="zalaczniki" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="ObwieszczenieTyp">
		<xs:sequence>
			<xs:element name="metadane" type="MetadaneTyp"/>
			<xs:element name="oznaczenie" type="JednostkaTekstowaTyp" minOccurs="0"/>
			<xs:element name="rodzaj-aktu" type="JednostkaTekstowaTyp"/><!--Patrz uwaga o dwóch wystąpieniach przy tj rozporządzenia wyżej.-->
			<xs:element name="autor-aktu" type="JednostkaTekstowaTyp"/>
			<xs:element name="data" type="JednostkaTekstowaTyp"/>
			<xs:element name="tytul" type="JednostkaTekstowaTyp"/>
			<xs:element ref="punkt-OTJ" minOccurs="2" maxOccurs="2"/>
			<xs:group ref="podpisy"/>
			<xs:choice>
				<xs:element name="ustawa" type="TJUstawyTyp"/>
				<xs:element name="kodeks" type="TJKodeksuTyp"/>
				<xs:element name="rozporzadzenie" type="TJRozporzadzeniaTyp"/>
				<xs:element name="zarzadzenie" type="TJRozporzadzeniaTyp"/>
				<xs:element name="uchwala" type="TJRozporzadzeniaTyp"/>
				<xs:element name="inny-akt-prawny" type="TJRozporzadzeniaTyp"/>
			</xs:choice>
			<xs:element name="uzasadnienie" type="UzasadnienieTyp" minOccurs="0"/>
			<xs:group ref="e-podpisy"/>
		</xs:sequence>
		<xs:attributeGroup ref="enklawy"/>
		<xs:attribute name="odnosniki">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="litery"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>



	<!--
        ============================================================
        SEKCJA: METADANE
        ============================================================
    -->
	<!--
        *TYPY POMOCNICZE*
    -->
	<!-- Liczba całkowita lub pusty łańcuch (np. Pozycja, Wolumin) -->
	<xs:simpleType name="LiczbaOpcjTyp">
		<xs:union memberTypes="xs:integer PustyTekstTyp">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value=" "/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>

	<!-- Data lub pusty łańcuch -->
	<xs:simpleType name="DataOpcjTyp">
		<xs:union memberTypes="xs:date PustyTekstTyp"/>
	</xs:simpleType>

	<!-- Rok (gYear) lub pusty łańcuch -->
	<xs:simpleType name="RokOpcjTyp">
		<xs:union memberTypes="xs:gYear PustyTekstTyp"/>
	</xs:simpleType>

	<!-- Łańcuch z zachowaniem spacji-->
	<xs:simpleType name="TekstZeSpacjamiTyp">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- Identyfikator GUID w formacie {xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx} -->
	<xs:simpleType name="GUIDMetaTyp">
		<xs:restriction base="xs:string">
			<xs:pattern value="[\da-fA-F]{8}(-[\da-fA-F]{4}){3}-[\da-fA-F]{12}"/>
		</xs:restriction>
	</xs:simpleType>

	<!--
        *TYPY WYLICZENIOWE*
    -->
	<!--
      Rodzaj aktu prawnego jest zgodny ze słownikiem https://eli.gov.pl/resource/authority/resource-type
      Jest to katalog szerszy, niż obsługiwany w tym momencie (wersja 0.2) w schemie.
    -->
	<xs:simpleType name="RodzajAktuTyp">
		<xs:restriction base="xs:string">
			<!-- Akty ustawodawcze -->
			<xs:enumeration value="KONSTYTUCJA">
				<xs:annotation>
					<xs:documentation xml:lang="pl">konstytucja</xs:documentation>
					<xs:appinfo><label>konstytucja</label></xs:appinfo>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="USTAWA">
				<xs:annotation>
					<xs:documentation xml:lang="pl">ustawa</xs:documentation>
					<xs:appinfo><label>ustawa</label></xs:appinfo>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="USTAWA_BUDZ">
				<xs:annotation>
					<xs:documentation xml:lang="pl">ustawa budżetowa</xs:documentation>
					<xs:appinfo><label>ustawa budżetowa</label></xs:appinfo>
				</xs:annotation>
			</xs:enumeration>
			<!-- Rozporządzenia i zarządzenia -->
			<xs:enumeration value="ROZP">
				<xs:annotation>
					<xs:documentation xml:lang="pl">rozporządzenie</xs:documentation>
					<xs:appinfo><label>rozporządzenie</label></xs:appinfo>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ZARZĄD">
				<xs:annotation>
					<xs:documentation xml:lang="pl">zarządzenie</xs:documentation>
					<xs:appinfo><label>zarządzenie</label></xs:appinfo>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ZARZĄD_PORZ">
				<xs:annotation>
					<xs:documentation xml:lang="pl">zarządzenie porządkowe</xs:documentation>
					<xs:appinfo><label>zarządzenie porządkowe</label></xs:appinfo>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ZARZĄD_ZAST">
				<xs:annotation>
					<xs:documentation xml:lang="pl">zarządzenie zastępcze</xs:documentation>
					<xs:appinfo><label>zarządzenie zastępcze</label></xs:appinfo>
				</xs:annotation>
			</xs:enumeration>
			<!-- Uchwały -->
			<xs:enumeration value="UCHW">
				<xs:annotation>
					<xs:documentation xml:lang="pl">uchwała</xs:documentation>
					<xs:appinfo><label>uchwała</label></xs:appinfo>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UCH_BUDZ">
				<xs:annotation>
					<xs:documentation xml:lang="pl">uchwała budżetowa</xs:documentation>
					<xs:appinfo><label>uchwała budżetowa</label></xs:appinfo>
				</xs:annotation>
			</xs:enumeration>
			<!-- Postanowienia, decyzje, wyroki -->
			<xs:enumeration value="POST">
				<xs:annotation>
					<xs:documentation xml:lang="pl">postanowienie</xs:documentation>
					<xs:appinfo><label>postanowienie</label></xs:appinfo>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DECYZJA">
				<xs:annotation>
					<xs:documentation xml:lang="pl">decyzja</xs:documentation>
					<xs:appinfo><label>decyzja</label></xs:appinfo>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WYROK">
				<xs:annotation>
					<xs:documentation xml:lang="pl">wyrok</xs:documentation>
					<xs:appinfo><label>wyrok</label></xs:appinfo>
				</xs:annotation>
			</xs:enumeration>
			<!-- Obwieszczenia i teksty jednolite -->
			<xs:enumeration value="OBW">
				<xs:annotation>
					<xs:documentation xml:lang="pl">obwieszczenie</xs:documentation>
					<xs:appinfo><label>obwieszczenie</label></xs:appinfo>
